E71D                             ; RAM Locations
E71D                             ;--------------
E71D                GBUF:     EQU   0A00H   ;Graphics Buffer 16 * 64 = 1024 byte
E71D                ENDPT:    EQU   0E00H   ;End Point for Line
E71D                SX:       EQU   0E02H   ;Sign of X
E71D                SY:       EQU   0E03H   ;Sign of Y
E71D                DX:       EQU   0E04H   ;Change of X
E71D                DY:       EQU   0E06H   ;Change of Y
E71D                ERR:      EQU   0E08H   ;Error Rate
E71D                RAD:      EQU   0E0AH   ;Radius
E71D                CLRBUF:   EQU   0E0CH   ;Clear Buffer Flag on LCD Displaying
E71D                CURSOR_XY:   EQU   0E0DH   ;Cursor Address X,Y
E71D                CURSOR_Y:   EQU   CURSOR_XY   ;Cursor Y
E71D                CURSOR_X:   EQU   CURSOR_XY+1   ;Cursor X
E71D                CURSOR_YS:   EQU   0E0FH   ;Start Y row for new line
E71D                CURSOR_ON:   EQU   0E10H   ;Cursor on/off flag
E71D                INVERSE:   EQU   0E11H   ;Inverse Flag
E71D                PIXEL_X:   EQU   0E12H   ;Pixel X length
E71D                VPORT:    EQU   0E13H   ;View port start address
E71D                TBUF:     EQU   0E15H   ;Top of Buffer pointer
E71D                SBUF:     EQU   16 * 60   ;Scroll Buffer size  16 * 60 = 960 byte (10 lines)
E71D                TGBUF:    EQU   1000H + SBUF   ;Terminal GBUF
E71D                             ; jims disassembler source code
E71D                             ; -----------------------------
E71D                             ; 
E71D                             ; note: this file was updated so i can place it in any memory location.
E71D                             ; for full annotation please look at the pdf "disassembler_listing.pdf"
E71D                             ; 
E71D                             ; edits by craig hart: removed junk code
E71D                             ; fixed two remaining fixed memory references; code can now run anywhere in address apce
E71D                             ; update to add in (xx),a and out (xx),a brackets
E71D                             ; update to add "," in call/jp/jr <flag> opcodes
E71D                             ; optimze by removing code such as jp => jp => dest.
E71D                             ; 
E71D                             ; edit by brian chiha: formatted code
E71D                             ; remove extra space from call/jp/jr <flag> opcodes
E71D                             ; fixed missing opcode LD SP,IX and LD SP,IY
E71D                             ; note: LD (XY+d),n isn't working yet....
E71D                             ; 
E71D                             ; local variables
E71D                DISRAM:   EQU   0900H   
E71D                DISLINE1:   EQU   DISRAM   ;DIS STRING START
E71D                DISLINE2:   EQU   DISRAM + 19   ;DIS SECOND LINE
E71D                DISPTR:   EQU   DISRAM + 38   ;DIS STRING END
E71D                DISFLAG:   EQU   DISRAM + 40   ;DIS FLAG FOR HL,IX,IY
E71D                DISFROM:   EQU   DISRAM + 41   ;DIS START ADDRESS
E71D                             ; 
