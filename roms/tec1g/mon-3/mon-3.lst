F41C   B5                     OR   L   ;AND NON-ZERO
F41D   CA 39 F0               JP   Z,QHOW   
F420   D5                     PUSH   DE   ;SAVE BOTH
F421   E5                     PUSH   HL   
F422   2A D3 17               LD   HL,(RANPNT)   ;GET MEMORY AS RANDOM
F425   11 A5 F8               LD   DE,LSTROM   ;NUMBER
F428   CD C0 EF               CALL   RST20TB   
F42B   38 03                  JR   C,RA1   ;WRAP AROUND IF LAST
F42D   21 A1 EF               LD   HL,tinyBasic   
F430                RA1:         
F430   5E                     LD   E,(HL)   
F431   23                     INC   HL   
F432   56                     LD   D,(HL)   
F433   22 D3 17               LD   (RANPNT),HL   
F436   E1                     POP   HL   
F437   EB                     EX   DE,HL   
F438   C5                     PUSH   BC   
F439   CD 5E F4               CALL   DIVIDE   ;RND (N)=MOD(M,N)+1
F43C   C1                     POP   BC   
F43D   D1                     POP   DE   
F43E   23                     INC   HL   
F43F   C9                     RET      
F440                ABS:         
F440   CD 03 F4               CALL   PARN   ;*** ABS (EXPR) ***
F443   1B                     DEC   DE   
F444   CD 7A F4               CALL   CHKSGN   ;CHECK SIGN
F447   13                     INC   DE   
F448   C9                     RET      
F449                PEEK:        
F449   CD 03 F4               CALL   PARN   ;*** PEEK (EXPR) ***
F44C   7E                     LD   A,(HL)   ;GET VALUE STORED AT EXPRESSION
