F455   EB                     EX   DE,HL   ;BYTES BETWEEN "TXTUNF"
F456   21 00 3E               LD   HL,VARBGN   ;AND "VARBGN"
F459   CD 73 F4               CALL   SUBDE   
F45C   D1                     POP   DE   
F45D   C9                     RET      
F45E                             ;*************************************************************
F45E                             ; 
F45E                             ; *** DIVIDE *** SUBDE *** CHKSGN *** CHGSGN *** & CKHLDE ***
F45E                             ; 
F45E                             ; "DIVIDE" DIVIDES HL BY DE, RESULT IN BC, REMAINDER IN HL
F45E                             ; 
F45E                             ; "SUBDE" SUBSTRACTS DE FROM HL
F45E                             ; 
F45E                             ; "CHKSGN" CHECKS SIGN OF HL.  IF +, NO CHANGE.  IF -, CHANGE
F45E                             ; SIGN AND FLIP SIGN OF B.
F45E                             ; 
F45E                             ; "CHGSGN" CHECKS SIGN N OF HL AND B UNCONDITIONALLY.
F45E                             ; 
F45E                             ; "CKHLDE" CHECKS SIGN OF HL AND DE.  IF DIFFERENT, HL AND DE
F45E                             ; ARE INTERCHANGED.  IF SAME SIGN, NOT INTERCHANGED.  EITHER
F45E                             ; CASE, HL DE ARE THEN COMPARED TO SET THE FLAGS.
F45E                             ;*************************************************************
F45E                DIVIDE:      
F45E   E5                     PUSH   HL   ;*** DIVIDE ***
F45F   6C                     LD   L,H   ;DIVIDE H BY DE
F460   26 00                  LD   H,00H   
F462   CD 69 F4               CALL   DV1   
F465   41                     LD   B,C   ;SAVE RESULT IN B
F466   7D                     LD   A,L   ;(REMAINDER+L)/DE
F467   E1                     POP   HL   
F468   67                     LD   H,A   
F469                DV1:         
F469   0E FF                  LD   C,0FFH   ;RESULT IN C
F46B                DV2:         
F46B   0C                     INC   C   ;DUMB ROUTINE
F46C   CD 73 F4               CALL   SUBDE   ;DIVIDE BY SUBTRACT
F46F   30 FA                  JR   NC,DV2   ;AND COUNT
F471   19                     ADD   HL,DE   
F472   C9                     RET      
F473                SUBDE:       
F473   7D                     LD   A,L   ;*** SUBDE ***
F474   93                     SUB   E   ;SUBSTRACT DE FROM
F475   6F                     LD   L,A   ;HL
F476   7C                     LD   A,H   
F477   9A                     SBC   A,D   
F478   67                     LD   H,A   
F479   C9                     RET      
F47A                CHKSGN:      
F47A   7C                     LD   A,H   ;*** CHKSGN ***
F47B   B7                     OR   A   ;CHECK SIGN OF HL
F47C   F0                     RET   P   
F47D                CHGSGN:      
F47D   7C                     LD   A,H   ;*** CHGSGN ***
F47E   B5                     OR   L   
F47F   C8                     RET   Z   
F480   7C                     LD   A,H   
F481   F5                     PUSH   AF   
F482   2F                     CPL      ;CHANGE SIGN OF HL
F483   67                     LD   H,A   
F484   7D                     LD   A,L   
F485   2F                     CPL      
F486   6F                     LD   L,A   
F487   23                     INC   HL   
F488   F1                     POP   AF   
F489   AC                     XOR   H   
F48A   F2 39 F0               JP   P,QHOW   
F48D   78                     LD   A,B   ;AND ALSO FLIP B
F48E   EE 80                  XOR   80H   
F490   47                     LD   B,A   
F491   C9                     RET      
F492                CKHLDE:      
F492   7C                     LD   A,H   ;SAME SIGN?
F493   AA                     XOR   D   ;YES, COMPARE
F494   F2 98 F4               JP   P,CK1   ;NO, XCHANGE AND COMP
F497   EB                     EX   DE,HL   
F498                CK1:         
F498   C3 C0 EF               JP   RST20TB   
F49B                             ;*************************************************************
F49B                             ; 
F49B                             ; *** SETVAL *** FIN *** ENDCHK *** & ERROR (& FRIENDS) ***
F49B                             ; 
F49B                             ; "SETVAL" EXPECTS A VARIABLE, FOLLOWED BY AN EQUAL SIGN AND
F49B                             ; THEN AN EXPR.  IT EVALUATES THE EXPR. AND SET THE VARIABLE
F49B                             ; TO THAT VALUE.
F49B                             ; 
F49B                             ; "FIN" CHECKS THE END OF A COMMAND.  IF IT ENDED WITH ";",
F49B                             ; EXECUTION CONTINUES.  IF IT ENDED WITH A CR, IT FINDS THE
F49B                             ; NEXT LINE AND CONTINUE FROM THERE.
F49B                             ; 
F49B                             ; "ENDCHK" CHECKS IF A COMMAND IS ENDED WITH CR.  THIS IS
F49B                             ; REQUIRED IN CERTAIN COMMANDS.  (GOTO, RETURN, AND STOP ETC.)
F49B                             ; 
F49B                             ; "ERROR" PRINTS THE STRING POINTED BY DE (AND ENDS WITH CR).
F49B                             ; IT THEN PRINTS THE LINE POINTED BY "CURRNT" WITH A "?"
F49B                             ; INSERTED AT WHERE THE OLD TEXT POINTER (SHOULD BE ON TOP
F49B                             ; OF THE STACK) POINTS TO.  EXECUTION OF TB IS STOPPED
F49B                             ; AND TBI IS RESTARTED.  HOWEVER, IF "CURRNT" -> ZERO
F49B                             ; (INDICATING A DIRECT COMMAND), THE DIRECT COMMAND IS NOT
F49B                             ; PRINTED.  AND IF "CURRNT" -> NEGATIVE # (INDICATING "INPUT"
F49B                             ; COMMAND), THE INPUT LINE IS NOT PRINTED AND EXECUTION IS
F49B                             ; NOT TERMINATED BUT CONTINUED AT "INPERR".
F49B                             ; 
F49B                             ; RELATED TO "ERROR" ARE THE FOLLOWING:
F49B                             ; "QWHAT" SAVES TEXT POINTER IN STACK AND GET MESSAGE "WHAT?"
F49B                             ; "AWHAT" JUST GET MESSAGE "WHAT?" AND JUMP TO "ERROR".
F49B                             ; "QSORRY" AND "ASORRY" DO SAME KIND OF THING.
F49B                             ; "AHOW" AND "AHOW" IN THE ZERO PAGE SECTION ALSO DO THIS.
F49B                             ;*************************************************************
F49B                SETVAL:      
F49B   CD D4 EF               CALL   RST38TB   ;*** SETVAL ***
F49E   DA CD F4               JP   C,QWHAT   ;"WHAT?" NO VARIABLE
F4A1   E5                     PUSH   HL   ;SAVE ADDRESS OF VAR.
F4A2   CD A7 EF               CALL   RST08TB   ;PASS "=" SIGN
F4A5   3D                     DB   "="   
F4A6   0A                     DB   SV1-$-1   
F4A7   CD B9 EF               CALL   RST18TB   ;EVALUATE EXPR.
F4AA   44                     LD   B,H   ;VALUE IS IN BC NOW
F4AB   4D                     LD   C,L   
F4AC   E1                     POP   HL   ;GET ADDRESS
F4AD   71                     LD   (HL),C   ;SAVE VALUE
F4AE   23                     INC   HL   
F4AF   70                     LD   (HL),B   
F4B0   C9                     RET      
F4B1                SV1:         
F4B1   C3 CD F4               JP   QWHAT   ;NO "=" SIGN
F4B4                FIN:         
F4B4   CD A7 EF               CALL   RST08TB   ;*** FIN ***
F4B7   3B                     DB   ";"   
F4B8   04                     DB   FI1-$-1   
F4B9   F1                     POP   AF   ;";", PURGE RET. ADDR.
F4BA   C3 F7 F0               JP   RUNSML   ;CONTINUE SAME LINE
F4BD                FI1:         
F4BD   CD A7 EF               CALL   RST08TB   ;NOT ";", IS IT CR?
F4C0   0D                     DB   CR   
F4C1   04                     DB   FI2-$-1   
F4C2   F1                     POP   AF   ;YES, PURGE RET. ADDR.
F4C3   C3 E7 F0               JP   RUNNXL   ;RUN NEXT LINE
F4C6                FI2:         
F4C6   C9                     RET      ;ELSE RETURN TO CALLER
F4C7                ENDCHK:      
F4C7   CD C6 EF               CALL   RST28TB   ;*** ENDCHK ***
F4CA   FE 0D                  CP   CR   ;END WITH CR?
F4CC   C8                     RET   Z   ;OK, ELSE SAY: "WHAT?"
F4CD                QWHAT:       
F4CD   D5                     PUSH   DE   ;*** QWHAT ***
F4CE                AWHAT:       
F4CE   11 48 F0               LD   DE,WHAT   ;*** AWHAT ***
F4D1                ERROR_ROUTINE:      
F4D1   97                     SUB   A   ;*** ERROR ***
F4D2   CD 64 F5               CALL   PRTSTG   ;PRINT "WHAT?", "HOW?"
F4D5   D1                     POP   DE   ;OR "SORRY"
F4D6   1A                     LD   A,(DE)   ;SAVE THE CHARACTER
F4D7   F5                     PUSH   AF   ;AT WHERE OLD DE ->
F4D8   97                     SUB   A   ;AND PUT A 0 THERE
F4D9   12                     LD   (DE),A   
F4DA   2A C1 17               LD   HL,(CURRNT)   ;GET CURRENT LINE #
F4DD   E5                     PUSH   HL   
F4DE   7E                     LD   A,(HL)   ;CHECK THE VALUE
F4DF   23                     INC   HL   
F4E0   B6                     OR   (HL)   
F4E1   D1                     POP   DE   
F4E2   CA 54 F0               JP   Z,RSTART   ;IF ZERO, JUST RESTART
F4E5   7E                     LD   A,(HL)   ;IF NEGATIVE,
F4E6   B7                     OR   A   
F4E7   FA 9E F2               JP   M,INPERR   ;REDO INPUT
F4EA   CD F9 F5               CALL   PRTLN   ;ELSE PRINT THE LINE
F4ED   1B                     DEC   DE   ;UPTO WHERE THE 0 IS
F4EE   F1                     POP   AF   ;RESTORE THE CHARACTER
F4EF   12                     LD   (DE),A   
F4F0   3E 3F                  LD   A,"?"   ;PRINT A "?"
F4F2   CD B1 EF               CALL   RST10TB   
F4F5   97                     SUB   A   ;AND THE REST OF THE
F4F6   CD 64 F5               CALL   PRTSTG   ;LINE
F4F9   C3 54 F0               JP   RSTART   ;THEN RESTART
F4FC                QSORRY:      
F4FC   D5                     PUSH   DE   ;*** QSORRY ***
F4FD                ASORRY:      
F4FD   11 4E F0               LD   DE,SORRY   ;*** ASORRY ***
F500   18 CF                  JR   ERROR_ROUTINE   
F502                             ;*************************************************************
F502                             ; 
F502                             ; *** GETLN *** FNDLN (& FRIENDS) ***
F502                             ; 
F502                             ; "GETLN" READS A INPUT LINE INTO "BUFFER".  IT FIRST PROMPT
F502                             ; THE CHARACTER IN A (GIVEN BY THE CALLER), THEN IT FILLS
F502                             ; THE BUFFER AND ECHOS.  IT IGNORES LF'S AND NULLS, BUT STILL
F502                             ; ECHOS THEM BACK.  BACKSPACE IS USED TO CAUSE IT TO DELETE
F502                             ; THE LAST CHARACTER (IF THERE IS ONE), AND CTRL-Z IS USED TO
F502                             ; CAUSE IT TO DELETE THE WHOLE LINE AND START IT ALL OVER.
F502                             ; CR SIGNALS THE END OF A LINE, AND CAUSE "GETLN" TO RETURN.
F502                             ; 
F502                             ; "FNDLN" FINDS A LINE WITH A GIVEN LINE # (IN HL) IN THE
F502                             ; TEXT SAVE AREA.  DE IS USED AS THE TEXT POINTER.  IF THE
F502                             ; LINE IS FOUND, DE WILL POINT TO THE BEGINNING OF THAT LINE
F502                             ; (I.E., THE LOW BYTE OF THE LINE #), AND FLAGS ARE NC & Z.
F502                             ; IF THAT LINE IS NOT THERE AND A LINE WITH A HIGHER LINE #
F502                             ; IS FOUND, DE POINTS TO THERE AND FLAGS ARE NC & NZ.  IF
F502                             ; WE REACHED THE END OF TEXT SAVE AREA AND CANNOT FIND THE
F502                             ; LINE, FLAGS ARE C & NZ.
F502                             ; "FNDLN" WILL INITIALIZE DE TO THE BEGINNING OF THE TEXT SAVE
F502                             ; AREA TO START THE SEARCH.  SOME OTHER ENTRIES OF THIS
F502                             ; ROUTINE WILL NOT INITIALIZE DE AND DO THE SEARCH.
F502                             ; "FNDLNP" WILL START WITH DE AND SEARCH FOR THE LINE #.
F502                             ; "FNDNXT" WILL BUMP DE BY 2, FIND A CR AND THEN START SEARCH.
F502                             ; "FNDSKP" USE DE TO FIND A CR, AND THEN START SEARCH.
F502                             ;*************************************************************
F502                GETLN:       
F502   CD B1 EF               CALL   RST10TB   ;*** GETLN ***
F505   11 37 3E               LD   DE,BUFFER   ;PROMPT AND INIT.
F508                GL1:         
F508   CD F4 F6               CALL   CHKIO   ;CHECK KEYBOARD
F50B   28 FB                  JR   Z,GL1   ;NO INPUT, WAIT
F50D   FE 08                  CP   BKSP   ;DELETE LAST CHARACTER?
F50F   28 18                  JR   Z,GL3   ;YES
F511   CD B1 EF               CALL   RST10TB   ;INPUT, ECHO BACK
F514   FE 0A                  CP   LF   ;IGNORE LF
F516   28 F0                  JR   Z,GL1   
F518   B7                     OR   A   ;IGNORE NULL
F519   28 ED                  JR   Z,GL1   
F51B   FE 1A                  CP   CTRLZ   ;DELETE THE WHOLE LINE?
F51D   28 17                  JR   Z,GL4   ;YES
F51F   12                     LD   (DE),A   ;ELSE SAVE INPUT
F520   13                     INC   DE   ;AND BUMP POINTER
F521   FE 0D                  CP   CR   ;WAS IT CR
F523   C8                     RET   Z   ;YES, END OF LINE
F524   7B                     LD   A,E   ;ELSE MORE FREE ROOM?
F525   FE 87                  CP   BUFEND & 0FFH   
F527   20 DF                  JR   NZ,GL1   ;YES, GET NEXT INPUT
F529                GL3:         
F529   7B                     LD   A,E   ;DELETE LAST CHARACTER
F52A   FE 37                  CP   BUFFER & 0FFH   ;BUT DO WE HAVE ANY?
F52C   28 08                  JR   Z,GL4   ;NO, REDO WHOLE LINE
F52E   1B                     DEC   DE   ;YES, BACKUP POINTER
F52F   3E 08                  LD   A,BKSP   ;AND ECHO A BACK SPACE
F531   CD B1 EF               CALL   RST10TB   
F534   18 D2                  JR   GL1   ;GO GET NEXT INPUT
F536                GL4:         
F536   CD AF EF               CALL   CRLF   ;REDO ENTIRE LINE
F539                             ; LD A,VT                         ;CR, LF AND UP-ARROW
F539                             ; CALL RST10TB
F539   3E 3E                  LD   A,">"   
F53B   18 C5                  JR   GETLN   
F53D                FNDLN:       
F53D   7C                     LD   A,H   ;*** FNDLN ***
F53E   B7                     OR   A   ;CHECK SIGN OF HL
F53F   FA 39 F0               JP   M,QHOW   ;IT CANNOT BE -
F542   11 D7 17               LD   DE,TXTBGN   ;INIT TEXT POINTER
F545                FNDLP:       ;*** FDLNP ***
F545                FL1:         
F545   E5                     PUSH   HL   ;SAVE LINE #
F546   2A D5 17               LD   HL,(TXTUNF)   ;CHECK IF WE PASSED END
F549   2B                     DEC   HL   
F54A   CD C0 EF               CALL   RST20TB   
F54D   E1                     POP   HL   ;GET LINE # BACK
F54E   D8                     RET   C   ;C,NZ PASSED END
F54F   1A                     LD   A,(DE)   ;WE DID NOT, GET BYTE 1
F550   95                     SUB   L   ;IS THIS THE LINE?
F551   47                     LD   B,A   ;COMPARE LOW ORDER
F552   13                     INC   DE   
F553   1A                     LD   A,(DE)   ;GET BYTE 2
F554   9C                     SBC   A,H   ;COMPARE HIGH ORDER
F555   38 04                  JR   C,FL2   ;NO, NOT THERE YET
F557   1B                     DEC   DE   ;ELSE WE EITHER FOUND
F558   B0                     OR   B   ;IT, OR IT IS NOT THERE
F559   C9                     RET      ;NC,Z;FOUND, NC,NZ:NO
F55A                FNDNXT:      ;*** FNDNXT ***
F55A   13                     INC   DE   ;FIND NEXT LINE
F55B                FL2:         
F55B   13                     INC   DE   ;JUST PASSED BYTE 1 & 2
F55C                FNDSKP:      
F55C   1A                     LD   A,(DE)   ;*** FNDSKP ***
F55D   FE 0D                  CP   CR   ;TRY TO FIND CR
F55F   20 FA                  JR   NZ,FL2   ;KEEP LOOKING
F561   13                     INC   DE   ;FOUND CR, SKIP OVER
F562   18 E1                  JR   FL1   ;CHECK IF END OF TEXT
F564                             ;*************************************************************
F564                             ; 
F564                             ; *** PRTSTG *** QTSTG *** PRTNUM *** & PRTLN ***
F564                             ; 
F564                             ; "PRTSTG" PRINTS A STRING POINTED BY DE.  IT STOPS PRINTING
F564                             ; AND RETURNS TO CALLER WHEN EITHER A CR IS PRINTED OR WHEN
F564                             ; THE NEXT BYTE IS THE SAME AS WHAT WAS IN A (GIVEN BY THE
F564                             ; CALLER).  OLD A IS STORED IN C, OLD C IS LOST.
F564                             ; 
F564                             ; "QTSTG" LOOKS FOR A UNDERSCORE, SINGLE QUOTE, OR DOUBLE
F564                             ; QUOTE.  IF NONE OF THESE, RETURN TO CALLER.  IF UNDERSCORE,
F564                             ; OUTPUT A CR WITHOUT A LF.  IF SINGLE OR DOUBLE QUOTE, PRINT
F564                             ; THE STRING IN THE QUOTE AND DEMANDS A MATCHING UNQUOTE.
F564                             ; AFTER THE PRINTING THE NEXT 2 BYTES OF THE CALLER IS SKIPPED
F564                             ; OVER (USUALLY A JUMP INSTRUCTION.
F564                             ; 
F564                             ; "PRTNUM" PRINTS THE NUMBER IN HL.  LEADING BLANKS ARE ADDED
F564                             ; IF NEEDED TO PAD THE NUMBER OF SPACES TO THE NUMBER IN C.
F564                             ; HOWEVER, IF THE NUMBER OF DIGITS IS LARGER THAN THE # IN
F564                             ; C, ALL DIGITS ARE PRINTED ANYWAY.  NEGATIVE SIGN IS ALSO
F564                             ; PRINTED AND COUNTED IN, POSITIVE SIGN IS NOT.
F564                             ; 
F564                             ; "PRTLN" PRINTS A SAVED TEXT LINE WITH LINE # AND ALL.
F564                             ; 
F564                             ; "PRTCHR" PRINTS THE VALUE IN L AS AN ASCII CHARACTER.  THIS
F564                             ; WILL PRINT NON ASCII CHARACTERS TOO.  IE: ^G (BEL)
F564                             ; 
F564                             ; "PRTASC" PRINTS THE VALUE IN L AS AN ASCII
F564                             ; 
F564                             ; "PRTHEX" PRINTS THE VALUE IN HL AS A HEXIDECIMAL NUMBER.
F564                             ; HL IS TWO BYTES, SO TWO HEX VALUES WILL BE DISPLAYED.
F564                             ; IF H IS ZERO THEN ONLY ONE BYTE WILL BE DISPLAYED.
F564                             ; 
F564                             ;*************************************************************
F564                PRTSTG:      
F564   47                     LD   B,A   ;*** PRTSTG ***
F565   CD 8F CF               CALL   getGLCDTerm   
F568   B7                     OR   A   ;CHECK VALUE
F569   28 13                  JR   Z,PS1   
F56B   C5                     PUSH   BC   
F56C   48                     LD   C,B   ;*** PRTSTG ***
F56D   D5                     PUSH   DE   
F56E   E5                     PUSH   HL   
F56F   CD AD DB               CALL   sendStringToLCD   ;SEND TO GLCD TERMINAL
F572   E1                     POP   HL   
F573   D1                     POP   DE   
F574   C1                     POP   BC   
F575                PS0:         
F575   1A                     LD   A,(DE)   ;ADJUST DE (UGGHH)
F576   13                     INC   DE   
F577   B8                     CP   B   
F578   C8                     RET   Z   
F579   FE 0D                  CP   CR   
F57B   20 F8                  JR   NZ,PS0   
F57D   C9                     RET      
F57E                PS1:         
F57E   1A                     LD   A,(DE)   ;GET A CHARACTER
F57F   13                     INC   DE   ;BUMP POINTER
F580   B8                     CP   B   ;SAME AS OLD A?
F581   C8                     RET   Z   ;YES, RETURN
F582   CD B1 EF               CALL   RST10TB   ;NO, NEXT
F585   FE 0D                  CP   CR   ;WAS IT A CR?
F587   20 F5                  JR   NZ,PS1   ;NO, NEXT
F589   C9                     RET      ;YES, RETURN
F58A                QTSTG:       
F58A   CD A7 EF               CALL   RST08TB   ;*** QTSTG ***
F58D   22                     DB   22H   
F58E   0E                     DB   QT3-$-1   
F58F   3E 22                  LD   A,22H   ;IT IS A "
F591                QT1:         
F591   CD 64 F5               CALL   PRTSTG   ;PRINT UNTIL ANOTHER
F594   FE 0D                  CP   CR   ;WAS LAST ONE A CR?
F596   E1                     POP   HL   ;RETURN ADDRESS
F597   CA E7 F0               JP   Z,RUNNXL   ;WAS CR, RUN NEXT LINE
F59A                QT2:         
F59A   23                     INC   HL   ;SKIP 2 BYTES ON RETURN
F59B   23                     INC   HL   
F59C   E9                     JP   (HL)   ;RETURN
F59D                QT3:         
F59D   CD A7 EF               CALL   RST08TB   ;IS IT A '?
F5A0   27                     DB   27H   
F5A1   04                     DB   QT4-$-1   
F5A2   3E 27                  LD   A,27H   ;YES, DO THE SAME
F5A4   18 EB                  JR   QT1   ;AS IN "
F5A6                QT4:         
F5A6   CD A7 EF               CALL   RST08TB   ;IS IT UNDERSCORE?
F5A9   5F                     DB   "_"   
F5AA   0D                     DB   QT5-$-1   
F5AB   3E 0D                  LD   A,CR   ;YES, CR WITHOUT LF
F5AD   CD B1 EF               CALL   RST10TB   ;DO IT TWICE TO GIVE
F5B0   3E 0B                  LD   A,VT   ;YES, CR WITHOUT LF
F5B2   CD B1 EF               CALL   RST10TB   ;TTY ENOUGH TIME
F5B5   E1                     POP   HL   ;RETURN ADDRESS
F5B6   18 E2                  JR   QT2   
F5B8                QT5:         
F5B8   C9                     RET      ;NONE OF ABOVE
F5B9                             ; 
F5B9                PRTNUM:      
F5B9   06 00                  LD   B,00H   ;*** PRTNUM ***
F5BB   CD 7A F4               CALL   CHKSGN   ;CHECK SIGN
F5BE   F2 C4 F5               JP   P,PN1   ;NO SIGN
F5C1   06 2D                  LD   B,"-"   ;B=SIGN
F5C3   0D                     DEC   C   ;"-" TAKES SPACE
F5C4                PN1:         
F5C4   D5                     PUSH   DE   ;SAVE
F5C5   11 0A 00               LD   DE,000AH   ;DECIMAL
F5C8   D5                     PUSH   DE   ;SAVE AS FLAG
F5C9   0D                     DEC   C   ;C=SPACES
F5CA   C5                     PUSH   BC   ;SAVE SIGN & SPACE
F5CB                PN2:         
F5CB   CD 5E F4               CALL   DIVIDE   ;DIVIDE HL BY 10
F5CE   78                     LD   A,B   ;RESULT 0?
F5CF   B1                     OR   C   
F5D0   28 07                  JR   Z,PN3   ;YES, WE GOT ALL
F5D2   E3                     EX   (SP),HL   ;NO, SAVE REMAINDER
F5D3   2D                     DEC   L   ;AND COUNT SPACE
F5D4   E5                     PUSH   HL   ;HL IS OLD BC
F5D5   60                     LD   H,B   ;MOVE RESULT TO BC
F5D6   69                     LD   L,C   
F5D7   18 F2                  JR   PN2   ;AND DIVIDE BY 10
F5D9                PN3:         
F5D9   C1                     POP   BC   ;WE GOT ALL DIGITS IN
F5DA                PN4:         
F5DA   0D                     DEC   C   ;THE STACK
F5DB   79                     LD   A,C   ;LOOK AT SPACE COUNT
F5DC   B7                     OR   A   
F5DD   FA E7 F5               JP   M,PN5   ;NO LEADING BLANKS
F5E0   3E 20                  LD   A,20H   ;LEADING BLANKS
F5E2   CD B1 EF               CALL   RST10TB   
F5E5   18 F3                  JR   PN4   ;MORE?
F5E7                PN5:         
F5E7   78                     LD   A,B   ;PRINT SIGN
F5E8   B7                     OR   A   
F5E9   C4 B1 EF               CALL   NZ,RST10TB   
F5EC   5D                     LD   E,L   ;LAST REMAINDER IN E
F5ED                PN6:         
F5ED   7B                     LD   A,E   ;CHECK DIGIT IN E
F5EE   FE 0A                  CP   0AH   ;10 IS FLAG FOR NO MORE
F5F0   D1                     POP   DE   
F5F1   C8                     RET   Z   ;IF SO, RETURN
F5F2   C6 30                  ADD   A,30H   ;ELSE, CONVERT TO ASCII
F5F4   CD B1 EF               CALL   RST10TB   ;PRINT THE DIGIT
F5F7   18 F4                  JR   PN6   ;GO BACK FOR MORE
F5F9                PRTLN:       
F5F9   1A                     LD   A,(DE)   ;*** PRTLN ***
F5FA   6F                     LD   L,A   ;LOW ORDER LINE #
F5FB   13                     INC   DE   
F5FC   1A                     LD   A,(DE)   ;HIGH ORDER
F5FD   67                     LD   H,A   
F5FE   13                     INC   DE   
F5FF   0E 04                  LD   C,04H   ;PRINT 4 DIGIT LINE #
F601   CD B9 F5               CALL   PRTNUM   
F604   3E 20                  LD   A,20H   ;FOLLOWED BY A BLANK
F606   CD B1 EF               CALL   RST10TB   
F609   97                     SUB   A   ;AND THEN THE NEXT
F60A   C3 64 F5               JP   PRTSTG   
F60D                PRTCHR:      
F60D   7D                     LD   A,L   ;GET THE NUMBER
F60E                             ;AND DEL                         ;ONLY LOOK AT 0-128
F60E                PC1:         
F60E   C3 B1 EF               JP   RST10TB   ;PRINT VALUE IN A
F611                PRTASC:      
F611   7D                     LD   A,L   ;GET THE NUMBER
F612   FE 20                  CP   SPACE   ;IS IT LOWER THAN " " ?
F614   38 04                  JR   C,PA1   ;YES
F616   FE 7F                  CP   DEL   ;IS IT HIGHER THAN "~" ?
F618   38 F4                  JR   C,PC1   ;NO
F61A                PA1:         
F61A   3E 2E                  LD   A,"."   ;DISPLAY A . IF NON PRINTABLE
F61C   18 F0                  JR   PC1   
F61E                PRTHEX:      
F61E   7C                     LD   A,H   
F61F   B7                     OR   A   
F620   28 03                  JR   Z,PH1   
F622   CD 26 F6               CALL   A2HEX   
F625                PH1:         
F625   7D                     LD   A,L   
F626                A2HEX:       
F626   F5                     PUSH   AF   ;SAVE A FOR SECOND NIBBLE
F627   0F                     RRCA      ;SHIFT HIGH NIBBLE ACROSS
F628   0F                     RRCA      ; 
F629   0F                     RRCA      ; 
F62A   0F                     RRCA      ; 
F62B   CD 2F F6               CALL   PH2   ;CALL NIBBLE CONVERTER
F62E   F1                     POP   AF   ;RECOVER LOW NIBBLE
F62F                PH2:         
F62F   E6 0F                  AND   0FH   ;MASK OFF HIGH NIBBLE
F631   C6 90                  ADD   A,90H   ;CONVERT TO
F633   27                     DAA      ;ASCII
F634   CE 40                  ADC   A,40H   ;USING THIS
F636   27                     DAA      ;AMAZING ROUTINE
F637   C3 B1 EF               JP   RST10TB   ;DONE
F63A                             ;*************************************************************
F63A                             ; 
F63A                             ; *** MVUP *** MVDOWN *** POPA *** & PUSHA ***
F63A                             ; 
F63A                             ; "MVUP" MOVES A BLOCK UP FROM WHERE DE-> TO WHERE BC-> UNTIL
F63A                             ; DE = HL
F63A                             ; 
F63A                             ; "MVDOWN" MOVES A BLOCK DOWN FROM WHERE DE-> TO WHERE HL->
F63A                             ; UNTIL DE = BC
F63A                             ; 
F63A                             ; "POPA" RESTORES THE "FOR" LOOP VARIABLE SAVE AREA FROM THE
F63A                             ; STACK
F63A                             ; 
F63A                             ; "PUSHA" STACKS THE "FOR" LOOP VARIABLE SAVE AREA INTO THE
F63A                             ; STACK
F63A                             ;*************************************************************
F63A                MVUP1:       
F63A   CD C0 EF               CALL   RST20TB   ;*** MVUP ***
F63D   C8                     RET   Z   ;DE = HL, RETURN
F63E   1A                     LD   A,(DE)   ;GET ONE BYTE
F63F   02                     LD   (BC),A   ;MOVE IT
F640   13                     INC   DE   ;INCREASE BOTH POINTERS
F641   03                     INC   BC   
F642   18 F6                  JR   MVUP1   ;UNTIL DONE
F644                MVDOWN:      
F644   78                     LD   A,B   ;*** MVDOWN ***
F645   92                     SUB   D   ;TEST IF DE = BC
F646   C2 4C F6               JP   NZ,MD1   ;NO, GO MOVE
F649   79                     LD   A,C   ;MAYBE, OTHER BYTE?
F64A   93                     SUB   E   
F64B   C8                     RET   Z   ;YES, RETURN
F64C                MD1:         
F64C   1B                     DEC   DE   ;ELSE MOVE A BYTE
F64D   2B                     DEC   HL   ;BUT FIRST DECREASE
F64E   1A                     LD   A,(DE)   ;BOTH POINTERS AND
F64F   77                     LD   (HL),A   ;THEN DO IT
F650   18 F2                  JR   MVDOWN   ;LOOP BACK
F652                POPA:        
F652   C1                     POP   BC   ;BC = RETURN ADDR.
F653   E1                     POP   HL   ;RESTORE LOPVAR, BUT
F654   22 C9 17               LD   (LOPVAR),HL   ;=0 MEANS NO MORE
F657   7C                     LD   A,H   
F658   B5                     OR   L   
F659   28 10                  JR   Z,PP1   ;YEP, GO RETURN
F65B   E1                     POP   HL   ;NOP, RESTORE OTHERS
F65C   22 CB 17               LD   (LOPINC),HL   
F65F   E1                     POP   HL   
F660   22 CD 17               LD   (LOPLMT),HL   
F663   E1                     POP   HL   
F664   22 CF 17               LD   (LOPLN),HL   
F667   E1                     POP   HL   
F668   22 D1 17               LD   (LOPPT),HL   
F66B                PP1:         
F66B   C5                     PUSH   BC   ;BC = RETURN ADDR.
F66C   C9                     RET      
F66D                PUSHA:       
F66D   21 88 3E               LD   HL,STKLMT   ;*** PUSHA ***
F670   CD 7D F4               CALL   CHGSGN   
F673   C1                     POP   BC   ;BC=RETURN ADDRESS
F674   39                     ADD   HL,SP   ;IS STACK NEAR THE TOP?
F675   D2 FC F4               JP   NC,QSORRY   ;YES, SORRY FOR THAT
F678   2A C9 17               LD   HL,(LOPVAR)   ;ELSE SAVE LOOP VAR'S
F67B   7C                     LD   A,H   ;BUT IF LOPVAR IS 0
F67C   B5                     OR   L   ;THAT WILL BE ALL
F67D   28 13                  JR   Z,PU1   
F67F   2A D1 17               LD   HL,(LOPPT)   ;ELSE, MORE TO SAVE
F682   E5                     PUSH   HL   
F683   2A CF 17               LD   HL,(LOPLN)   
F686   E5                     PUSH   HL   
F687   2A CD 17               LD   HL,(LOPLMT)   
F68A   E5                     PUSH   HL   
F68B   2A CB 17               LD   HL,(LOPINC)   
F68E   E5                     PUSH   HL   
F68F   2A C9 17               LD   HL,(LOPVAR)   
F692                PU1:         
F692   E5                     PUSH   HL   
F693   C5                     PUSH   BC   ;BC = RETURN ADDR.
F694   C9                     RET      
F695                             ;*************************************************************
F695                             ; 
F695                             ; *** OUTC *** OUTP *** XON *** XOFF *** CHKIO ***
F695                             ; 
F695                             ; THESE ARE THE ONLY I/O ROUTINES IN TBI.
F695                             ; "OUTC" IS CONTROLLED BY A SOFTWARE SWITCH "OCSW".  IF OCSW=0
F695                             ; "OUTC" WILL JUST RETURN TO THE CALLER.  IF OCSW IS NOT 0,
F695                             ; IT WILL OUTPUT THE BYTE IN A.  IF THAT IS A CR, A LF IS ALSO
F695                             ; SEND OUT.  ONLY THE FLAGS MAY BE CHANGED AT RETURN. ALL REG.
F695                             ; ARE RESTORED.
F695                             ; 
F695                             ; "OUTP" LETS THE USER SEND DATA TO AN OUTPUT PORT ON THE
F695                             ; CONTROLING HARDWARE.  THE FORMAT IS "OUT <PORT>,<DATA>"
F695                             ; WHERE <PORT> IS THE PORT NUMBER AND <DATA> IS THE DATA
F695                             ; TO OUTPUT.  BOTH PORT NUMBER AND DATA ARE EXPRESIONS AND
F695                             ; ARE TO BE LESS THAN 256.
F695                             ; 
F695                             ; "XON" AND "XOFF" PROGRAMATICALLY TURN ON OR OFF THE
F695                             ; OUTPUT SWITCH.  THIS IS THE SAME AS PRESSING CONTROL-O
F695                             ; ON THE KEYBOARD.  THE CAN BE USED TO DISABLE TX_RDY,
F695                             ; THE SERIAL OUTPUT ROUTINE, IF THE SAME PORT IS BEING
F695                             ; USED.
F695                             ; 
F695                             ; "CHKIO" CHECKS THE INPUT.  IF NO INPUT, IT WILL RETURN TO
F695                             ; THE CALLER WITH THE Z FLAG SET.  IF THERE IS INPUT, Z FLAG
F695                             ; IS CLEARED AND THE INPUT BYTE IS IN A.  HOWEVER, IF THE
F695                             ; INPUT IS A CONTROL-O, THE "OCSW" SWITCH IS COMPLIMENTED, AND
F695                             ; Z FLAG IS RETURNED.  IF A CONTROL-C IS READ, "CHKIO" WILL
F695                             ; RESTART TBI AND DO NOT RETURN TO THE CALLER.
F695                             ; 
F695                             ; Do not modify these routines.  Routines requiring
F695                             ; modification are : SERIAL_INIT, RX_RDY, and TX_RDY.
F695                             ;*************************************************************
F695                INIT:        
F695   CD 18 F8               CALL   SERIAL_INIT   ;INITIALIZE THE SIO
F698   AF                     XOR   A   
F699   11 23 F7               LD   DE,MSG1   ;PRINT THE BOOT MESSAGES
F69C   CD 64 F5               CALL   PRTSTG   
F69F   AF                     XOR   A   
F6A0   11 36 F7               LD   DE,MSG2   
F6A3   CD 64 F5               CALL   PRTSTG   
F6A6   21 A1 EF               LD   HL,tinyBasic   
F6A9   22 D3 17               LD   (RANPNT),HL   
F6AC   21 D7 17               LD   HL,TXTBGN   
F6AF   22 D5 17               LD   (TXTUNF),HL   
F6B2   C3 54 F0               JP   RSTART   
F6B5                OUTC:        
F6B5   20 02                  JR   NZ,OUTC2   ;IT IS ON
F6B7   F1                     POP   AF   ;IT IS OFF
F6B8   C9                     RET      ;RESTORE AF AND RETURN
F6B9                OUTC2:       
F6B9   F1                     POP   AF   ;RESTORE THE REGISTER
F6BA   CD 23 F8               CALL   TX_RDY   ;SEND THE BYTE
F6BD   FE 0D                  CP   CR   
F6BF   C0                     RET   NZ   
F6C0   3E 0A                  LD   A,LF   
F6C2   CD B1 EF               CALL   RST10TB   
F6C5   3E 0D                  LD   A,CR   
F6C7   C9                     RET      
F6C8                OUTP:        
F6C8   CD B9 EF               CALL   RST18TB   ;GET PORT NUMBER
F6CB   AF                     XOR   A   ;IS PORT > 255?
F6CC   BC                     CP   H   
F6CD   C2 39 F0               JP   NZ,QHOW   ;YES, NOT A VALID PORT
F6D0   CD A7 EF               CALL   RST08TB   ;IF "," THEN GET DATA
F6D3   2C                     DB   ","   
F6D4   11                     DB   OT1-$-1   
F6D5   E5                     PUSH   HL   
F6D6   CD B9 EF               CALL   RST18TB   ;GET DATA TO OUTPUT
F6D9   AF                     XOR   A   ;IS DATA > 255?
F6DA   BC                     CP   H   
F6DB   C2 39 F0               JP   NZ,QHOW   ;YES, NOT A DATA VALUE
F6DE   7D                     LD   A,L   ;RETRIVE DATA
F6DF   E1                     POP   HL   
F6E0   4D                     LD   C,L   ;RETRIVE PORT
F6E1   ED 79                  OUT   (C),A   ;SEND IT OUT
F6E3   CD CD EF               CALL   RST30TB   
F6E6                OT1:         
F6E6   C3 CD F4               JP   QWHAT   
F6E9                XON:         
F6E9   3E FF                  LD   A,0FFH   ;SET SWTICH TO ON
F6EB   18 01                  JR   XO1   
F6ED                XOFF:        
F6ED   AF                     XOR   A   ;SET SWITCH TO OFF
F6EE                XO1:         
F6EE   32 C0 17               LD   (OCSW),A   ;SAVE NEW SWITCH
F6F1   CD CD EF               CALL   RST30TB   ;CONTINUE
F6F4                CHKIO:       
F6F4   CD 5F F8               CALL   RX_RDY   ;CHECK IF CHARACTER AVAILABLE
F6F7   C8                     RET   Z   ;RETURN IF NO CHARACTER AVAILABLE
F6F8   C5                     PUSH   BC   ;IF IT'S A LF, IGNORE AND RETURN
F6F9   47                     LD   B,A   ; AS IF THERE WAS NO CHARACTER.
F6FA   D6 0A                  SUB   LF   
F6FC   28 0F                  JR   Z,CHKIO2   
F6FE   78                     LD   A,B   ;OTHERWISE RESTORE "A" AND "BC"
F6FF   C1                     POP   BC   ; AND CONTINUE ON.
F700   FE 0F                  CP   CTRLO   ;IS IT CONTROL-0?
F702   20 0C                  JR   NZ,CI1   ;NO, MORE CHECKING
F704   3A C0 17               LD   A,(OCSW)   ;CONTROL-0 FLIPS OCSW
F707   2F                     CPL      ;ON TO OFF, OFF TO ON
F708   32 C0 17               LD   (OCSW),A   
F70B   18 E7                  JR   CHKIO   ;GET ANOTHER INPUT
F70D                CHKIO2:      
F70D   AF                     XOR   A   ;CLEAR A
F70E   C1                     POP   BC   ;RESTORE THE "BC" PAIR
F70F   C9                     RET      ;RETURN WITH "Z" SET.
F710                CI1:         
F710   FE 61                  CP   61H   ;IS IT LOWER THAN "a" ?
F712   38 06                  JR   C,CI2   ;YES
F714   FE 7B                  CP   7BH   ;IS IT HIGHT THAN "z" ?
F716   30 02                  JR   NC,CI2   ;YES
F718   E6 DF                  AND   0DFH   ;MAKE IT UPPER CASE
F71A                CI2:         
F71A   FE 03                  CP   CTRLC   ;IS IT CONTROL-C?
F71C   CA 54 F0               JP   Z,RSTART   ;YES, RESTART TBI
F71F   FE 04                  CP   CTRLD   ;IS IT CONTROL-D?
F721   C0                     RET   NZ   ;NO, RETURN "NZ"
F722   C7                     RST   00H   ;RESTART MONITOR AND EXIT
F723   54 45 43 2D 31 47 20 54 49 4E 59 20 42 41 53 49 43 20 0D MSG1:   DB   "TEC-1G TINY BASIC ",CR   ;CLEAR SCREEN AND BOOT MESSAGE
F736   43 52 41 43 4B 45 44 20 42 59 20 42 20 43 48 49 48 41 20 17 0D MSG2:   DB   "CRACKED BY B CHIHA ",23,CR   
F74B                             ;*************************************************************
F74B                             ; 
F74B                             ; *** TABLES *** DIRECT *** & EXEC ***
F74B                             ; 
F74B                             ; THIS SECTION OF THE CODE TESTS A STRING AGAINST A TABLE.
F74B                             ; WHEN A MATCH IS FOUND, CONTROL IS TRANSFERED TO THE SECTION
F74B                             ; OF CODE ACCORDING TO THE TABLE.
F74B                             ; 
F74B                             ; AT "EXEC", DE SHOULD POINT TO THE STRING AND HL SHOULD POINT
F74B                             ; TO THE TABLE-1.  AT "DIRECT", DE SHOULD POINT TO THE STRING.
F74B                             ; HL WILL BE SET UP TO POINT TO TAB1-1, WHICH IS THE TABLE OF
F74B                             ; ALL DIRECT AND STATEMENT COMMANDS.
F74B                             ; 
F74B                             ; A "." IN THE STRING WILL TERMINATE THE TEST AND THE PARTIAL
F74B                             ; MATCH WILL BE CONSIDERED AS A MATCH.  E.G., "P.", "PR.",
F74B                             ; "PRI.", "PRIN.", OR "PRINT" WILL ALL MATCH "PRINT".
F74B                             ; 
F74B                             ; THE TABLE CONSISTS OF ANY NUMBER OF ITEMS.  EACH ITEM
F74B                             ; IS A STRING OF CHARACTERS WITH BIT 7 SET TO 0 AND
F74B                             ; A JUMP ADDRESS STORED HI-LOW WITH BIT 7 OF THE HIGH
F74B                             ; BYTE SET TO 1.
F74B                             ; 
F74B                             ; END OF TABLE IS AN ITEM WITH A JUMP ADDRESS ONLY.  IF THE
F74B                             ; STRING DOES NOT MATCH ANY OF THE OTHER ITEMS, IT WILL
F74B                             ; MATCH THIS NULL ITEM AS DEFAULT.
F74B                             ;*************************************************************
F74B                TAB1:        ;DIRECT COMMANDS
F74B   4C 49 53 54            DB   "LIST"   
F74F   F1                     DB   LIST/100H   
F750   10                     DB   LIST   
F751   52 55 4E               DB   "RUN"   
F754   F0                     DB   RUN/100H   
F755   E1                     DB   RUN   
F756   4E 45 57               DB   "NEW"   
F759   F0                     DB   NEW/100H   
F75A   D2                     DB   NEW   
F75B                TAB2:        ;DIRECT/STATEMENT
F75B   4E 45 58 54            DB   "NEXT"   
F75F   F2                     DB   NEXT/100H   
F760   2A                     DB   NEXT   
F761   4C 45 54               DB   "LET"   
F764   F3                     DB   LET/100H   
F765   03                     DB   LET   
F766   49 46                  DB   "IF"   
F768   F2                     DB   IFF/100H   
F769   8D                     DB   IFF   
F76A   47 4F 54 4F            DB   "GOTO"   
F76E   F1                     DB   GOTO/100H   
F76F   00                     DB   GOTO   
F770   47 4F 53 55 42         DB   "GOSUB"   
F775   F1                     DB   GOSUB/100H   
F776   8E                     DB   GOSUB   
F777   52 45 54 55 52 4E      DB   "RETURN"   
F77D   F1                     DB   RETURN/100H   
F77E   B0                     DB   RETURN   
F77F   52 45 4D               DB   "REM"   
F782   F2                     DB   REM/100H   
F783   88                     DB   REM   
F784   46 4F 52               DB   "FOR"   
F787   F1                     DB   FOR/100H   
F788   CB                     DB   FOR   
F789   49 4E 50 55 54         DB   "INPUT"   
F78E   F2                     DB   INPUT/100H   
F78F   A8                     DB   INPUT   
F790   50 52 49 4E 54         DB   "PRINT"   
F795   F1                     DB   PRINT/100H   
F796   27                     DB   PRINT   
F797   4F 55 54               DB   "OUT"   
F79A   F6                     DB   OUTP/100H   
F79B   C8                     DB   OUTP   
F79C   53 54 4F 50            DB   "STOP"   
F7A0   F0                     DB   STOP/100H   
F7A1   DB                     DB   STOP   
F7A2   58 4F 4E               DB   "XON"   
F7A5   F6                     DB   XON/100H   
F7A6   E9                     DB   XON   
F7A7   58 4F 46 46            DB   "XOFF"   
F7AB   F6                     DB   XOFF/100H   
F7AC   ED                     DB   XOFF   
F7AD   F2                     DB   DEFLT/100H   
F7AE   FE                     DB   DEFLT   
F7AF                TAB4:        ;FUNCTIONS
F7AF   52 4E 44               DB   "RND"   
F7B2   F4                     DB   RND/100H   
F7B3   14                     DB   RND   
F7B4   41 42 53               DB   "ABS"   
F7B7   F4                     DB   ABS/100H   
F7B8   40                     DB   ABS   
F7B9   50 45 45 4B            DB   "PEEK"   
F7BD   F4                     DB   PEEK/100H   
F7BE   49                     DB   PEEK   
F7BF   53 49 5A 45            DB   "SIZE"   
F7C3   F4                     DB   SIZE/100H   
F7C4   51                     DB   SIZE   
F7C5   F3                     DB   XP40/100H   
F7C6   F3                     DB   XP40   
F7C7                TAB5:        ;"TO" IN "FOR"
F7C7   54 4F                  DB   "TO"   
F7C9   F1                     DB   FR1/100H   
F7CA   DB                     DB   FR1   
F7CB   F4                     DB   QWHAT/100H   
F7CC   CD                     DB   QWHAT   
F7CD                TAB6:        ;"STEP" IN "FOR"
F7CD   53 54 45 50            DB   "STEP"   
F7D1   F1                     DB   FR2/100H   
F7D2   E7                     DB   FR2   
F7D3   F1                     DB   FR3/100H   
F7D4   EC                     DB   FR3   
F7D5                TAB8:        ;RELATION OPERATORS
F7D5   3E 3D                  DB   ">="   
F7D7   F3                     DB   XP11/100H   
F7D8   16                     DB   XP11   
F7D9   23                     DB   "#"   
F7DA   F3                     DB   XP12/100H   
F7DB   1C                     DB   XP12   
F7DC   3E                     DB   ">"   
F7DD   F3                     DB   XP13/100H   
F7DE   22                     DB   XP13   
F7DF   3D                     DB   "="   
F7E0   F3                     DB   XP15/100H   
F7E1   31                     DB   XP15   
F7E2   3C 3D                  DB   "<="   
F7E4   F3                     DB   XP14/100H   
F7E5   29                     DB   XP14   
F7E6   3C                     DB   "<"   
F7E7   F3                     DB   XP16/100H   
F7E8   37                     DB   XP16   
F7E9   F3                     DB   XP17/100H   
F7EA   3D                     DB   XP17   
F7EB   21 4A F7     DIRECT:   LD   HL,TAB1-1   ;*** DIRECT ***
F7EE                EXEC:        ;*** EXEC ***
F7EE   CD C6 EF     EX0:      CALL   RST28TB   ;IGNORE LEADING BLANKS
F7F1   D5                     PUSH   DE   ;SAVE POINTER
F7F2                EX1:         
F7F2   1A                     LD   A,(DE)   ;IF FOUND "." IN STRING
F7F3   13                     INC   DE   ;BEFORE ANY MISMATCH
F7F4   FE 2E                  CP   "."   ;WE DECLARE A MATCH
F7F6   28 12                  JR   Z,EX3   
F7F8   23                     INC   HL   ;HL->TABLE
F7F9   BE                     CP   (HL)   ;IF MATCH, TEST NEXT
F7FA   28 F6                  JR   Z,EX1   
F7FC   3E 7F                  LD   A,7FH   ;ELSE SEE IF BIT 7
F7FE   1B                     DEC   DE   ;OF TABLE IS SET, WHICH
F7FF   BE                     CP   (HL)   ;IS THE JUMP ADDR. (HI)
F800   38 0E                  JR   C,EX5   ;C:YES, MATCHED
F802                EX2:         
F802   23                     INC   HL   ;NC:NO, FIND JUMP ADDR.
F803   BE                     CP   (HL)   
F804   30 FC                  JR   NC,EX2   
F806   23                     INC   HL   ;BUMP TO NEXT TAB. ITEM
F807   D1                     POP   DE   ;RESTORE STRING POINTER
F808   18 E4                  JR   EX0   ;TEST AGAINST NEXT ITEM
F80A                EX3:         
F80A   3E 7F                  LD   A,7FH   ;PARTIAL MATCH, FIND
F80C                EX4:         
F80C   23                     INC   HL   ;JUMP ADDR., WHICH IS
F80D   BE                     CP   (HL)   ;FLAGGED BY BIT 7
F80E   30 FC                  JR   NC,EX4   
F810                EX5:         
F810   7E                     LD   A,(HL)   ;LOAD HL WITH THE JUMP
F811   23                     INC   HL   ;ADDRESS FROM THE TABLE
F812   6E                     LD   L,(HL)   
F813                             ;AND 7FH                         ;MASK OFF BIT 7
F813   00                     NOP      
F814   00                     NOP      
F815   67                     LD   H,A   
F816   F1                     POP   AF   ;CLEAN UP THE GABAGE
F817   E9                     JP   (HL)   ;AND WE GO DO IT
F818                             ;-------------------------------------------------------------------------------
F818                             ;///////////////////////////////////////////////////////////////////////////////
F818                             ;-------------------------------------------------------------------------------
F818                             ;COMPUTER SPECIFIC ROUTINES.
F818                             ;-------------------------------------------------------------------------------
F818                SERIAL_INIT:      
F818   21 00 20               LD   HL,2000H   ;POWER UP DELAY
F81B   CD E2 C6               CALL   timeDelay   
F81E   3E 40                  LD   A,40H   
F820   D3 01                  OUT   (DIGITS),A   ;MAKE THE OUTPUT PORT HIGH
F822   C9                     RET      
F823                             ;-------------------------------------------------------------------------------
F823                TX_RDY:      
F823                             ; This routine sends the character to the output port.  Port is always
F823                             ; ready as init and last part sets output port to high for two stop bits
F823   F5                     PUSH   AF   
F824   C5                     PUSH   BC   
F825   E5                     PUSH   HL   
F826   D5                     PUSH   DE   
F827   F5                     PUSH   AF   
F828   CD 8F CF               CALL   getGLCDTerm   ;CHECK OUTPUT
F82B   B7                     OR   A   ;CHECK VALUE
F82C   28 07                  JR   Z,SERIAL   
F82E                GLCD:        
F82E   F1                     POP   AF   
F82F   4F                     LD   C,A   
F830   CD 3C DB               CALL   sendCharToLCD   
F833   18 25                  JR   TXEXIT   
F835                SERIAL:      
F835   F1                     POP   AF   
F836   21 1B 00               LD   HL,BAUD   ;HL HOLDS THE BIT TIME DELAY
F839   4F                     LD   C,A   ;STORE CHRACTER IN C FOR BIT SENDING
F83A   AF                     XOR   A   ;TRANSMIT THE START BIT
F83B   D3 01                  OUT   (DIGITS),A   
F83D   CD E2 C6               CALL   timeDelay   
F840   06 08                  LD   B,08H   ;TRANSMIT 8 BITS OF DATA
F842   CB 09                  RRC   C   ;SHIFT BIT 0 TO BIT 7
F844                NXTBIT:      
F844   CB 09                  RRC   C   ;SHIFT BITS TO D6
F846   79                     LD   A,C   ;SEND FIRST LSB
F847   E6 40                  AND   40H   ;FOR ONE BIT TIME
F849   D3 01                  OUT   (DIGITS),A   
F84B   CD E2 C6               CALL   timeDelay   
F84E   10 F4                  DJNZ   NXTBIT   ;DO FOR ALL BITS
F850   3E 40                  LD   A,40H   ;SEND THE TWO STOP BITS
F852   D3 01                  OUT   (DIGITS),A   
F854   CD E2 C6               CALL   timeDelay   
F857   CD E2 C6               CALL   timeDelay   
F85A                TXEXIT:      
F85A   D1                     POP   DE   
F85B   E1                     POP   HL   
F85C   C1                     POP   BC   
F85D   F1                     POP   AF   
F85E   C9                     RET      
F85F                             ;-------------------------------------------------------------------------------
F85F                RX_RDY:      
F85F                             ; This routine is for checkif if a character is available over
F85F                             ; serial. If a character is available, it returns to the calling
F85F                             ; function with the character in "A" and the Z-flag reset.
F85F                             ; However, if a character is not available, it returns with the
F85F                             ; Z-flag set.
F85F   C5                     PUSH   BC   
F860   E5                     PUSH   HL   
F861   D5                     PUSH   DE   
F862   CD 8F CF               CALL   getGLCDTerm   ;CHECK INPUT
F865   B7                     OR   A   ;CHECK VALUE
F866   28 0A                  JR   Z,SERIALI   
F868                GLCDI:       
F868   CD 1F CC               CALL   matrixScan   ;READ MATRIX KEYBOARD
F86B   CD E2 D0               CALL   parseMatrixScan   ;PARSE KEY PRESS
F86E   30 0C                  JR   NC,NOCHAR   
F870   18 2F                  JR   RX_EXIT   ;EXIT
F872                SERIALI:      
F872   06 20                  LD   B,20H   ;CHECK FOR START BIT 20H TIMES BEFORE EXITING
F874                LSTARTBIT:      
F874   DB 03                  IN   A,(SYS_INPUT)   
F876   CB 7F                  BIT   7,A   
F878   28 05                  JR   Z,GETCHAR   ;START BIT FOUND, GET CHARACTER
F87A   10 F8                  DJNZ   LSTARTBIT   ;KEEP CHECKING FOR START BIT
F87C                NOCHAR:      
F87C   AF                     XOR   A   ;SET ZERO FLAG
F87D   18 22                  JR   RX_EXIT   ;EXIT
F87F                GETCHAR:      ;START BIT DETECTED
F87F   21 1B 00               LD   HL,BAUD   ;DELAY FOR HALF A
F882   CB 3C                  SRL   H   ;BIT TIME TO SAMPLE THE MIDDLE
F884   CB 1D                  RR   L   ;OF THE BIT CELL
F886   CD E2 C6               CALL   timeDelay   
F889   DB 03                  IN   A,(SYS_INPUT)   
F88B   CB 7F                  BIT   7,A   ;CHECK THE START BIT IS STILL LOW
F88D   20 E5                  JR   NZ,LSTARTBIT   
F88F   06 08                  LD   B,08H   ;VALID START BIT DETECTED
F891                GETBITS:      
F891   21 1B 00               LD   HL,BAUD   
F894   CD E2 C6               CALL   timeDelay   ;DELAY FOR ONE FULL BIT TIME
F897   DB 03                  IN   A,(SYS_INPUT)   
F899   CB 17                  RL   A   
F89B   CB 19                  RR   C   ;SHIFT BIT INTO OUTPUT REGISTER
F89D   10 F2                  DJNZ   GETBITS   
F89F   79                     LD   A,C   
F8A0   B7                     OR   A   ;CLEAR CARRY FLAG AND RESET ZERO FLAG
F8A1                RX_EXIT:      
F8A1   D1                     POP   DE   
F8A2   E1                     POP   HL   
F8A3   C1                     POP   BC   
F8A4   C9                     RET      
F8A5                             ;-------------------------------------------------------------------------------
F8A5                             ;///////////////////////////////////////////////////////////////////////////////
F8A5                             ;-------------------------------------------------------------------------------
F8A5                LSTROM:      ;ALL ABOVE CAN BE ROM
F8A5                             ;HERE DOWN MUST BE RAM
F8A5                          .END      
F8A5                             ; ----------------------------------------------------------------------------
F8A5                             ; 
F8A5                             ; DS1302 RTC API Routines for MON3 - For use with GPIO RTC Card
F8A5                             ; 
F8A5                             ; Written By Craig Hart, 2024
F8A5                             ; 
F8A5                             ; ----------------------------------------------------------------------------
F8A5                             ; 
F8A5                             ; C register - API Call #
F8A5                             ; B register - API Function
F8A5                             ; 
F8A5                             ; Calls return C=1 if failed, C=0 if success
F8A5                             ; 
F8A5                RTCAPI:      
F8A5   78                     LD   a,b   
F8A6   FE 13                  CP   DSAPIFnMax   ; Valid API Number?
F8A8   38 02                  JR   c,APIOk   
F8AA   37           APIERR:   SCF      ; set C flag = Error
F8AB   C9                     RET      
F8AC   87           APIOK:    ADD   a,a   ; 2 byte table
F8AD   E5                     PUSH   hl   
F8AE   C5                     PUSH   bc   
F8AF   06 00                  LD   b,0   
F8B1   4F                     LD   c,a   
F8B2   21 DE FD               LD   hl,DSAPIFunctions   
F8B5   09                     ADD   hl,bc   
F8B6   4E                     LD   c,(hl)   
F8B7   23                     INC   hl   
F8B8   46                     LD   b,(hl)   
F8B9   C5                     PUSH   bc   
F8BA   DD E1                  POP   ix   
F8BC   C1                     POP   bc   
F8BD   E1                     POP   hl   
F8BE   DD E9                  JP   (ix)   
F8C0                             ; ----------------------------------------------------------------------------
F8C0                             ; Determine if a DS1302 is pesent
F8C0                             ; 
F8C0                             ; If all registers return FFh, no DS1302 exists
F8C0                             ; ----------------------------------------------------------------------------
F8C0                CHECKDS1302PRESENT:      
F8C0   D5                     PUSH   de   
F8C1   11 00 8E               LD   de,8E00H   ; clear write protect bit
F8C4   CD 9C FA               CALL   rtc_wr   
F8C7   11 00 90               LD   de,9000H   ; clear trickle charge bits
F8CA   CD 9C FA               CALL   rtc_wr   
F8CD   16 81                  LD   d,81H   
F8CF   CD B1 FA               CALL   rtc_rd   
F8D2   FE 5A                  CP   5AH   ; should come back 00..59h
F8D4   30 0C                  JR   nc,noDS1302   
F8D6   16 8B                  LD   d,8BH   
F8D8   CD B1 FA               CALL   rtc_rd   
F8DB   FE 08                  CP   08H   ; should come back 01..07
F8DD   30 03                  JR   nc,noDS1302   
F8DF   D1                     POP   de   
F8E0   B7                     OR   a   ; clear C flag
F8E1   C9                     RET      
F8E2                NODS1302:      
F8E2   D1                     POP   de   
F8E3   37                     SCF      ; set C flag
F8E4   C9                     RET      
F8E5                             ; ----------------------------------------------------------------------------
F8E5                             ; Reset the DS1302 fully to a known date/time condition
F8E5                             ; does not clear RTC bytes
F8E5                             ; ----------------------------------------------------------------------------
F8E5                RESETDS1302:      
F8E5   D5                     PUSH   de   
F8E6   11 00 8E               LD   de,8E00H   ; clear write protect bit
F8E9   CD 9C FA               CALL   rtc_wr   
F8EC   11 00 90               LD   de,9000H   ; clear trickle charge bits
F8EF   CD 9C FA               CALL   rtc_wr   
F8F2   11 00 80               LD   de,8000H   ; seconds 00
F8F5   CD 9C FA               CALL   rtc_wr   
F8F8   11 00 82               LD   de,8200H   ; minutes 00
F8FB   CD 9C FA               CALL   rtc_wr   
F8FE   11 90 84               LD   de,8490H   ; hours 01, 12 hour mode
F901   CD 9C FA               CALL   rtc_wr   
F904   11 01 86               LD   de,8601H   ; date 01
F907   CD 9C FA               CALL   rtc_wr   
F90A   11 01 88               LD   de,8801H   ; month 01
F90D   CD 9C FA               CALL   rtc_wr   
F910   11 01 8A               LD   de,8A01H   ; day 01 (Monday)
F913   CD 9C FA               CALL   rtc_wr   
F916   11 00 8C               LD   de,8C00H   ; year 00 (2000)
F919   CD 9C FA               CALL   rtc_wr   
F91C   D1                     POP   de   
F91D   B7                     OR   a   ; clear Z flag
F91E   C9                     RET      
F91F                             ; ----------------------------------------------------------------------------
F91F                             ; Returns time
F91F                             ; 
F91F                             ; H = hour      ; bit 5 = am/pm flag (in 12 hr mode). 1=PM
F91F                             ; L = minute
F91F                             ; D = second
F91F                             ; ----------------------------------------------------------------------------
F91F                GETTIME:      
F91F   16 85                  LD   d,85H   ; hour
F921   CD B1 FA               CALL   rtc_rd   
F924   E6 3F                  AND   3FH   ; strip off bits
F926   67                     LD   h,a   
F927   16 83                  LD   d,83H   ; min
F929   CD B1 FA               CALL   rtc_rd   
F92C   6F                     LD   l,a   
F92D   16 81                  LD   d,81H   ; sec
F92F   CD B1 FA               CALL   rtc_rd   
F932   57                     LD   d,a   
F933   B7                     OR   a   
F934   C9                     RET      
F935                             ; ----------------------------------------------------------------------------
F935                             ; Sets time; preserves 12/24 hour mode
F935                             ; 
F935                             ; H = hour             ; bit 5 = am/pm in 12hr mode
F935                             ; L = minute
F935                             ; D = second
F935                             ; ----------------------------------------------------------------------------
F935                SETTIME:      
F935   5A                     LD   e,d   
F936   16 80                  LD   d,80H   ; secs
F938   CD 9C FA               CALL   rtc_wr   
F93B   7C                     LD   a,h   ; mask off junk bits
F93C   E6 3F                  AND   3FH   
F93E   67                     LD   h,a   
F93F   CD AA F9               CALL   get1224Mode   ; get 12/24 flag
F942   B4                     OR   h   
F943   5F                     LD   e,a   
F944   16 84                  LD   d,84H   ; hour
F946   CD 9C FA               CALL   rtc_wr   
F949   5D                     LD   e,l   
F94A   16 82                  LD   d,82H   ; mins
F94C   CD 9C FA               CALL   rtc_wr   
F94F   B7                     OR   a   
F950   C9                     RET      
F951                             ; ----------------------------------------------------------------------------
F951                             ; Returns date
F951                             ; 
F951                             ; H = date
F951                             ; L = month
F951                             ; DE = year 2000..2099
F951                             ; ----------------------------------------------------------------------------
F951                GETDATE:      
F951   C5                     PUSH   bc   
F952   16 87                  LD   d,87H   ; date
F954   CD B1 FA               CALL   rtc_rd   
F957   67                     LD   h,a   
F958   16 89                  LD   d,89H   ; month
F95A   CD B1 FA               CALL   rtc_rd   
F95D   6F                     LD   l,a   
F95E   16 8D                  LD   d,8DH   ; year
F960   CD B1 FA               CALL   rtc_rd   
F963   5F                     LD   e,a   
F964   16 20                  LD   d,20H   ; Add "20"xxh
F966   C1                     POP   bc   
F967   B7                     OR   a   
F968   C9                     RET      
F969                             ; ----------------------------------------------------------------------------
F969                             ; sets date
F969                             ; 
F969                             ; H = date
F969                             ; L = month
F969                             ; DE = year (Decimal) 2000..2099
F969                             ; ----------------------------------------------------------------------------
F969                SETDATE:      
F969   16 8C                  LD   d,8CH   ; year  (just ignore "20"xxh)
F96B   CD 9C FA               CALL   rtc_wr   
F96E   16 88                  LD   d,88H   ; month
F970   5D                     LD   e,l   
F971   CD 9C FA               CALL   rtc_wr   
F974   16 86                  LD   d,86H   ; date
F976   5C                     LD   e,h   
F977   CD 9C FA               CALL   rtc_wr   
F97A   B7                     OR   a   
F97B   C9                     RET      
F97C                             ; ----------------------------------------------------------------------------
F97C                             ; Returns day in D
F97C                             ; returns HL points to day ASCIIZ String
F97C                             ; ----------------------------------------------------------------------------
F97C                GETDAY:      
F97C   16 8B                  LD   d,8BH   ; day
F97E   CD B1 FA               CALL   rtc_rd   
F981   E6 07                  AND   07H   
F983   57                     LD   d,a   
F984   21 7B FD               LD   hl,daysList   
F987   3D                     DEC   a   
F988   FE 00                  CP   0   
F98A   28 09                  JR   z,foundDay   
F98C   47                     LD   b,a   
F98D                DAYLOOP:      
F98D   7E                     LD   a,(HL)   
F98E   23                     INC   hl   
F98F   FE 00                  CP   0   
F991   20 FA                  JR   nz,dayLoop   
F993   10 F8                  DJNZ   dayLoop   
F995                FOUNDDAY:      
F995   B7                     OR   a   
F996   C9                     RET      
F997                             ; ----------------------------------------------------------------------------
F997                             ; sets day from D - 01..07
F997                             ; ----------------------------------------------------------------------------
F997                SETDAY:      
F997   7A                     LD   a,d   
F998   FE 00                  CP   0   
F99A   20 02                  JR   nz,validDay   
F99C   37                     SCF      
F99D   C9                     RET      
F99E                VALIDDAY:      
F99E   D5                     PUSH   de   
F99F   E6 07                  AND   07H   
F9A1   5F                     LD   e,a   
F9A2   16 8A                  LD   d,8AH   ; day
F9A4   CD 9C FA               CALL   rtc_wr   
F9A7   D1                     POP   de   
F9A8   B7                     OR   a   
F9A9   C9                     RET      
F9AA                             ; ----------------------------------------------------------------------------
F9AA                             ; Returns 12hr / 24hr mode. A = 00h = 24 hour mode, 80h = 12 hr mode
F9AA                             ; ----------------------------------------------------------------------------
F9AA                GET1224MODE:      
F9AA   D5                     PUSH   de   
F9AB   16 85                  LD   d,85H   ; hour
F9AD   CD B1 FA               CALL   rtc_rd   
F9B0   E6 80                  AND   80H   ; mask bits
F9B2   D1                     POP   de   
F9B3   B7                     OR   a   
F9B4   C9                     RET      
F9B5                             ; ----------------------------------------------------------------------------
F9B5                             ; Sets 12hr mode
F9B5                             ; no prameters
F9B5                             ; ----------------------------------------------------------------------------
F9B5                SET12HRMODE:      
F9B5   16 85                  LD   d,85H   ; hour
F9B7   CD B1 FA               CALL   rtc_rd   
F9BA   CB 7F                  BIT   7,a   ; is it already 12 hr mode?
F9BC   28 02                  JR   z,pr12   
F9BE   37                     SCF      ; already 12 hour mode dude!
F9BF   C9                     RET      
F9C0   E6 3F        PR12:     AND   3FH   ; 24 hour to 12 hour - strip bits
F9C2   FE 00                  CP   00H   
F9C4   20 04                  JR   nz,notMidnight   
F9C6   3E 92                  LD   a,92H   ; 12am + 12 hour flag
F9C8   18 34                  JR   setHour   
F9CA                NOTMIDNIGHT:      
F9CA   FE 12                  CP   12H   
F9CC   28 09                  JR   z,setpm   ; 12pm exactly?
F9CE   30 04                  JR   nc,ispm   ; >12 ?
F9D0   F6 80                  OR   80H   ; <12, so hours same, set 12 hour flag
F9D2   18 2A                  JR   setHour   
F9D4   D6 12        ISPM:     SUB   12H   ; convert to 12 hr time
F9D6   27                     DAA      
F9D7   F6 A0        SETPM:    OR   0A0H   ; set 12 hour flag + PM fag
F9D9   18 23                  JR   setHour   
F9DB                             ; ----------------------------------------------------------------------------
F9DB                             ; Sets 24hr mode
F9DB                             ; no prameters
F9DB                             ; ----------------------------------------------------------------------------
F9DB                SET24HRMODE:      
F9DB   16 85                  LD   d,85H   ; hour
F9DD   CD B1 FA               CALL   rtc_rd   
F9E0   CB 7F                  BIT   7,a   ; is it already 24 hr mode?
F9E2   20 02                  JR   nz,pr24   
F9E4   37                     SCF      ; already 24 hour mode dude!
F9E5   C9                     RET      
F9E6   E6 3F        PR24:     AND   3FH   ; strip bits 7 and 6 to set 24h mode
F9E8   CB 6F                  BIT   5,a   ; was it pm?
F9EA   28 0B                  JR   z,fixt   ; am? if so am is same as 24hr
F9EC   E6 1F                  AND   1FH   ; clear PM flag
F9EE   FE 12                  CP   12H   ; is it 12pm? no change
F9F0   28 0C                  JR   z,setHour   
F9F2   C6 12                  ADD   a,12H   ; adjust by adding 12 hours
F9F4   27                     DAA      ; in BCD
F9F5   18 07                  JR   setHour   
F9F7   FE 12        FIXT:     CP   12H   ; 12am = 00 hours
F9F9   20 01                  JR   nz,nofix   
F9FB   AF                     XOR   a   
F9FC   E6 1F        NOFIX:    AND   1FH   ; clear PM flag
F9FE                             ; sethour is a Shared function of above 2 calls
F9FE                SETHOUR:      
F9FE   5F                     LD   e,a   ; set clock
F9FF   16 84                  LD   d,84H   
FA01   CD 9C FA               CALL   rtc_wr   
FA04   B7                     OR   a   
FA05   C9                     RET      
FA06                             ; ----------------------------------------------------------------------------
FA06                             ; formatTime takes in a time, and outputs it as a well structured string
FA06                             ; 
FA06                             ; note -- must supply bit 7 if 12hr!!!
FA06                             ; 
FA06                             ; H = hour      ; bit 7 = 12/24hr. bit 5 = am/pm flag (in 12 hr mode). 1=PM
FA06                             ; L = minute
FA06                             ; D = second
FA06                             ; 
FA06                             ; IY = pointer to where to write output
FA06                             ; ----------------------------------------------------------------------------
FA06                FORMATTIME:      
FA06   D5                     PUSH   de   
FA07   FD E5                  PUSH   iy   
FA09   D1                     POP   de   
FA0A   7C                     LD   a,h   ; get hours
FA0B   CB 7F                  BIT   7,a   ; 1 = 12 hour
FA0D   28 02                  JR   z,is24   
FA0F   E6 1F                  AND   1FH   
FA11   E6 3F        IS24:     AND   3FH   
FA13   CD AD C8               CALL   AToString   
FA16   3E 3A                  LD   a,":"   ; add deliminator
FA18   12                     LD   (de),a   
FA19   13                     INC   de   
FA1A   7D                     LD   a,l   ; get minutes
FA1B   CD AD C8               CALL   AToString   
FA1E   3E 3A                  LD   a,":"   ; add deliminator
FA20   12                     LD   (de),a   
FA21   13                     INC   de   
FA22   C1                     POP   bc   
FA23   78                     LD   a,b   ; set seconds
FA24   CD AD C8               CALL   AToString   
FA27   7C                     LD   a,h   ; work out if AM or PM, or 24 hour mode
FA28   CB 7F                  BIT   7,a   
FA2A   28 14                  JR   z,noampm   ; skip AM/PM if 24 hour mode
FA2C   3E 20                  LD   a," "   ; add space
FA2E   12                     LD   (de),a   
FA2F   13                     INC   de   
FA30   06 41                  LD   b,"A"   
FA32   7C                     LD   a,h   ; is it AM or PM
FA33   E6 20                  AND   20H   
FA35   28 02                  JR   z,isam   
FA37   06 50                  LD   b,"P"   
FA39   78           ISAM:     LD   a,b   ; copy 2 bytes AM or PM to buffer
FA3A   12                     LD   (de),a   
FA3B   13                     INC   de   
FA3C   3E 4D                  LD   a,"M"   
FA3E   12                     LD   (de),a   
FA3F   13                     INC   de   
FA40   AF           NOAMPM:   XOR   a   ; null terminate string
FA41   12                     LD   (de),a   
FA42   C9                     RET      
FA43                             ; ----------------------------------------------------------------------------
FA43                             ; formatDate takes in a date, and outputs it as a well structured string
FA43                             ; 
FA43                             ; H = date
FA43                             ; L = month
FA43                             ; DE = year
FA43                             ; 
FA43                             ; IY = pointer to where to write output
FA43                             ; ----------------------------------------------------------------------------
FA43                FORMATDATE:      
FA43   D5                     PUSH   de   
FA44   FD E5                  PUSH   iy   
FA46   D1                     POP   de   
FA47   7C                     LD   a,h   
FA48   CD AD C8               CALL   AToString   
FA4B   3E 2F                  LD   a,"/"   
FA4D   12                     LD   (de),a   
FA4E   13                     INC   de   
FA4F   7D                     LD   a,l   
FA50   CD AD C8               CALL   AToString   
FA53   3E 2F                  LD   a,"/"   
FA55   12                     LD   (de),a   
FA56   13                     INC   de   
FA57   C1                     POP   bc   ; year now in BC
FA58   78                     LD   a,b   
FA59   CD AD C8               CALL   AToString   
FA5C   79                     LD   a,c   
FA5D   CD AD C8               CALL   AToString   
FA60   3E 00                  LD   a,0   
FA62   12                     LD   (de),a   
FA63   C9                     RET      
FA64                             ; ----------------------------------------------------------------------------
FA64                             ; Input:        D = byte to return 0..30
FA64                             ; Output:       A = byte read
FA64                             ; ----------------------------------------------------------------------------
FA64                READRTCBYTE:      
FA64   7A                     LD   a,d   
FA65   16 00                  LD   d,0   
FA67   FE 1F                  CP   31   
FA69   D0                     RET   nc   ;exit if greater then 30
FA6A   87                     ADD   a,a   ;Double in to get read index
FA6B   C6 C1                  ADD   a,0C1H   
FA6D   57                     LD   d,a   
FA6E   CD B1 FA               CALL   rtc_rd   
FA71   B7                     OR   a   
FA72   C9                     RET      
FA73                             ; ----------------------------------------------------------------------------
FA73                             ; Input:        DE = register and byte to write, D=0..30
FA73                             ; ----------------------------------------------------------------------------
FA73                WRITERTCBYTE:      
FA73   7A                     LD   a,d   
FA74   FE 1F                  CP   31   
FA76   D0                     RET   nc   ;exit if greater then 30
FA77   87                     ADD   a,a   ;Double it to get write index
FA78   C6 C0                  ADD   a,0C0H   
FA7A   57                     LD   d,a   
FA7B   CD 9C FA               CALL   rtc_wr   
FA7E   B7                     OR   a   
FA7F   C9                     RET      
FA80                             ; ----------------------------------------------------------------------------
FA80                             ; Reads all 31 RTC RAM bytes to userbuffer
FA80                             ; input: HL = location to write to (31 bytes to be written)
FA80                             ; ----------------------------------------------------------------------------
FA80                BURSTRTCREAD:      
FA80   C5                     PUSH   bc   
FA81   D5                     PUSH   de   
FA82   0E FC                  LD   c,RTC_PORT   
FA84   3E 10                  LD   a,10H   ; raise CS, enable data out
FA86   ED 79                  OUT   (c),a   
FA88   16 FF                  LD   d,0FFH   ; ram burst
FA8A   CD C4 FA               CALL   bytelpW   ; write D to select the register
FA8D   06 1F                  LD   b,31   
FA8F   CD D6 FA     BREAD:    CALL   bytelpR   ; read value (into D)
FA92   72                     LD   (hl),d   
FA93   23                     INC   hl   
FA94   10 F9                  DJNZ   bRead   
FA96   AF                     XOR   a   ; drop CS & clear CF
FA97   ED 79                  OUT   (c),a   
FA99   D1                     POP   de   
FA9A   C1                     POP   bc   
FA9B   C9                     RET      
FA9C                             ; ----------------------------------------------------------------------------
FA9C                             ; Write cycle. Writes 2 bytes
FA9C                             ; D = command/register
FA9C                             ; E = data byte
FA9C                             ; ----------------------------------------------------------------------------
FA9C                RTC_WR:      
FA9C   F5                     PUSH   af   
FA9D   C5                     PUSH   bc   
FA9E   0E FC                  LD   c,RTC_PORT   
FAA0   3E 10                  LD   a,10H   ; raise CS, enable data in
FAA2   ED 79                  OUT   (c),a   
FAA4   CD C4 FA               CALL   bytelpW   ; write D to select the register
FAA7   53                     LD   d,e   
FAA8   CD C4 FA               CALL   bytelpW   ; write E - the data
FAAB   AF                     XOR   a   ; drop CS
FAAC   ED 79                  OUT   (c),a   
FAAE   C1                     POP   bc   
FAAF   F1                     POP   af   
FAB0   C9                     RET      
FAB1                             ; ----------------------------------------------------------------------------
FAB1                             ; Read cycle. Writes command and reads result
FAB1                             ; D = command/register needed
FAB1                             ; A = result
FAB1                             ; ----------------------------------------------------------------------------
FAB1                RTC_RD:      
FAB1   C5                     PUSH   bc   
FAB2   0E FC                  LD   c,RTC_PORT   
FAB4   3E 10                  LD   a,10H   ; raise CS, enable data out
FAB6   ED 79                  OUT   (c),a   
FAB8   CD C4 FA               CALL   bytelpW   ; write D to select the register
FABB   CD D6 FA               CALL   bytelpR   ; read value (into D)
FABE   AF                     XOR   a   ; drop CS
FABF   ED 79                  OUT   (c),a   
FAC1   7A                     LD   a,d   ; return value in A
FAC2   C1                     POP   bc   
FAC3   C9                     RET      
FAC4                             ; ----------------------------------------------------------------------------
FAC4                             ; write one byte to the DS1302
FAC4                             ; byte in D
FAC4                             ; ----------------------------------------------------------------------------
FAC4                BYTELPW:      
FAC4   C5                     PUSH   bc   
FAC5   06 08                  LD   b,8   
FAC7   CB 3A        BLP:      SRL   d   ; data bit 0 to carry
FAC9   3E 20                  LD   a,20H   
FACB   1F                     RRA      ; carry to data bit 7
FACC   ED 79                  OUT   (c),a   ; setup bus - drops clock
FACE   F6 40                  OR   40H   ; raise CLK
FAD0   ED 79                  OUT   (c),a   
FAD2   10 F3                  DJNZ   blp   
FAD4   C1                     POP   bc   
FAD5   C9                     RET      
FAD6                             ; ----------------------------------------------------------------------------
FAD6                             ; Read one byte from the DS1302
FAD6                             ; byte read is returned in D
FAD6                             ; ----------------------------------------------------------------------------
FAD6                BYTELPR:      
FAD6   C5                     PUSH   bc   
FAD7   06 08                  LD   b,8   
FAD9   16 00                  LD   d,0   
FADB   3E 30        BLP2:     LD   a,30H   
FADD   F6 40                  OR   40H   ; raise CLK
FADF   ED 79                  OUT   (c),a   
FAE1   E6 BF                  AND   0BFH   ; drop CLK
FAE3   ED 79                  OUT   (c),a   
FAE5   ED 58                  IN   e,(c)   ; read value
FAE7   CB 3B                  SRL   e   
FAE9   CB 1A                  RR   d   
FAEB   10 EE                  DJNZ   blp2   
FAED   C1                     POP   bc   
FAEE   C9                     RET      
FAEF                             ; ----------------------------------------------------------------------------
FAEF                             ; Conversion routine - BCD to true Binary
FAEF                             ; input:  A = BCD value
FAEF                             ; output: A = binary value
FAEF                             ; ----------------------------------------------------------------------------
FAEF                BCDTOBIN:      
FAEF   C5                     PUSH   bc   
FAF0   4F                     LD   c,a   
FAF1   E6 F0                  AND   0F0H   
FAF3   CB 3F                  SRL   a   
FAF5   47                     LD   b,a   
FAF6   CB 3F                  SRL   a   
FAF8   CB 3F                  SRL   a   
FAFA   80                     ADD   a,b   
FAFB   47                     LD   b,a   
FAFC   79                     LD   a,c   
FAFD   E6 0F                  AND   0FH   
FAFF   80                     ADD   a,b   
FB00   C1                     POP   bc   
FB01   C9                     RET      
FB02                             ; ----------------------------------------------------------------------------
FB02                             ; Conversion routine - Binary to BCD
FB02                             ; input:  A = binary value
FB02                             ; output: A = BCD value
FB02                             ; ----------------------------------------------------------------------------
FB02                BINTOBCD:      
FB02   C5                     PUSH   bc   
FB03   06 0A                  LD   b,10   
FB05   0E FF                  LD   c,-1   
FB07   0C           DIV10:    INC   c   
FB08   90                     SUB   b   
FB09   30 FC                  JR   nc,div10   
FB0B   80                     ADD   a,b   
FB0C   47                     LD   b,a   
FB0D   79                     LD   a,c   
FB0E   87                     ADD   a,a   
FB0F   87                     ADD   a,a   
FB10   87                     ADD   a,a   
FB11   87                     ADD   a,a   
FB12   B0                     OR   b   
FB13   C1                     POP   bc   
FB14   C9                     RET      
FB15                             ; ----------------------------------------------------------------------------
FB15                             ; Stand Alone, RTC configuration and PRAM Viewer
FB15                             ; Setting time:
FB15                             ;       0 sets hours
FB15                             ;       1 sets minutes
FB15                             ;       2 resets seconds to 00
FB15                             ;       3 toggles 12/24 hour time
FB15                             ; 
FB15                             ; Setting calendar:
FB15                             ;       4 sets day of week
FB15                             ;       5 sets date
FB15                             ;       6 sets month
FB15                             ;       7 sets year
FB15                             ; 
FB15                             ; Special Keys:
FB15                             ; 
FB15                             ; A - Reset the DS1302 to 01/01/2000, 01:00.00am & 12hr mode
FB15                             ; D - DUMPs the RTC RAM to LCD (Addr to exit dump mode) where
FB15                             ;       + Moves down RAM list
FB15                             ;       - Moves up RAM list
FB15                             ;       AD Exits back to RTC Setup
FB15                             ; Addr - Exit
FB15                             ; ----------------------------------------------------------------------------
FB15                RTCSETUP:      
FB15                             ; clear the LCD
FB15   06 01                  LD   b,01H   ;clear LCD
FB17   0E 0F                  LD   c,15   ;command to LCD
FB19   D7                     RST   10H   
FB1A                             ; setup RTC chip
FB1A   CD C0 F8               CALL   checkDS1302Present   
FB1D                             ;Carry set = No RTC
FB1D   30 22                  JR   nc,clockLoop   ;RTC Found, continue with program
FB1F   21 2C FB               LD   hl,noRTC   ;Load HL with no RTC Found text
FB22   0E 0D                  LD   c,13   ;string to LCD
FB24   D7                     RST   10H   
FB25   11 75 FD               LD   de,segDisp   
FB28   E7                     RST   20H   
FB29   30 FA                  JR   nc,$-4   
FB2B   C9                     RET      ;exit back to calling routine
FB2C   52 54 43 20 4D 6F 64 75 6C 65 20 6E 6F 74 20 66 6F 75 6E 64 00 NORTC:   DB   "RTC Module not found",0   
FB41                             ; Main Loop
FB41                CLOCKLOOP:      
FB41                             ; read RTC and store time
FB41   CD 3E FD               CALL   getRTCTime   
FB44                             ; display time and date on LCD
FB44   3A 01 09               LD   a,(RTC_OSEC)   ;get old seconds
FB47   47                     LD   b,a   ;save old seconds
FB48   3A 00 09               LD   a,(RTC_SECS)   ;get current seconds
FB4B   B8                     CP   b   ;are they the same?
FB4C   28 59                  JR   z,keyRTC   ;yes, skip updating LCD
FB4E                             ; seconds have changed, update LCD
FB4E   32 01 09               LD   (RTC_OSEC),a   ;save new seconds in old
FB51                RTCUPDATE:      
FB51   06 02                  LD   b,02H   ;set LCD Cursor to top left
FB53   0E 0F                  LD   c,15   ;command to LCD
FB55   D7                     RST   10H   
FB56   CD 3E FD               CALL   getRTCTime   
FB59                             ;format time
FB59   FD 21 08 09            LD   iy,RTC_BUFF   ;get LCD buffer
FB5D   CD 06 FA               CALL   formatTime   
FB60   21 08 09               LD   hl,RTC_BUFF   ;get new buffer
FB63   0E 0D                  LD   c,13   ;string to LCD
FB65   D7                     RST   10H   
FB66                             ; LCD section, calendar
FB66   06 C0                  LD   b,0C0H   ;Cursor to row 2
FB68   0E 0F                  LD   c,15   ;command to LCD
FB6A   D7                     RST   10H   
FB6B   CD 7C F9               CALL   getDay   ;get Day as a string
FB6E   0E 0D                  LD   c,13   ;string to LCD
FB70   D7                     RST   10H   
FB71   FD 21 08 09            LD   iy,RTC_BUFF   ;get LCD buffer
FB75   3E 20                  LD   a," "   ;add space
FB77   FD 77 00               LD   (iy),a   
FB7A   FD 23                  INC   iy   
FB7C   CD 51 F9               CALL   getDate   
FB7F   7C                     LD   a,h   ;save day
FB80   32 04 09               LD   (RTC_DAY),a   
FB83   7D                     LD   a,l   ;save month
FB84   32 05 09               LD   (RTC_MONTH),a   
FB87   ED 53 06 09            LD   (RTC_YEAR),de   ;save year
FB8B   CD 43 FA               CALL   formatDate   
FB8E                             ; display date on LCD
FB8E   21 08 09               LD   hl,RTC_BUFF   
FB91   0E 0D                  LD   c,13   ;string to LCD
FB93   D7                     RST   10H   
FB94                             ; display help on LCD
FB94   06 94                  LD   b,94H   ;Cursor to row 3
FB96   0E 0F                  LD   c,15   ;command to LCD
FB98   D7                     RST   10H   
FB99   21 B4 FD               LD   hl,helpList   ;Load HL help text
FB9C   0E 0D                  LD   c,13   ;string to LCD
FB9E   D7                     RST   10H   
FB9F   06 D4                  LD   b,0D4H   ;Cursor to row 4
FBA1   0E 0F                  LD   c,15   ;command to LCD
FBA3   D7                     RST   10H   
FBA4   0E 0D                  LD   c,13   ;string to LCD
FBA6   D7                     RST   10H   
FBA7                             ; keystroke handling section
FBA7                KEYRTC:      
FBA7   11 75 FD               LD   de,segDisp   
FBAA   E7                     RST   20H   
FBAB   D2 41 FB               JP   nc,clockLoop   ;loop if no key or repeat key
FBAE   FE 13                  CP   13H   ;Addr key?
FBB0   C8                     RET   z   ;exit program
FBB1                KEYTRYF:      
FBB1   FE 0F                  CP   0FH   ;F = reset clock
FBB3   20 06                  JR   nz,keyTry0   
FBB5   CD E5 F8               CALL   resetDS1302   
FBB8   C3 41 FB               JP   clockLoop   
FBBB                KEYTRY0:      
FBBB   B7                     OR   a   ;Hours adjust
FBBC   20 33                  JR   nz,keyTry1   
FBBE   3A 03 09               LD   a,(RTC_HOURS)   
FBC1   CB 7F                  BIT   7,a   ;check if 24 hours
FBC3   20 09                  JR   nz,set12   
FBC5   3C                     INC   a   ;set to next hour
FBC6   27                     DAA      
FBC7   FE 24                  CP   24H   ;is it 24
FBC9   20 17                  JR   nz,saveTime   
FBCB   AF                     XOR   a   
FBCC   18 14                  JR   saveTime   
FBCE   4F           SET12:    LD   c,a   
FBCF   E6 A0                  AND   0A0H   ;mask out bits 7 and 5
FBD1   57                     LD   d,a   
FBD2   79                     LD   a,c   ;restore A
FBD3   E6 1F                  AND   1FH   ;mask off junk bits
FBD5   3C                     INC   a   
FBD6   27                     DAA      
FBD7   FE 13                  CP   13H   ;is it 13 o'clock?
FBD9   20 06                  JR   nz,noflip   
FBDB   7A                     LD   a,d   ;get AM/PM bits
FBDC   EE 20                  XOR   20H   ;toggle bit 5
FBDE   3C                     INC   a   ;make it 1 o'clock
FBDF   18 01                  JR   saveTime   
FBE1   B2           NOFLIP:   OR   d   ;add AM/PM bits
FBE2                SAVETIME:      
FBE2   67                     LD   h,a   ;save adjusted hours
FBE3   3A 02 09               LD   a,(RTC_MINS)   ;save minutes
FBE6   6F                     LD   l,a   
FBE7   3A 00 09               LD   a,(RTC_SECS)   ;save seconds
FBEA   57                     LD   d,a   
FBEB                             ;Set the time with HL,D
FBEB                STTIME:      
FBEB   CD 35 F9               CALL   setTime   ;set time
FBEE   C3 51 FB               JP   RTCUpdate   
FBF1                KEYTRY1:      
FBF1   FE 01                  CP   1   ;minutes adjust
FBF3   20 0E                  JR   nz,keyTry2   
FBF5   CD 1F F9               CALL   getTime   
FBF8   7D                     LD   a,l   ;get minutes
FBF9   3C                     INC   a   
FBFA   27                     DAA      
FBFB   FE 60                  CP   60H   ;is it over 59?
FBFD   20 01                  JR   nz,$+3   ;skip xor
FBFF   AF                     XOR   a   ;reset to zero
FC00   6F                     LD   l,a   ;save minutes
FC01   18 E8                  JR   stTime   
FC03                KEYTRY2:      
FC03   FE 02                  CP   2   ;seconds adjust
FC05   20 07                  JR   nz,keyTry3   
FC07   CD 1F F9               CALL   getTime   
FC0A   16 00                  LD   d,0   ;reset to zero seconds
FC0C   18 DD                  JR   stTime   
FC0E                KEYTRY3:      
FC0E   FE 03                  CP   3   ;12/24 hour mode
FC10   20 18                  JR   nz,keyTry4   
FC12   06 01                  LD   b,01H   ;clear LCD screen to fix AM/PM sign
FC14   0E 0F                  LD   c,15   ;command to LCD
FC16   D7                     RST   10H   
FC17   3A 03 09               LD   a,(RTC_HOURS)   ;get hours
FC1A   CB 7F                  BIT   7,a   ;is it 12 hour mode?
FC1C   20 06                  JR   nz,to24   
FC1E   CD B5 F9               CALL   set12HrMode   
FC21   C3 51 FB               JP   RTCUpdate   
FC24   CD DB F9     TO24:     CALL   set24HrMode   
FC27   C3 51 FB               JP   RTCUpdate   
FC2A                KEYTRY4:      
FC2A   FE 04                  CP   4   ;get day
FC2C   20 17                  JR   nz,keyTry5   
FC2E   CD 7C F9               CALL   getDay   
FC31   7A                     LD   a,d   
FC32   3C                     INC   a   
FC33   FE 08                  CP   8   
FC35   20 02                  JR   nz,$+4   
FC37   3E 01                  LD   a,1   
FC39   57                     LD   d,a   
FC3A   CD 97 F9               CALL   setDay   
FC3D   06 01                  LD   b,01H   ;clear LCD screen to fix AM/PM sign
FC3F   0E 0F                  LD   c,15   ;command to LCD
FC41   D7                     RST   10H   
FC42   C3 51 FB               JP   RTCUpdate   
FC45                KEYTRY5:      
FC45   FE 05                  CP   5   ;get day of month
FC47   20 16                  JR   nz,keyTry6   
FC49   3A 04 09               LD   a,(RTC_DAY)   
FC4C   3C                     INC   a   
FC4D   27                     DAA      
FC4E   FE 32                  CP   32H   
FC50   20 02                  JR   nz,$+4   
FC52   3E 01                  LD   a,1   
FC54   67                     LD   h,a   
FC55   3A 05 09               LD   a,(RTC_MONTH)   
FC58   6F                     LD   l,a   
FC59   ED 5B 06 09            LD   de,(RTC_YEAR)   
FC5D   18 32                  JR   setYear   
FC5F                KEYTRY6:      
FC5F   FE 06                  CP   6   ;get month
FC61   20 16                  JR   nz,keyTry7   
FC63   3A 05 09               LD   a,(RTC_MONTH)   
FC66   3C                     INC   a   
FC67   27                     DAA      
FC68   FE 13                  CP   13H   
FC6A   20 02                  JR   nz,$+4   
FC6C   3E 01                  LD   a,1   
FC6E   6F                     LD   l,a   
FC6F   3A 04 09               LD   a,(RTC_DAY)   
FC72   67                     LD   h,a   
FC73   ED 5B 06 09            LD   de,(RTC_YEAR)   
FC77   18 18                  JR   setYear   
FC79                KEYTRY7:      
FC79   FE 07                  CP   7   ;get year
FC7B   20 1A                  JR   nz,keyTry8   
FC7D   ED 5B 06 09            LD   de,(RTC_YEAR)   
FC81   7B                     LD   a,e   
FC82   3C                     INC   a   
FC83   27                     DAA      
FC84   5F                     LD   e,a   
FC85   ED 53 06 09            LD   (RTC_YEAR),de   
FC89   3A 04 09               LD   a,(RTC_DAY)   
FC8C   67                     LD   h,a   
FC8D   3A 05 09               LD   a,(RTC_MONTH)   
FC90   6F                     LD   l,a   
FC91                SETYEAR:      
FC91   CD 69 F9               CALL   setDate   
FC94   C3 51 FB               JP   RTCUpdate   
FC97                KEYTRY8:      
FC97   FE 08                  CP   8   ;PRAM view
FC99   C2 41 FB               JP   nz,clockLoop   
FC9C   CD A2 FC               CALL   dumpRAM   ;Display PRAM
FC9F   C3 41 FB               JP   clockLoop   
FCA2                             ; Display the contents of the RTC RAM (PRAM) bytes (31 bytes) on the LCD
FCA2                DUMPRAM:      
FCA2   21 1D 09               LD   hl,RTC_RAM   
FCA5   CD 80 FA               CALL   burstRTCRead   ;put RAM data in RTC_RAM location
FCA8   AF                     XOR   a   
FCA9   32 3C 09               LD   (RAM_PTR),a   
FCAC                DUMPLOOP:      
FCAC   3A 3C 09               LD   a,(RAM_PTR)   ;get pointer (0,1 or 2)
FCAF   87                     ADD   a,a   ;x2
FCB0   47                     LD   b,a   
FCB1   87                     ADD   a,a   ;x4
FCB2   80                     ADD   a,b   ;x6
FCB3   21 1D 09               LD   hl,RTC_RAM   ;index HL to pointer position
FCB6   85                     ADD   a,l   
FCB7   6F                     LD   l,a   
FCB8   06 01                  LD   b,01H   ;clear LCD
FCBA   0E 0F                  LD   c,15   ;command to LCD
FCBC   D7                     RST   10H   
FCBD   CD 09 FD               CALL   displayRAMline   
FCC0   06 C0                  LD   b,0C0H   ;set second row
FCC2   0E 0F                  LD   c,15   ;command to LCD
FCC4   D7                     RST   10H   
FCC5   CD 09 FD               CALL   displayRAMline   
FCC8   06 94                  LD   b,94H   ;set third row
FCCA   0E 0F                  LD   c,15   ;command to LCD
FCCC   D7                     RST   10H   
FCCD   CD 09 FD               CALL   displayRAMline   
FCD0   06 D4                  LD   b,0D4H   ;set forth row
FCD2   0E 0F                  LD   c,15   ;command to LCD
FCD4   D7                     RST   10H   
FCD5   CD 09 FD               CALL   displayRAMline   
FCD8                             ;get key input
FCD8                DUMPKEY:      
FCD8   11 75 FD               LD   de,segDisp   
FCDB   E7                     RST   20H   
FCDC   30 FA                  JR   nc,dumpKey   
FCDE   FE 13                  CP   13H   ;is it Addr?
FCE0   20 06                  JR   nz,keyTryPlus   
FCE2   06 01                  LD   b,01H   ;clear LCD
FCE4   0E 0F                  LD   c,15   ;command to LCD
FCE6   D7                     RST   10H   
FCE7   C9                     RET      
FCE8                KEYTRYPLUS:      
FCE8   FE 10                  CP   10H   ;is it plus key?
FCEA   20 0D                  JR   nz,keyTryMinus   
FCEC   3A 3C 09               LD   a,(RAM_PTR)   ;get pointer
FCEF   FE 02                  CP   2   ;is it at bottom?
FCF1   28 E5                  JR   z,dumpKey   ;yet, get key again
FCF3   3C                     INC   a   
FCF4   32 3C 09               LD   (RAM_PTR),a   ;save it
FCF7   18 B3                  JR   dumpLoop   
FCF9                KEYTRYMINUS:      
FCF9   FE 11                  CP   11H   ;is it minus key?
FCFB   20 DB                  JR   nz,dumpKey   ;get key again
FCFD   3A 3C 09               LD   a,(RAM_PTR)   ;get pointer
FD00   B7                     OR   a   ;is it at top?
FD01   28 D5                  JR   z,dumpKey   ;yet, get key again
FD03   3D                     DEC   a   
FD04   32 3C 09               LD   (RAM_PTR),a   ;save it
FD07   18 A3                  JR   dumpLoop   
FD09                DISPLAYRAMLINE:      
FD09   CD 12 FD               CALL   genRAMline   ;input HL, output DE
FD0C   EB                     EX   de,hl   
FD0D   0E 0D                  LD   c,13   ;string to LCD
FD0F   D7                     RST   10H   
FD10   EB                     EX   de,hl   
FD11   C9                     RET      
FD12                             ; fill RTC_BUFF with line to display on LCD
FD12                             ; someting like this 06:06 07 08 09 0A 0B
FD12                             ; input: HL = address of first byte to display
FD12                             ; outptu: DE = address of LCD ASCII line
FD12                GENRAMLINE:      
FD12                             ;get index
FD12   11 1D 09               LD   de,RTC_RAM   
FD15   B7                     OR   a   
FD16   ED 52                  SBC   hl,de   ;get index difference
FD18   7D                     LD   a,l   ;store index in a
FD19   19                     ADD   hl,de   ;restore HL
FD1A   06 06                  LD   b,6   ;six bytes by default
FD1C   FE 1E                  CP   1EH   ;is it on the last line?
FD1E   20 02                  JR   nz,$+4   ;yes, only display one byte
FD20   06 01                  LD   b,1   ;one byte
FD22   0E 09                  LD   c,9   ;A to string
FD24   11 08 09               LD   de,RTC_BUFF   ;convert A to "AA"
FD27   D7                     RST   10H   
FD28   3E 3A                  LD   a,":"   ;add colon
FD2A   12                     LD   (de),a   
FD2B   13                     INC   de   
FD2C                RAMDISPLOOP:      
FD2C   7E                     LD   a,(hl)   
FD2D   23                     INC   hl   
FD2E   0E 09                  LD   c,9   ;A to string
FD30   D7                     RST   10H   
FD31   3E 20                  LD   a," "   ;add space
FD33   12                     LD   (de),a   
FD34   13                     INC   de   
FD35   10 F5                  DJNZ   RAMdisploop   
FD37   1B                     DEC   de   
FD38   AF                     XOR   a   
FD39   12                     LD   (de),a   ;terminate with zero
FD3A   11 08 09               LD   de,RTC_BUFF   ;reset to start of buffer
FD3D   C9                     RET      
FD3E                             ; Get current time and save in local RAM.
FD3E                             ; Returns: H = hour      ; bit 5 = am/pm flag (in 12 hr mode). 1=PM
FD3E                             ;          L = minute
FD3E                             ;          D = second
FD3E                GETRTCTIME:      
FD3E   CD 1F F9               CALL   getTime   
FD41   7A                     LD   a,d   ;save seconds
FD42   32 00 09               LD   (RTC_SECS),a   
FD45   7D                     LD   a,l   ;save minutes
FD46   32 02 09               LD   (RTC_MINS),a   
FD49                             ; check if 12 or 24 hours
FD49   CD AA F9               CALL   get1224Mode   ;A = 00H, 24 hour mode, 80h, 12 hr mode
FD4C   B4                     OR   h   ;set bit 7 if 12 hour mode in hours data and save it
FD4D   67                     LD   h,a   
FD4E   32 03 09               LD   (RTC_HOURS),a   
FD51   C9                     RET      
FD52                             ; Checks the state of the RTC checksum (RAM at 31 slot).  Checksum is the twos
FD52                             ; compliment of the first 16 bytes of RAM.  It will then compare the result
FD52                             ; with the stored checksum in slot 31.
FD52                             ; Input: none
FD52                             ; Output: A = 00 if match or something else if no match
FD52                             ;         Zero Flag = set if calculated checksum = stored checksum
FD52                             ; Destroy: A
FD52                CHECKRTCCHECKSUM:      
FD52   CD 5D FD               CALL   getRTCChecksum   
FD55   6F                     LD   l,a   
FD56   16 1E                  LD   d,30   
FD58   CD 64 FA               CALL   readRTCByte   ;get stored checksum
FD5B   95                     SUB   l   
FD5C   C9                     RET      ;Zero flag set if checksum = stored checksum
FD5D                             ; Calculate checksum for MON3 stored values.  First 16 bytes of RAM are reserved
FD5D                             ; for MON3.  Calculate the checksum of the first 16 bytes.  Checksum is the
FD5D                             ; twos compliment of the sum of the 16 bytes
FD5D                             ; Input: none
FD5D                             ; Output: A = calculated checksum
FD5D                GETRTCCHECKSUM:      
FD5D   E5                     PUSH   hl   
FD5E   C5                     PUSH   bc   
FD5F   21 1D 09               LD   hl,RTC_RAM   
FD62   CD 80 FA               CALL   burstRTCRead   ;put RAM data in RTC_RAM location
FD65   21 1D 09               LD   hl,RTC_RAM   ;index HL to start position
FD68   06 10                  LD   b,16   ;B=16 bytes to parse
FD6A   AF                     XOR   a   ;A=initial checksum
FD6B                CHECKSUMLOOP:      
FD6B   4E                     LD   c,(hl)   ;get RAM value
FD6C   81                     ADD   a,c   
FD6D   23                     INC   hl   ;move to next RAM value
FD6E   10 FB                  DJNZ   checksumloop   
FD70   ED 44                  NEG      ;get the twos compliment
FD72   C1                     POP   bc   
FD73   E1                     POP   hl   
FD74   C9                     RET      ;Zero flag set if checksum = stored checksum
FD75                             ; ----------------------------------------------------------------------------
FD75                             ; RAM Locations
FD75                             ; ----------------------------------------------------------------------------
FD75                RTC_BASE:   EQU   0900H   ;Start of RAM location
FD75                RTC_SECS:   EQU   RTC_BASE   ;Seconds (1-byte)
FD75                RTC_OSEC:   EQU   RTC_BASE+1   ;Old Seconds (1-byte)
FD75                RTC_MINS:   EQU   RTC_BASE+2   ;Minutes (1-byte)
FD75                RTC_HOURS:   EQU   RTC_BASE+3   ;Hours (1-byte)
FD75                RTC_DAY:   EQU   RTC_BASE+4   ;Day of Week (1-byte)
FD75                RTC_MONTH:   EQU   RTC_BASE+5   ;Month (1-byte)
FD75                RTC_YEAR:   EQU   RTC_BASE+6   ;Year (2-bytes)
FD75                RTC_BUFF:   EQU   RTC_BASE+8   ;LCD Buffer (21-bytes)
FD75                RTC_RAM:   EQU   RTC_BASE+29   ;RAM Data (31-byte)
FD75                RAM_PTR:   EQU   RTC_BASE+60   ;RAM Pointer (1-byte)
FD75                             ; ----------------------------------------------------------------------------
FD75                             ; constants
FD75                             ; ----------------------------------------------------------------------------
FD75                RTC_PORT:   EQU   0FCH   
FD75   A7 C7 C6 4B C6 C3 SEGDISP:   DB   0A7H,0C7H,0C6H,4BH,0C6H,0C3H   
FD7B   4D 6F 6E 64 61 79 00 DAYSLIST:   DB   "Monday",0   
FD82   54 75 65 73 64 61 79 00 DB   "Tuesday",0   
FD8A   57 65 64 6E 65 73 64 61 79 00 DB   "Wednesday",0   
FD94   54 68 75 72 73 64 61 79 00 DB   "Thursday",0   
FD9D   46 72 69 64 61 79 00   DB   "Friday",0   
FDA4   53 61 74 75 72 64 61 79 00 DB   "Saturday",0   
FDAD   53 75 6E 64 61 79 00   DB   "Sunday",0   
FDB4   48 3A 4D 3A 53 20 50 4D 3A 30 2D 33 2C 20 50 52 41 4D 3A 38 00 HELPLIST:   DB   "H:M:S PM:0-3, PRAM:8",0   
FDC9   57 44 20 44 2F 4D 2F 59 3A 34 2D 37 2C 20 52 53 45 54 3A 46 00 DB   "WD D/M/Y:4-7, RSET:F",0   
FDDE   C0 F8        DSAPIFUNCTIONS:   DW   checkDS1302Present   
FDE0   E5 F8                  DW   resetDS1302   
FDE2   1F F9                  DW   getTime   
FDE4   35 F9                  DW   setTime   
FDE6   51 F9                  DW   getDate   
FDE8   69 F9                  DW   setDate   
FDEA   7C F9                  DW   getDay   
FDEC   97 F9                  DW   setDay   
FDEE   AA F9                  DW   get1224Mode   
FDF0   B5 F9                  DW   set12HrMode   
FDF2   DB F9                  DW   set24HrMode   
FDF4   64 FA                  DW   readRTCByte   
FDF6   73 FA                  DW   writeRTCByte   
FDF8   80 FA                  DW   burstRTCRead   
FDFA   EF FA                  DW   bcdToBin   
FDFC   02 FB                  DW   binToBcd   
FDFE   06 FA                  DW   formatTime   
FE00   43 FA                  DW   formatDate   
FE02   15 FB                  DW   RTCSetup   
FE04                DSAPIFNMAX:   EQU   ($-DSAPIFunctions)/2   
FE04                             ; 
