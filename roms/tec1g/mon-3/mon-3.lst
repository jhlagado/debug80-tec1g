F3B0   21 00 00               LD   HL,0000H   ;CLEAR RESULT
F3B3   B7                     OR   A   ;ADD AND COUNT
F3B4   28 2A                  JR   Z,XP35   
F3B6                XP33:        
F3B6   19                     ADD   HL,DE   
F3B7   DA 3A F0               JP   C,AHOW   ;OVERFLOW
