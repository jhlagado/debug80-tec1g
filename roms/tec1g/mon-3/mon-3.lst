F3F6   38 05                  JR   C,XP41   ;NOR A VARIABLE
F3F8   7E                     LD   A,(HL)   ;VARIABLE
F3F9   23                     INC   HL   
F3FA   66                     LD   H,(HL)   ;VALUE IN HL
F3FB   6F                     LD   L,A   
F3FC   C9                     RET      
F3FD                XP41:        
F3FD   CD 10 F0               CALL   TSTNUM   ;OR IS IT A NUMBER
F400   78                     LD   A,B   ;# OF DIGIT
F401   B7                     OR   A   
