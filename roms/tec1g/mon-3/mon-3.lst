EFA1                             ; 
EFA1                             ;                 TINY BASIC FOR ZILOG Z80
EFA1                             ;                       VERSION 2.0
EFA1                             ;                     BY LI-CHEN WANG
EFA1                             ; 
EFA1                             ;                  MODIFIED AND TRANSLATED
EFA1                             ;                    TO INTEL MNEMONICS
EFA1                             ;                     BY ROGER RAUSKOLB
EFA1                             ;                      10 OCTOBER,1976
EFA1                             ; 
EFA1                             ;                  MODIFIED AND TRANSLATED
EFA1                             ;                    TO ZILOG MNEMONICS
EFA1                             ;                      BY DOUG GABBARD
EFA1                             ;            www.retrodepot.net
EFA1                             ; 
EFA1                             ;                  MODIFIED AND FIXED TO WORK
EFA1                             ;                  ON THE TEC-1G Z80 SBC USING
EFA1                             ;                  ON BOARD BIT BANG SERIAL
EFA1                             ;                  BY BRIAN CHIHA, OCT 2023
EFA1                             ; 
EFA1                             ;           RELEASED TO THE PUBLIC
EFA1                             ;                      10 OCTOBER,2017
EFA1                             ;                  YEAH, 41 YEARS LATER....
EFA1                             ; 
EFA1                             ;                         @COPYLEFT
EFA1                             ;                   ALL WRONGS RESERVED
EFA1                             ; 
EFA1                             ;*************************************************************
EFA1                             ; This code is derived from the original 8080 Tiny Basic.
EFA1                             ; It was first compiled in 8080 Mnemonics, then disassembled
EFA1                             ; into Zilog Mnemonics.  And then checked against the original
EFA1                             ; to ensure accuracy.  It was then partially enhanced with z80
EFA1                             ; specific code. And once done, it was then modified to work
EFA1                             ; with the G80-S Micro Computer. However, that portion of the
EFA1                             ; code has been left out in order to make this code a little
EFA1                             ; more portable.  There are only three routines that one needs
EFA1                             ; to write, and specifing the serial port's I/O address, in
EFA1                             ; order to make this version work with your own DIY computer.
EFA1                             ; Those routines can be found at the end of the source code.
EFA1                             ; 
EFA1                             ; I hope you find good use for this relic. However, I would
EFA1                             ; ask that if you do find use for it, please put a reference
EFA1                             ; to me in your work. And please, distribute freely.
EFA1                             ;*************************************************************
EFA1                             ; Modified to work on the TEC-1F using Bit Bang Serial
EFA1                             ; TEC 1F Contants
EFA1                             ; BAUD:	         .equ	 001BH           ; BAUD 4800 delay
EFA1                             ; SYS_INPUT:          .equ     03H             ; Keyboard Bit 7 (INPUT)
EFA1                             ; SCAN:            .equ     01H             ; Segment Scan Bit 6 (OUTPUT)
EFA1                             ;TINY BASIC CONSTANTS
EFA1                             ;ASCII CONTROL CHARACTERS
EFA1                SPACE:    EQU   20H   ; Space
EFA1                TAB:      EQU   09H   ; HORIZONTAL TAB
EFA1                CTRLC:    EQU   03H   ; Control "C"
EFA1                CTRLG:    EQU   07H   ; Control "G"
EFA1                BKSP:     EQU   08H   ; Back space
EFA1                LF:       EQU   0AH   ; Line feed
EFA1                VT:       EQU   0BH   ; Vertical tab
EFA1                CS:       EQU   0CH   ; Clear screen
EFA1                CR:       EQU   0DH   ; Carriage return
EFA1                CTRLO:    EQU   0FH   ; Control "O"
EFA1                CTRLQ:    EQU   11H   ; Control "Q"
EFA1                CTRLD:    EQU   04H   ; Control "D"
EFA1                CTRLU:    EQU   15H   ; Control "U"
EFA1                CTRLZ:    EQU   1AH   ; Control "Z"
EFA1                ESC:      EQU   1BH   ; Escape
EFA1                DEL:      EQU   7FH   ; Delete
EFA1                             ;LOCAL VARIABLES
EFA1                OCSW:     EQU   17C0H   ;SWITCH FOR OUTPUT
EFA1                CURRNT:   EQU   OCSW+1   ;POINTS FOR OUTPUT
EFA1                STKGOS:   EQU   OCSW+3   ;SAVES SP IN "GOSUB"
EFA1                VARNXT:   EQU   OCSW+5   ;TEMP STORAGE
EFA1                STKINP:   EQU   OCSW+7   ;SAVES SP IN "INPUT"
EFA1                LOPVAR:   EQU   OCSW+9   ;"FOR" LOOP SAVE AREA
EFA1                LOPINC:   EQU   OCSW+11   ;INCREMENT
EFA1                LOPLMT:   EQU   OCSW+13   ;LIMIT
EFA1                LOPLN:    EQU   OCSW+15   ;LINE NUMBER
EFA1                LOPPT:    EQU   OCSW+17   ;TEXT POINTER
EFA1                RANPNT:   EQU   OCSW+19   ;RANDOM NUMBER POINTER
EFA1                TXTUNF:   EQU   OCSW+21   ;->UNFILLED TEXT AREA
EFA1                TXTBGN:   EQU   OCSW+23   ;TEXT SAVE AREA BEGINS
EFA1                TXTEND:   EQU   3E00H   ;TEXT SAVE AREA ENDS
EFA1                             ;STACK, VARIABLES AND INPUT BUFFER
EFA1                VARBGN:   EQU   3E00H   ;VARIABLE LOCATION (SIZE OF 55)
EFA1                BUFFER:   EQU   3E37H   ;INPUT BUFFER (SIZE OF 80)
EFA1                BUFEND:   EQU   3E87H   ;BUFFER END
EFA1                STKLMT:   EQU   3E88H   ;TOP LIMIT FOR STACK
EFA1                STACK:    EQU   3EFFH   ;STACK
EFA1                             ;*************************************************************
EFA1                             ; *** ZERO PAGE SUBROUTINES ***
EFA1                             ; 
EFA1                             ; THE Z80 INSTRUCTION SET ALLOWS FOR 8 ROUTINES IN LOW MEMORY
EFA1                             ; THAT MAY BE CALLED BY RST 00H, 08H, 10H, 18H, 20H, 28H, 30H,
EFA1                             ; AND 38H.  THIS IS A ONE BYTE INSTRUCTION, AND IS FUNCTIONALLY
EFA1                             ; SIMILAR TO THE THREE BYTE INSTRUCTION "CALL XXXX". TINY BASIC
EFA1                             ; WILL USE THE RST INSTRUCTION FOR THE 7 MOST FREQUENTLY USED
EFA1                             ; SUBROUTINES. TWO OTHER SUBROUTINES (CRLF & TSTNUM) ARE ALSO
EFA1                             ; IN THIS SECTION. THEY CAN BE REACHED WITH "CALL".
EFA1                             ;*************************************************************
EFA1                             ; DWA:    MACRO WHERE
EFA1                             ;         .db   (WHERE >> 8) & 0FFH
EFA1                             ; ;        .db   (WHERE >> 8) + 128
EFA1                             ;         .db   WHERE & 0FFH
EFA1                             ;         ENDM
EFA1                             ; .macro DWA
EFA1                             ;         .db (%%1 >> 8) & 0FFH
EFA1                             ;         .db %%1 & 0FFH
EFA1                             ; .endm
EFA1                TINYBASIC:      
EFA1   31 FF 3E               LD   SP,STACK   ;*** COLD START ***
EFA4   C3 95 F6               JP   INIT   
EFA7   E3           RST08TB:   EX   (SP),HL   ;*** TSTC OR RST 08H ***
EFA8   CD C6 EF               CALL   RST28TB   ;IGNORE BLANKS AND
EFAB   BE                     CP   (HL)   ;TEST CHARACTER
EFAC   C3 02 F0               JP   TC1   ;REST OF THIS IS AT TC1
EFAF                CRLF:        
EFAF   3E 0D                  LD   A,CR   ;*** CRLF ***
EFB1   F5           RST10TB:   PUSH   AF   ;*** OUTC OR RST 10H ***
EFB2   3A C0 17               LD   A,(OCSW)   ;PRINT CHARACTER ONLY
EFB5   B7                     OR   A   ;IF OCSW SWITCH IS ON
EFB6   C3 B5 F6               JP   OUTC   ;REST OF THIS AT OUTC
EFB9   CD 54 F3     RST18TB:   CALL   EXPR2   ;*** EXPR OR RST 18H ***
EFBC   E5                     PUSH   HL   ;EVALUATE AN EXPRESSION
EFBD   C3 10 F3               JP   EXPR1   ;REST OF IT AT EXPR1
EFC0   7C           RST20TB:   LD   A,H   ;*** COMP OR RST 20H ***
EFC1   BA                     CP   D   ;COMPARE HL WITH DE
EFC2   C0                     RET   NZ   ;RETURN CORRECT C AND
EFC3   7D                     LD   A,L   ;Z FLAGS
EFC4   BB                     CP   E   ;BUT OLD A IS LOST
EFC5   C9                     RET      
EFC6   1A           RST28TB:   LD   A,(DE)   ;*** IGNBLK/RST 28H ***
EFC7   FE 20                  CP   SPACE   ;IGNORE BLANKS
EFC9   C0                     RET   NZ   ;IN TEXT (WHERE DE->)
EFCA   13                     INC   DE   ;AND RETURN THE FIRST
EFCB   18 F9                  JR   RST28TB   ;NON-BLANK CHAR. IN A
EFCD   F1           RST30TB:   POP   AF   ;*** FINISH/RST 30H ***
EFCE   CD B4 F4               CALL   FIN   ;CHECK END OF COMMAND
EFD1   C3 CD F4               JP   QWHAT   ;PRINT "WHAT?" IF WRONG
EFD4   CD C6 EF     RST38TB:   CALL   RST28TB   ;*** TSTV OR RST 38H ***
EFD7   D6 40                  SUB   40H   ;TEST VARIABLES
EFD9   D8                     RET   C   ;C:NOT A VARIABLE
EFDA   20 1A                  JR   NZ,TV1   ;NOT "@" ARRAY
EFDC   13                     INC   DE   ;IT IS THE "@" ARRAY
EFDD   CD 03 F4               CALL   PARN   ;@ SHOULD BE FOLLOWED
EFE0   29                     ADD   HL,HL   ;BY (EXPR) AS ITS INDEX
EFE1   38 56                  JR   C,QHOW   ;IS INDEX TOO BIG?
EFE3   D5                     PUSH   DE   ;WILL IT OVERWRITE
EFE4   EB                     EX   DE,HL   ;TEXT?
EFE5   CD 51 F4               CALL   SIZE   ;FIND SIZE OF FREE
EFE8   CD C0 EF               CALL   RST20TB   ;AND CHECK THAT
EFEB   DA FD F4               JP   C,ASORRY   ;IF SO, SAY "SORRY"
EFEE   21 00 3E               LD   HL,VARBGN   ;IF NOT GET ADDRESS
EFF1   CD 73 F4               CALL   SUBDE   ;OF @(EXPR) AND PUT IT
EFF4   D1                     POP   DE   ;IN HL
EFF5   C9                     RET      ;C FLAG IS CLEARED
EFF6                TV1:         
EFF6   FE 1B                  CP   1BH   ;NOT @, IS IT A TO Z?
EFF8   3F                     CCF      ;IF NOT RETURN C FLAG
EFF9   D8                     RET   C   
EFFA   13                     INC   DE   ;IF A THROUGH Z
EFFB   21 00 3E               LD   HL,VARBGN   ;COMPUTE ADDRESS OF
EFFE   07                     RLCA      ;THAT VARIABLE
EFFF   85                     ADD   A,L   ;AND RETURN IT IN HL
F000   6F                     LD   L,A   ;WITH C FLAG CLEARED
F001                             ;        XOR A
F001                             ;        ADC A,H
F001                             ;        LD H,A
F001   C9                     RET      
F002                TC1:         
F002   23                     INC   HL   ;COMPARE THE BYTE THAT
F003   28 07                  JR   Z,TC2   ;FOLLOWS THE RST INST.
F005   C5                     PUSH   BC   ;WITH THE TEXT (DE->)
F006   4E                     LD   C,(HL)   ;IF NOT =, ADD THE 2ND
F007   06 00                  LD   B,00H   ;BYTE THAT FOLLOWS THE
F009   09                     ADD   HL,BC   ;RST TO THE OLD PC
F00A   C1                     POP   BC   ;I.E., DO A RELATIVE
F00B   1B                     DEC   DE   ;JUMP IF NOT =
F00C                TC2:         
F00C   13                     INC   DE   ;IF =, SKIP THOSE BYTES
F00D   23                     INC   HL   ;AND CONTINUE
F00E   E3                     EX   (SP),HL   
F00F   C9                     RET      
F010                TSTNUM:      
F010   21 00 00               LD   HL,0000H   ;*** TSTNUM ***
F013   44                     LD   B,H   ;TEST IF THE TEXT IS
F014   CD C6 EF               CALL   RST28TB   ;A NUMBER
F017                TN1:         
F017   FE 30                  CP   "0"   ;IF NOT, RETURN 0 IN
F019   D8                     RET   C   ;B AND HL
F01A   FE 3A                  CP   ":"   ;IF NUMBERS, CONVERT
F01C   D0                     RET   NC   ;TO BINARY IN HL AND
F01D   3E F0                  LD   A,0F0H   ;SET B TO # OF DIGITS
F01F   A4                     AND   H   ;IF H>255, THERE IS NO
F020   20 17                  JR   NZ,QHOW   ;ROOM FOR NEXT DIGIT
F022   04                     INC   B   ;B COUNTS # OF DIGITS
F023   C5                     PUSH   BC   
F024   44                     LD   B,H   ;HL=10*HL+(NEW DIGIT)
F025   4D                     LD   C,L   
F026   29                     ADD   HL,HL   ;WHERE 10* IS DONE BY
F027   29                     ADD   HL,HL   ;SHIFT AND ADD
F028   09                     ADD   HL,BC   
F029   29                     ADD   HL,HL   
F02A   1A                     LD   A,(DE)   ;AND (DIGIT) IS FROM
F02B   13                     INC   DE   ;STRIPPING THE ASCII
F02C   E6 0F                  AND   0FH   ;CODE
F02E   85                     ADD   A,L   
F02F   6F                     LD   L,A   
F030   3E 00                  LD   A,00H   ;DO THIS TO MAINTAIN CARRY FLAG
F032   8C                     ADC   A,H   ;WHILE SETTING A TO ZERO
F033   67                     LD   H,A   
F034   C1                     POP   BC   
F035   1A                     LD   A,(DE)   ;DO THIS DIGIT AFTER
F036   F2 17 F0               JP   P,TN1   ;DIGIT. S SAYS OVERFLOW
F039                QHOW:        
F039   D5                     PUSH   DE   ;*** ERROR "HOW?" ***
F03A                AHOW:        
F03A   11 40 F0               LD   DE,HOW   
F03D   C3 D1 F4               JP   ERROR_ROUTINE   
F040   48 4F 57 3F 0D HOW:    DB   "HOW?",CR   
F045   4F 4B 0D     OK:       DB   "OK",CR   
F048   57 48 41 54 3F 0D WHAT:   DB   "WHAT?",CR   
F04E   53 4F 52 52 59 0D SORRY:   DB   "SORRY",CR   
F054                             ;*************************************************************
F054                             ; 
F054                             ; *** MAIN ***
F054                             ; 
F054                             ; THIS IS THE MAIN LOOP THAT COLLECTS THE TINY BASIC PROGRAM
F054                             ; AND STORES IT IN THE MEMORY.
F054                             ; 
F054                             ; AT START, IT PRINTS OUT "(CR)OK(CR)", AND INITIALIZES THE
F054                             ; STACK AND SOME OTHER INTERNAL VARIABLES.  THEN IT PROMPTS
F054                             ; ">" AND READS A LINE.  IF THE LINE STARTS WITH A NON-ZERO
F054                             ; NUMBER, THIS NUMBER IS THE LINE NUMBER.  THE LINE NUMBER
F054                             ; (IN 16 BIT BINARY) AND THE REST OF THE LINE (INCLUDING CR)
F054                             ; IS STORED IN THE MEMORY.  IF A LINE WITH THE SAME LINE
F054                             ; NUMBER IS ALREADY THERE, IT IS REPLACED BY THE NEW ONE.  IF
F054                             ; THE REST OF THE LINE CONSISTS OF A CR ONLY, IT IS NOT STORED
F054                             ; AND ANY EXISTING LINE WITH THE SAME LINE NUMBER IS DELETED.
F054                             ; 
F054                             ; AFTER A LINE IS INSERTED, REPLACED, OR DELETED, THE PROGRAM
F054                             ; LOOPS BACK AND ASKS FOR ANOTHER LINE.  THIS LOOP WILL BE
F054                             ; TERMINATED WHEN IT READS A LINE WITH ZERO OR NO LINE
F054                             ; NUMBER; AND CONTROL IS TRANSFERED TO "DIRECT".
F054                             ; 
F054                             ; TINY BASIC PROGRAM SAVE AREA STARTS AT THE MEMORY LOCATION
F054                             ; LABELED "TXTBGN" AND ENDS AT "TXTEND".  WE ALWAYS FILL THIS
F054                             ; AREA STARTING AT "TXTBGN", THE UNFILLED PORTION IS POINTED
F054                             ; BY THE CONTENT OF A MEMORY LOCATION LABELED "TXTUNF".
F054                             ; 
F054                             ; THE MEMORY LOCATION "CURRNT" POINTS TO THE LINE NUMBER
F054                             ; THAT IS CURRENTLY BEING INTERPRETED.  WHILE WE ARE IN
F054                             ; THIS LOOP OR WHILE WE ARE INTERPRETING A DIRECT COMMAND
F054                             ; (SEE NEXT SECTION). "CURRNT" SHOULD POINT TO A 0.
F054                             ;*************************************************************
F054                RSTART:      
F054   31 FF 3E               LD   SP,STACK   
F057                ST1:         
F057   3E FF                  LD   A,0FFH   
F059   32 C0 17               LD   (OCSW),A   ;ENSURE OUTPUT IS ON
F05C   CD AF EF               CALL   CRLF   ;AND JUMP TO HERE
F05F   11 45 F0               LD   DE,OK   ;DE->STRING
F062   97                     SUB   A   ;A=0
F063   CD 64 F5               CALL   PRTSTG   ;PRINT STRING UNTIL CR
F066   21 6D F0               LD   HL,ST2+1   ;LITERAL 0 STORED AT STG+1
F069   22 C1 17               LD   (CURRNT),HL   ;CURRENT->LINE # = 0
F06C                ST2:         
F06C   21 00 00               LD   HL,0000H   
F06F   22 C9 17               LD   (LOPVAR),HL   
F072   22 C3 17               LD   (STKGOS),HL   
F075                ST3:         
F075   3E 3E                  LD   A,">"   ;PROMPT ">" AND
F077   CD 02 F5               CALL   GETLN   ;READ A LINE
F07A   D5                     PUSH   DE   ;DE->END OF LINE
F07B   11 37 3E               LD   DE,BUFFER   ;DE->BEGINNING OF LINE
F07E   CD 10 F0               CALL   TSTNUM   ;TEST IF IT IS A NUMBER
F081   CD C6 EF               CALL   RST28TB   
F084   7C                     LD   A,H   ;HL=VALUE OF THE # OR
F085   B5                     OR   L   ;0 IF NO # WAS FOUND
F086   C1                     POP   BC   ;BC->END OF LINE
F087   CA EB F7               JP   Z,DIRECT   
F08A   1B                     DEC   DE   ;BACKUP DE AND SAVE
F08B   7C                     LD   A,H   ;VALUE OF LINE # THERE
F08C   12                     LD   (DE),A   
F08D   1B                     DEC   DE   
F08E   7D                     LD   A,L   
F08F   12                     LD   (DE),A   
F090   C5                     PUSH   BC   ;BC,DE->BEGIN, END
F091   D5                     PUSH   DE   
F092   79                     LD   A,C   
F093   93                     SUB   E   
F094   F5                     PUSH   AF   ;A=# OF BYTES IN LINE
F095   CD 3D F5               CALL   FNDLN   ;FIND THIS LINE IN SAVE
F098   D5                     PUSH   DE   ;AREA, DE->SAVE AREA
F099   20 10                  JR   NZ,ST4   ;NZ:NOT FOUND, INSERT
F09B   D5                     PUSH   DE   ;Z:FOUND, DELETE IT
F09C   CD 5A F5               CALL   FNDNXT   ;FIND NEXT LINE
F09F                             ;DE->NEXT LINE
F09F   C1                     POP   BC   ;BC->LINE TO BE DELETED
F0A0   2A D5 17               LD   HL,(TXTUNF)   ;HL->UNFILLED SAVE AREA
F0A3   CD 3A F6               CALL   MVUP1   ;MOVE UP TO DELETE
F0A6   60                     LD   H,B   ;TXTUNF->UNFILLED ARA
F0A7   69                     LD   L,C   
F0A8   22 D5 17               LD   (TXTUNF),HL   ;UPDATE
F0AB                ST4:         
F0AB   C1                     POP   BC   ;GET READY TO INSERT
F0AC   2A D5 17               LD   HL,(TXTUNF)   ;BUT FIRST CHECK IF
F0AF   F1                     POP   AF   ;THE LENGTH OF NEW LINE
F0B0   E5                     PUSH   HL   ;IS 3 (LINE # AND CR)
F0B1   FE 03                  CP   CTRLC   ;THEN DO NOT INSERT
F0B3   28 9F                  JR   Z,RSTART   ;MUST CLEAR THE STACK
F0B5   85                     ADD   A,L   ;COMPUTE NEW TXTUNF
F0B6   6F                     LD   L,A   
F0B7   3E 00                  LD   A,00H   
F0B9   8C                     ADC   A,H   
F0BA   67                     LD   H,A   ;HL->NEW UNFILLED AREA
F0BB   11 00 3E               LD   DE,TXTEND   ;CHECK TO SEE IF THERE
F0BE   CD C0 EF               CALL   RST20TB   ;IS ENOUGH SPACE
F0C1   D2 FC F4               JP   NC,QSORRY   ;SORRY, NO ROOM FOR IT
F0C4   22 D5 17               LD   (TXTUNF),HL   ;OK, UPDATE TXTUNF
F0C7   D1                     POP   DE   ;DE->OLD UNFILLED AREA
F0C8   CD 44 F6               CALL   MVDOWN   
F0CB   D1                     POP   DE   ;DE->BEGIN, HL->END
F0CC   E1                     POP   HL   
F0CD   CD 3A F6               CALL   MVUP1   ;MOVE NEW LINE TO SAVE
F0D0   18 A3                  JR   ST3   ;AREA
F0D2                             ;*************************************************************
F0D2                             ; 
F0D2                             ; WHAT FOLLOWS IS THE CODE TO EXECUTE DIRECT AND STATEMENT
F0D2                             ; COMMANDS.  CONTROL IS TRANSFERED TO THESE POINTS VIA THE
F0D2                             ; COMMAND TABLE LOOKUP CODE OF "DIRECT" AND "EXEC" IN LAST
F0D2                             ; SECTION.  AFTER THE COMMAND IS EXECUTED, CONTROL IS
F0D2                             ; TRANSFERED TO OTHERS SECTIONS AS FOLLOWS:
F0D2                             ; 
F0D2                             ; FOR "LIST", "NEW", AND "STOP": GO BACK TO "RSTART"
F0D2                             ; FOR "RUN": GO EXECUTE THE FIRST STORED LINE IF ANY, ELSE
F0D2                             ; GO BACK TO "RSTART".
F0D2                             ; FOR "GOTO" AND "GOSUB": GO EXECUTE THE TARGET LINE.
F0D2                             ; FOR "RETURN" AND "NEXT": GO BACK TO SAVED RETURN LINE.
F0D2                             ; FOR ALL OTHERS: IF "CURRENT" -> 0, GO TO "RSTART", ELSE
F0D2                             ; GO EXECUTE NEXT COMMAND.  (THIS IS DONE IN "FINISH".)
F0D2                             ;*************************************************************
F0D2                             ; 
F0D2                             ; *** NEW *** STOP *** RUN (& FRIENDS) *** & GOTO ***
F0D2                             ; 
F0D2                             ; "NEW(CR)" SETS "TXTUNF" TO POINT TO "TXTBGN"
F0D2                             ; 
F0D2                             ; "STOP(CR)" GOES BACK TO "RSTART"
F0D2                             ; 
F0D2                             ; "RUN(CR)" FINDS THE FIRST STORED LINE, STORE ITS ADDRESS (IN
F0D2                             ; "CURRENT"), AND START EXECUTE IT.  NOTE THAT ONLY THOSE
F0D2                             ; COMMANDS IN TAB2 ARE LEGAL FOR STORED PROGRAM.
F0D2                             ; 
F0D2                             ; THERE ARE 3 MORE ENTRIES IN "RUN":
F0D2                             ; "RUNNXL" FINDS NEXT LINE, STORES ITS ADDR. AND EXECUTES IT.
F0D2                             ; "RUNTSL" STORES THE ADDRESS OF THIS LINE AND EXECUTES IT.
F0D2                             ; "RUNSML" CONTINUES THE EXECUTION ON SAME LINE.
F0D2                             ; 
F0D2                             ; "GOTO EXPR(CR)" EVALUATES THE EXPRESSION, FIND THE TARGET
F0D2                             ; LINE, AND JUMP TO "RUNTSL" TO DO IT.
F0D2                             ;*************************************************************
F0D2                NEW:         
F0D2   CD C7 F4               CALL   ENDCHK   ;*** NEW(CR) ***
F0D5   21 D7 17               LD   HL,TXTBGN   
F0D8   22 D5 17               LD   (TXTUNF),HL   
F0DB                STOP:        
F0DB   CD C7 F4               CALL   ENDCHK   ;*** STOP(CR) ***
F0DE   C3 54 F0               JP   RSTART   
F0E1                RUN:         
F0E1   CD C7 F4               CALL   ENDCHK   ;*** RUN(CR) ***
F0E4   11 D7 17               LD   DE,TXTBGN   ;FIRST SAVED LINE
F0E7                RUNNXL:      
F0E7   21 00 00               LD   HL,00H   ;*** RUNNXL ***
F0EA   CD 45 F5               CALL   FNDLP   ;FIND WHATEVER LINE #
F0ED   DA 54 F0               JP   C,RSTART   ;C:PASSED TXTUNF, QUIT
F0F0                RUNTSL:      
F0F0   EB                     EX   DE,HL   ;*** RUNTSL ***
F0F1   22 C1 17               LD   (CURRNT),HL   ;SET "CURRENT"->LINE #
F0F4   EB                     EX   DE,HL   
F0F5   13                     INC   DE   ;BUMP PASS LINE #
F0F6   13                     INC   DE   
F0F7                RUNSML:      
F0F7   CD F4 F6               CALL   CHKIO   ;*** RUNSML ***
F0FA   21 5A F7               LD   HL,TAB2-1   ;FIND COMMAND IN TAB2
F0FD   C3 EE F7               JP   EXEC   ;AND EXECUTE IT
F100                GOTO:        
F100   CD B9 EF               CALL   RST18TB   ;*** GOTO EXPR ***
F103   D5                     PUSH   DE   ;SAVE FOR ERROR ROUTINE
F104   CD C7 F4               CALL   ENDCHK   ;MUST FIND A CR
F107   CD 3D F5               CALL   FNDLN   ;FIND THE TARGET LINE
F10A   C2 3A F0               JP   NZ,AHOW   ;NO SUCH LINE #
F10D   F1                     POP   AF   ;CLEAR THE PUSH DE
F10E   18 E0                  JR   RUNTSL   ;GO DO IT
F110                             ;*************************************************************
F110                             ; 
F110                             ; *** LIST *** & PRINT ***
F110                             ; 
F110                             ; LIST HAS TWO FORMS:
F110                             ; "LIST(CR)" LISTS ALL SAVED LINES
F110                             ; "LIST #(CR)" START LIST AT THIS LINE #
F110                             ; YOU CAN STOP THE LISTING BY CONTROL C KEY
F110                             ; 
F110                             ; PRINT COMMAND IS "PRINT ....;" OR "PRINT ....(CR)"
F110                             ; WHERE "...." IS A LIST OF EXPRESIONS, FORMATS, BACK-
F110                             ; ARROWS, AND STRINGS.  THESE ITEMS ARE SEPERATED BY COMMAS.
F110                             ; 
F110                             ; A FORMAT IS A POUND SIGN FOLLOWED BY A NUMBER.  IT CONTROLS
F110                             ; THE NUMBER OF SPACES THE VALUE OF A EXPRESION IS GOING TO
F110                             ; BE PRINTED.  IT STAYS EFFECTIVE FOR THE REST OF THE PRINT
F110                             ; COMMAND UNLESS CHANGED BY ANOTHER FORMAT.  IF NO FORMAT IS
F110                             ; SPECIFIED, 6 POSITIONS WILL BE USED.
F110                             ; 
F110                             ; IF A & IS THE FIRST CHARACTER, THE NUMBER FOLLOWING IS
F110                             ; PRINTED AS HEXADECIMAL.  IF NUMBER IS GREATER THAN 255
F110                             ; THEN H IS PRINTED FIRST THEN L WITH NO SPACE BETWEEN
F110                             ; 
F110                             ; IF A % IS THE FIRST CHARACTER, THE NUMBER IS PRINTED
F110                             ; AS AN ASCII CHARCTER.  IF THE CARACTER IS NOT PRINTABLE
F110                             ; A "." WILL BE PRINTED.
F110                             ; 
F110                             ; IF A $ IS THE FIRST CHARACTER, THE NUMBER IS PRINTED
F110                             ; AS AN ASCII CHARCTER BUT ALL ASCII CHARACTERS ARE PRINTED
F110                             ; BETWEEN 0 AND 128
F110                             ; 
F110                             ; A STRING IS QUOTED IN A PAIR OF SINGLE QUOTES OR A PAIR OF
F110                             ; DOUBLE QUOTES.
F110                             ; 
F110                             ; A UNDERSCORE MEANS GENERATE A (CR) WITHOUT (LF)
F110                             ; 
F110                             ; A (CRLF) IS GENERATED AFTER THE ENTIRE LIST HAS BEEN
F110                             ; PRINTED OR IF THE LIST IS A NULL LIST.  HOWEVER IF THE LIST
F110                             ; ENDED WITH A COMMA, NO (CRLF) IS GENERATED.
F110                             ;*************************************************************
F110                LIST:        
F110   CD 10 F0               CALL   TSTNUM   ;TEST IF THERE IS A #
F113   CD C7 F4               CALL   ENDCHK   ;IF NO # WE GET A 0
F116   CD 3D F5               CALL   FNDLN   ;FIND THIS OR NEXT LINE
F119                LS1:         
F119   DA 54 F0               JP   C,RSTART   ;C:PASSED TXTUNF
F11C   CD F9 F5               CALL   PRTLN   ;PRINT THE LINE
F11F   CD F4 F6               CALL   CHKIO   ;STOP IF HIT CONTROL-C
F122   CD 45 F5               CALL   FNDLP   ;FIND NEXT LINE
F125   18 F2                  JR   LS1   ;AND LOOP BACK
F127                PRINT:       
F127   0E 06                  LD   C,06H   ;C = # OF SPACES
F129   CD A7 EF               CALL   RST08TB   ;F NULL LIST & ";"
F12C   3B                     DB   ";"   
F12D   05                     DB   PR2-$-1   
F12E   CD AF EF               CALL   CRLF   ;GIVE CR-LF AND
F131   18 C4                  JR   RUNSML   ;CONTINUE SAME LINE
F133                PR2:         
F133   CD A7 EF               CALL   RST08TB   ;IF NULL LIST (CR)
F136   0D                     DB   CR   
F137   05                     DB   PR0-$-1   
F138   CD AF EF               CALL   CRLF   ;ALSO GIVE CR-LF AND
F13B   18 AA                  JR   RUNNXL   ;GO TO NEXT LINE
F13D                PR0:         
F13D   CD A7 EF               CALL   RST08TB   ;ELSE IS IT FORMAT?
F140   23                     DB   "#"   
F141   06                     DB   PR9-$-1   
F142   CD B9 EF               CALL   RST18TB   ;YES, EVALUATE EXPR.
F145   4D                     LD   C,L   ;AND SAVE IT IN C
F146   18 2C                  JR   PR3   ;LOOK FOR MORE TO PRINT
F148                PR9:         
F148   CD A7 EF               CALL   RST08TB   ;ELSE IS IT PRINT AS HEXIDECIMAL?
F14B   26                     DB   "&"   
F14C   08                     DB   PR10-$-1   
F14D   CD B9 EF               CALL   RST18TB   ;YES, EVALUATE EXPR.
F150   CD 1E F6               CALL   PRTHEX   
F153   18 1F                  JR   PR3   
F155                PR10:        
F155   CD A7 EF               CALL   RST08TB   ;ELSE IS IT PRINT AS ASCII?
F158   25                     DB   "%"   ;FOR ASCII PRINTING?
F159   08                     DB   PR11-$-1   
F15A   CD B9 EF               CALL   RST18TB   ;YES, EVALUATE EXPR.
F15D   CD 11 F6               CALL   PRTASC   ;PRINT ONLY PRINTABLE ASCII
F160   18 12                  JR   PR3   
F162                PR11:        
F162   CD A7 EF               CALL   RST08TB   ;ELSE IS IT CHR$?
F165   24                     DB   "$"   
F166   08                     DB   PR1-$-1   
F167   CD B9 EF               CALL   RST18TB   ;YES, EVALUATE EXPR.
F16A   CD 0D F6               CALL   PRTCHR   ;PRINT THE ASCII VALUE
F16D   18 05                  JR   PR3   
F16F                PR1:         
F16F   CD 8A F5               CALL   QTSTG   ;OR IS IT A STRING?
F172   18 10                  JR   PR8   ;IF NOT, MUST BE EXPR.
F174                PR3:         
F174   CD A7 EF               CALL   RST08TB   ;IF ",", GO FIND NEXT
F177   2C                     DB   ","   
F178   05                     DB   PR6-$-1   
F179   CD B4 F4               CALL   FIN   ;IN THE LIST.
F17C   18 BF                  JR   PR0   ;LIST CONTINUES
F17E                PR6:         
F17E   CD AF EF               CALL   CRLF   ;LIST ENDS
F181   CD CD EF               CALL   RST30TB   
F184                PR8:         
F184   CD B9 EF               CALL   RST18TB   ;EVALUATE THE EXPR
F187   C5                     PUSH   BC   
F188   CD B9 F5               CALL   PRTNUM   ;PRINT THE VALUE
F18B   C1                     POP   BC   
F18C   18 E6                  JR   PR3   ;MORE TO PRINT?
F18E                             ;*************************************************************
F18E                             ; 
F18E                             ; *** GOSUB *** & RETURN ***
F18E                             ; 
F18E                             ; "GOSUB EXPR;" OR "GOSUB EXPR (CR)" IS LIKE THE "GOTO"
F18E                             ; COMMAND, EXCEPT THAT THE CURRENT TEXT POINTER, STACK POINTER
F18E                             ; ETC. ARE SAVE SO THAT EXECUTION CAN BE CONTINUED AFTER THE
F18E                             ; SUBROUTINE "RETURN".  IN ORDER THAT "GOSUB" CAN BE NESTED
F18E                             ; (AND EVEN RECURSIVE), THE SAVE AREA MUST BE STACKED.
F18E                             ; THE STACK POINTER IS SAVED IN "STKGOS", THE OLD "STKGOS" IS
F18E                             ; SAVED IN THE STACK.  IF WE ARE IN THE MAIN ROUTINE, "STKGOS"
F18E                             ; IS ZERO (THIS WAS DONE BY THE "MAIN" SECTION OF THE CODE),
F18E                             ; BUT WE STILL SAVE IT AS A FLAG FOR NO FURTHER "RETURN"S.
F18E                             ; 
F18E                             ; "RETURN(CR)" UNDOS EVERYTHING THAT "GOSUB" DID, AND THUS
F18E                             ; RETURN THE EXECUTION TO THE COMMAND AFTER THE MOST RECENT
F18E                             ; "GOSUB".  IF "STKGOS" IS ZERO, IT INDICATES THAT WE
F18E                             ; NEVER HAD A "GOSUB" AND IS THUS AN ERROR.
F18E                             ;*************************************************************
F18E                GOSUB:       
F18E   CD 6D F6               CALL   PUSHA   ;SAVE THE CURRENT "FOR"
F191   CD B9 EF               CALL   RST18TB   ;PARAMETERS
F194   D5                     PUSH   DE   ;AND TEXT POINTER
F195   CD 3D F5               CALL   FNDLN   ;FIND THE TARGET LINE
F198   C2 3A F0               JP   NZ,AHOW   ;NOT THERE. SAY "HOW?"
F19B   2A C1 17               LD   HL,(CURRNT)   ;FOUND IT, SAVE OLD.
F19E   E5                     PUSH   HL   ;"CURRNT" OLD "STKGOS"
F19F   2A C3 17               LD   HL,(STKGOS)   
F1A2   E5                     PUSH   HL   
F1A3   21 00 00               LD   HL,0000H   ;AND LOAD NEW ONES
F1A6   22 C9 17               LD   (LOPVAR),HL   
F1A9   39                     ADD   HL,SP   
F1AA   22 C3 17               LD   (STKGOS),HL   
F1AD   C3 F0 F0               JP   RUNTSL   ;THEN RUN THAT LINE
F1B0                RETURN:      
F1B0   CD C7 F4               CALL   ENDCHK   ;THERE MUST BE A CR
F1B3   2A C3 17               LD   HL,(STKGOS)   ;OLD STACK POINTER
F1B6   7C                     LD   A,H   ;0 MEANS NOT EXIST
F1B7   B5                     OR   L   
F1B8   CA CD F4               JP   Z,QWHAT   ;SO, WE SAY: "WHAT?"
F1BB   F9                     LD   SP,HL   ;ELSE, RESTORE IT
F1BC   E1                     POP   HL   
F1BD   22 C3 17               LD   (STKGOS),HL   ;AND THE OLD "STKGOS"
F1C0   E1                     POP   HL   
F1C1   22 C1 17               LD   (CURRNT),HL   ;AND THE OLD "CURRNT"
F1C4   D1                     POP   DE   ;OLD TEXT POINTER
F1C5   CD 52 F6               CALL   POPA   ;OLD "FOR" PARAMETERS
F1C8   CD CD EF               CALL   RST30TB   ;AND WE ARE BACK HOME
F1CB                             ;*************************************************************
F1CB                             ; 
F1CB                             ; *** FOR *** & NEXT ***
F1CB                             ; 
F1CB                             ; "FOR" HAS TWO FORMS:
F1CB                             ; "FOR VAR=EXP1 TO EXP2 STEP EXP3" AND "FOR VAR=EXP1 TO EXP2"
F1CB                             ; THE SECOND FORM MEANS THE SAME THING AS THE FIRST FORM WITH
F1CB                             ; EXP3=1.  (I.E., WITH A STEP OF +1.)
F1CB                             ; TBI WILL FIND THE VARIABLE VAR, AND SET ITS VALUE TO THE
F1CB                             ; CURRENT VALUE OF EXP1.  IT ALSO EVALUATES EXP2 AND EXP3
F1CB                             ; AND SAVE ALL THESE TOGETHER WITH THE TEXT POINTER ETC. IN
F1CB                             ; THE "FOR" SAVE AREA, WHICH CONSISTS OF "LOPVAR", "LOPINC",
F1CB                             ; "LOPLMT", "LOPLN", AND "LOPPT".  IF THERE IS ALREADY SOME-
F1CB                             ; THING IN THE SAVE AREA (THIS IS INDICATED BY A NON-ZERO
F1CB                             ; "LOPVAR"), THEN THE OLD SAVE AREA IS SAVED IN THE STACK
F1CB                             ; BEFORE THE NEW ONE OVERWRITES IT.
F1CB                             ; TBI WILL THEN DIG IN THE STACK AND FIND OUT IF THIS SAME
F1CB                             ; VARIABLE WAS USED IN ANOTHER CURRENTLY ACTIVE "FOR" LOOP.
F1CB                             ; IF THAT IS THE CASE, THEN THE OLD "FOR" LOOP IS DEACTIVATED.
F1CB                             ; (PURGED FROM THE STACK..)
F1CB                             ; 
F1CB                             ; "NEXT VAR" SERVES AS THE LOGICAL (NOT NECESSARILLY PHYSICAL)
F1CB                             ; END OF THE "FOR" LOOP.  THE CONTROL VARIABLE VAR. IS CHECKED
F1CB                             ; WITH THE "LOPVAR".  IF THEY ARE NOT THE SAME, TBI DIGS IN
F1CB                             ; THE STACK TO FIND THE RIGHT ONE AND PURGES ALL THOSE THAT
F1CB                             ; DID NOT MATCH.  EITHER WAY, TBI THEN ADDS THE "STEP" TO
F1CB                             ; THAT VARIABLE AND CHECK THE RESULT WITH THE LIMIT.  IF IT
F1CB                             ; IS WITHIN THE LIMIT, CONTROL LOOPS BACK TO THE COMMAND
F1CB                             ; FOLLOWING THE "FOR".  IF OUTSIDE THE LIMIT, THE SAVE AREA
F1CB                             ; IS PURGED AND EXECUTION CONTINUES.
F1CB                             ;*************************************************************
F1CB                FOR:         
F1CB   CD 6D F6               CALL   PUSHA   ;SAVE THE OLD SAVE AREA
F1CE   CD 9B F4               CALL   SETVAL   ;SET THE CONTROL VAR.
F1D1   2B                     DEC   HL   ;HL IS ITS ADDRESS
F1D2   22 C9 17               LD   (LOPVAR),HL   ;SAVE THAT
F1D5   21 C6 F7               LD   HL,TAB5-1   ;USE "EXEC" TO LOOK
F1D8   C3 EE F7               JP   EXEC   ;FOR THE WORK "TO"
F1DB                FR1:         
F1DB   CD B9 EF               CALL   RST18TB   ;EVALUATE THE LIMITE
F1DE   22 CD 17               LD   (LOPLMT),HL   ;SAVE THAT
F1E1   21 CC F7               LD   HL,TAB6-1   ;USE "EXEC" TO LOOK
F1E4   C3 EE F7               JP   EXEC   ;FOR THE WORD "STEP"
F1E7                FR2:         
F1E7   CD B9 EF               CALL   RST18TB   ;FOUND IT, GET STEP
F1EA   18 03                  JR   FR4   
F1EC                FR3:         
F1EC   21 01 00               LD   HL,0001H   ;NOT FOUND, SET TO 1
F1EF                FR4:         
F1EF   22 CB 17               LD   (LOPINC),HL   ;SAVE THAT TOO
F1F2                FR5:         
F1F2   2A C1 17               LD   HL,(CURRNT)   ;SAVE CURRENT LINE #
F1F5   22 CF 17               LD   (LOPLN),HL   
F1F8   EB                     EX   DE,HL   ;AND TEXT POINTER
F1F9   22 D1 17               LD   (LOPPT),HL   
F1FC   01 0A 00               LD   BC,0AH   ;DIG INTO STACK TO
F1FF   2A C9 17               LD   HL,(LOPVAR)   ;FIND "LOPVAR"
F202   EB                     EX   DE,HL   
F203   60                     LD   H,B   
F204   68                     LD   L,B   ;HL=0 NOW
F205   39                     ADD   HL,SP   ;HERE IS THE STACK
F206                FR7:         
F206   09                     ADD   HL,BC   ;EACH LEVEL IS 10 DEEP - DIS = 09
F207   7D                     LD   A,L   
F208   81                     ADD   A,C   
F209   38 18                  JR   C,FR8   
F20B   7E                     LD   A,(HL)   
F20C   2B                     DEC   HL   
F20D   BA                     CP   D   ;SAME AS THIS ONE?
F20E   20 F6                  JR   NZ,FR7   
F210   7E                     LD   A,(HL)   ;THE OTHER HALF?
F211   BB                     CP   E   
F212   20 F2                  JR   NZ,FR7   
F214   EB                     EX   DE,HL   ;YES, FOUND ONE
F215   21 00 00               LD   HL,0000H   
F218   39                     ADD   HL,SP   ;TRY TO MOVE SP
F219   44                     LD   B,H   
F21A   4D                     LD   C,L   
F21B   21 0A 00               LD   HL,000AH   
F21E   19                     ADD   HL,DE   
F21F   CD 44 F6               CALL   MVDOWN   ;AND PURGE 10 WORDS
F222   F9                     LD   SP,HL   ;IN THE STACK
F223                FR8:         
F223   2A D1 17               LD   HL,(LOPPT)   ;JOB DONE, RESTORE DE
F226   EB                     EX   DE,HL   
F227   CD CD EF               CALL   RST30TB   ;AND CONTINUE
F22A                             ; 
F22A                NEXT:        
F22A   CD D4 EF               CALL   RST38TB   ;GET ADDRESS OF VAR.
F22D   DA CD F4               JP   C,QWHAT   ;NO VARIABLE, "WHAT?"
F230   22 C5 17               LD   (VARNXT),HL   ;YES, SAVE IT
F233                NX0:         
F233   D5                     PUSH   DE   ;SAVE TEXT POINTER
F234   EB                     EX   DE,HL   
F235   2A C9 17               LD   HL,(LOPVAR)   ;GET VAR. IN "FOR"
F238   7C                     LD   A,H   
F239   B5                     OR   L   ;0 SAYS NEVER HAD ONE
F23A   CA CE F4               JP   Z,AWHAT   ;SO WE ASK: "WHAT?"
F23D   CD C0 EF               CALL   RST20TB   ;ELSE WE CHECK THEM
F240   28 09                  JR   Z,NX3   ;OK, THEY AGREE
F242   D1                     POP   DE   ;NO, LET'S SEE
F243   CD 52 F6               CALL   POPA   ;PURGE CURRENT LOOP
F246   2A C5 17               LD   HL,(VARNXT)   ;AND POP ONE LEVEL
F249   18 E8                  JR   NX0   ;GO CHECK AGAIN
F24B                NX3:         
F24B   5E                     LD   E,(HL)   ;COME HERE WHEN AGREED
F24C   23                     INC   HL   
F24D   56                     LD   D,(HL)   ;DE=VALUE OF VAR.
F24E   2A CB 17               LD   HL,(LOPINC)   
F251   E5                     PUSH   HL   
F252   7C                     LD   A,H   
F253   AA                     XOR   D   
F254   7A                     LD   A,D   
F255   19                     ADD   HL,DE   ;ADD ONE STEP
F256   FA 5D F2               JP   M,NX4   
F259   AC                     XOR   H   
F25A   FA 80 F2               JP   M,NX5   
F25D                NX4:         
F25D   EB                     EX   DE,HL   
F25E   2A C9 17               LD   HL,(LOPVAR)   ;PUT IT BACK
F261   73                     LD   (HL),E   
F262   23                     INC   HL   
F263   72                     LD   (HL),D   
F264   2A CD 17               LD   HL,(LOPLMT)   ;HL->LIMIT
F267   F1                     POP   AF   ;OLD HL
F268   B7                     OR   A   
F269   F2 6D F2               JP   P,NX1   ;STEP > 0
F26C   EB                     EX   DE,HL   ;STEP < 0
F26D                NX1:         
F26D   CD 92 F4               CALL   CKHLDE   ;COMPARE WITH LIMIT
F270   D1                     POP   DE   ;RESTORE TEXT POINTER
F271   38 0F                  JR   C,NX2   ;OUTSIDE LIMIT
F273   2A CF 17               LD   HL,(LOPLN)   ;WITHIN LIMIT, GO
F276   22 C1 17               LD   (CURRNT),HL   ;BACK TO THE SAVED
F279   2A D1 17               LD   HL,(LOPPT)   ;"CURRNT" AND TEXT
F27C   EB                     EX   DE,HL   ;POINTER
F27D   CD CD EF               CALL   RST30TB   
F280                NX5:         
F280   E1                     POP   HL   
F281   D1                     POP   DE   
F282                NX2:         
F282   CD 52 F6               CALL   POPA   ;PURGE THIS LOOP
F285   CD CD EF               CALL   RST30TB   
F288                             ;*************************************************************
F288                             ; 
F288                             ; *** REM *** IF *** INPUT *** & LET (& DEFLT) ***
F288                             ; 
F288                             ; "REM" CAN BE FOLLOWED BY ANYTHING AND IS IGNORED BY TBI.
F288                             ; TBI TREATS IT LIKE AN "IF" WITH A FALSE CONDITION.
F288                             ; 
F288                             ; "IF" IS FOLLOWED BY AN EXPR. AS A CONDITION AND ONE OR MORE
F288                             ; COMMANDS (INCLUDING OTHER "IF"S) SEPERATED BY SEMI-COLONS.
F288                             ; NOTE THAT THE WORD "THEN" IS NOT USED.  TBI EVALUATES THE
F288                             ; EXPR. IF IT IS NON-ZERO, EXECUTION CONTINUES.  IF THE
F288                             ; EXPR. IS ZERO, THE COMMANDS THAT FOLLOWS ARE IGNORED AND
F288                             ; EXECUTION CONTINUES AT THE NEXT LINE.
F288                             ; 
F288                             ; "INPUT" COMMAND IS LIKE THE "PRINT" COMMAND, AND IS FOLLOWED
F288                             ; BY A LIST OF ITEMS.  IF THE ITEM IS A STRING IN SINGLE OR
F288                             ; DOUBLE QUOTES, OR IS A UNDERSCORE, IT HAS THE SAME EFFECT AS
F288                             ; IN "PRINT".  IF AN ITEM IS A VARIABLE, THIS VARIABLE NAME IS
F288                             ; PRINTED OUT FOLLOWED BY A COLON.  THEN TBI WAITS FOR AN
F288                             ; EXPR. TO BE TYPED IN.  THE VARIABLE IS THEN SET TO THE
F288                             ; VALUE OF THIS EXPR.  IF THE VARIABLE IS PROCEDED BY A STRING
F288                             ; (AGAIN IN SINGLE OR DOUBLE QUOTES), THE STRING WILL BE
F288                             ; PRINTED FOLLOWED BY A COLON.  TBI THEN WAITS FOR INPUT EXPR.
F288                             ; AND SET THE VARIABLE TO THE VALUE OF THE EXPR.
F288                             ; 
F288                             ; IF THE INPUT EXPR. IS INVALID, TBI WILL PRINT "WHAT?",
F288                             ; "HOW?" OR "SORRY" AND REPRINT THE PROMPT AND REDO THE INPUT.
F288                             ; THE EXECUTION WILL NOT TERMINATE UNLESS YOU TYPE CONTROL-C.
F288                             ; THIS IS HANDLED IN "INPERR".
F288                             ; 
F288                             ; "LET" IS FOLLOWED BY A LIST OF ITEMS SEPERATED BY COMMAS.
F288                             ; EACH ITEM CONSISTS OF A VARIABLE, AN EQUAL SIGN, AND AN EXPR.
F288                             ; TBI EVALUATES THE EXPR. AND SET THE VARIABLE TO THAT VALUE.
F288                             ; TBI WILL ALSO HANDLE "LET" COMMAND WITHOUT THE WORD "LET".
F288                             ; THIS IS DONE BY "DEFLT".
F288                             ;*************************************************************
F288                REM:         
F288   21 00 00               LD   HL,0000H   ;*** REM ***
F28B   18 03                  JR   IF1   
F28D                IFF:         
F28D   CD B9 EF               CALL   RST18TB   ;*** IF ***
F290                IF1:         
F290   7C                     LD   A,H   ;IS THE EXPR.=0?
F291   B5                     OR   L   
F292   C2 F7 F0               JP   NZ,RUNSML   ;NO, CONTINUE
F295   CD 5C F5               CALL   FNDSKP   ;YES, SKIP REST OF LINE
F298   D2 F0 F0               JP   NC,RUNTSL   ;AND RUN THE NEXT LINE
F29B   C3 54 F0               JP   RSTART   ;IF NO NEXT, RE-START
F29E                INPERR:      
F29E   2A C7 17               LD   HL,(STKINP)   ;*** INPERR ***
F2A1   F9                     LD   SP,HL   ;RESTORE OLD SP
F2A2   E1                     POP   HL   ;AND OLD "CURRNT"
F2A3   22 C1 17               LD   (CURRNT),HL   
F2A6   D1                     POP   DE   ;AND OLD TEXT POINTER
F2A7   D1                     POP   DE   ;REDO INPUT
F2A8                INPUT:       ;*** INPUT ***
F2A8                IP1:         
F2A8   D5                     PUSH   DE   ;SAVE IN CASE OF ERROR
F2A9   CD 8A F5               CALL   QTSTG   ;IS NEXT ITEM A STRING?
F2AC   18 07                  JR   IP2   ;NO
F2AE   CD D4 EF               CALL   RST38TB   ;YES, BUT FOLLOWED BY A
F2B1   38 40                  JR   C,IP4   ;VARIABLE? NO.
F2B3   18 12                  JR   IP3   ;YES. INPUT VARIABLE
F2B5                IP2:         
F2B5   D5                     PUSH   DE   ;SAVE FOR "PRTSTG"
F2B6   CD D4 EF               CALL   RST38TB   ;MUST BE VARIABLE NOW
F2B9   DA CD F4               JP   C,QWHAT   ;"WHAT?" IT IS NOT?
F2BC   1A                     LD   A,(DE)   ;GET READY FOR "PRTSTR"
F2BD   4F                     LD   C,A   
F2BE   97                     SUB   A   
F2BF   12                     LD   (DE),A   
F2C0   D1                     POP   DE   
F2C1   CD 64 F5               CALL   PRTSTG   ;PRINT STRING AS PROMPT
F2C4   79                     LD   A,C   ;RESTORE TEXT
F2C5   1B                     DEC   DE   
F2C6   12                     LD   (DE),A   
F2C7                IP3:         
F2C7   D5                     PUSH   DE   ;SAVE TEXT POINTER
F2C8   EB                     EX   DE,HL   
F2C9   2A C1 17               LD   HL,(CURRNT)   ;ALSO SAVE "CURRNT"
F2CC   E5                     PUSH   HL   
F2CD   21 A8 F2               LD   HL,IP1   ;A NEGATIVE NUMBER
F2D0   22 C1 17               LD   (CURRNT),HL   ;AS A FLAG
F2D3   21 00 00               LD   HL,0000H   ;SAVE SP TOO
F2D6   39                     ADD   HL,SP   
F2D7   22 C7 17               LD   (STKINP),HL   
F2DA   D5                     PUSH   DE   ;OLD HL
F2DB   3E 3A                  LD   A,3AH   ;PRINT THIS TOO
F2DD   CD 02 F5               CALL   GETLN   ;AND GET A LINE
F2E0   11 37 3E               LD   DE,BUFFER   ;POINTS TO BUFFER
F2E3   CD B9 EF               CALL   RST18TB   ;EVALUATE INPUT
F2E6   00                     NOP      ;CAN BE "CALL ENDCHK"
F2E7   00                     NOP      
F2E8   00                     NOP      
F2E9   D1                     POP   DE   ;OK,GET OLD HL
F2EA   EB                     EX   DE,HL   
F2EB   73                     LD   (HL),E   ;SAVE VALUE IN VAR.
F2EC   23                     INC   HL   
F2ED   72                     LD   (HL),D   
F2EE   E1                     POP   HL   ;GET OLD "CURRNT"
F2EF   22 C1 17               LD   (CURRNT),HL   
F2F2   D1                     POP   DE   ;AND OLD TEXT POINTER
F2F3                IP4:         
F2F3   F1                     POP   AF   ;PURGE JUNK IN STACK
F2F4   CD A7 EF               CALL   RST08TB   ;IS NEXT CH. ","?
F2F7   2C                     DB   ","   
F2F8   02                     DB   IP5-$-1   
F2F9   18 AD                  JR   IP1   ;YES, MORE ITEMS.
F2FB                IP5:         
F2FB   CD CD EF               CALL   RST30TB   
F2FE                DEFLT:       
F2FE   1A                     LD   A,(DE)   ;***  DEFLT ***
F2FF   FE 0D                  CP   CR   ;EMPTY LINE IS OK
F301   28 0A                  JR   Z,LT1   ;ELSE IT IS "LET"
F303                LET:         
F303   CD 9B F4               CALL   SETVAL   ;*** LET ***
F306   CD A7 EF               CALL   RST08TB   ;SET VALUE TO VAR
F309   2C                     DB   ","   ;IS NEXT CH. ","?
F30A   02                     DB   LT1-$-1   
F30B   18 F6                  JR   LET   ;ITEM BY ITEM
F30D                LT1:         
F30D   CD CD EF               CALL   RST30TB   ;UNTIL FINISH
F310                             ;*************************************************************
F310                             ; 
F310                             ; *** EXPR ***
F310                             ; 
F310                             ; "EXPR" EVALUATES ARITHMETICAL OR LOGICAL EXPRESSIONS.
F310                             ; <EXPR>::<EXPR2>
F310                             ;         <EXPR2><REL.OP.><EXPR2>
F310                             ; WHERE <REL.OP.> IS ONE OF THE OPERATORS IN TAB8 AND THE
F310                             ; RESULT OF THESE OPERATIONS IS 1 IF TRUE AND 0 IF FALSE.
F310                             ; <EXPR2>::=(+ OR -)<EXPR3>(+ OR -<EXPR3>)(....)
F310                             ; WHERE () ARE OPTIONAL AND (....) ARE OPTIONAL REPEATS.
F310                             ; <EXPR3>::=<EXPR4>(* OR /)<EXPR4>(....)
F310                             ; <EXPR4>::=<VARIABLE>
F310                             ;           <FUNCTION>
F310                             ;           (<EXPR>)
F310                             ; <EXPR> IS RECURSIVE SO THAT VARIABLE "@" CAN HAVE AN <EXPR>
F310                             ; AS INDEX, FUNCTIONS CAN HAVE AN <EXPR> AS ARGUMENTS, AND
F310                             ; <EXPR4> CAN BE AN <EXPR> IN PARANTHESE.
F310                             ;*************************************************************
F310                EXPR1:       
F310   21 D4 F7               LD   HL,TAB8-1   ;LOOKUP REL.OP.
F313   C3 EE F7               JP   EXEC   ;GO DO IT
F316                XP11:        
F316   CD 3F F3               CALL   XP18   ;REL.OP.">="
F319   D8                     RET   C   ;NO, RETURN HL=0
F31A   6F                     LD   L,A   ;YES, RETURN HL=1
F31B   C9                     RET      
F31C                XP12:        
F31C   CD 3F F3               CALL   XP18   ;REL.OP."#"
F31F   C8                     RET   Z   ;FALSE, RETURN HL=0
F320   6F                     LD   L,A   ;TRUE, RETURN HL=1
F321   C9                     RET      
F322                XP13:        
F322   CD 3F F3               CALL   XP18   ;REL.OP.">"
F325   C8                     RET   Z   ;FALSE
F326   D8                     RET   C   ;ALSO FALSE, HL=0
F327   6F                     LD   L,A   ;TRUE, HL=1
F328   C9                     RET      
F329                XP14:        
F329   CD 3F F3               CALL   XP18   ;REL.OP."<="
F32C   6F                     LD   L,A   ;SET HL=1
F32D   C8                     RET   Z   ;REL. TRUE, RETURN
F32E   D8                     RET   C   
F32F   6C                     LD   L,H   ;ELSE SET HL=0
F330   C9                     RET      
F331                XP15:        
F331   CD 3F F3               CALL   XP18   ;REL.OP."="
F334   C0                     RET   NZ   ;FALSE, RETURN HL=0
F335   6F                     LD   L,A   ;ELSE SET HL=1
F336   C9                     RET      
F337                XP16:        
F337   CD 3F F3               CALL   XP18   ;REL.OP."<"
F33A   D0                     RET   NC   ;FALSE, RETURN HL=0
F33B   6F                     LD   L,A   ;ELSE SET HL=1
F33C   C9                     RET      
F33D                XP17:        
F33D   E1                     POP   HL   ;NOT .REL.OP
F33E   C9                     RET      ;RETURN HL=<EXPR2>
F33F                XP18:        
F33F   79                     LD   A,C   ;SUBROUTINE FOR ALL
F340   E1                     POP   HL   ;REL.OP.'S
