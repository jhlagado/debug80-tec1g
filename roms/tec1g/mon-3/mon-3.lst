F394   2A                     DB   "*"   
F395   29                     DB   XP34-$-1   
F396   E5                     PUSH   HL   ;YES, SAVE 1ST
F397   CD ED F3               CALL   EXPR4   ;AND GET 2ND <EXPR4>
F39A   06 00                  LD   B,00H   ;CLEAR B FOR SIGN
