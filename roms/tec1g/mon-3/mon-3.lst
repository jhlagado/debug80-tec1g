F3BF                XP34:        
F3BF   CD A7 EF               CALL   RST08TB   ;DIVIDE?
F3C2   2F                     DB   "/"   
F3C3   4C                     DB   XP42-$-1   
F3C4   E5                     PUSH   HL   ;YES, SAVE 1ST <EXPR4>
F3C5   CD ED F3               CALL   EXPR4   ;AND GET THE SECOND ONE
F3C8   06 00                  LD   B,00H   ;CLEAR B FOR SIGN
F3CA   CD 7A F4               CALL   CHKSGN   ;CHECK SIGN OF 2ND
F3CD   E3                     EX   (SP),HL   ;GET 1ST IN HL
F3CE   CD 7A F4               CALL   CHKSGN   ;CHECK SIGN OF 1ST
F3D1   EB                     EX   DE,HL   
F3D2   E3                     EX   (SP),HL   
F3D3   EB                     EX   DE,HL   
F3D4   7A                     LD   A,D   ;DIVIDE BY 0?
F3D5   B3                     OR   E   
F3D6   CA 3A F0               JP   Z,AHOW   ;SAY "HOW?"
F3D9   C5                     PUSH   BC   ;ELSE SAVE SIGN
F3DA   CD 5E F4               CALL   DIVIDE   ;USE SUBROUTINE
F3DD   60                     LD   H,B   ;RESULT IN HL NOW
F3DE   69                     LD   L,C   
F3DF   C1                     POP   BC   ;GET SIGN BACK
F3E0                XP35:        
