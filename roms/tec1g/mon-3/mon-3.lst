0000                             ; MONITOR 3 for the TEC-1G
0000                             ; ------------------------
0000                             ;  _______ ______ _____     __  _____   __  __  ____  _   _ ____
0000                             ; |__   __|  ____/ ____|   /_ |/ ____| |  \/  |/ __ \| \ | |___ \
0000                             ;    | |  | |__ | |   ______| | |  __  | \  / | |  | |  \| | __) |
0000                             ;    | |  |  __|| |  |______| | | |_ | | |\/| | |  | | . ` ||__ <
0000                             ;    | |  | |___| |____     | | |__| | | |  | | |__| | |\  |___) |
0000                             ;    |_|  |______\_____|    |_|\_____| |_|  |_|\____/|_| \_|____/
0000                             ;                 Coding by Brian Chiha, Oct-2023
0000                             ; 
0000                             ; With help from Craig Hart, Mark Jelic, Ian McLean and James Elphick
0000                             ; 
0000                             ; Constants
0000                             ; ---------
0000                             ; Ports
0000                KEYB:     EQU   00H   ;Keyboard
0000                DIGITS:   EQU   01H   ;Seven Segment Digits
0000                SEGS:     EQU   02H   ;Seven Segment Display
0000                SYS_INPUT:   EQU   03H   ;System Input
0000                LCD_INST:   EQU   04H   ;LCD Instruction
0000                LCD_DATA:   EQU   84H   ;LCD Data
0000                LED8X8H:   EQU   05H   ;LED 8x8 Horizontal
0000                LED8X8V:   EQU   06H   ;LED 8x8 Vertical
0000                GLCD_INST:   EQU   07H   ;Graphics LCD Instruction
0000                GLCD_DATA:   EQU   87H   ;Graphics LCD Data
0000                SDIO:     EQU   0FDH   ;SD Card IO
0000                MATRIX:   EQU   0FEH   ;QWERTY Keyboard Matrix
0000                SYS_CTRL:   EQU   0FFH   ;System Control
0000                             ; 
0000                             ; SYSCTRL  port bits
0000                SHADOW:   EQU   01H   ;Shadow ROM
0000                PROTECT:   EQU   02H   ;Memory Protect
0000                EXPAND:   EQU   04H   ;Expand
0000                CART:     EQU   10H   ;Cartridge
0000                CAPSLOCK:   EQU   80H   ;Caps lock for Keyboard
0000                             ; 
0000                             ; Monitor Control Bit
0000                             ;MCB = Bits 0,1 = Data Nibbles Entered
0000                             ;      Bit 2 = Address=H/Data=L mode
0000                             ;      Bit 3 = LCD=H/Segment=L mode
0000                             ;      Bit 4 = Disassembler View=H/Data Entry View=L mode (for segment mode only)
0000                             ;      Bit 5 = Menu=L/Parameter=H Format for Menu handler (for LCD mode only)
0000                             ;      Bit 6 = RTC Add-On Present=H
0000                             ;      Bit 7 = SD Card Add-On Present=H (not implemented yet)
0000                MCB_AD_DATA:   EQU   04H   ;Address=H/Data=L mode
0000                MCB_LCD_SEG:   EQU   08H   ;LCD=H/Segment=L mode
0000                MCB_DIS_DE:   EQU   10H   ;Disassembler View=H/Data Entry View=L mode
0000                MCB_MEN_PAR:   EQU   20H   ;Menu=L/Parameter=H Format for Menu handler
0000                MCB_RTC:   EQU   40H   ;RTC Add-On Present=H
0000                MCB_SD_CARD:   EQU   80H   ;SD Card Add-On Present=H
0000                             ; 
0000                             ; Serial Constants Delay
0000                BAUD:     EQU   1BH   ;BAUD 4800 Delay
0000                             ;BAUD:       .equ    0BH         ;BAUD 9600 Delay
0000                CR:       EQU   0DH   ;Carriage Return
0000                LF:       EQU   0AH   ;Line Feed
0000                SPACE:    EQU   " "   ;Space
0000                COLON:    EQU   ":"   ;Colon
0000                             ; 
0000                             ; Keyboard reference
0000                K_FN:     EQU   02H   ;Fn key on Keyboard Matrix
0000                K_PLUS:   EQU   10H   ;+ Key
0000                K_MINUS:   EQU   11H   ;- Key
0000                K_GO:     EQU   12H   ;GO Key
0000                K_ADDR:   EQU   13H   ;Address Key
0000                             ; 
0000                             ; Constants
0000                KEY_SPEED:   EQU   20H   ;Speed of auto repeat press (lower=faster)
0000                USER_ADDR:   EQU   4000H   ;User starting address
0000                BASE_ADDR:   EQU   0C000H   ;Start Address of monitor
0000                LCD_ROW1:   EQU   80H   ;LCD Row 1, Column 1
0000                LCD_ROW2:   EQU   0C0H   ;LCD Row 2, Column 1
0000                LCD_ROW3:   EQU   94H   ;LCD Row 3, Column 1
0000                LCD_ROW4:   EQU   0D4H   ;LCD Row 4, Column 1
0000                MENU_PTR:   EQU   7EH   ;LCD Right Arrow
0000                             ; 
0000                             ; RAM Locations
0000                MON_RAM:   EQU   0800H   ;Monitor RAM start
0000                STACK_SIZE:   EQU   80H   ;128 Bytes
0000                STACK_TOP:   EQU   MON_RAM+STACK_SIZE   
0000                TOP_RAM:   EQU   7FFFH   ;Highest RAM location (no expansion)
0000                             ; 
0000                ROMSIG:   EQU   MON_RAM   ;16 byte buffer holding the ROM signature; used for cold start detection
0000                             ; 
0000                             ; Monitor Configuration and display data
0000                DISP_BUFF:   EQU   STACK_TOP   ;Display Buffer for Segments
0000                DISP_DATA:   EQU   STACK_TOP+4   ;Display Buffer Data for Segments
0000                CEL:      EQU   STACK_TOP+6   ;Current Editing location
0000                MCB:      EQU   STACK_TOP+8   ;Monitor Control Byte
0000                KEY_BUFF:   EQU   STACK_TOP+9   ;Keypress Buffer
0000                KEY_PRESS:   EQU   STACK_TOP+10   ;Keypress Flag
0000                KEY_AUTO:   EQU   STACK_TOP+11   ;Key Auto Increment Flag
0000                KEY_REPEAT:   EQU   STACK_TOP+12   ;Key Auto Repeat timer
0000                KEY_BEEP:   EQU   STACK_TOP+13   ;Keypress Beep flag
0000                KEY_SECOND:   EQU   STACK_TOP+14   ;Matrix Keyboard second key Buffer
0000                GLCD_TERM:   EQU   STACK_TOP+15   ;GLCD Terminal Enable Flag
0000                DIS_ADDR:   EQU   STACK_TOP+16   ;Base Disassembler/Editing address
0000                USER_INT:   EQU   STACK_TOP+18   ;User defined INT routine
0000                USER_NMI:   EQU   STACK_TOP+20   ;User defined NMI routine
0000                MENU_POS:   EQU   STACK_TOP+22   ;Menu listing position
0000                MENU_SEL:   EQU   STACK_TOP+23   ;Menu pointer seletion
0000                MENU_CNT:   EQU   STACK_TOP+24   ;Menu listing count
0000                MENU_CFG:   EQU   STACK_TOP+25   ;Menu configuration address
0000                MENU_IDX:   EQU   STACK_TOP+27   ;Menu depth index
0000                CAPS_LOCK:   EQU   STACK_TOP+28   ;Caps Lock Flag
0000                SYS_MODE:   EQU   STACK_TOP+29   ;SYS_CTRL current monitor state
0000                PROT_MODE:   EQU   STACK_TOP+30   ;Use Protect at GO
0000                XPND_MODE:   EQU   STACK_TOP+31   ;Expand Mode
0000                             ; 
0000                             ; Free Monitor RAM area for specific functions (08A0H).  Areas can overlap
0000                MON_FRAM:   EQU   STACK_TOP+32   ;Free Monitor RAM Starts Here
0000                             ; 
0000                             ; Parameter Base Address.  All parameters are two bytes long from this address
0000                PARAM_DATA:   EQU   MON_FRAM+32   ;Start of Parameter storage (08C0H)
0000                             ; 
0000                             ; ASCII string for data entry area  ;IE "4000: 23 34 45 56 78"
0000                DATA_BASE:   EQU   MON_FRAM   ;Base address for Data view (08A0H)
0000                DATA_ROW:   EQU   DATA_BASE+96   ;Start of ASCII data entry string (0900H)
0000                             ; 
0000                             ; Current Editing Location Quick Jump locations
0000                CEL_QJMP:   EQU   MON_FRAM+2   ;Location 1,2, and 3 (08A2H,08A4H,08A6H)
0000                             ; 
0000                             ; Menu depth pointers to remember nested menus
0000                MENU_CFG_D:   EQU   MON_FRAM+8   ;Menu Config. depth (08A8H,08AAH,08ACH,08AEH) 
0000                             ; 
0000                             ; RNG Seed
0000                RNG_SEED:   EQU   MON_FRAM+16   ;Random Number Seed (08B0H)
0000                             ; 
0000                             ; RAM for Smart Copy
0000                COPY_START:   EQU   PARAM_DATA   ;Start (08C0H)
0000                COPY_END:   EQU   COPY_START+2   ;End
0000                COPY_DEST:   EQU   COPY_START+4   ;Destination
0000                COPY_PTR:   EQU   COPY_START+6   ;Pointer
0000                COPY_EBLK:   EQU   COPY_START+8   ;End Block
0000                COPY_CORR:   EQU   COPY_START+10   ;Correction
0000                REST_START:   EQU   COPY_START+12   ;Restore Start
0000                REST_END:   EQU   COPY_START+14   ;Restore End
0000                REST_DEST:   EQU   COPY_START+16   ;Restore Destination
0000                TEMP_START:   EQU   COPY_START+18   ;Temporaly Start
0000                TEMP_END:   EQU   COPY_START+20   ;Temporaly End
0000                TEMP_DEST:   EQU   COPY_START+22   ;Temporaly Destination
0000                             ; 
0000                             ; RAM for To/From Addresses
0000                DATA_FROM:   EQU   PARAM_DATA   ;From (08C0H)
0000                DATA_TO:   EQU   DATA_FROM+2   ;To
0000                             ; 
0000                             ; Breakpoint regsiter save area.
0000                BP_BASE_SP:   EQU   MON_FRAM+96   ;Start of Register save area (0900H)   
0000                BP_HL:    EQU   BP_BASE_SP+2   ;HL position in BP stack
0000                BP_REGS:   EQU   BP_BASE_SP+20   ;Top of Stack (Goes down towards MON_RAM)
0000                BP_PC:    EQU   BP_BASE_SP+20   ;Calling Program Counter
0000                BP_ORIG_SP:   EQU   BP_BASE_SP+22   ;Original hardware stack pointer
0000                BP_LCD:   EQU   BP_BASE_SP+24   ;LCD Screen Buffer (20x4 or 80 bytes)
0000                             ; 
0000                             ; -----------------------------------------------------------------------------
0000                             ; CODE start here, with code running at 0000H
0000                             ; -----------------------------------------------------------------------------
0000                             ; 
C000                          .ORG   BASE_ADDR   
C000                BOOT:        
C000   C3 00 C1               JP   preInit   
C003                             ; 
C008                          .ORG   BASE_ADDR+08H   
C008                RST08:       ;Key Read and Wait for key release.  (Halt simulation)
C008                             ;Output: A = Key pressed
C008   C3 35 C6               JP   scanKeysWait   ;Wait and Scan key routine
C00B                             ; 
C010                          .ORG   BASE_ADDR+10H   
C010                RST10:       ;API Call Entry
C010   C3 70 00               JP   APICall-BASE_ADDR   ;API Call routine
C013                             ; 
C018                          .ORG   BASE_ADDR+18H   
C018                RST18:       ;API Call 2 Entry
C018   C3 40 00               JP   APICall2-BASE_ADDR   ;API Call 2 routine
C01B                             ; 
C020                          .ORG   BASE_ADDR+20H   
C020                RST20:       ;Scan Segments and Keyboard.  Must be called constantly
C020                             ;Input: DE = Pointer to LCD Segment code (Must be 6 bytes)
C020                             ;Output: A = Key pressed if Zero flag is set
C020   CD 4A C5               CALL   scanSegments   ;Multiplex the seven segments
C023   CD B0 C5               CALL   scanKeys   ;Scan for key press
C026                             ; 
C028                          .ORG   BASE_ADDR+28H   
C028                RST28:       ;LCD Busy
C028   F5                     PUSH   af   ;save af
C029                BUSYLOOP:      
C029   DB 04                  IN   a,(LCD_INST)   ;Read status bit on LCD
C02B   07                     RLCA      ;put bit 7 (status) in carry
C02C   38 FB                  JR   c,busyLoop   ;loop if LCD is busy
C02E   F1                     POP   af   ;restore af
C02F   C9                     RET      
C030                             ; 
C030                          .ORG   BASE_ADDR+30H   
C030                RST30:       ;Breakpoint Entry
C030   E3                     EX   (sp),hl   ;get return address
C031   22 14 09               LD   (BP_PC),hl   ;save it
C034   E3                     EX   (sp),hl   ;fix stack
C035   C3 59 CC               JP   breakPoint   
C038                             ; 
C038                          .ORG   BASE_ADDR+38H   
C038                RST38:       
C038   E5                     PUSH   hl   ;save HL
C039   2A 92 08               LD   hl,(USER_INT)   ;get address at USER_INT
C03C   E3                     EX   (sp),hl   ;restore HL and put INT routine on stack
C03D   C9                     RET      
C03E                             ; 
C040                          .ORG   BASE_ADDR+40H   
C040                             ;API Call Routine
C040                             ; Input:   A = Function index
C040                             ;          BC, DE, HL = Parameters if needed
C040                             ; Corrupt: IX
C040                APICALL2:      
C040   FE 1F                  CP   API_COUNT2/2   ;Adjust for real count
C042   38 03                  JR   c,APIGood2   
C044   C3 0D CC               JP   displayError   ;exit with Error Message
C047                APIGOOD2:      
C047   C5                     PUSH   bc   ;save BC
C048   E5                     PUSH   hl   ;save HL
C049   21 00 D7               LD   hl,APITable2   ;API Funciton Table
C04C   87                     ADD   a,a   ;double it
C04D   4F                     LD   c,a   ;store index in
C04E   06 00                  LD   b,0   ;bc
C050   09                     ADD   hl,bc   ;index table
C051   7E                     LD   a,(hl)   ;store jump
C052   23                     INC   hl   ;address
C053   66                     LD   h,(hl)   ;back into
C054   6F                     LD   l,a   ;HL
C055   E5                     PUSH   hl   ;IX = HL
C056   DD E1                  POP   ix   
C058   E1                     POP   hl   ;restore HL
C059   C1                     POP   bc   ;restore BC
C05A   DD E9                  JP   (ix)   ;Jump to API Routine
C05C                             ; 
C066                          .ORG   BASE_ADDR+66H   
C066                NMI:         
C066   E5                     PUSH   hl   ;save HL
C067   2A 94 08               LD   hl,(USER_NMI)   ;get address at USER_NMI
C06A   E3                     EX   (sp),hl   ;restore HL and put INT routine on stack
C06B   C9                     RET      
C06C                             ; 
C070                          .ORG   BASE_ADDR+70H   
C070                             ;API Call Routine
C070                             ; Input:   C = Function index
C070                             ;          A, B, DE, HL = Parameters if needed
C070                             ; Corrupt: IX
C070                APICALL:      
C070   F5                     PUSH   af   ;save AF
C071   79                     LD   a,c   ;Check index is within range
C072   FE 3A                  CP   API_COUNT/2   ;Adjust for real count
C074   38 04                  JR   c,APIGood   
C076   F1                     POP   af   ;restore AF
C077   C3 0D CC               JP   displayError   ;exit with Error Message
C07A                APIGOOD:      
C07A   C5                     PUSH   bc   ;save BC
C07B   E5                     PUSH   hl   ;save HL
C07C   21 00 D6               LD   hl,APITable   ;API Funciton Table
C07F   87                     ADD   a,a   ;double it
C080   4F                     LD   c,a   ;store index in
C081   06 00                  LD   b,0   ;bc
C083   09                     ADD   hl,bc   ;index table
C084   7E                     LD   a,(hl)   ;store jump
C085   23                     INC   hl   ;address
C086   66                     LD   h,(hl)   ;back into
C087   6F                     LD   l,a   ;HL
C088   E5                     PUSH   hl   ;IX = HL
C089   DD E1                  POP   ix   
C08B   E1                     POP   hl   ;restore HL
C08C   C1                     POP   bc   ;restore BC
C08D   F1                     POP   af   ;restore AF
C08E   DD E9                  JP   (ix)   ;Jump to API Routine
C090                             ; 
C090                             ; Restart Handler (temp)
C090                RESTARTHANDLE:      
C090   C9                     RET      
C091                             ; 
C091                             ;Interrupt Handler Stub (just return)
C091                INTHANDLER:      
C091   ED 4D                  RETI      ;Exit cleanly
C093                             ; 
C093                             ;NMI Handler Stub (just return)
C093                NMIHANDLER:      
C093   ED 45                  RETN      ;Exit cleanly
C095                             ; 
C095                             ; 
C095                             ; -----------------------------------------------------------------------------
C095                             ; CODE running in ROM proper, at C000H upwards
C095                             ; -----------------------------------------------------------------------------
C095                             ; 
C100                          .ORG   BASE_ADDR+100H   
C100                             ; 
C100                PREINIT:      
C100   31 80 08               LD   sp,STACK_TOP   ;Set the Hardware Stack to top of stack in RAM
C103   21 00 40               LD   hl,4000H   ;Long delay to ensure reset of latches are complete
C106   CD E2 C6               CALL   timeDelay   
C109   AF                     XOR   a   ;Blank the 8x8 display to prevent LED burnout
C10A   D3 05                  OUT   (LED8X8H),a   
C10C   D3 06                  OUT   (LED8X8V),a   
C10E   3E 05                  LD   a,05H   ;Set SD Card to Idle; turns off activity LED
C110   D3 FD                  OUT   (SDIO),a   
C112   DB 03                  IN   a,(SYS_INPUT)   ;Check for CART presence
C114   47                     LD   b,a   
C115   E6 10                  AND   CART   ;Check bit 4
C117   C2 00 80               JP   nz,08000H   ;Launch CARTridge code if CART present
C11A   78                     LD   a,b   ;Honor PROTECT bit
C11B   E6 02                  AND   PROTECT   
C11D   32 9E 08               LD   (PROT_MODE),a   
C120   3A 9F 08               LD   a,(XPND_MODE)   
C123   E6 04                  AND   EXPAND   
C125   4F                     LD   c,a   
C126   3A 9C 08               LD   a,(CAPS_LOCK)   
C129   E6 80                  AND   CAPSLOCK   
C12B   81                     ADD   a,c   
C12C   06 01                  LD   b,SHADOW   ;Force Shadow mode OFF
C12E   80                     ADD   a,b   
C12F   D3 FF                  OUT   (SYS_CTRL),a   
C131   32 9D 08               LD   (SYS_MODE),a   ;Update MONitors idea of the config
C134   3A 9D 08               LD   a,(SYS_MODE)   ;Is shadow disabled ? (should be yes it is)
C137   E6 01                  AND   SHADOW   
C139   28 0B                  JR   z,hardBoot   ;if enabled, skip memcopy
C13B   21 00 C0               LD   hl,0C000H   ;copy bottom 256 bytes of ROM to RAM at 0000
C13E   11 00 00               LD   de,0000H   ;so RST vectors etc. are in RAM now
C141   01 00 01               LD   bc,0100H   
C144   ED B0                  LDIR      
C146                             ; 
C146                             ;Place initialisation routines here.  MemCheck, RAM defaults
C146                HARDBOOT:      
C146   CD 82 C5               CALL   LCDinitialise   ;reset LCD Screen always on reset
C149   21 00 40               LD   hl,USER_ADDR   ;fixup edit location for startup
C14C   22 86 08               LD   (CEL),hl   
C14F   22 A0 08               LD   (DATA_BASE),hl   ;update base address
C152   DB 00                  IN   a,(KEYB)   ;Check for Fn key press when RESET key is released
C154   E6 20                  AND   20H   ;Check bit 5
C156   28 1D                  JR   z,hardInit   ;Fn Key pressed, do a hard initialise
C158   DB 03                  IN   a,(SYS_INPUT)   ;read simp buffer for keyboard input type
C15A   0F                     RRCA      ;check bit 0
C15B   30 0A                  JR   nc,skipMatrix   ;if set, matrix keyboard in use
C15D   CD 1F CC               CALL   matrixScan   
C160   20 05                  JR   nz,$+7   ;no key pressed, skip hard init       
C162   7B                     LD   a,e   ;grab first key pressed
C163   FE 02                  CP   K_FN   ;is it the FN key?
C165   28 0E                  JR   z,hardInit   ;Fn Key pressed, do a hard initialise
C167                SKIPMATRIX:      
C167                             ;Look for hard reset flag
C167   21 F0 FF               LD   hl,SOFTWARE   
C16A   11 00 08               LD   de,ROMSIG   
C16D   06 10                  LD   b,10H   
C16F   CD 76 C8               CALL   stringCompare   
C172   CA D4 C1               JP   z,preSoftBoot   ;Yes, just softboot
C175                HARDINIT:      
C175                             ;Honour Expand
C175   DB 03                  IN   a,(SYS_INPUT)   ;read simp buffer for real expand bit
C177   CD DE CF               CALL   setExpand   ;honor EXPAND bit
C17A                             ;Set Capslock to OFF
C17A   AF                     XOR   a   ;A = 0
C17B   CD A5 CF               CALL   setCaps   ;set caps lock flag
C17E                             ;Copy ROMSTR into RAM - warm boot flag
C17E   21 F0 FF               LD   hl,SOFTWARE   
C181   11 00 08               LD   de,ROMSIG   
C184   01 10 00               LD   bc,10H   
C187   ED B0                  LDIR      
C189                             ;Default monitor RAM variables
C189   21 00 D2               LD   hl,defaults   ;Start from MCB
C18C   11 86 08               LD   de,CEL   ;Set to CEL and onwards in RAM
C18F   01 17 00               LD   bc,defaultsSize   ;Load defaultsSize bytes
C192   ED B0                  LDIR      
C194                             ;Check if RTC Add-On is installed
C194   CD C0 F8               CALL   checkDS1302Present   ;Carry set = No RTC
C197   38 12                  JR   c,skipRTC   ;skip RTC config as no RTC Add-on found
C199   21 88 08               LD   hl,MCB   ;set MCB
C19C   CB F6                  SET   6,(hl)   ;bit 6 RTC present
C19E   CD 52 FD               CALL   checkRTCchecksum   ;check if PRAM is not corrupt
C1A1   28 03                  JR   z,$+5   ;all good, skip resetting PRAM
C1A3   CD 24 CE               CALL   resetRTCPRAM   ;reset RTC PRAM
C1A6   CD 6D CE               CALL   RTCFillRAM   ;fill RTC PRAM to Mon3 RAM
C1A9   18 0C                  JR   LCDbanners   
C1AB                SKIPRTC:      
C1AB                             ;Default CEL Jump Table
C1AB   21 00 40               LD   hl,USER_ADDR   ;default to intial CEL
C1AE   22 A2 08               LD   (CEL_QJMP),hl   
C1B1   22 A4 08               LD   (CEL_QJMP+2),hl   
C1B4   22 A6 08               LD   (CEL_QJMP+4),hl   
C1B7                LCDBANNERS:      
C1B7                             ;Display Welcome Message
C1B7   21 61 D3               LD   hl,hardResetMessage   
C1BA   CD 62 C5               CALL   stringToLCD   ;print line to LCD
C1BD                             ;send a welcome message to the Serial Terminal if connected
C1BD   21 29 D3               LD   hl,serialStartup   
C1C0   CD 6B C5               CALL   stringToSerial   
C1C3                             ;send a welcome banner to the GCLD (disabled for now)
C1C3                             ; call initLCD        ;Initialise the GLCD
C1C3                             ; ld c,0              ;first row
C1C3                             ; call printString    ;display text
C1C3                             ; .db 10H," Initialising ",11H,0
C1C3                             ; ld bc,0             ;set cursor to top left
C1C3                             ; call setCursor
C1C3                             ; ld hl,GLCD_BANNER   ;point to welcome banner
C1C3                             ; ld bc,8040H         ;full screen graphic
C1C3                             ; ld d,0
C1C3                             ; call drawGraphic    ;Draw to GLCD buffer
C1C3                             ; ld a,01H
C1C3                             ; out (GLCD_INST),a   ;clear text buffer
C1C3                             ; ld de,0140H         ;1.6 ms
C1C3                             ; call delayMS
C1C3                             ; call setGrMode      ;Set it for graphics mode
C1C3                             ; call plotToLCD      ;Display it
C1C3                             ;play a tone...
C1C3   11 51 D3               LD   de,hardResetTune   ;Set DE to tune data
C1C6   CD F7 EE               CALL   playTune   
C1C9                             ;wait a bit
C1C9   21 EE FE               LD   hl,0FEEEH   ;delay
C1CC   CD E2 C6               CALL   timeDelay   
C1CF                             ;random number seed
C1CF   ED 5F                  LD   a,r   ;get R value
C1D1   32 B0 08               LD   (RNG_SEED),a   ;save it
C1D4                             ;TODO add more here...
C1D4                             ; 
C1D4                PRESOFTBOOT:      
C1D4                             ;get current GLCD Term status
C1D4   CD 8F CF               CALL   getGLCDTerm   ;get flag
C1D7   CD B9 CF               CALL   setGLCDTerm   ;set GLCD status
C1DA                             ;set up initial menu if RESET is pressed
C1DA   21 B2 D3               LD   hl,mainMenuCFG   ;set up 1G Menu
C1DD   CD B8 CE               CALL   menuReset   ;clear menu flags
C1E0   3E FF                  LD   a,0FFH   ;reset menu index
C1E2   32 9B 08               LD   (MENU_IDX),a   ;save it
C1E5   CD 9E CE               CALL   menuInit   
C1E8                             ; 
C1E8                             ;Soft Reset call and fallthrough for Hard Reset and GO return address
C1E8                SOFTBOOT:      
C1E8   31 80 08               LD   sp,STACK_TOP   ;Set the Hardware Stack to top of stack in RAM
C1EB   3A 9D 08               LD   a,(SYS_MODE)   ;reset hardware to MONitor mode
C1EE   D3 FF                  OUT   (SYS_CTRL),a   
C1F0                             ;reset MCB
C1F0   3A 88 08               LD   a,(MCB)   ;Get MCB
C1F3                RESETMCB:      
C1F3   E6 D8                  AND   0D8H   ;Mask out params, nibble and mode bits
C1F5                UPDATEMCB:      
C1F5   32 88 08               LD   (MCB),a   ;Save MCB back
C1F8                             ; 
C1F8                             ;fill display buffer with current editing location
C1F8                SETDISPBUFFER:      
C1F8   CD EB C4               CALL   beep   ;beep the speaker bit
C1FB   ED 5B 86 08            LD   de,(CEL)   ;load DE with current editing location
C1FF   CD 04 C5               CALL   CELToSeg   ;convert CEL and its value to display buffer
C202   CD 25 C5               CALL   setDots   ;set decimal point on segments
C205                             ;update LCD screen
C205                SETLCD:      
C205   CD F3 C3               CALL   updateLCD   ;Update LCD screen (and also DISP_BUFF if LCD)
C208                             ; 
C208                             ;main system loop
C208                MAINLOOP:      
C208   CD 47 C5               CALL   scanDisplayBuff   ;Multiplex the seven segments
C20B   CD B0 C5               CALL   scanKeys   ;Scan for key press
C20E   21 8C 08               LD   hl,KEY_REPEAT   ;get the key repeat timer
C211   28 04                  JR   z,keyDelay   ;key has been pressed
C213   36 00                  LD   (hl),00H   ;reset delay counter
C215   18 F1                  JR   mainLoop   ;loop back to the main loop
C217                KEYDELAY:      
C217   38 05                  JR   c,keyFirst   ;new key press first detection
C219   35                     DEC   (hl)   ;key held, decrease timer
C21A   20 EC                  JR   nz,mainLoop   ;loop back to the main loop if timer is not zero
C21C   36 20                  LD   (hl),KEY_SPEED   ;short timer set for subsequent presses
C21E                KEYFIRST:      
C21E   35                     DEC   (hl)   ;set timer off
C21F                             ;key has been detected handle it
C21F   21 88 08               LD   hl,MCB   ;get the MCB
C222   CB 5E                  BIT   3,(hl)   ;is bit 3 set? LCD/Segment
C224   C2 26 C3               JP   nz,keyProcessLCD   ;yes, process key for LCD
C227                             ; 
C227                             ;process key press for segment data entry (A = key, HL = MCB)
C227                             ;set C=key pressed, B=MCB, HL=CEL
C227                KEYPROCESSSEGS:      
C227   4F                     LD   c,a   ;store key pressed
C228   CB A9                  RES   5,c   ;reset Fn key bit if set
C22A   7E                     LD   a,(HL)   ;get MCB
C22B   47                     LD   b,a   ;save in B
C22C   79                     LD   a,c   ;restore key pressed
C22D   2A 86 08               LD   hl,(CEL)   ;load Current Editing location in HL
C230                KEYPLUS:      
C230   FE 10                  CP   K_PLUS   ;Plus key press
C232   20 0D                  JR   nz,keyMinus   ;no, Check Minus key
C234   CD E3 C3               CALL   checkFnKey   ;check for Function key
C237   CA CD C2               JP   z,fnPlus   ;handle Fn+Plus key
C23A   23                     INC   hl   ;move to next CEL
C23B                UPDATECEL:      
C23B   22 86 08               LD   (CEL),hl   ;save CEL
C23E   78                     LD   a,b   ;get MCB
C23F   18 B2                  JR   resetMCB   ;reset MCB and jump to Main loop
C241                KEYMINUS:      
C241   FE 11                  CP   K_MINUS   ;Minus key press
C243   20 09                  JR   nz,keyAddress   ;no, Check Address key
C245   CD E3 C3               CALL   checkFnKey   ;check for Function key
C248   CA F4 C2               JP   z,fnMinus   ;handle Fn+Minus key
C24B   2B                     DEC   hl   ;move to previous address
C24C   18 ED                  JR   updateCEL   ;update CEL and return
C24E                KEYADDRESS:      
C24E   FE 13                  CP   K_ADDR   ;Address key press
C250   20 0D                  JR   nz,keyGo   ;no, Check Go key
C252   CD E3 C3               CALL   checkFnKey   ;check for Function key
C255   CA 1A C3               JP   z,fnAd   ;handle Fn+AD key
C258   78                     LD   a,b   ;get MCB
C259   EE 04                  XOR   MCB_AD_DATA   ;flip Address/Data bit
C25B   E6 FC                  AND   0FCH   ;clear nibble counter
C25D   18 96                  JR   updateMCB   ;update MCB and jump to Main loop
C25F                KEYGO:       
C25F   FE 12                  CP   K_GO   ;Go key press
C261   20 1F                  JR   nz,keyHex   ;no, Must be Hex key
C263   06 01                  LD   b,01H   ;clear LCD instruction
C265   CD 7B C5               CALL   commandToLCD   ;update LCD
C268   C3 8B C3               JP   lcdRunning   ;display Code running at on LCD
C26B                RUNROUTINE:      
C26B   CD EB C4               CALL   beep   ;indicate key press
C26E   3A 9D 08               LD   a,(SYS_MODE)   ;reset hardware to MONitor mode
C271   47                     LD   b,a   
C272   3A 9E 08               LD   a,(PROT_MODE)   ;enable PROTECT if configured
C275   B0                     OR   b   
C276   D3 FF                  OUT   (SYS_CTRL),a   
C278   3E FF                  LD   a,0FFH   
C27A   32 89 08               LD   (KEY_BUFF),a   ;remove GO from key Buffer to avoid GO held
C27D   11 E8 C1               LD   de,softBoot   ;get return address
C280   D5                     PUSH   de   ;put return address on stack
C281   E9                     JP   (hl)   ;jump to CEL and execute it
C282                KEYHEX:      
C282   78                     LD   a,b   ;get MCB
C283   CB 57                  BIT   2,a   ;check mode Address or Data
C285   20 25                  JR   nz,updateAddress   ;update address
C287   CD E3 C3               CALL   checkFnKey   ;check for Function key
C28A   28 2F                  JR   z,keyFn   ;jump to Function key routine
C28C                             ;update data and set nibble decimal point and auto address increment
C28C   78                     LD   a,b   ;get MCB
C28D   E6 03                  AND   03H   ;mask out to nibble counter
C28F   FE 02                  CP   02H   ;is this the second nibble?
C291   78                     LD   a,b   ;get orginal MCB
C292   20 0E                  JR   nz,enterNibble   ;no, just enter the nibble into (CEL)
C294   F5                     PUSH   af   ;save MCB
C295   3A 8B 08               LD   a,(KEY_AUTO)   ;check for auto address increment flag
C298   B7                     OR   a   ;is it zero?
C299   20 04                  JR   nz,skipAutoInc   ;no, don't update CEL
C29B   23                     INC   hl   ;move to next CEL to enter nibble
C29C   22 86 08               LD   (CEL),hl   ;store it
C29F                SKIPAUTOINC:      
C29F   F1                     POP   af   ;restore MCB
C2A0   E6 FC                  AND   0FCH   ;clear nibble counter
C2A2                ENTERNIBBLE:      
C2A2   3C                     INC   a   ;add one to nibble conter
C2A3   32 88 08               LD   (MCB),a   ;store it
C2A6   79                     LD   a,c   ;get key
C2A7   ED 6F                  RLD      ;shift key into CEL
C2A9   C3 F8 C1               JP   setDispBuffer   ;jump back to main loop
C2AC                             ;update address
C2AC                UPDATEADDRESS:      
C2AC   21 86 08               LD   hl,CEL   ;set hl to address of CEL
C2AF   79                     LD   a,c   ;load a with hex key pressed
C2B0   ED 6F                  RLD      ;shift key into lower byte of CEL
C2B2   23                     INC   hl   ;move to upper byte
C2B3   ED 6F                  RLD      ;shift carry nibble into upper byte
C2B5   CD E0 C4               CALL   setDataBase   ;set the DATA_BASE variable
C2B8   C3 F8 C1               JP   setDispBuffer   ;jump back to main loop
C2BB                             ;function key handler
C2BB                KEYFN:       
C2BB   11 2F D2               LD   de,functionJumpTable   ;reference jump table
C2BE   79                     LD   a,c   ;load a with hex key pressed
C2BF   87                     ADD   a,a   ;double it
C2C0   6F                     LD   l,a   ;store index in
C2C1   26 00                  LD   h,0   ;hl
C2C3   19                     ADD   hl,de   ;index DE with HL
C2C4   7E                     LD   a,(hl)   ;store jump
C2C5   23                     INC   hl   ;address
C2C6   66                     LD   h,(hl)   ;back into
C2C7   6F                     LD   l,a   ;HL
C2C8   11 E8 C1               LD   de,softBoot   ;get return address
C2CB   D5                     PUSH   de   ;put return address on stack
C2CC   E9                     JP   (hl)   ;jump to HL and execute it
C2CD                             ;function + Plus handler
C2CD                FNPLUS:      
C2CD                             ;shift from CEL to High RAM 1 byte up, make CEL=0
C2CD   ED 5B 86 08            LD   de,(CEL)   ;get current CEL
C2D1   21 FF 7F               LD   hl,TOP_RAM   ;get high ram
C2D4   B7                     OR   a   ;clear carry
C2D5   ED 52                  SBC   hl,de   ;get difference
C2D7   FA F8 C1               JP   m,setDispBuffer   ;high ram < cel, exit
C2DA   EB                     EX   de,hl   ;set hl to CEL
C2DB   22 C0 08               LD   (COPY_START),hl   ;move from CEL
C2DE   23                     INC   hl   
C2DF   22 C4 08               LD   (COPY_DEST),hl   ;save from CEL+1
C2E2   21 FF 7F               LD   hl,TOP_RAM   ;HL = 7FFEH
C2E5   2B                     DEC   hl   
C2E6   22 C2 08               LD   (COPY_END),hl   ;save from TOP_RAM-1
C2E9   CD 0A CA               CALL   smartCopyDirect   ;do the smart update
C2EC   2A 86 08               LD   hl,(CEL)   ;get CEL
C2EF   36 00                  LD   (hl),00H   ;put zero in CEL
C2F1   C3 F8 C1               JP   setDispBuffer   ;jump back to main loop
C2F4                FNMINUS:      
C2F4                             ;shift from CEL to High RAM 1 byte down, make High RAM=0
C2F4   ED 5B 86 08            LD   de,(CEL)   ;get current CEL
C2F8   21 FF 7F               LD   hl,TOP_RAM   ;get high ram
C2FB   B7                     OR   a   ;clear carry
C2FC   ED 52                  SBC   hl,de   ;get difference
C2FE   FA F8 C1               JP   m,setDispBuffer   ;high ram < cel, exit
C301   EB                     EX   de,hl   ;set hl to CEL
C302   22 C4 08               LD   (COPY_DEST),hl   ;move to CEL
C305   23                     INC   hl   
C306   22 C0 08               LD   (COPY_START),hl   ;save from CEL+1
C309   21 FF 7F               LD   hl,TOP_RAM   ;HL = 7FFFH
C30C   22 C2 08               LD   (COPY_END),hl   ;save from TOP_RAM
C30F   CD 0A CA               CALL   smartCopyDirect   ;do the smart update
C312   21 FF 7F               LD   hl,TOP_RAM   ;get High RAM
C315   36 00                  LD   (hl),00H   ;put zero in High RAM
C317   C3 F8 C1               JP   setDispBuffer   ;jump back to main loop
C31A                FNAD:        
C31A                             ;display main menu
C31A   21 B2 D3               LD   hl,mainMenuCFG   ;set up 1G Menu
C31D   CD 9E CE               CALL   menuInit   
C320   CD 44 C6               CALL   switchMode   
C323   C3 F8 C1               JP   setDispBuffer   
C326                             ; 
C326                             ;process key press for segment data entry (A = key, HL = MCB)
C326                KEYPROCESSLCD:      
C326   FE 10                  CP   K_PLUS   ;is it the plus key
C328   20 26                  JR   nz,keyMinusLCD   ;no, try -
C32A                KEYPLUSLCD:      
C32A   3A 98 08               LD   a,(MENU_CNT)   ;get menu count
C32D   3D                     DEC   a   ;adjust for 0
C32E   47                     LD   b,a   ;save it in B
C32F   3A 97 08               LD   a,(MENU_SEL)   ;get current menu selection
C332   B8                     CP   b   ;is count = selection?
C333   CA 08 C2               JP   z,mainLoop   ;yes, ignore and return to menu
C336   3C                     INC   a   ;move to next item
C337   32 97 08               LD   (MENU_SEL),a   ;save it
C33A   4F                     LD   c,a   ;save for later
C33B   3A 96 08               LD   a,(MENU_POS)   ;get menu display position
C33E   C6 03                  ADD   a,3   ;add 3
C340   47                     LD   b,a   ;B = menu pos
C341   79                     LD   a,c   ;A = menu sel
C342   B8                     CP   b   ;if b+3>a then no change
C343   DA F8 C1               JP   c,setDispBuffer   ;yes return to menu
C346   3A 96 08               LD   a,(MENU_POS)   ;get menu display position
C349   3C                     INC   a   ;update it
C34A   32 96 08               LD   (MENU_POS),a   ;save it
C34D   C3 F8 C1               JP   setDispBuffer   ;exit and update LCD
C350                KEYMINUSLCD:      
C350   FE 11                  CP   K_MINUS   ;is it the minus key
C352   20 1A                  JR   nz,keyGoLCD   ;no, try GO
C354   3A 97 08               LD   a,(MENU_SEL)   ;get current menu selection
C357   3D                     DEC   a   ;decrease it by 1
C358   FA 08 C2               JP   m,mainLoop   ;if negative exit
C35B   32 97 08               LD   (MENU_SEL),a   ;save it
C35E   4F                     LD   c,a   ;save for later
C35F   3A 96 08               LD   a,(MENU_POS)   ;get menu display position
C362   47                     LD   b,a   ;B = menu pos
C363   79                     LD   a,c   ;A = menu sel
C364   B8                     CP   b   ;if b<a then no change
C365   D2 F8 C1               JP   nc,setDispBuffer   ;return
C368   32 96 08               LD   (MENU_POS),a   ;save it
C36B   C3 F8 C1               JP   setDispBuffer   ;exit
C36E                KEYGOLCD:      
C36E   FE 12                  CP   K_GO   ;is it the GO key
C370   20 2C                  JR   nz,keyAddressLCD   ;no, try AD
C372   CB 6E                  BIT   5,(hl)   ;check MCB for Parameter Entry
C374   28 03                  JR   z,menuGo   ;if Zero, it must be a menu
C376                             ;Parameter GO needs to pop menu and just return
C376   C3 C7 CE               JP   menuPop   ;restore to the previous menu and return back
C379                MENUGO:      
C379   3A 97 08               LD   a,(MENU_SEL)   ;get current menu selection
C37C   CD 5B CF               CALL   menuIndex   ;set HL to menu config at index A
C37F   06 01                  LD   b,01H   ;clear LCD instruction
C381   CD 7B C5               CALL   commandToLCD   ;update LCD
C384   CD 62 C5               CALL   stringToLCD   ;Display Message on LCD
C387                             ;HL is now at address to jump to
C387   7E                     LD   a,(hl)   ;fix HL
C388   23                     INC   hl   ;for executing
C389   66                     LD   h,(hl)   ;and displaying
C38A   6F                     LD   l,a   
C38B                LCDRUNNING:      
C38B   E5                     PUSH   hl   ;save HL
C38C   06 D6                  LD   b,0D6H   ;set cursor to Row 4,Col 3
C38E   CD 7B C5               CALL   commandToLCD   ;update LCD
C391   21 1C D3               LD   hl,menuGoText   ;display "  Running at: 1234  "
C394   CD 62 C5               CALL   stringToLCD   ;write text
C397   E1                     POP   hl   ;restore HL
C398   CD 95 C5               CALL   HLtoLCD   ;display HL as a string on LCD
C39B   C3 6B C2               JP   runRoutine   ;execute it safely
C39E                KEYADDRESSLCD:      
C39E   FE 13                  CP   K_ADDR   ;is key AD?
C3A0   C2 A9 C3               JP   nz,keyHexLCD   ;no, try Hex key
C3A3   CD C7 CE               CALL   menuPop   ;restore to previous menu
C3A6   C3 E8 C1               JP   softBoot   ;and return
C3A9                KEYHEXLCD:      
C3A9                             ;only applicable in Parameter mode
C3A9   CB 6E                  BIT   5,(hl)   ;check MCB
C3AB   CA 08 C2               JP   z,mainLoop   ;in Menu Mode, ignore key
C3AE   4F                     LD   c,a   ;save key press
C3AF   3A 97 08               LD   a,(MENU_SEL)   ;get current menu selection
C3B2   CD 5B CF               CALL   menuIndex   ;set HL to menu config at index A
C3B5   7E                     LD   a,(hl)   ;skip menu label
C3B6   23                     INC   hl   
C3B7   B7                     OR   a   ;is it zero
C3B8   20 FB                  JR   nz,$-3   ;repeat until zero found
C3BA   7E                     LD   a,(hl)   ;fix HL
C3BB   23                     INC   hl   ;for updating
C3BC   66                     LD   h,(hl)   
C3BD   6F                     LD   l,a   
C3BE   79                     LD   a,c   ;restore key pressed
C3BF   ED 6F                  RLD      ;shift key into lower byte of CEL
C3C1   23                     INC   hl   ;move to upper byte
C3C2   ED 6F                  RLD      ;shift carry nibble into upper byte
C3C4                             ;check if HL=COPY_START/END/DEST for RTC update
C3C4   3A 88 08               LD   a,(MCB)   ;check if RTC installed
C3C7   E6 40                  AND   MCB_RTC   ;is bit 6 set
C3C9   CA F8 C1               JP   z,setDispBuffer   ;no, just exit back
C3CC   2B                     DEC   hl   ;move HL back to original address
C3CD   3E 08                  LD   a,08H   
C3CF   94                     SUB   h   ;is address 08?
C3D0   C2 F8 C1               JP   nz,setDispBuffer   
C3D3   7D                     LD   a,l   
C3D4   D6 C0                  SUB   0C0H   ;is address C0-C4?
C3D6   FE 05                  CP   05H   ;is it > 4
C3D8   D2 F8 C1               JP   nc,setDispBuffer   
C3DB                             ;all good to update RTC
C3DB   C6 06                  ADD   a,06H   ;index A for RTC slot
C3DD   CD 5C CE               CALL   RTCSetPRAM   ;save it 
C3E0   C3 F8 C1               JP   setDispBuffer   ;exit
C3E3                             ; 
C3E3                             ; Check for Fn key pressed.
C3E3                             ; Output: Zero is set if Fn key is pressed
C3E3                CHECKFNKEY:      
C3E3   DB 03                  IN   a,(SYS_INPUT)   ;read simp buffer
C3E5   0F                     RRCA      ;check bit 0
C3E6   38 05                  JR   c,checkSecond   ;if set, matrix keyboard in use
C3E8   DB 00                  IN   a,(KEYB)   ;check keyboard latch
C3EA   E6 20                  AND   20H   ;is bit 5 set
C3EC   C9                     RET      
C3ED                CHECKSECOND:      
C3ED   3A 8E 08               LD   a,(KEY_SECOND)   ;get second key if any
C3F0   FE 02                  CP   K_FN   ;is it the FN key?
C3F2   C9                     RET      
C3F3                             ; 
C3F3                             ; Update LCD screen.  Either show a menu if LCD mode or byte information if
C3F3                             ; segment mode
C3F3                UPDATELCD:      
C3F3   06 0C                  LD   b,0CH   ;display on, cursor off
C3F5   CD 7B C5               CALL   commandToLCD   ;update LCD
C3F8   06 01                  LD   b,01H   ;clear LCD instruction
C3FA   CD 7B C5               CALL   commandToLCD   ;update LCD
C3FD   21 88 08               LD   hl,MCB   ;get the MCB
C400   CB 5E                  BIT   3,(hl)   ;is bit 3 set? LCD/Segment
C402   C2 E1 CE               JP   nz,menuDraw   ;LCD menu mode is set, draw the menu and return
C405   CB 66                  BIT   4,(hl)   ;is bit 4 set? Disassembly / Data view
C407   C2 A4 C4               JP   nz,LCDDisView   ;display Disassembly View
C40A                LCDDATAVIEW:      
C40A   CD E0 C4               CALL   setDataBase   ;set the DATA_BASE variable
C40D   11 FC FF               LD   de,0FFFCH   ;set DE to -4
C410   19                     ADD   hl,de   ;set HL = HL - 4
C411   01 04 03               LD   bc,0304H   ;three lines, four bytes
C414   11 1B D2               LD   de,LCDBaseRows   ;set de to first row
C417                LCDDATAROW:      
C417   C5                     PUSH   bc   ;save BC
C418   1A                     LD   a,(de)   ;get row value
C419   13                     INC   de   ;move to next row
C41A   47                     LD   b,a   ;set B as LCD row
C41B   CD 7B C5               CALL   commandToLCD   ;update LCD
C41E   41                     LD   b,c   ;load byte count in B
C41F   D5                     PUSH   de   ;save row table
C420   11 00 09               LD   de,DATA_ROW   ;point to Data Entry RAM
C423   CD D5 C8               CALL   genDataDump   ;fill DE with data dump line
C426   E5                     PUSH   hl   ;save HL
C427   21 00 09               LD   hl,DATA_ROW   ;point to Data Entry RAM start
C42A   CD 62 C5               CALL   stringToLCD   ;print line to LCD
C42D   E1                     POP   hl   ;get current address
C42E   D1                     POP   de   ;restore row table
C42F   C1                     POP   bc   ;restore BC
C430   10 E5                  DJNZ   LCDDataRow   ;do for all three rows
C432                             ; 
C432                             ;draw disassembly line
C432   1A                     LD   a,(de)   ;get row value
C433   47                     LD   b,a   ;set B as LCD row
C434   CD 7B C5               CALL   commandToLCD   ;update LCD
C437   CD 31 CB               CALL   calcDisAddress   ;get actual dis address from CEL
C43A   2A 90 08               LD   hl,(DIS_ADDR)   ;set DE to DIS_ADDR
C43D   22 29 09               LD   (DISFROM),hl   ;user DIS_ADDR as start address for disassembler
C440   CD BD C4               CALL   drawDisRow   ;Draw the Disassembly line
C443                             ; 
C443                             ;draw state information
C443   06 91                  LD   b,091H   ;move cursor
C445   CD 7B C5               CALL   commandToLCD   ;to top right
C448   3E 7C                  LD   a,"|"   
C44A   CD 77 C5               CALL   charToLCD   
C44D   3A 88 08               LD   a,(MCB)   
C450   4F                     LD   c,a   
C451   3E 64                  LD   a,"d"   
C453   06 05                  LD   b,05h   ;special flip bit xor "a" <-> "d"
C455   CB 51                  BIT   2,c   ;is in Data or Address mode?
C457   28 01                  JR   z,$+3   
C459   A8                     XOR   b   
C45A   CD 77 C5               CALL   charToLCD   ;Display the byte
C45D   A8                     XOR   b   ;flip it back to a or d
C45E   CD 77 C5               CALL   charToLCD   ;Display the byte
C461                             ; 
C461   06 D1                  LD   b,0D1H   ;move cursor
C463   CD 7B C5               CALL   commandToLCD   ;to far right
C466   3E 7C                  LD   a,"|"   
C468   CD 77 C5               CALL   charToLCD   
C46B   3E 20                  LD   a," "   
C46D   CD 77 C5               CALL   charToLCD   
C470   2A 86 08               LD   hl,(CEL)   ;get current byte
C473   7E                     LD   a,(HL)   ;get byte
C474   CD 77 C5               CALL   charToLCD   ;Display the byte
C477                             ; 
C477   06 A5                  LD   b,0A5H   ;move cursor
C479   CD 7B C5               CALL   commandToLCD   ;to far right
C47C   3E 7C                  LD   a,"|"   
C47E   CD 77 C5               CALL   charToLCD   
C481   3E 6E                  LD   a,"n"   
C483   CD 77 C5               CALL   charToLCD   ;Display the byte
C486   79                     LD   a,c   ;mask out lower MCB
C487   E6 03                  AND   03H   
C489   C6 30                  ADD   a,"0"   ;convert binary to ascii value
C48B   CD 77 C5               CALL   charToLCD   ;display the byte count
C48E                             ; 
C48E                             ;set cursor
C48E   ED 4B A0 08            LD   bc,(DATA_BASE)   ;load BC with DATA_BASE
C492   B7                     OR   a   ;reset carry
C493   ED 42                  SBC   hl,bc   ;get difference between HL and BC
C495   7D                     LD   a,l   ;load difference in a
C496   4F                     LD   c,a   ;save to C
C497   87                     ADD   a,a   ;double A
C498   81                     ADD   a,c   ;add C
C499   C6 C5                  ADD   a,LCD_ROW2+5   ;add 5 to set row 1, col 5
C49B   47                     LD   b,a   ;set LCD command
C49C   CD 7B C5               CALL   commandToLCD   ;move cursor to correct position
C49F   3E 7E                  LD   a,MENU_PTR   ;display ->
C4A1   C3 77 C5               JP   charToLCD   ;update LCD
C4A4                             ; 
C4A4                             ; Work out valid Disassembly start based on where CEL is.
C4A4                LCDDISVIEW:      
C4A4   CD 31 CB               CALL   calcDisAddress   ;work out Actual disassembly address from CEL
C4A7                             ;Display disassembly in 4 rows
C4A7   22 29 09               LD   (DISFROM),hl   ;Store it in the disassembler start address
C4AA   06 04                  LD   b,4   ;four lines
C4AC   11 1B D2               LD   de,LCDBaseRows   ;set DE to second row
C4AF                LCDDISROW:      
C4AF   C5                     PUSH   bc   ;save BC
C4B0   1A                     LD   a,(de)   ;get row value
C4B1   13                     INC   de   ;move to next row
C4B2   47                     LD   b,a   ;set B as LCD row
C4B3   CD 7B C5               CALL   commandToLCD   ;update LCD
C4B6   CD BD C4               CALL   drawDisRow   ;Draw the Disassembly line
C4B9   C1                     POP   bc   ;restore BC
C4BA   10 F3                  DJNZ   LCDDisRow   ;do for all four rows
C4BC   C9                     RET      
C4BD                             ; 
C4BD                             ; Update LCD with Disassembly Line: 
C4BD                             ; Input: DISFROM is to be be set, IE , ld (DISFROM),hl
C4BD                             ; Output: On LCD as current cursor: IE: "4000: LD A,34"
C4BD                             ; Destroy: HL,A
C4BD                DRAWDISROW:      
C4BD   D5                     PUSH   de   ;save row table
C4BE   CD 1D E7               CALL   disStart   ;Generate disassembly from command after CEL
C4C1   21 00 09               LD   hl,DISLINE1   ;Point to first line
C4C4   3E 3A                  LD   a,COLON   ;load A with colon
C4C6   32 04 09               LD   (DISLINE1+4),a   ;place colon after address
C4C9   3E 20                  LD   a,SPACE   ;load A with space
C4CB   32 05 09               LD   (DISLINE1+5),a   ;just display address
C4CE   AF                     XOR   a   ;zero A
C4CF   32 06 09               LD   (DISLINE1+6),a   ;just display address
C4D2   CD 62 C5               CALL   stringToLCD   ;update LCD
C4D5   21 13 09               LD   hl,DISLINE2   ;Point to second line
C4D8   CD 80 C8               CALL   stringZeroSpace   ;Place 0 at actual end of stirng
C4DB   CD 62 C5               CALL   stringToLCD   ;update LCD
C4DE   D1                     POP   de   ;restore row table
C4DF   C9                     RET      
C4E0                             ; 
C4E0                             ; Set the DATA_BASE varaible with the CEL rounded down to base hex value
C4E0                             ; Input: none
C4E0                             ; Output: DATA_BASE set
C4E0                             ; Destroy: HL
C4E0                SETDATABASE:      
C4E0   2A 86 08               LD   hl,(CEL)   ;get CEL
C4E3   7D                     LD   a,l   ;get lower byte
C4E4   E6 FC                  AND   0FCH   ;mask out two lowest bits
C4E6   6F                     LD   l,a   ;store it back to get read base adderss
C4E7   22 A0 08               LD   (DATA_BASE),hl   ;store new Base
C4EA   C9                     RET      
C4EB                             ; 
C4EB                             ; Monitor routines
C4EB                             ; ----------------
C4EB                             ; 
C4EB                             ; Product a short Beep from the speaker
C4EB                             ; Input: N/A
C4EB                             ; Destroys: A
C4EB                BEEP:        
C4EB   3A 8D 08               LD   a,(KEY_BEEP)   ;check sound flag
C4EE   B7                     OR   a   ;is it zero?
C4EF   C0                     RET   nz   ;exit if not zero
C4F0                BEEPALWAYS:      
C4F0   C5                     PUSH   bc   ;save BC
C4F1   0E 40                  LD   c,40H   ;Tone count
C4F3   AF                     XOR   a   ;clear A
C4F4                BEEPLOOP:      
C4F4   D3 01                  OUT   (DIGITS),a   ;output to segment latch
C4F6   06 40                  LD   b,40H   ;set delay
C4F8   10 FE                  DJNZ   $   ;delay
C4FA   EE 80                  XOR   80H   ;toggle speaker bit
C4FC   0D                     DEC   c   ;decrease count
C4FD   20 F5                  JR   nz,beepLoop   ;repeat until c is zero
C4FF   C1                     POP   bc   ;restore BC
C500   AF                     XOR   a   ;clear A
C501   D3 01                  OUT   (DIGITS),a   ;output to segment latch
C503   C9                     RET      
C504                             ; 
C504                             ; Move Current Editing Location in Display Buffer
C504                             ; Input: DE = current editing location
C504                             ; Destroys: HL, DE, BC
C504                CELTOSEG:      
C504   EB                     EX   de,hl   ;swap DE with HL
C505   11 80 08               LD   de,DISP_BUFF   ;point DE to display buffer
C508   7C                     LD   a,h   ;get high byte
C509   CD 11 C5               CALL   convAToSeg   ;convert A to segment
C50C   7D                     LD   a,l   ;get low byte
C50D   CD 11 C5               CALL   convAToSeg   ;convert A to segment
C510   7E                     LD   a,(hl)   ;get data value to convert
C511                             ; 
C511                             ; Convert register A to Seven Segment
C511                             ; Inputs: A = byte to convert, DE = address to store segment values (2 bytes)
C511                             ; Destroys: BC
C511                CONVATOSEG:      
C511   F5                     PUSH   af   ;save AF
C512   07                     RLCA      ;move upper nibble to lower
C513   07                     RLCA      
C514   07                     RLCA      
C515   07                     RLCA      
C516   CD 1A C5               CALL   convNibToSeg   ;convert lower nibble to segment
C519   F1                     POP   af   ;restore AF
C51A                CONVNIBTOSEG:      
C51A   E6 0F                  AND   0FH   ;mask out upper nibble
C51C   01 1F D2               LD   bc,hexToSegmentTable   ;point BC to segment table
C51F   81                     ADD   a,c   ;index table with A
C520   4F                     LD   c,a   
C521   0A                     LD   a,(bc)   ;get segment data
C522   12                     LD   (de),a   ;store segment data in DE
C523   13                     INC   de   ;move to next DE address
C524   C9                     RET      
C525                             ; 
C525                             ; Sets the Segement decimal point depending on what mode the TEC is in.
C525                             ; Either Address edit or Data edit.  And nibble data entry
C525                             ; Destroys: A, B, HL
C525                SETDOTS:      
C525   21 80 08               LD   hl,DISP_BUFF   ;point HL to address location in display buffer
C528   06 04                  LD   b,04H   ;four dots for address
C52A   3A 88 08               LD   a,(MCB)   ;get monitor control byte
C52D   CB 57                  BIT   2,a   ;check address/data bit status
C52F   20 10                  JR   nz,setDot   ;Address mode, set 4 dots
C531   06 02                  LD   b,02H   ;two dots for data
C533   21 84 08               LD   hl,DISP_DATA   ;point HL to data location in display buffer
C536   E6 03                  AND   03H   ;mask out nibble bits
C538   B7                     OR   a   ;is it zero?
C539   28 06                  JR   z,setDot   ;yes, display two dots
C53B   3D                     DEC   a   ;subract 1
C53C   B7                     OR   a   ;is it zero
C53D   20 01                  JR   nz,$+3   ;no, skip buffer move
C53F   23                     INC   hl   ;move to lower nibble of display
C540   05                     DEC   b   ;set only one dot
C541                SETDOT:      
C541   CB E6                  SET   4,(hl)   ;set segment decimal place dot ON
C543   23                     INC   hl   ;move to next segment
C544   10 FB                  DJNZ   setDot   ;repeat if necessary
C546   C9                     RET      
C547                             ; 
C547                             ; Entry to multiplex the monitor display buffer
C547                SCANDISPLAYBUFF:      
C547   11 80 08               LD   de,DISP_BUFF   ;point DE to display buffer location
C54A                             ; 
C54A                             ; Multiplex the Seven Segment displays with the contents of DE
C54A                             ; Inputs: DE = 6 byte location of segment data
C54A                             ; Destorys: A, B, DE = DE + 6
C54A                SCANSEGMENTS:      
C54A   06 20                  LD   b,00100000B   ;left most digit port address
C54C                SCANLOOP:      
C54C   1A                     LD   a,(de)   ;load A with Segment data
C54D   D3 02                  OUT   (SEGS),a   ;send it to LED Segment
C54F   78                     LD   a,b   ;get digit port address
C550   D3 01                  OUT   (DIGITS),a   ;light up digit
C552   06 40                  LD   b,40H   ;set on delay
C554   10 FE                  DJNZ   $   ;delay
C556   13                     INC   de   ;move to next buffer location
C557   47                     LD   b,a   ;save current digit reference
C558   AF                     XOR   a   ;zero A
C559   D3 01                  OUT   (DIGITS),a   ;blank digits
C55B   CB 08                  RRC   b   ;rotate digit port bit to the right
C55D   30 ED                  JR   nc,scanLoop   ;if not on last digit repeat
C55F   D3 02                  OUT   (SEGS),a   ;clear LED Segment
C561   C9                     RET      
C562                             ; 
C562                             ; ASCII string to LCD.  Writes a string to the current cursor location on the LCD
C562                             ; Inputs: HL = ASCII string terminated with zero byte
C562                             ; Destroys: A, HL (moves to end of list)
C562                STRINGTOLCD:      
C562   7E                     LD   a,(hl)   ;get ASCII character
C563   23                     INC   hl   ;move to next ASCII character
C564   B7                     OR   a   ;is it zero?
C565   C8                     RET   z   ;yes, exit
C566   EF                     RST   28H   ;wait until LCD is not busy
C567   D3 84                  OUT   (LCD_DATA),a   ;send ASCII to LCD Data port
C569   18 F7                  JR   stringToLCD   ;repeat
C56B                             ; 
C56B                             ; ASCII string to Serial.  Writes a string to the FTDI serial port 
C56B                             ; Inputs: HL = ASCII string terminated with zero byte
C56B                             ; Destroys: A, HL (moves to end of list)
C56B                STRINGTOSERIAL:      
C56B   CD 7B C6               CALL   readyToTransmit   ;set up serial for transmit
C56E                STRSERIALLOOP:      
C56E   7E                     LD   a,(hl)   ;get ASCII character
C56F   23                     INC   hl   ;move to next ASCII character
C570   B7                     OR   a   ;is it zero?
C571   C8                     RET   z   ;yes, exit
C572   CD 87 C6               CALL   txByte   ;send ASCII to serial port
C575   18 F7                  JR   strSerialLoop   ;repeat
C577                             ; 
C577                             ; ASCII character to LCD.  Writes one character to the LCD as the current curso locaiton
C577                             ; Inputs: A = ASCII character
C577                             ; Destroys: none
C577                CHARTOLCD:      
C577   EF                     RST   28H   ;wait until LCD is not busy
C578   D3 84                  OUT   (LCD_DATA),a   ;send ASCII to LCD Data port
C57A   C9                     RET      
C57B                             ; 
C57B                             ; Command to LCD.  Sends an LCD instruction to the LCD
C57B                             ; Inputs: B = Instruction byte
C57B                             ; Destroys: none
C57B                COMMANDTOLCD:      
C57B   F5                     PUSH   af   ;save AF
C57C   EF                     RST   28H   ;wait until LCD is not busy
C57D   78                     LD   a,b   ;move instruction into A
C57E   D3 04                  OUT   (LCD_INST),a   ;send byte to instruction port
C580   F1                     POP   af   ;restore AF
C581   C9                     RET      
C582                             ; 
C582                             ; LCD initialise routine to set up LCD for correct use after a reset
C582                             ; Inputs: nothing
C582                             ; Destroys: all
C582                LCDINITIALISE:      
C582   01 04 04               LD   bc,400H+LCD_INST   ;4 instructions, LCD Instruction port
C585   21 17 D2               LD   hl,LCDInitTable   ;LCD instructions table
C588   11 00 10               LD   de,1000H   
C58B   1B                     DEC   de   
C58C   7B                     LD   a,e   
C58D   B2                     OR   d   
C58E   20 FB                  JR   nz,$-3   
C590   ED A3                  OUTI      ;send it to LCD
C592   20 F4                  JR   nz,$-10   ;loop again
C594   C9                     RET      
C595                             ; 
C595                             ; HL to LCD.  Dipslay the contents of HL as a string on the LCD at the current
C595                             ; cursor location
C595                             ; Inputs: HL
C595                             ; Destroy: A
C595                HLTOLCD:      
C595   E5                     PUSH   hl   ;save HL
C596   D5                     PUSH   de   ;save DE
C597   11 00 09               LD   de,DATA_ROW   ;tmp memory storage
C59A   CD A8 C8               CALL   HLToString   ;convert HL to ASCII string in (DE)
C59D   AF                     XOR   a   ;set A = 0
C59E   12                     LD   (de),a   ;terminate string with zero
C59F   21 00 09               LD   hl,DATA_ROW   ;set HL to text address
C5A2   CD 62 C5               CALL   stringToLCD   ;write text
C5A5   D1                     POP   de   ;restore DE
C5A6   E1                     POP   hl   ;restore HL to address
C5A7   C9                     RET      
C5A8                             ; 
C5A8                             ; LCD busy check.  Checks the LCD busy flag and loops until LCD isn't busy
C5A8                             ; Inputs: nothing
C5A8                             ; Destorys: none
C5A8                LCDBUSY:      
C5A8   F5                     PUSH   af   ;save af
C5A9   DB 04                  IN   a,(LCD_INST)   ;Read status bit on LCD
C5AB   07                     RLCA      ;put bit 7 (status) in carry
C5AC   38 FB                  JR   c,$-3   ;loop if LCD is busy
C5AE   F1                     POP   af   ;restore af
C5AF   C9                     RET      
C5B0                             ; 
C5B0                             ; Universal Key input detection routine.  Responds to Hex keypad or Matrix Keyboard
C5B0                             ; Return: A = key value
C5B0                             ;         zero flag set if a key is pressed
C5B0                             ;         carry flag set if press detected of a new key
C5B0                             ;         carry flag not set for key pressed and held
C5B0                             ; Destroys: DE if using Matrix Keyboard
C5B0                SCANKEYS:      
C5B0                             ;Detect keyboard input method
C5B0   DB 03                  IN   a,(SYS_INPUT)   ;read simp buffer
C5B2   0F                     RRCA      ;check bit 0
C5B3   38 20                  JR   c,keyboardScan   ;if set, matrix keyboard in use
C5B5                             ;Check keypad for press via keyboard decoder
C5B5   E6 20                  AND   20H   ;check bit 6 (now 5) for keypress on keypad
C5B7   28 04                  JR   z,keyPress   ;bit is low, a key is pressed
C5B9   32 8A 08               LD   (KEY_PRESS),a   ;set key press to non zero
C5BC   C9                     RET      ;return non zero for no key press
C5BD                KEYPRESS:      
C5BD   3A 8A 08               LD   a,(KEY_PRESS)   ;get key press flag
C5C0   B7                     OR   a   ;has it been already pressed (held down)?
C5C1   3A 89 08               LD   a,(KEY_BUFF)   ;set a to current key pressed if returning
C5C4   C8                     RET   z   ;key pressed and held, return zero and carry not set
C5C5   AF                     XOR   a   ;clear a
C5C6   32 8A 08               LD   (KEY_PRESS),a   ;set key press flag to zero
C5C9                             ;Universal key reader
C5C9   DB 00                  IN   a,(KEYB)   ;read key pressed
C5CB   E6 3F                  AND   3FH   ;mask out high bits
C5CD   EE 20                  XOR   20H   ;flip bit 5 (Fn-key)
C5CF                KEYEXIT:      
C5CF   BF                     CP   a   ;set zero flag
C5D0   37                     SCF      ;set carry flag
C5D1   32 89 08               LD   (KEY_BUFF),a   ;save key pressed into key buffer
C5D4   C9                     RET      
C5D5                             ; 
C5D5                             ; Matrix Keyboard handler.  If no key or invalid key press
C5D5                KEYBOARDSCAN:      
C5D5   CD 1F CC               CALL   matrixScan   ;detect if key has been pressed
C5D8   28 04                  JR   z,keyboardFetch   ;yes, continue with a key press flow
C5DA   32 8A 08               LD   (KEY_PRESS),a   ;set key press to non zero
C5DD   C9                     RET      ;return non zero for no key press
C5DE                KEYBOARDFETCH:      
C5DE                             ;E = key, D = second key
C5DE   7A                     LD   a,d   ;get seocnd key press if any
C5DF   32 8E 08               LD   (KEY_SECOND),a   ;store second key press
C5E2   7B                     LD   a,e   ;get first key press
C5E3                             ;Need to check if key is 0-F, +, -, GO or AD
C5E3                             ;0-9 = 13H-1CH, A-F = 24H-29H
C5E3                             ;AD = 3 or C, GO = 4 or A, - = 5, + = 6
C5E3   FE 2A                  CP   2AH   ;is it greater than 29H?
C5E5   30 4B                  JR   nc,keyBad   ;yes, return with non zero
C5E7   FE 24                  CP   24H   ;is it greater than 24H? (in range)
C5E9   38 04                  JR   c,keyNumber   ;no, could be a number
C5EB   D6 1A                  SUB   1AH   ;adjust alpha to be A-F
C5ED   18 2A                  JR   keyGood   ;clean exit
C5EF                KEYNUMBER:      
C5EF   FE 1D                  CP   1DH   ;is it greater than 1CH?
C5F1   30 3F                  JR   nc,keyBad   ;yes, return with non zero
C5F3   FE 13                  CP   13H   ;is it greater than 13H? (in range)
C5F5   38 04                  JR   c,keySpecial   ;no, could be special key
C5F7   D6 13                  SUB   13H   ;adjust for number 0-9
C5F9   18 1E                  JR   keyGood   ;clean exit
C5FB                KEYSPECIAL:      
C5FB   FE 0C                  CP   0CH   ;is it ESC?
C5FD   20 04                  JR   nz,$+6   ;no, keep checking
C5FF   3E 13                  LD   a,K_ADDR   ;set key to AD
C601   18 16                  JR   keyGood   ;clean exit
C603   FE 0A                  CP   0AH   ;is it Enter?
C605   20 04                  JR   nz,$+6   ;no, keep checking
C607   3E 12                  LD   a,K_GO   ;set key to GO
C609   18 0E                  JR   keyGood   ;clean exit
C60B   FE 07                  CP   07H   ;is it greater than 06H?
C60D   30 23                  JR   nc,keyBad   ;yes, return with non zero
C60F   FE 05                  CP   05H   ;is it less than 5?
C611   38 1F                  JR   c,keyBad   ;yes, return with non zero
C613   D6 03                  SUB   3   ;subtract 3
C615   EE 03                  XOR   03H   ;flip bits
C617   C6 10                  ADD   a,10H   ;adjust special to be 10H-13H
C619                KEYGOOD:      
C619   5F                     LD   e,a   ;store key
C61A   3A 8A 08               LD   a,(KEY_PRESS)   ;get key press flag
C61D   B7                     OR   a   ;has it been already pressed (held down)?
C61E   3A 89 08               LD   a,(KEY_BUFF)   ;set a to current key pressed if returning
C621   C8                     RET   z   ;key pressed and held, return zero and carry not set
C622   AF                     XOR   a   ;clear a
C623   32 8A 08               LD   (KEY_PRESS),a   ;set key press flag to zero
C626   7A                     LD   a,d   ;check for Fn key
C627   FE 02                  CP   K_FN   ;is it function?
C629   3E 00                  LD   a,0   ;reset A but not flags
C62B   20 02                  JR   nz,$+4   ;skip adding function
C62D   3E 20                  LD   a,00100000B   ;set bit 5
C62F   83                     ADD   a,e   ;restore key
C630   18 9D                  JR   keyExit   ;clean exit
C632                KEYBAD:      
C632   F6 01                  OR   1   ;reset zero flag
C634   C9                     RET      ;return non zero for invalid key press
C635                             ; 
C635                             ; Scan keys and wait until key released to get next key
C635                             ; Input: none
C635                             ; Return: A = key pressed
C635                             ;         Zero flag is set
C635                             ; Destroys: DE if using Matrix Keyboard
C635                SCANKEYSWAIT:      
C635   CD B0 C5               CALL   scanKeys   ;check for key pressed
C638   3A 8A 08               LD   a,(KEY_PRESS)   ;is a key currently pressed?
C63B   B7                     OR   a   ;is it zero (pressed)
C63C   28 F7                  JR   z,scanKeysWait   ;repeat until key is released
C63E   CD B0 C5               CALL   scanKeys   ;check for key pressed
C641   20 FB                  JR   nz,$-3   ;repeat scanKeys until a key is pressed
C643   C9                     RET      
C644                             ; 
C644                             ; Toggles LCD Menu or Segment Data entry mode
C644                SWITCHMODE:      
C644   3A 88 08               LD   a,(MCB)   ;get MCB
C647   EE 08                  XOR   MCB_LCD_SEG   ;toggle Bit 3
C649   CB AF                  RES   5,a   ;reset Parameter bit
C64B   32 88 08               LD   (MCB),a   ;save it back
C64E   C9                     RET      
C64F                             ; 
C64F                             ; Toggles Data Entry View or Disassembler View
C64F                SWITCHVIEW:      
C64F   3A 88 08               LD   a,(MCB)   ;get MCB
C652   EE 10                  XOR   MCB_DIS_DE   ;toggle Bit 4
C654   32 88 08               LD   (MCB),a   ;save it back
C657   C9                     RET      
C658                             ; 
C658                             ; ASCII to Segment.  Converts an ASCII character to Seven Segment character
C658                             ; Input: A = ASCII character
C658                             ; Return: A = Segment character or 0 if out of range
C658                             ; Destroys: none
C658                ASCIITOSEGMENT:      
C658   D6 20                  SUB   20H   ;adjust for table lookup
C65A   38 04                  JR   c,a2sExit   ;out of range
C65C   FE 60                  CP   60H   ;check upper range
C65E   38 02                  JR   c,a2sLookup   ;okay
C660                A2SEXIT:      
C660   AF                     XOR   a   ;set return value to zero
C661   C9                     RET      
C662                A2SLOOKUP:      
C662   E5                     PUSH   hl   ;save HL
C663   21 4F D2               LD   hl,ASCIISegTable   ;point hl to ASCII segment table
C666   85                     ADD   a,l   ;index l
C667   6F                     LD   l,a   ;save l
C668   7E                     LD   a,(hl)   ;get value in table
C669   E1                     POP   hl   ;restore HL
C66A   C9                     RET      ;exit
C66B                             ; 
C66B                             ; Software ID.  Get Software ID String
C66B                             ; Input: nothing
C66B                             ; Return: HL = Pointer to SOFTWARE ASCIIZ String
C66B                             ; Destroys: none
C66B                SOFTWAREID:      
C66B   21 F0 FF               LD   hl,SOFTWARE   ;return the ID string pointer
C66E   C9                     RET      
C66F                             ; 
C66F                             ; Version ID.  Get Version Number and Version String
C66F                             ; Input: nothing
C66F                             ; Return: HL = Pointer to Release ASCIIZ String
C66F                             ;         BC = Release major version number
C66F                             ;         DE = Release minor version number
C66F                             ; Destroys: none
C66F                VERSIONID:      
C66F   21 F8 FF               LD   hl,RELEASE   ;return the ID string pointerB
C672   ED 4B EC FF            LD   bc,(RELMAJOR)   ;return major version as a number
C676   ED 5B EE FF            LD   de,(RELMINOR)   ;return minor version as a number
C67A   C9                     RET      
C67B                             ; 
C67B                             ; Set serial for Ready To Transmit.  Must be called prior to any TEC to Serial
C67B                             ; routine
C67B                             ; Input: none
C67B                             ; Destroy: A
C67B                READYTOTRANSMIT:      
C67B   CD 02 CE               CALL   serialEnable   ;enable serial
C67E   E5                     PUSH   hl   ;save hl
C67F   21 00 20               LD   hl,2000H   ;small
C682   CD E2 C6               CALL   timeDelay   ;delay
C685   E1                     POP   hl   ;restore HL
C686   C9                     RET      
C687                             ; 
C687                             ; Bit Bang FTDI USB tranmit routine.  Transmit one byte via the FTDI USB serial
C687                             ; connection.  It assumes a uart connection of 4800-8-N-2
C687                             ; Input: A = byte to transmit
C687                             ; Output: nothing
C687                             ; Destroy: none
C687                TXBYTE:      
C687   F5                     PUSH   af   ;save AF
C688   C5                     PUSH   bc   ;save BC
C689   E5                     PUSH   hl   ;save HL
C68A   21 1B 00               LD   hl,BAUD   ;set HL to Baud delay
C68D   4F                     LD   c,a   ;save transmit byte in C
C68E                             ;transmit the start bit
C68E   AF                     XOR   a   ;clear A
C68F   D3 01                  OUT   (DIGITS),a   ;pull D6 low
C691   D3 02                  OUT   (SEGS),a   ;output to disco leds
C693   CD E2 C6               CALL   timeDelay   ;do a baud delay
C696                             ;transmit the byte
C696   06 08                  LD   b,8   ;eight bits to send
C698   CB 09                  RRC   c   ;move fist bit into carry flag
C69A                SENDBIT:      
C69A   CB 09                  RRC   c   ;shift to bit 6
C69C   79                     LD   a,c   ;load byte in A
C69D   E6 40                  AND   40H   ;mask out all bits except 6
C69F   D3 01                  OUT   (DIGITS),a   ;output the bit
C6A1   D3 02                  OUT   (SEGS),a   ;output to disco leds
C6A3   CD E2 C6               CALL   timeDelay   ;do a baud delay
C6A6   10 F2                  DJNZ   sendBit   ;send next bit
C6A8                             ;transmit stop bits
C6A8   3E 40                  LD   a,40H   ;set bit
C6AA   D3 01                  OUT   (DIGITS),a   ;output the bit
C6AC   D3 02                  OUT   (SEGS),a   ;output to disco leds
C6AE   CD E2 C6               CALL   timeDelay   ;do a baud delay
C6B1   CD E2 C6               CALL   timeDelay   ;do a baud delay x2 (two stop bits)
C6B4   E1                     POP   hl   ;restore HL
C6B5   C1                     POP   bc   ;restore BC
C6B6   F1                     POP   af   ;restore AF
C6B7   C9                     RET      
C6B8                             ; 
C6B8                             ; Bit Bang FTDI USB receive routine.  Receive one byte via the FTDI USB serial
C6B8                             ; connection.  It assumes a uart connection of 4800-8-N-2
C6B8                             ; Input: nothing
C6B8                             ; Return: A = byte received
C6B8                             ; Destroy: none
C6B8                RXBYTE:      
C6B8   C5                     PUSH   bc   ;save BC
C6B9   E5                     PUSH   hl   ;save HL
C6BA                STARTBIT:      
C6BA   DB 03                  IN   a,(SYS_INPUT)   ;read system input for High to Low on Bit 7
C6BC   07                     RLCA      ;put bit 7 (TX line) in carry
C6BD   38 FB                  JR   c,startBit   ;loop if TX line is high
C6BF                             ;start bit detected
C6BF   21 1B 00               LD   hl,BAUD   ;set HL to Baud delay
C6C2   CB 3C                  SRL   h   ;half the delay
C6C4   CB 1D                  RR   l   
C6C6   CD E2 C6               CALL   timeDelay   ;do a baud delay
C6C9   DB 03                  IN   a,(SYS_INPUT)   ;get start bit
C6CB   07                     RLCA      ;move bit 7 into carry
C6CC   38 EC                  JR   c,startBit   ;start bit too short, try again
C6CE                             ;valid start bit detected
C6CE   06 08                  LD   b,8   ;eight bits to receive
C6D0                GETBIT:      
C6D0   21 1B 00               LD   hl,BAUD   ;set HL to Baud delay
C6D3   CD E2 C6               CALL   timeDelay   ;do a baud delay
C6D6   DB 03                  IN   a,(SYS_INPUT)   ;get data bit
C6D8   07                     RLCA      ;move bit 7 into carry
C6D9   CB 19                  RR   c   ;rotate register C and put carry in bit 7
C6DB   10 F3                  DJNZ   getBit   ;get next bit
C6DD   79                     LD   a,c   ;load byte C to A
C6DE   B7                     OR   a   ;clear carry flag
C6DF   E1                     POP   hl   ;restore HL
C6E0   C1                     POP   bc   ;restore BC
C6E1   C9                     RET      
C6E2                             ; 
C6E2                             ; Time delay.  16-bit Delay routine
C6E2                             ; Input: HL = delay amount
C6E2                             ; Destroy: none
C6E2                TIMEDELAY:      
C6E2   E5                     PUSH   hl   ;save HL
C6E3   D5                     PUSH   de   ;save DE
C6E4   11 01 00               LD   de,1   ;load DE with 1
C6E7   ED 52                  SBC   hl,de   ;subtract 1 from HL
C6E9   D2 E7 C6               JP   nc,$-2   ;repeat subtraction until HL=0
C6EC   D1                     POP   de   ;restore DE
C6ED   E1                     POP   hl   ;restore HL
C6EE   C9                     RET      
C6EF                             ; 
C6EF                             ; INTEL Hex Load Routine.
C6EF                             ; Intel Hex file format is a string of ASCII with the following parts:
C6EF                             ; MARK | LENGTH | ADDRESS | RECORD TYPE | DATA | CHECKSUM
C6EF                             ; :10200000210621CD7D20CD98203A00213C320021AF <- EXAMPLE LINE
C6EF                             ; MARK is a colon character, LENGTH is the number of bytes per line, ADDRESS  is
C6EF                             ; the 2 byte address of where the data is to be stored.  RECORD TYPE is 00 for
C6EF                             ; Data and 01 for EOF.  DATA is the bytes to be stored.  CHECKSUM is the addition of
C6EF                             ; all bytes in the one line.
C6EF                             ; Input: nothing
C6EF                             ; Output: nothing
C6EF                             ; Destroy: HL,DE,BC,A
C6EF                INTELHEXLOAD:      
C6EF   3A 9D 08               LD   a,(SYS_MODE)   ;reset hardware to MONitor mode
C6F2   47                     LD   b,a   
C6F3   3E 02                  LD   a,PROTECT   ;Disable PROTECT during load
C6F5   2F                     CPL      
C6F6   A0                     AND   b   
C6F7   D3 FF                  OUT   (SYS_CTRL),a   
C6F9   CD 07 C7               CALL   intelLoader   ;call the load routine, set zero if passed
C6FC   3A 9D 08               LD   a,(SYS_MODE)   ;reset hardware to MONitor mode
C6FF   D3 FF                  OUT   (SYS_CTRL),a   
C701   CA 13 CC               JP   z,displayPass   ;if checksum good then display pass
C704   C3 0D CC               JP   displayError   ;else display error
C707                             ; 
C707                             ; Intel Hex Load Routine.
C707                             ; Returns: Zero Flag set = Pass, Zero Flag not set = Fail
C707                INTELLOADER:      
C707   AF                     XOR   a   ;zero A
C708   4F                     LD   c,a   ;clear checksum
C709                             ;Get header information
C709                INTELMARK:      
C709   CD B8 C6               CALL   rxByte   ;Get Byte from FTDI USB driver
C70C   FE 3A                  CP   ":"   ;Is byte received a colon?
C70E   20 F9                  JR   nz,intelMark   ;No, loop until a colon is found
C710   CD 3E C7               CALL   getHexByte   ;Convert ASCII to Byte (Length)
C713   47                     LD   b,a   ;Store Record Length in B
C714   CD 3E C7               CALL   getHexByte   ;Convert ASCII to Byte (Destination address)
C717   67                     LD   h,a   ;Store High Address byte in H
C718   CD 3E C7               CALL   getHexByte   ;Convert ASCII to Byte (Destination address)
C71B   6F                     LD   l,a   ;Store Low Address byte in L
C71C                             ; 
C71C                             ;Display indication that file is loading
C71C   D3 02                  OUT   (SEGS),a   ;load low address byte to segments
C71E   3E 01                  LD   a,1   ;set first segment
C720   D3 01                  OUT   (DIGITS),a   ;light up first segment
C722                             ; 
C722   CD 3E C7               CALL   getHexByte   ;Convert ASCII to Byte (Record Type)
C725   20 11                  JR   nz,intelCheckSum   ;Anything non zero treat as EOF
C727                             ; 
C727                             ;C=checksum, B=number of bytes, HL=destination address
C727                             ;Load bytes to (HL), B times
C727                INTELLOAD:      
C727   CD 3E C7               CALL   getHexByte   ;Convert ASCII to Byte (Data)
C72A   77                     LD   (hl),a   ;store data in RAM
C72B   57                     LD   d,a   ;copy A to D for later checking
C72C   7E                     LD   a,(hl)   ;read back value stored
C72D   BA                     CP   d   ;check if we stored the value successfully
C72E   C0                     RET   nz   ;exit with ZF not set if the store value check failed
C72F   23                     INC   hl   ;move to next RAM location
C730   10 F5                  DJNZ   intelLoad   ;repeat until B=0
C732   CD 38 C7               CALL   intelCheckSum   ;Get checksum value
C735   28 D0                  JR   z,intelLoader   ;Line is processed and okay, get next line
C737   C9                     RET      ;Exit with zero flag not set (load error)
C738                             ; 
C738                INTELCHECKSUM:      
C738   CD 3E C7               CALL   getHexByte   ;Convert ASCII to Byte (Checksum)
C73B   79                     LD   a,c   ;Final Checksum is zero if okay
C73C   B7                     OR   a   ;set zero flag
C73D   C9                     RET      ;get next line or exit
C73E                             ; 
C73E                             ;Get ASCII character from FTDI AND convert it to a byte
C73E                             ;IE: "D3" -> 0D3H
C73E                GETHEXBYTE:      
C73E   CD 4F C7               CALL   getHexChar   ;Get first Hex character from FTDI
C741   07                     RLCA      ;Move lower nibble
C742   07                     RLCA      ;(first character)
C743   07                     RLCA      ;to upper
C744   07                     RLCA      ;nibble in A
C745   57                     LD   d,a   ;store it in D
C746   CD 4F C7               CALL   getHexChar   ;Get second Hex character from FTDI
C749   B2                     OR   d   ;make a byte
C74A                             ;add byte to checksum
C74A   F5                     PUSH   af   ;save AF
C74B   81                     ADD   a,c   ;add existing checksum C to current byte
C74C   4F                     LD   c,a   ;load total back to C
C74D   F1                     POP   af   ;restore AF
C74E   C9                     RET      
C74F                GETHEXCHAR:      
C74F   CD B8 C6               CALL   rxByte   ;Get Byte from FTDI USB driver
C752   CB 77                  BIT   6,a   ;is the chracter 0-9 or A-F?
C754   28 02                  JR   z,$+4   ;Its 0-9 skip A-F adjustment
C756   C6 09                  ADD   a,9   ;add 9 to fix A-F
C758   E6 0F                  AND   0FH   ;mask out high nibble and convert to binary
C75A   C9                     RET      
C75B                             ; 
C75B                             ; SIO Hex Dump.  Transfer data on the TEC to a serial terminal
C75B                             ; Destroys: A,HL,DE,BC
C75B                DATATOSERIAL:      
C75B   CD 82 C7               CALL   getToFrom   ;collect parameters
C75E                             ; transmits data from HL for BC bytes
C75E                SENDTOSERIAL:      
C75E   CD 7B C6               CALL   readyToTransmit   ;set up serial for transmit
C761                SENDLOOP:      
C761   7E                     LD   a,(hl)   ;load A with data
C762   CD 87 C6               CALL   txByte   ;transmit it to FTDI
C765   ED A1                  CPI      ;inc HL, dec BC
C767   EA 61 C7               JP   pe,sendLoop   ;repeat until BC=0
C76A   C9                     RET      ;all done
C76B                             ; send to serial Entry for API
C76B                             ; Input: HL = start address
C76B                             ;        DE = length in bytes
C76B                SENDTOSERIALAPI:      
C76B   D5                     PUSH   de   ;make BC = DE
C76C   C1                     POP   bc   
C76D   C3 5E C7               JP   sendToSerial   
C770                             ; 
C770                             ; SIO receive data.  Receive binary data from FTDI
C770                DATAFROMSERIAL:      
C770   CD 82 C7               CALL   getToFrom   ;collect parameters
C773                RECEIVEFROMSERIAL:      
C773   CD B8 C6               CALL   rxByte   ;get byte from serial
C776   77                     LD   (hl),a   ;load byte into HL
C777   ED A1                  CPI      ;inc HL, dec BC
C779   EA 73 C7               JP   pe,receiveFromSerial   ;repeat until BC=0
C77C   C9                     RET      ;all done
C77D                             ; receive from serial Entry for API
C77D                             ; Input: HL = start address
C77D                             ;        DE = length in bytes
C77D                RECEIVEFROMSERIALAPI:      
C77D   D5                     PUSH   de   ;make BC = DE
C77E   C1                     POP   bc   
C77F   C3 73 C7               JP   receiveFromSerial   
C782                             ; 
C782                             ; Collect Address To and From information from user via the LCD interface
C782                             ; Stores From at DATA_FROM (08C0H) and To at DATA_TO (08C2H)
C782                             ; Output: HL = start address
C782                             ;         BC = length of end - start+1
C782                             ; Note: if end < start (error) then call error handler
C782                             ; Destroys: DE
C782                GETTOFROM:      
C782   21 93 C7               LD   hl,dataRangeParams   
C785   CD 7E CF               CALL   paramDriver   ;collect parameters
C788   21 C0 08               LD   hl,DATA_FROM   ;check parameters
C78B   CD EC C8               CALL   checkStartEnd   ; 
C78E   D0                     RET   nc   ;All good, continue
C78F   E1                     POP   hl   ;remove call return from stack
C790   C3 0D CC               JP   displayError   ;display error if end < start
C793                             ; 
C793                DATARANGEPARAMS:      
C793   02                     DB   2   ;Three parameters
C794   45 6E 74 65 72 20      DB   "Enter "   ;7seg Text
C79A   3D 20 45 6E 74 65 72 20 50 61 72 61 6D 65 74 65 72 73 20 3D 00 DB   "= Enter Parameters =",0   ;Parameter title
C7AF   46 72 6F 6D 20 41 64 64 72 65 73 73 3A 00 DB   "From Address:",0   ;Text and Address
C7BD   C0 08                  DW   DATA_FROM   
C7BF   54 6F 20 41 64 64 72 65 73 73 3A 00 DB   "To Address:",0   ;Text and Address
C7CB   C2 08                  DW   DATA_TO   
C7CD                             ; 
C7CD                             ; Send Disassembly to serial terminal
C7CD                             ; Destroys: All
C7CD                ASSEMBLYTOSERIAL:      
C7CD   CD 82 C7               CALL   getToFrom   ;collect parameters
C7D0                             ; prints assemblybetween DATA_FROM / DATA_TO to the serial terminal.  Can
C7D0                             ; be called externally provided DATA_FROM/TO (08C0-08C3) are populated.
C7D0                SENDASSEMBLY:      
C7D0   CD 7B C6               CALL   readyToTransmit   ;set up serial for transmit
C7D3   2A C0 08               LD   hl,(DATA_FROM)   ;get start address
C7D6   22 29 09               LD   (DISFROM),hl   ;save start in DIS_FROM
C7D9                ASSEMBLYLOOP:      
C7D9   CD 1D E7               CALL   disStart   ;generate Disassembly
C7DC   21 00 09               LD   hl,DISLINE1   ;get string
C7DF   06 26                  LD   b,38   ;38 characters
C7E1   7E                     LD   a,(hl)   ;load A with data
C7E2   CD 87 C6               CALL   txByte   ;transmit it to FTDI
C7E5   23                     INC   hl   ;move to next location
C7E6   10 F9                  DJNZ   $-5   ;repeat 38 times
C7E8   3E 0D                  LD   a,CR   ;carriage return
C7EA   CD 87 C6               CALL   txByte   ;send CR
C7ED   3E 0A                  LD   a,LF   ;line feed
C7EF   CD 87 C6               CALL   txByte   ;send LF
C7F2   2A 29 09               LD   hl,(DISFROM)   ;get current start
C7F5   ED 5B C2 08            LD   de,(DATA_TO)   ;get end address
C7F9   B7                     OR   a   ;clear carry
C7FA   ED 52                  SBC   hl,de   ;check difference between
C7FC   19                     ADD   hl,de   ;start and end address
C7FD   38 DA                  JR   c,assemblyLoop   ;if not zero then loop
C7FF   C9                     RET      ;all done
C800                             ; send assembly to serial Entry for API
C800                             ; Input: HL = start address
C800                             ;        DE = length in bytes
C800                SENDASSEMBLYAPI:      
C800   22 29 09               LD   (DISFROM),hl   ;save start in DIS_FROM
C803   19                     ADD   hl,de   ;get end address
C804   22 C2 08               LD   (DATA_TO),hl   ;get end address
C807   CD 7B C6               CALL   readyToTransmit   ;set up serial for transmit
C80A   C3 D9 C7               JP   assemblyLoop   
C80D                             ; Send a traditional HEX dump to the serial terminal.
C80D                             ; Input: none
C80D                             ; Output: text to  serial
C80D                             ; Destroy: All
C80D                HEXDUMPTOSERIAL:      
C80D   CD 82 C7               CALL   getToFrom   ;collect parameters
C810   CD 7B C6               CALL   readyToTransmit   ;set up serial for transmit
C813                SENDHEX:      
C813   E5                     PUSH   hl   ;store current address
C814   C5                     PUSH   bc   ;store byte count
C815   E1                     POP   hl   ;HL = BC
C816   11 F0 FF               LD   de,-16   ;load DE with minus 16
C819   19                     ADD   hl,de   ;reduce hl by 16
C81A   1E 10                  LD   e,16   
C81C   38 03                  JR   c,hexMore   
C81E   C5                     PUSH   bc   
C81F   E1                     POP   hl   
C820   59                     LD   e,c   
C821                HEXMORE:      
C821   E3                     EX   (sp),hl   ;get current address, store bytes remaining
C822   43                     LD   b,e   ;byte count
C823   11 00 09               LD   de,DATA_ROW   ;point to Data Entry RAM
C826   CD D5 C8               CALL   genDataDump   ;fill DE with data dump line
C829   E5                     PUSH   hl   ;store next address
C82A   21 00 09               LD   hl,DATA_ROW   ;make HL = start or data row
C82D                HEXTEXTLOOP:      
C82D   7E                     LD   a,(hl)   ;get ASCII
C82E   23                     INC   hl   ;move to next address
C82F   B7                     OR   a   ;is it zero
C830   28 05                  JR   z,skipHex   ;yes, skip sending to serial
C832   CD 87 C6               CALL   txByte   ;send byte to serial
C835   18 F6                  JR   hexTextloop   ;repeat
C837                SKIPHEX:      
C837   3E 0D                  LD   a,CR   ;carriage return
C839   CD 87 C6               CALL   txByte   ;send CR
C83C   3E 0A                  LD   a,LF   ;line feed
C83E   CD 87 C6               CALL   txByte   ;send LF
C841   D1                     POP   de   ;restore next start address
C842   C1                     POP   bc   ;restore bytes remaining
C843   2A C2 08               LD   hl,(DATA_TO)   ;get end address
C846   B7                     OR   a   
C847   ED 52                  SBC   hl,de   ;check difference
C849   C8                     RET   z   ;return if all done
C84A   D8                     RET   c   ;return if all done
C84B   EB                     EX   de,hl   ;set hl to new start address
C84C   18 C5                  JR   sendHex   ;repeat until all bytes are printed
C84E                             ; send hex dump to serial Entry for API
C84E                             ; Input: HL = start address
C84E                             ;        DE = length in bytes
C84E                SENDHEXAPI:      
C84E   D5                     PUSH   de   ;make BC = DE
C84F   C1                     POP   bc   
C850   EB                     EX   de,hl   ;set HL for add
C851   19                     ADD   hl,de   ;get end address
C852   22 C2 08               LD   (DATA_TO),hl   ;put end address in RAM
C855   EB                     EX   de,hl   ;restore HL  
C856   CD 7B C6               CALL   readyToTransmit   ;set up serial for transmit
C859   C3 13 C8               JP   sendHex   
C85C                             ; 
C85C                             ; Display 7Seg Message.  Display data on the Seven Segment Display and 
C85C                             ; maintain display until a key is pressed
C85C                             ; Input: HL = 6 byte Segment Data pointer
C85C                             ; Destroy: ALL
C85C                DISPLAY7SEGS:      
C85C   11 80 08               LD   de,DISP_BUFF   ;set destination to display buffer
C85F   01 06 00               LD   bc,6   ;size bytes
C862   ED B0                  LDIR      ;fill display buffer with text
C864   CD B0 C5               CALL   scanKeys   ;check for key pressed
C867   3A 8A 08               LD   a,(KEY_PRESS)   ;is a key currently pressed?
C86A   B7                     OR   a   ;is it zero (pressed)
C86B   28 F7                  JR   z,$-7   ;repeat until key is released
C86D                DISPLAYLOOP:      
C86D   CD 47 C5               CALL   scanDisplayBuff   ;Multiplex the seven segments
C870   CD B0 C5               CALL   scanKeys   ;Scan for key press
C873   20 F8                  JR   nz,displayLoop   ;Repeat scan until key pressed
C875   C9                     RET      
C876                             ; 
C876                             ; Compare strings utility
C876                             ; HL = source
C876                             ; DE = target
C876                             ; B = #bytes to compare (up to 256)
C876                             ; 
C876                             ; Z = compare match
C876                             ; NZ = compare fail
C876                             ; 
C876                             ; destroys HL, DE, A, BC
C876                STRINGCOMPARE:      
C876   7E                     LD   a,(hl)   ;Load Source into A
C877   4F                     LD   c,a   ;Store in C
C878   1A                     LD   a,(de)   ;Load compare into A
C879   B9                     CP   c   ;A==C ?
C87A   C0                     RET   nz   ;No - so edxt with Z flag reset
C87B   23                     INC   hl   ;Yes - move on to next byte
C87C   13                     INC   de   ;Next byte
C87D   10 F7                  DJNZ   stringCompare   ;Loop around till B=0 (check whole string)
C87F   C9                     RET      ;Matched, so return with Z flag set
C880                             ; 
C880                             ; Defaults to check for double ASCII space
C880                STRINGZEROSPACE:      
C880   3E 20                  LD   a,SPACE   ;Space and fall through.         
C882                             ; Place a zero at then end of a string.  Routine checks for two bytes
C882                             ; in a row that are the same and when found, will place a zero in the first 
C882                             ; byte found.  If no byte found within 20 characters then exit with no update
C882                             ; Input: A = byte value to check, usually 0 or " "
C882                             ;        HL = pointer to ASCII string
C882                             ; Output: Zero Set = Updated HL
C882                             ;         Zero not set = No match found
C882                             ; Destroys: A
C882                STRINGZERO:      
C882   C5                     PUSH   bc   ;save BC
C883   E5                     PUSH   hl   ;save HL
C884   01 14 00               LD   bc,20   ;twenty goes (LCD width)
C887                SZ1:         
C887   ED B1                  CPIR      ;find a matching byte
C889   20 06                  JR   nz,sZ2   ;if non zero here, no byte match and BC=0, just exit
C88B   BE                     CP   (hl)   ;compare with next value
C88C   20 F9                  JR   nz,sZ1   ;Nope, try again
C88E   2B                     DEC   hl   ;go back to first match
C88F   AF                     XOR   a   ;set A=0
C890   77                     LD   (hl),a   ;make it zero
C891                SZ2:         
C891   E1                     POP   hl   ;restore HL
C892   C1                     POP   bc   ;restore BC
C893   C9                     RET      
C894                             ; 
C894                             ; Count the number of ASCII spaces in a zero terminated string
C894                             ; Input: HL = pointer to string
C894                             ; Output: A = number of spaces
C894                STRINGSPACES:      
C894   C5                     PUSH   bc   ;save BC
C895   E5                     PUSH   hl   ;save HL
C896   0E 00                  LD   c,0   ;counter
C898                STRSPLOOP:      
C898   7E                     LD   a,(hl)   ;get value
C899   B7                     OR   a   ;is it zero?
C89A   20 04                  JR   nz,strSpCheck   ;no
C89C   79                     LD   a,c   ;set return value
C89D   E1                     POP   hl   ;restore HL
C89E   C1                     POP   bc   ;restore BC
C89F   C9                     RET      ;exit
C8A0                STRSPCHECK:      
C8A0   FE 20                  CP   SPACE   ;is it a space
C8A2   23                     INC   hl   ;move to next address
C8A3   20 F3                  JR   nz,strSpLoop   ;loop again if not space
C8A5   0C                     INC   c   ;increase space counter
C8A6   18 FB                  JR   $-3   ;loop again, c = non zero
C8A8                             ; 
C8A8                             ; Convert HL to ASCII string. IE: 2CH -> "2C"
C8A8                             ; Input: HL = value to convert
C8A8                             ;        DE = address of string destination
C8A8                             ; Output: DE = address one after last ASCII entry
C8A8                             ; Destroys: A
C8A8                HLTOSTRING:      
C8A8   7C                     LD   a,h   ;get H
C8A9   CD AD C8               CALL   AToString   ;convert to String
C8AC   7D                     LD   a,l   ;get L
C8AD                             ; 
C8AD                             ; Convert A to ASCII string
C8AD                             ; Input: A = byte to convert
C8AD                             ;        DE = address of string destination
C8AD                             ; Output: DE = address one after last ASCII entry
C8AD                             ; Destroys: A
C8AD                ATOSTRING:      
C8AD   F5                     PUSH   af   ;save AF
C8AE   1F                     RRA      ;move high
C8AF   1F                     RRA      ;nibble to low nibble
C8B0   1F                     RRA      
C8B1   1F                     RRA      
C8B2   CD B6 C8               CALL   lowNibToString   ;get lower nibble and save in DE
C8B5   F1                     POP   af   ;restore AF
C8B6                LOWNIBTOSTRING:      
C8B6   E6 0F                  AND   0FH   ;mask out high nibble
C8B8   C6 90                  ADD   a,90H   ;convert to
C8BA   27                     DAA      ;ASCII
C8BB   CE 40                  ADC   a,40H   ;using this
C8BD   27                     DAA      ;amazing routine
C8BE   12                     LD   (de),a   ;save in DE
C8BF   13                     INC   de   ;move to next DE
C8C0   C9                     RET      ;exit back
C8C1                             ; 
C8C1                             ; convert register A to ASCII. IE: 2CH -> "2C"
C8C1                             ; Input: A = byte to convert
C8C1                             ; Output: HL = two byte ASCII string
C8C1                             ; Destroys: A
C8C1                REGATOASCII:      
C8C1   F5                     PUSH   af   ;save AF
C8C2   0F                     RRCA      ;move high 
C8C3   0F                     RRCA      ;nibble to
C8C4   0F                     RRCA      ;low
C8C5   0F                     RRCA      ;nibble
C8C6   CD CB C8               CALL   nibble2ASCII   ;call nib to ASCII routine
C8C9   65                     LD   h,l   ;move upper nibble to H
C8CA   F1                     POP   af   
C8CB                NIBBLE2ASCII:      
C8CB   E6 0F                  AND   0FH   ;mask out high nibble
C8CD   C6 90                  ADD   a,90H   ;convert to
C8CF   27                     DAA      ;ASCII
C8D0   CE 40                  ADC   a,40H   ;using this
C8D2   27                     DAA      ;amazing routine
C8D3   6F                     LD   l,a   ;store in L
C8D4   C9                     RET      ;exit
C8D5                             ; 
C8D5                             ; Generate data dump in ASCII.  Print Address and then C number of bytes
C8D5                             ; Input: B = number of bytes to display
C8D5                             ;        HL = start address of data dump
C8D5                             ;        DE = address of string destination
C8D5                             ; Output: DE = zero terminated address one after last ASCII entry
C8D5                             ;           IE: "4000: 23 34 45 56 78 9A BC DE",0
C8D5                             ; Destroys: A, HL (moves to next address after last byte)
C8D5                GENDATADUMP:      
C8D5   C5                     PUSH   bc   ;save BC
C8D6   CD A8 C8               CALL   HLToString   ;convert HL to address in ASCII
C8D9   3E 3A                  LD   a,COLON   ;set A = colon
C8DB   12                     LD   (de),a   ;write a colon after address
C8DC   13                     INC   de   
C8DD                DATADUMPLOOP:      
C8DD   3E 20                  LD   a,SPACE   ;set A = space
C8DF   12                     LD   (de),a   ;write a space
C8E0   13                     INC   de   
C8E1   7E                     LD   a,(hl)   ;get byte at HL
C8E2   CD AD C8               CALL   AToString   ;convert A to string
C8E5   23                     INC   hl   ;move HL to next address
C8E6   10 F5                  DJNZ   dataDumpLoop   ;if not zero get next byte
C8E8   AF                     XOR   a   ;set A = 0
C8E9   12                     LD   (de),a   ;terminate string with zero
C8EA   C1                     POP   bc   ;restore BC
C8EB   C9                     RET      
C8EC                             ; 
C8EC                             ; Check start and end address difference.
C8EC                             ; Input: HL = address location of START value
C8EC                             ;        HL+2 = address location of END value
C8EC                             ; Output: HL = start address
C8EC                             ;         BC = length of end-start
C8EC                             ;         Carry = set if end is less than start
C8EC                             ; Destroys: DE
C8EC                CHECKSTARTEND:      
C8EC   5E                     LD   e,(HL)   ;move start
C8ED   23                     INC   hl   ;address into DE
C8EE   56                     LD   d,(HL)   ;move end
C8EF   23                     INC   hl   ;address into HL
C8F0   4E                     LD   c,(HL)   
C8F1   23                     INC   hl   
C8F2   66                     LD   h,(HL)   
C8F3   69                     LD   l,c   
C8F4   B7                     OR   a   ;clear carry
C8F5   ED 52                  SBC   hl,de   ;is END > START (it should be)
C8F7   4D                     LD   c,l   ;move byte count
C8F8   44                     LD   b,h   ;into BC
C8F9   03                     INC   bc   ;if END < START then carry is set
C8FA   EB                     EX   de,hl   ;HL is start address
C8FB   C9                     RET      
C8FC                             ; 
C8FC                             ; Block Move generic routine.  Move a block of code between start and end
C8FC                             ; to destination.
C8FC                             ; NOTE: Must have COPY_START,COPY_END and COPY_DEST filled
C8FC                             ; Destroys HL, DE, A, BC
C8FC                BLOCKMOVE:      
C8FC   21 C0 08               LD   hl,COPY_START   ;get start location
C8FF   CD EC C8               CALL   checkStartEnd   ;check start < end
C902   DA 0D CC               JP   c,displayError   ;if carry is set exit and error
C905   ED 5B C4 08            LD   de,(COPY_DEST)   ;load DE with destination address
C909   ED 52                  SBC   hl,de   ;see if destination is < or > than start
C90B   30 0B                  JR   nc,mvup   ;jump if start > destination
C90D   EB                     EX   de,hl   ;add byte count to destination
C90E   09                     ADD   hl,bc   
C90F   2B                     DEC   hl   
C910   EB                     EX   de,hl   
C911   2A C2 08               LD   hl,(COPY_END)   ;get end address
C914   ED B8                  LDDR      ;copy End to Start going backwards
C916   13                     INC   de   
C917   C9                     RET      ;move done
C918                MVUP:        
C918   19                     ADD   hl,de   ;make HL the difference between start and dest
C919   ED B0                  LDIR      ;copy Start to End going forwards
C91B   1B                     DEC   de   
C91C   C9                     RET      ;move done
C91D                BLOCKMOVEPARAMS:      
C91D   03                     DB   3   ;Three parameters
C91E   42 41 43 4B 55 50      DB   "BACKUP"   ;7seg Text
C924   3D 20 20 20 42 6C 6F 63 6B 20 42 61 63 6B 75 70 20 20 20 3D 00 DB   "=   Block Backup   =",0   ;Parameter title
C939   53 74 61 72 74 20 41 64 64 72 65 73 73 3A 00 DB   "Start Address:",0   ;Text and Address
C948   C0 08                  DW   COPY_START   
C94A   45 6E 64 20 41 64 64 72 65 73 73 3A 00 DB   "End Address:",0   ;Text and Address
C957   C2 08                  DW   COPY_END   
C959   44 65 73 74 2E 20 41 64 64 72 65 73 73 3A 00 DB   "Dest. Address:",0   ;Text and Address
C968   C4 08                  DW   COPY_DEST   
C96A                BLOCKCOPYPARAMS:      
C96A   03                     DB   3   ;Three parameters
C96B   53 2D 43 4F 50 59      DB   "S-COPY"   ;7seg Text
C971   3D 20 53 6D 61 72 74 20 42 6C 6F 63 6B 20 43 6F 70 79 20 3D 00 DB   "= Smart Block Copy =",0   ;Parameter title
C986   53 74 61 72 74 20 41 64 64 72 65 73 73 3A 00 DB   "Start Address:",0   ;Text and Address
C995   C0 08                  DW   COPY_START   
C997   45 6E 64 20 41 64 64 72 65 73 73 3A 00 DB   "End Address:",0   ;Text and Address
C9A4   C2 08                  DW   COPY_END   
C9A6   44 65 73 74 2E 20 41 64 64 72 65 73 73 3A 00 DB   "Dest. Address:",0   ;Text and Address
C9B5   C4 08                  DW   COPY_DEST   
C9B7                BLOCKRESTOREPARAMS:      
C9B7   03                     DB   3   ;Three parameters
C9B8   52 45 53 54 4F 52      DB   "RESTOR"   ;7seg Text
C9BE   3D 20 20 52 65 73 74 6F 72 65 20 42 61 63 6B 75 70 20 20 3D 00 DB   "=  Restore Backup  =",0   ;Parameter title
C9D3   53 74 61 72 74 20 41 64 64 72 65 73 73 3A 00 DB   "Start Address:",0   ;Text and Address
C9E2   CC 08                  DW   REST_START   
C9E4   45 6E 64 20 41 64 64 72 65 73 73 3A 00 DB   "End Address:",0   ;Text and Address
C9F1   CE 08                  DW   REST_END   
C9F3   44 65 73 74 2E 20 41 64 64 72 65 73 73 3A 00 DB   "Dest. Address:",0   ;Text and Address
CA02   D0 08                  DW   REST_DEST   
CA04                             ; 
CA04                             ; Move a block of code AND update all absolute jumps and calls.
CA04                             ; Destroys HL, DE, A, BC
CA04                SMARTCOPY:      
CA04   21 6A C9               LD   hl,blockCopyParams   
CA07   CD 7E CF               CALL   paramDriver   ;collect parameters
CA0A                SMARTCOPYDIRECT:      
CA0A   CD FC C8               CALL   blockMove   ;move block
CA0D   2A C4 08               LD   hl,(COPY_DEST)   ;put destination in HL
CA10   ED 5B C0 08            LD   de,(COPY_START)   ;put start in DE
CA14   B7                     OR   a   ;clear carry
CA15   ED 52                  SBC   hl,de   ;get offset from start and destination
CA17   22 CA 08               LD   (COPY_CORR),HL   ;save offset in correction
CA1A   2A C2 08               LD   hl,(COPY_END)   ;put end in HL
CA1D   ED 5B C0 08            LD   de,(COPY_START)   ;put start in DE
CA21   B7                     OR   a   ;clear carry
CA22   ED 52                  SBC   hl,de   ;get byte count between start and end
CA24   23                     INC   hl   ;correct HL to real count
CA25   ED 5B C4 08            LD   de,(COPY_DEST)   ;put destination in DE
CA29   19                     ADD   hl,de   ;find end of destination block
CA2A   22 C8 08               LD   (COPY_EBLK),hl   ;save it
CA2D   ED 53 C6 08            LD   (COPY_PTR),de   ;save destination to pointer
CA31                CHECKINST:      
CA31   2A C6 08               LD   hl,(COPY_PTR)   ;get pointer
CA34   7E                     LD   a,(hl)   ;get instruction
CA35   CD A4 CA               CALL   getInstLen   ;get instruction length in C
CA38   79                     LD   a,c   ;get instruction count
CA39   FE 04                  CP   4   ;is it 4 bytes long?
CA3B   20 22                  JR   nz,check3   ;no, check 3
CA3D   7E                     LD   a,(hl)   ;get instruction
CA3E   FE ED                  CP   0EDH   ;is it extended instruciton?
CA40   28 17                  JR   z,fourByteAddr   ;yes, modify address
CA42   E6 DF                  AND   0DFH   ;check fo IX
CA44   FE DD                  CP   0DDH   ;and IY
CA46   20 56                  JR   nz,nextInst   ;skip, as its something else
CA48   23                     INC   hl   ;move to second byte
CA49   46                     LD   b,(hl)   ;get instruction
CA4A   2B                     DEC   hl   ;move back one byte
CA4B   78                     LD   a,b   ;check A
CA4C   E6 CF                  AND   0CFH   ;is it 21H?
CA4E   FE 01                  CP   01H   ; 
CA50   28 07                  JR   z,fourByteAddr   ;yes, modify address
CA52   78                     LD   a,b   ;check A
CA53   E6 E7                  AND   0E7H   ;is it 22H
CA55   FE 22                  CP   22H   ;or 2AH?
CA57   20 45                  JR   nz,nextInst   ;no, skip instruction
CA59                FOURBYTEADDR:      
CA59   23                     INC   hl   ;move to make 3 bytes
CA5A   22 C6 08               LD   (COPY_PTR),hl   ;save destination to pointer
CA5D   18 02                  JR   $+4   ;continue
CA5F                CHECK3:      
CA5F   FE 03                  CP   3   ;is it 3 bytes long?
CA61   20 3B                  JR   nz,nextInst   ;no, just get next instruction
CA63   7E                     LD   a,(hl)   ;get instruction
CA64   E6 DF                  AND   0DFH   ;check fo IX
CA66   FE DD                  CP   0DDH   ;and IY
CA68   28 34                  JR   z,nextInst   ;skip, as its something else
CA6A   7E                     LD   a,(hl)   ;get instruction
CA6B   E5                     PUSH   hl   ;store instruction
CA6C   D1                     POP   de   ;put in DE
CA6D   23                     INC   hl   ;put address
CA6E   4E                     LD   c,(hl)   ;in
CA6F   23                     INC   hl   ;BC
CA70   46                     LD   b,(hl)   
CA71   2A C0 08               LD   hl,(COPY_START)   ;load HL with start address
CA74   2B                     DEC   hl   
CA75   B7                     OR   a   ;clear carry
CA76   ED 42                  SBC   hl,bc   ;get target difference
CA78   30 11                  JR   nc,targetSkip   ;jump if target is less than start
CA7A   2A C2 08               LD   hl,(COPY_END)   ;load HL with end address
CA7D   B7                     OR   a   ;clear carry
CA7E   ED 42                  SBC   hl,bc   ;get target difference
CA80   38 09                  JR   c,targetSkip   ;jump if target is higher than end
CA82   2A CA 08               LD   hl,(COPY_CORR)   ;get correction factor
CA85   09                     ADD   hl,bc   ;adjust target with correction
CA86   EB                     EX   de,hl   ;put new address in DE
CA87   23                     INC   hl   ;and store
CA88   73                     LD   (hl),e   ;it
CA89   23                     INC   hl   ;back
CA8A   72                     LD   (hl),d   ;to jump/call instruction
CA8B                TARGETSKIP:      
CA8B   2A C6 08               LD   hl,(COPY_PTR)   ;get pointer
CA8E   23                     INC   hl   ;increase to next instruction
CA8F   23                     INC   hl   
CA90   23                     INC   hl   
CA91                ENDTEST:      
CA91   22 C6 08               LD   (COPY_PTR),hl   ;save new pointer
CA94   ED 5B C8 08            LD   de,(COPY_EBLK)   ;get end block
CA98   B7                     OR   a   ;clear carry
CA99   ED 52                  SBC   hl,de   ;test for finish
CA9B   38 94                  JR   c,checkInst   ;not at end, check next instruction
CA9D   C9                     RET      ;end, just return
CA9E                NEXTINST:      
CA9E   23                     INC   hl   ;move to next byte
CA9F   0D                     DEC   c   ;until new instruction
CAA0   20 FC                  JR   nz,nextInst   
CAA2   18 ED                  JR   endTest   ;jump to end test
CAA4                             ; 
CAA4                             ; Instruction byte count routine
CAA4                             ; Input: HL = address of first op code
CAA4                             ; Return: C = instruction length
CAA4                             ;         Carry Set = instruction is a RET,JP,CALL,RST
CAA4                             ; Destroys A, B
CAA4                GETINSTLEN:      
CAA4   0E 04                  LD   c,4   ;set length to longest instruction
CAA6   7E                     LD   a,(hl)   ;put first op code in A
CAA7   23                     INC   hl   
CAA8   46                     LD   b,(hl)   ;put second op code in B
CAA9   2B                     DEC   hl   ;restore HL
CAAA   E6 DF                  AND   0DFH   
CAAC   FE DD                  CP   0DDH   ;is it an IX/IY instruction
CAAE   20 12                  JR   nz,getIns2   
CAB0   78                     LD   a,b   
CAB1   FE CB                  CP   0CBH   ;is it a IX/IY Bit instruction
CAB3   30 05                  JR   nc,getIns1   
CAB5   FE 36                  CP   36H   
CAB7   C8                     RET   z   
CAB8   FE 21                  CP   21H   
CABA                GETINS1:      
CABA   C8                     RET   z   
CABB   E6 F7                  AND   0F7H   
CABD   FE 22                  CP   22H   
CABF   C8                     RET   z   
CAC0   18 0F                  JR   getIns3   
CAC2                GETINS2:      
CAC2   7E                     LD   a,(hl)   
CAC3   FE ED                  CP   0EDH   ;is it an Misc Instruction
CAC5   20 1F                  JR   nz,getIns4   
CAC7   78                     LD   a,b   
CAC8   E6 C7                  AND   0C7H   
CACA   FE 43                  CP   43H   ;does it have a 2 byte address?
CACC   C8                     RET   z   
CACD   B7                     OR   a   
CACE   0D                     DEC   c   
CACF   0D                     DEC   c   
CAD0   C9                     RET      
CAD1                GETINS3:      
CAD1   0D                     DEC   c   
CAD2   78                     LD   a,b   
CAD3   E6 B8                  AND   0B8H   
CAD5   FE 30                  CP   30H   
CAD7   C8                     RET   z   
CAD8   78                     LD   a,b   
CAD9   E6 06                  AND   06H   
CADB   FE 06                  CP   06H   
CADD   C8                     RET   z   
CADE   0D                     DEC   c   
CADF   78                     LD   a,b   
CAE0   FE E9                  CP   0E9H   
CAE2   37                     SCF      
CAE3   C8                     RET   z   
CAE4   3F                     CCF      
CAE5   C9                     RET      
CAE6                GETINS4:      
CAE6   0D                     DEC   c   
CAE7   7E                     LD   a,(hl)   
CAE8   E6 CF                  AND   0CFH   
CAEA   FE 01                  CP   01H   
CAEC   C8                     RET   z   
CAED   7E                     LD   a,(hl)   
CAEE   E6 E7                  AND   0E7H   
CAF0   FE 22                  CP   22H   
CAF2   C8                     RET   z   
CAF3   7E                     LD   a,(hl)   
CAF4   FE C3                  CP   0C3H   
CAF6   37                     SCF      
CAF7   C8                     RET   z   
CAF8   FE CD                  CP   0CDH   
CAFA   37                     SCF      
CAFB   C8                     RET   z   
CAFC   E6 C7                  AND   0C7H   
CAFE   FE C2                  CP   0C2H   
CB00   37                     SCF      
CB01   C8                     RET   z   
CB02   FE C4                  CP   0C4H   
CB04   37                     SCF      
CB05   C8                     RET   z   
CB06   0D                     DEC   c   
CB07   FE 06                  CP   06H   
CB09   C8                     RET   z   
CB0A   FE C6                  CP   0C6H   
CB0C   C8                     RET   z   
CB0D   0D                     DEC   c   
CB0E   37                     SCF      
CB0F   C8                     RET   z   
CB10   7E                     LD   a,(hl)   
CB11   E6 F7                  AND   0F7H   
CB13   C8                     RET   z   
CB14   0C                     INC   c   
CB15   7E                     LD   a,(hl)   
CB16   E6 E7                  AND   0E7H   
CB18   FE C3                  CP   0C3H   
CB1A   C8                     RET   z   
CB1B   E6 C7                  AND   0C7H   
CB1D   37                     SCF      
CB1E   C8                     RET   z   
CB1F   0D                     DEC   c   
CB20   7E                     LD   a,(hl)   
CB21   FE E9                  CP   0E9H   
CB23   37                     SCF      
CB24   C8                     RET   z   
CB25   FE C9                  CP   0C9H   
CB27   37                     SCF      
CB28   C8                     RET   z   
CB29   E6 C1                  AND   0C1H   
CB2B   FE C0                  CP   0C0H   
CB2D   37                     SCF      
CB2E   C8                     RET   z   
CB2F   3F                     CCF      
CB30   C9                     RET      
CB31                             ; 
CB31                             ; Calculate actual disassembly address from CEL
CB31                             ; Output: HL = Disassembly start address
CB31                             ; Destroy: A,DE
CB31                             ; Updates DIS_ADDR
CB31                CALCDISADDRESS:      
CB31   2A 86 08               LD   hl,(CEL)   ;get CEL
CB34   01 F9 FF               LD   bc,0FFF9H   ;set BC = -7
CB37   09                     ADD   hl,bc   ;modify HL with offset
CB38   38 03                  JR   c,disTestLoop   ;if HL <=3 then fix HL
CB3A   21 00 00               LD   hl,0   
CB3D                DISTESTLOOP:      
CB3D   22 90 08               LD   (DIS_ADDR),hl   ;update DIS_ADDR with current HL
CB40   22 29 09               LD   (DISFROM),hl   ;Store it in the disassembler start address
CB43   CD 1D E7               CALL   disStart   ;Work out next valid from address
CB46   ED 5B 86 08            LD   de,(CEL)   ;get CEL
CB4A   EB                     EX   de,hl   ;swap HL,DE
CB4B   B7                     OR   a   
CB4C   ED 52                  SBC   hl,de   ;Calculate CEL-DISFROM
CB4E   EB                     EX   de,hl   
CB4F   F2 3D CB               JP   p,disTestLoop   ;If DISFROM < CEL then
CB52   2A 90 08               LD   hl,(DIS_ADDR)   ;Store HL with previous valid disassembly address
CB55   C9                     RET      
CB56                             ; 
CB56                             ; Just move a block from A to B with no 2 byte address updates
CB56                             ; Destroys HL, DE, A, BC
CB56                DUMBCOPY:      
CB56   21 1D C9               LD   hl,blockMoveParams   
CB59   CD 7E CF               CALL   paramDriver   ;collect parameters
CB5C   C3 FC C8               JP   blockMove   ;move block
CB5F                             ; 
CB5F                             ; Restore from backup.  This is the reverse of the Backup or Smart Copy
CB5F                             ; Start = COPY_DEST
CB5F                             ; End = COPY_DEST + (COPY_END - COPY_START + 1)
CB5F                             ; Dest = COPY_START
CB5F                RESTOREBACKUP:      
CB5F   21 C0 08               LD   hl,COPY_START   
CB62   11 D0 08               LD   de,REST_DEST   
CB65   CD AA CB               CALL   HLtoDE   
CB68   21 C4 08               LD   hl,COPY_DEST   
CB6B   11 CC 08               LD   de,REST_START   
CB6E   CD AA CB               CALL   HLtoDE   
CB71   21 C0 08               LD   hl,COPY_START   
CB74   CD EC C8               CALL   checkStartEnd   
CB77   0B                     DEC   bc   
CB78   2A CC 08               LD   hl,(REST_START)   
CB7B   09                     ADD   hl,bc   
CB7C   22 CE 08               LD   (REST_END),hl   
CB7F   21 B7 C9               LD   hl,blockRestoreParams   
CB82   CD 7E CF               CALL   paramDriver   ;collect parameters
CB85   21 C0 08               LD   hl,COPY_START   
CB88   11 D2 08               LD   de,TEMP_START   
CB8B   01 06 00               LD   bc,6   
CB8E   ED B0                  LDIR      
CB90   21 CC 08               LD   hl,REST_START   
CB93   11 C0 08               LD   de,COPY_START   
CB96   01 06 00               LD   bc,6   
CB99   ED B0                  LDIR      
CB9B   CD FC C8               CALL   blockMove   ;move block
CB9E   21 D2 08               LD   hl,TEMP_START   
CBA1   11 C0 08               LD   de,COPY_START   
CBA4   01 06 00               LD   bc,6   
CBA7   ED B0                  LDIR      
CBA9   C9                     RET      
CBAA                             ; 
CBAA                HLTODE:      
CBAA   7E                     LD   a,(hl)   
CBAB   12                     LD   (de),a   
CBAC   23                     INC   hl   
CBAD   13                     INC   de   
CBAE   7E                     LD   a,(hl)   
CBAF   12                     LD   (de),a   
CBB0   C9                     RET      
CBB1                             ; 
CBB1                             ; Fill with NOP.  Fill data range with 00h or NOP instruction
CBB1                NOPFILL:      
CBB1   21 D0 CB               LD   hl,fillRangeParams   
CBB4   CD 7E CF               CALL   paramDriver   ;collect parameters
CBB7   CD 11 CE               CALL   LCDConfirm   ;this is serious mum!
CBBA   C0                     RET   nz   ;no, just exit
CBBB   21 D2 08               LD   hl,TEMP_START   ;check parameters
CBBE   CD EC C8               CALL   checkStartEnd   ; 
CBC1   30 04                  JR   nc,doFill   ;All good, continue
CBC3   E1                     POP   hl   ;remove call return from stack
CBC4   C3 0D CC               JP   displayError   ;display error if end < start
CBC7                DOFILL:      
CBC7   54                     LD   d,h   
CBC8   5D                     LD   e,l   
CBC9   13                     INC   de   
CBCA   AF                     XOR   a   
CBCB   77                     LD   (hl),a   
CBCC   0B                     DEC   bc   
CBCD   ED B0                  LDIR      
CBCF   C9                     RET      
CBD0                             ; 
CBD0                FILLRANGEPARAMS:      
CBD0   02                     DB   2   ;Three parameters
CBD1   46 49 4C 4C 20 20      DB   "FILL  "   ;7seg Text
CBD7   3D 20 20 46 69 6C 6C 20 77 69 74 68 20 4E 4F 50 73 20 20 3D 00 DB   "=  Fill with NOPs  =",0   ;Parameter title
CBEC   46 72 6F 6D 20 41 64 64 72 65 73 73 3A 00 DB   "From Address:",0   ;Text and Address
CBFA   D2 08                  DW   TEMP_START   
CBFC   54 6F 20 41 64 64 72 65 73 73 3A 00 DB   "To Address:",0   ;Text and Address
CC08   D4 08                  DW   TEMP_END   
CC0A                             ; 
CC0A                             ; 
CC0A   CD 82 C7               CALL   getToFrom   ;collect parameters
CC0D                             ; 
CC0D                             ; 
CC0D                             ; Display ERROR/PASS on the 7Segs and wait for key press
CC0D                DISPLAYERROR:      
CC0D   21 B4 D2               LD   hl,errorText   ;error text
CC10   C3 5C C8               JP   display7Segs   ;display on 7Segs and exit when key is pressed
CC13                DISPLAYPASS:      
CC13   21 AE D2               LD   hl,passText   ;pass text
CC16   C3 5C C8               JP   display7Segs   ;display on 7Segs and exit when key is pressed
CC19                DISPLAYNOFN:      
CC19   21 BA D2               LD   hl,noFnText   ;no function text
CC1C   C3 5C C8               JP   display7Segs   ;display on 7Segs and exit when key is pressed
CC1F                             ; 
CC1F                             ; Key scan routine for the Matrix Keyboard.  This routine detects up to
CC1F                             ; two key presses at the same time.  Key values stored in DE
CC1F                             ; Note: Must be called repetatively
CC1F                             ; Input: None
CC1F                             ; Output: E = Key pressed between 00H-3FH (0-64)
CC1F                             ;         D = Second key, FF=no key, 00=shift, 01=Ctrl, 02=Fn
CC1F                             ;         zero flag set if a key is pressed or combination valid
CC1F                MATRIXSCAN:      
CC1F   2E FF                  LD   l,0FFH   ;Row value accumulator. Add 8 for each ROW
CC21   11 FF FF               LD   de,0FFFFH   ;Return Values if no key is pressed
CC24   01 FE FE               LD   bc,0FEFEH   ;Port = C, A8-A15 = B. B loaded with only A8 = 0 to start.
CC27                KLINE:       
CC27   ED 78                  IN   a,(c)   ;Check data bus for Port C and high address B
CC29   2F                     CPL      ;Invert to check for zero
CC2A   E6 FF                  AND   0FFH   ;Masking of bits would happen here, but we use all 8
CC2C   28 0B                  JR   z,kDone   ;If Zero, no key press for Address line
CC2E   67                     LD   h,a   ;Save key(s) pressed data in H
CC2F   7D                     LD   a,l   ;Load A with the current ROW count*8
CC30                KBITS:       
CC30   3C                     INC   a   ;Add one until data bit found
CC31   CB 3C                  SRL   h   ;Shift H right until bit is detected
CC33   30 FB                  JR   nc,kBits   ;If Carry is not set, shift again
CC35   53                     LD   d,e   ;Load first key detected into D
CC36   5F                     LD   e,a   ;Store key detected
CC37   20 F7                  JR   nz,kBits   ;Keep going until all bits are checked.
CC39                KDONE:       
CC39   3E 08                  LD   a,8   ; 
CC3B   85                     ADD   a,l   ;Increase L by 8 for each ROW checked
CC3C   6F                     LD   l,a   
CC3D   CB 00                  RLC   b   ;Move to next address line
CC3F   38 E6                  JR   c,kLine   ;if more address lines needed repeat key check
CC41                             ; 
CC41   7B                     LD   a,e   ;Check for any key press
CC42   FE 40                  CP   40H   ;Is it a valid key?
CC44   D0                     RET   nc   ;No, exit with Zero flag false
CC45                             ; 
CC45   7A                     LD   a,d   ;Check if 1 or two key pressed
CC46   3C                     INC   a   
CC47   C8                     RET   z   ;If one key exit, D=FF, E=key
CC48                             ;Check for Shift/Ctrl/Fn keys pressed
CC48   3D                     DEC   a   
CC49   C8                     RET   z   ;Exit zero if Shift pressed
CC4A   3D                     DEC   a   
CC4B   C8                     RET   z   ;Exit zero if Control pressed
CC4C   3D                     DEC   a   
CC4D   C9                     RET      ;Exit zero if Function pressed or non zero for anything else
CC4E                             ; 
CC4E                             ; Joystick port scan routines.  This routine will return a value based on the
CC4E                             ; movement / button of the joystick or any combination: IE: UP+DOWN = 03H
CC4E                             ; Note: Must be called repetatively
CC4E                             ; Input: None
CC4E                             ; Output: A = Joystick return value between 00H-5FH (0-95)
CC4E                             ;       01H = Up        10H = Fire 2
CC4E                             ;       02H = Down      20H = Comm2 (Pin 9)
CC4E                             ;       04H = Left      40H = Fire 1
CC4E                             ;       08H = Right     80H = Fire 3
CC4E                             ;         zero flag set if no joystick value returned
CC4E                             ; Destroy: none
CC4E                JOYSTICKSCAN:      
CC4E   C5                     PUSH   bc   ;save BC
CC4F   01 FE F7               LD   bc,0F7FEH   ;Port = FE, B is only loaded with A11 = 0 (Joystick Line)
CC52   ED 78                  IN   a,(c)   ;read joystick port
CC54   2F                     CPL      ;Invert to check for zero
CC55   E6 FF                  AND   0FFH   ;Mask and set zero flag if A=0
CC57   C1                     POP   bc   ;restore BC
CC58   C9                     RET      ;Exit with A set and Zero flag
CC59                             ; 
CC59                             ; Breakpoint Entry.  Display flags and most registers on the LCD Screen.
CC59                             ; Press GO to continue executing, AD to do a soft reset.  Entry to this
CC59                             ; routine can be done by RST 30H or 0F7H
CC59                BREAKPOINT:      
CC59   CD FC CC               CALL   saveRegisters   ;save all current registers to BP stack
CC5C   CD 44 CD               CALL   saveLCD   ;save contents of DDRAM into RAM
CC5F   06 01                  LD   b,01H   ;clear LCD
CC61   CD 7B C5               CALL   commandToLCD   ;update LCD
CC64                             ; display register text on LCD
CC64   11 E6 D2               LD   de,breakPointRows   ;LCD row table
CC67   21 C6 D2               LD   hl,breakPointRegs   ;LCD resgister text
CC6A   0E 08                  LD   c,8   ;eight registers
CC6C                BPTEXT:      
CC6C   1A                     LD   a,(de)   ;get row position
CC6D   47                     LD   b,a   ;move to B
CC6E   CD 7B C5               CALL   commandToLCD   ;update LCD
CC71   13                     INC   de   
CC72   CD 62 C5               CALL   stringToLCD   ;output text (HL) to LCD
CC75   0D                     DEC   c   ;next register
CC76   20 F4                  JR   nz,bpText   ;repeat for all 8 registers
CC78                             ; 
CC78                             ;display register values next to text
CC78                BPDATA:      
CC78   11 E6 D2               LD   de,breakPointRows   ;LCD row table
CC7B   21 00 09               LD   hl,BP_BASE_SP   ;register memory location
CC7E   0E 06                  LD   c,6   ;six registers
CC80   CD D7 CC               CALL   bpPrintData   
CC83   21 14 09               LD   hl,BP_PC   ;start at PC
CC86   0E 02                  LD   c,2   ;two registers
CC88   CD D7 CC               CALL   bpPrintData   
CC8B                             ; 
CC8B                             ;display flags
CC8B   3A 00 09               LD   a,(BP_BASE_SP)   ;register AF
CC8E   4F                     LD   c,a   
CC8F   11 F6 D2               LD   de,breakPointFlagRows   
CC92   21 EE D2               LD   hl,breakPointFlags   
CC95                BPFLAGROW:      
CC95   1A                     LD   a,(de)   
CC96   B7                     OR   a   
CC97   28 16                  JR   z,bpQuery   ;No more, go to key query
CC99   47                     LD   b,a   ;move to B
CC9A   CD 7B C5               CALL   commandToLCD   ;update LCD
CC9D   13                     INC   de   
CC9E   06 02                  LD   b,2   ;two flags
CCA0                BPFLAGCOL:      
CCA0   7E                     LD   a,(hl)   
CCA1   23                     INC   HL   
CCA2   CB 01                  RLC   c   
CCA4   38 02                  JR   c,$+4   ;Skip lower case
CCA6   C6 20                  ADD   a,20H   ;Make lowercase
CCA8   CD 77 C5               CALL   charToLCD   ;send character to LCD
CCAB   10 F3                  DJNZ   bpFlagCol   
CCAD   18 E6                  JR   bpFlagRow   
CCAF                             ; 
CCAF                             ;handle keypress and exit. GO = continue, AD = Exit
CCAF                BPQUERY:      
CCAF   11 C0 D2               LD   de,breakText   ;set display buffer to Breakpoint display
CCB2   CD 4A C5               CALL   scanSegments   ;Multiplex the seven segments
CCB5   DB 03                  IN   a,(SYS_INPUT)   ;Get System input
CCB7   E6 20                  AND   20H   ;check if GIMP is set
CCB9   20 0B                  JR   nz,bpNoStop   ;simulate GO pressed
CCBB   CD B0 C5               CALL   scanKeys   ;Scan for key press
CCBE   20 EF                  JR   nz,bpQuery   ;Repeat scan until key pressed
CCC0   30 ED                  JR   nc,bpQuery   ;Skip if not new key
CCC2   FE 12                  CP   K_GO   ;is key GO
CCC4   20 07                  JR   nz,$+9   ;No, check if AD key pressed
CCC6                BPNOSTOP:      
CCC6   CD 61 CD               CALL   restoreLCD   ;restore content of LCD from RAM
CCC9   CD 28 CD               CALL   restoreRegisters   ;clean up stack and exit back to code execution
CCCC   C9                     RET      ;return back to last execution location
CCCD   FE 13                  CP   K_ADDR   ;is it the AD key (Exit back to monitor)
CCCF   20 DE                  JR   nz,bpQuery   ;no, keep scanning
CCD1   31 80 08               LD   sp,STACK_TOP   ;reset the Hardware Stack to top of stack in RAM
CCD4   C3 E8 C1               JP   softBoot   ;just do a softboot and exit
CCD7                             ; 
CCD7                BPPRINTDATA:      
CCD7   1A                     LD   a,(de)   ;get row position
CCD8   C6 03                  ADD   a,3   ;move three to the right
CCDA   47                     LD   b,a   ;move to B
CCDB   CD 7B C5               CALL   commandToLCD   ;update LCD
CCDE   13                     INC   de   ;move to next postion
CCDF   D5                     PUSH   de   ;save DE
CCE0   EB                     EX   de,hl   
CCE1   06 02                  LD   b,2   
CCE3   13                     INC   de   
CCE4                BPDATAOUT:      
CCE4   1A                     LD   a,(de)   
CCE5   CD C1 C8               CALL   regAToASCII   
CCE8   7C                     LD   a,h   
CCE9   CD 77 C5               CALL   charToLCD   ;send character to LCD
CCEC   7D                     LD   a,l   
CCED   CD 77 C5               CALL   charToLCD   ;send character to LCD
CCF0   1B                     DEC   de   
CCF1   10 F1                  DJNZ   bpDataOut   
CCF3   13                     INC   de   
CCF4   13                     INC   de   
CCF5   13                     INC   de   
CCF6   EB                     EX   de,hl   
CCF7   D1                     POP   de   
CCF8   0D                     DEC   c   
CCF9   20 DC                  JR   nz,bpPrintData   
CCFB   C9                     RET      
CCFC                             ; 
CCFC                             ; Save registers to Break Point stack.  Registers are saved in memory in
CCFC                             ; this order: AF,HL,BC,DE,IX,IY,AF",HL",BC",DE",PC,SP
CCFC                             ; Input: none
CCFC                             ; Destroys: nothing
CCFC                             ; Note: need to set BP_PC prior to calling this routine to set actual program counter
CCFC                             ; Routine is to be called from previous CALL to get Actual SP. SP=SP-4.
CCFC                             ; IE: Actual Code > RST 30H > saveRegisters. 
CCFC                SAVEREGISTERS:      
CCFC   22 02 09               LD   (BP_HL),hl   ;save HL first so to use HL in routine
CCFF   F5                     PUSH   af   ;store AF
CD00   E1                     POP   hl   ;HL = AF
CD01   22 00 09               LD   (BP_BASE_SP),hl   ;save AF as flags get corrupt below
CD04   21 04 00               LD   hl,4   ;set HL to calling SP
CD07   39                     ADD   hl,sp   ;HL = SP+4
CD08   22 16 09               LD   (BP_ORIG_SP),hl   ;save actual SP
CD0B   31 14 09               LD   sp,BP_REGS   ;set SP to use Break Point stack
CD0E   08                     EX   af,af'   ;start saving registers
CD0F   D9                     EXX      
CD10   D5                     PUSH   de   
CD11   C5                     PUSH   bc   
CD12   E5                     PUSH   hl   
CD13   F5                     PUSH   af   
CD14   08                     EX   af,af'   
CD15   D9                     EXX      
CD16   FD E5                  PUSH   iy   
CD18   DD E5                  PUSH   ix   
CD1A   D5                     PUSH   de   
CD1B   C5                     PUSH   bc   
CD1C   2A 02 09               LD   hl,(BP_HL)   ;restore original hl
CD1F   ED 7B 16 09            LD   sp,(BP_ORIG_SP)   ;restore hardware stack
CD23   3B                     DEC   sp   ;to 
CD24   3B                     DEC   sp   ;acutal 
CD25   3B                     DEC   sp   ;position prior
CD26   3B                     DEC   sp   ;to calling this routine
CD27   C9                     RET      
CD28                             ; 
CD28                             ; Restore registers.  Replace CPU registers with values stored in the BreakPoint buffer
CD28                             ; A call to saveRegisters is to be called prior
CD28                             ; Input: none
CD28                             ; Output: Updates registers AF,HL,BC,DE,IX,IY,AF",HL",BC" and DE"
CD28                RESTOREREGISTERS:      
CD28   ED 73 16 09            LD   (BP_ORIG_SP),sp   
CD2C   31 00 09               LD   sp,BP_BASE_SP   
CD2F   F1                     POP   af   
CD30   E1                     POP   hl   
CD31   C1                     POP   bc   
CD32   D1                     POP   de   
CD33   DD E1                  POP   ix   
CD35   FD E1                  POP   iy   
CD37   08                     EX   af,af'   
CD38   D9                     EXX      
CD39   F1                     POP   af   
CD3A   E1                     POP   hl   
CD3B   C1                     POP   bc   
CD3C   D1                     POP   de   
CD3D   08                     EX   af,af'   
CD3E   D9                     EXX      
CD3F   ED 7B 16 09            LD   sp,(BP_ORIG_SP)   
CD43   C9                     RET      
CD44                             ; 
CD44                             ; Save LCD screen contents.  Copy LCD DDRAM contents to RAM location BP_LCD.  
CD44                             ; Input: none
CD44                             ; Output: Writes 80 bytes (20x4) of LCD DDRAM to BP_LCD address (08B8H-0908H)
CD44                             ; Destroys: A, BC, HL
CD44                SAVELCD:      
CD44   06 80                  LD   b,LCD_ROW1   ;Set DDRAM address counter to Row 1
CD46   CD 7B C5               CALL   commandToLCD   ;Send instruction to LCD
CD49   21 18 09               LD   hl,BP_LCD   ;set HL to LCD RAM location
CD4C   01 84 28               LD   bc,40*100H+LCD_DATA   ;40 bytes to read, Port LCD_DATA
CD4F   EF                     RST   28H   ;ensure LCD isn't busy
CD50   ED A2                  INI      ;read port C, into (HL), inc HL, dec B
CD52   20 FB                  JR   nz,$-3   ;Do unitl B=0
CD54                             ; 
CD54   06 C0                  LD   b,LCD_ROW2   ;Set DDRAM address counter to Row 2
CD56   CD 7B C5               CALL   commandToLCD   ;Send instruction to LCD
CD59   06 28                  LD   b,40   ;40 bytes to read
CD5B   EF                     RST   28H   ;ensure LCD isn't busy
CD5C   ED A2                  INI      ;read port C, into (HL), inc HL, dec B
CD5E   20 FB                  JR   nz,$-3   ;Do unitl B=0
CD60   C9                     RET      
CD61                             ; 
CD61                             ; Restore LCD screen contents.  Copy RAM location BP_LCD to LCD DDRAM
CD61                             ; A call to saveLCD is to be called prior
CD61                             ; Input: none
CD61                             ; Output: Updates LCD with values at BP_LCD (08B8H-0908H)
CD61                             ; Destroys: A, BC, HL
CD61                RESTORELCD:      
CD61   06 80                  LD   b,LCD_ROW1   ;Set DDRAM address counter to Row 1
CD63   CD 7B C5               CALL   commandToLCD   ;Send instruction to LCD
CD66   21 18 09               LD   hl,BP_LCD   ;set HL to LCD RAM location
CD69   01 84 28               LD   bc,40*100H+LCD_DATA   ;40 bytes to read, Port LCD_DATA
CD6C   EF                     RST   28H   ;ensure LCD isn't busy
CD6D   ED A3                  OUTI      ;write to port C, from (HL), inc HL, dec B
CD6F   20 FB                  JR   nz,$-3   ;Do unitl B=0
CD71                             ; 
CD71   06 C0                  LD   b,LCD_ROW2   ;Set DDRAM address counter to Row 2
CD73   CD 7B C5               CALL   commandToLCD   ;Send instruction to LCD
CD76   06 28                  LD   b,40   ;40 bytes to read
CD78   EF                     RST   28H   ;ensure LCD isn't busy
CD79   ED A3                  OUTI      ;write to port C, from (HL), inc HL, dec B
CD7B   20 FB                  JR   nz,$-3   ;Do unitl B=0
CD7D   C9                     RET      
CD7E                             ; 
CD7E                             ; Set the address of a Quick Jump CEL
CD7E                             ; Input: none
CD7E                             ; Destroys: All
CD7E                SETCELQUICKJUMP:      
CD7E   CD EB C4               CALL   beep   ;beep the speaker bit
CD81   06 01                  LD   b,01H   ;clear LCD
CD83   CD 7B C5               CALL   commandToLCD   ;update LCD
CD86   21 FB D2               LD   hl,CELJumpText   ;point to CEL Jump text
CD89   CD 62 C5               CALL   stringToLCD   ;write text
CD8C   06 C9                  LD   b,0C9H   ;set cursor to Row 2,Col 9
CD8E   CD 7B C5               CALL   commandToLCD   ;update LCD
CD91   21 10 D3               LD   hl,CELHelpText   ;point to CEL Help text
CD94   CD 62 C5               CALL   stringToLCD   ;write text
CD97   0E 03                  LD   c,3   ;three values
CD99   11 1E D2               LD   de,LCDBaseRows+3   ;set de to last row
CD9C   21 A7 08               LD   hl,CEL_QJMP+5   ;move to last entry
CD9F                PRINTCELROW:      
CD9F   1A                     LD   a,(de)   ;get column
CDA0   47                     LD   b,a   ;set B as LCD row
CDA1   CD 7B C5               CALL   commandToLCD   ;update LCD
CDA4   79                     LD   a,c   ;get location value
CDA5   C6 30                  ADD   a,30H   ;adjust for ascii
CDA7   CD 77 C5               CALL   charToLCD   ;send character to LCD
CDAA   3E 3A                  LD   a,COLON   
CDAC   CD 77 C5               CALL   charToLCD   ;send character to LCD
CDAF   06 02                  LD   b,2   ;two nibbles
CDB1                PRINTHL:      
CDB1   E5                     PUSH   hl   ;save CEL jump table
CDB2   7E                     LD   a,(hl)   ;get nibble
CDB3   CD C1 C8               CALL   regAToASCII   
CDB6   7C                     LD   a,h   
CDB7   CD 77 C5               CALL   charToLCD   ;send character to LCD
CDBA   7D                     LD   a,l   
CDBB   CD 77 C5               CALL   charToLCD   ;send character to LCD
CDBE   E1                     POP   hl   ;restore CEL jump table
CDBF   2B                     DEC   hl   ;move to next nibble
CDC0   10 EF                  DJNZ   printHL   
CDC2   1B                     DEC   de   ;move to next column
CDC3   0D                     DEC   c   ;move to next location
CDC4   20 D9                  JR   nz,printCELRow   ;do next row
CDC6                             ; LCD displayed, now get key
CDC6                CELKEYPRESS:      
CDC6   CF                     RST   08H   ;get key and wait
CDC7   FE 13                  CP   K_ADDR   ;is it address?
CDC9   C8                     RET   z   ;yes, just exit
CDCA   3D                     DEC   a   ;adjust key for index
CDCB   FE 03                  CP   3   ;check for range 0-2
CDCD   30 F7                  JR   nc,CELKeyPress   ;loop again until 1-3,AD is pressed
CDCF   21 86 08               LD   hl,CEL   ;get CEL
CDD2   11 A2 08               LD   de,CEL_QJMP   ;point to table
CDD5                QJMPTOCEL:      
CDD5   87                     ADD   a,a   ;double for index
CDD6   83                     ADD   a,e   ;index it
CDD7   5F                     LD   e,a   
CDD8   01 02 00               LD   bc,2   ;two bytes
CDDB   ED B0                  LDIR      
CDDD                             ; Check for RTC installed
CDDD   3A 88 08               LD   a,(MCB)   ;get MCB
CDE0   E6 40                  AND   MCB_RTC   ;is bit 6 set?
CDE2   C8                     RET   z   ;no just exit
CDE3   1B                     DEC   de   
CDE4   1B                     DEC   de   
CDE5   EB                     EX   de,hl   ;reset QJMP address and make it HL
CDE6   7D                     LD   a,l   
CDE7   D6 A2                  SUB   0A2H   ;take base off to get RTC slot
CDE9   CD 5C CE               CALL   RTCSetPRAM   ;save it to RTC
CDEC   C9                     RET      
CDED                             ; 
CDED                GETCELQUICKJUMP:      
CDED   11 86 08               LD   de,CEL   ;get CEL
CDF0   21 A2 08               LD   hl,CEL_QJMP   ;point to table
CDF3                             ;reg c=key
CDF3   79                     LD   a,c   ;get key pressed
CDF4   3D                     DEC   a   ;adjust for index
CDF5   87                     ADD   a,a   ;double for index
CDF6   85                     ADD   a,l   ;index it
CDF7   6F                     LD   l,a   
CDF8   7E                     LD   a,(hl)   ;hl = (hl)
CDF9   23                     INC   hl   
CDFA   66                     LD   h,(hl)   
CDFB   6F                     LD   l,a   
CDFC   22 86 08               LD   (CEL),hl   
CDFF   C3 E0 C4               JP   setDataBase   ;set the DATA_BASE variable
CE02                             ; 
CE02                             ; Serial Enable.  Sets the TX line to high ready for serial transfer
CE02                             ; Input: none
CE02                             ; Destroys: A
CE02                SERIALENABLE:      
CE02   3E 40                  LD   a,40H   ;Serial TX bit
CE04   D3 01                  OUT   (DIGITS),a   ;Set it high
CE06   3E 44                  LD   a,44H   ;Set Tri colour LEDs to Disco Blue
CE08   D3 02                  OUT   (SEGS),a   ;output it
CE0A   C9                     RET      
CE0B                             ; 
CE0B                             ; Serial Disable.  Sets the TX line to low disabling serial transfer
CE0B                             ; Input: none
CE0B                             ; Destroys: A
CE0B                SERIALDISABLE:      
CE0B   AF                     XOR   a   ;clear A
CE0C   D3 01                  OUT   (DIGITS),a   ;Set it segment display off
CE0E   D3 02                  OUT   (SEGS),a   ;Clear segment leds
CE10   C9                     RET      
CE11                             ; 
CE11                             ; Confirmation LCD Question.  Press "C" to confirm or any other key to not confirm
CE11                             ; Input: none
CE11                             ; Return: Zero Flag Set === Confirmed
CE11                LCDCONFIRM:      
CE11   21 3C D3               LD   hl,confirmText   
CE14   06 01                  LD   b,01H   ;clear LCD instruction
CE16   CD 7B C5               CALL   commandToLCD   ;update LCD
CE19   CD 62 C5               CALL   stringToLCD   ;Display Message on LCD
CE1C   CF                     RST   08H   ;get key and wait
CE1D   FE 0C                  CP   0CH   ;is it C? Set Zero Flag
CE1F   C9                     RET      
CE20                             ; 
CE20                             ; Real Time Clock (RTC) Routines
CE20                             ; ------------------------------
CE20                             ; 
CE20                             ; Nicely reset RTC PRAM by asking the question first!
CE20                RTCRESET:      
CE20   CD 11 CE               CALL   LCDConfirm   ;check before proceding TISM
CE23   C0                     RET   nz   ;no, just exit
CE24                             ;fall through to next routine
CE24                             ; 
CE24                             ; Reset Mon3 RTC PRAM data to default values.
CE24                             ; Input: none
CE24                             ; Destroys: none
CE24                RESETRTCPRAM:      
CE24   CD E5 F8               CALL   resetDS1302   ;Reset RTC Time/Date to start it off
CE27   01 00 08               LD   bc,0800H   ;B=eight 2 byte addresses, C=slot 0
CE2A   21 00 40               LD   hl,USER_ADDR   ;default to 4000H
CE2D                RTCRESETLOOP1:      
CE2D   51                     LD   d,c   ;load slot
CE2E   5D                     LD   e,l   ;load LSB
CE2F   CD 73 FA               CALL   writeRTCByte   ; 
CE32   0C                     INC   c   ;next slot
CE33   51                     LD   d,c   ;load slot
CE34   5C                     LD   e,h   ;load MSB
CE35   CD 73 FA               CALL   writeRTCByte   ; 
CE38   0C                     INC   c   ;next slot
CE39   3E 0C                  LD   a,0CH   ;are we on the last 4 slots?
CE3B   91                     SUB   c   
CE3C   20 02                  JR   nz,$+4   ;no, ignore
CE3E   26 00                  LD   h,00H   ;yes, set H=0
CE40   10 EB                  DJNZ   RTCResetLoop1   
CE42   CD 6D CE               CALL   RTCfillRAM   ;fill RTC PRAM to Mon3 Ram
CE45                             ; 
CE45                             ;get checksum
CE45                RTCSAVECHECKSUM:      
CE45   CD 5D FD               CALL   getRTCChecksum   ;get new checksum
CE48   16 1E                  LD   d,30   ;load slot 30
CE4A   5F                     LD   e,a   ;load with new checksum
CE4B   C3 73 FA               JP   writeRTCByte   ;save checksum
CE4E                             ; 
CE4E                             ; Get two byte value from PRAM
CE4E                             ; Input: A = first slot value
CE4E                             ; Output: HL = two byte value where L=slot, H=slot+1
CE4E                RTCGETPRAM:      
CE4E   F5                     PUSH   af   
CE4F   57                     LD   d,a   
CE50   CD 64 FA               CALL   readRTCByte   
CE53   6F                     LD   l,a   
CE54   F1                     POP   af   
CE55   3C                     INC   a   
CE56   57                     LD   d,a   
CE57   CD 64 FA               CALL   readRTCByte   
CE5A   67                     LD   h,a   
CE5B   C9                     RET      
CE5C                             ; 
CE5C                             ; Set two byte value to PRAM
CE5C                             ; Input: A = first slot value
CE5C                             ;        HL = address of value to write to
CE5C                RTCSETPRAM:      
CE5C   F5                     PUSH   af   
CE5D   57                     LD   d,a   
CE5E   5E                     LD   e,(hl)   
CE5F   CD 73 FA               CALL   writeRTCByte   
CE62   F1                     POP   af   
CE63   23                     INC   hl   
CE64   3C                     INC   a   
CE65   57                     LD   d,a   
CE66   5E                     LD   e,(hl)   
CE67   CD 73 FA               CALL   writeRTCByte   
CE6A   C3 45 CE               JP   RTCSaveChecksum   
CE6D                             ; 
CE6D                             ; Copy the RTC PRAM to Mon3 RAM locations
CE6D                RTCFILLRAM:      
CE6D                             ;Set CEL Jump Table from PRAM (Ugly code here!!)
CE6D   3E 00                  LD   a,0   ;get 1st slot
CE6F   CD 4E CE               CALL   RTCGetPRAM   
CE72   22 A2 08               LD   (CEL_QJMP),hl   
CE75   3E 02                  LD   a,2   ;get 3rd slot
CE77   CD 4E CE               CALL   RTCGetPRAM   
CE7A   22 A4 08               LD   (CEL_QJMP+2),hl   
CE7D   3E 04                  LD   a,4   ;get 5th slot
CE7F   CD 4E CE               CALL   RTCGetPRAM   
CE82   22 A6 08               LD   (CEL_QJMP+4),hl   
CE85                             ;Set Copy/To/Dest from PRAM
CE85   3E 06                  LD   a,6   ;get 7th slot
CE87   CD 4E CE               CALL   RTCGetPRAM   
CE8A   22 C0 08               LD   (COPY_START),hl   
CE8D   3E 08                  LD   a,8   ;get 9th slot
CE8F   CD 4E CE               CALL   RTCGetPRAM   
CE92   22 C2 08               LD   (COPY_END),hl   
CE95   3E 0A                  LD   a,10   ;get 11th slot
CE97   CD 4E CE               CALL   RTCGetPRAM   
CE9A   22 C4 08               LD   (COPY_DEST),hl   
CE9D   C9                     RET      
CE9E                             ; 
CE9E                             ; Menu Initialise.  Set a custom user menu on the LCD. 
CE9E                             ; Input: HL = Pointer to Menu configuration.
CE9E                             ; Destroys: A, HL
CE9E                MENUINIT:      
CE9E   CD B8 CE               CALL   menuReset   ;reset menu variables
CEA1   D5                     PUSH   de   ;store DE
CEA2   3A 9B 08               LD   a,(MENU_IDX)   ;get menu index
CEA5   3C                     INC   a   ;move to next index
CEA6   E6 03                  AND   03H   ;reset to 0 if 4
CEA8   32 9B 08               LD   (MENU_IDX),a   ;save it
CEAB   87                     ADD   a,a   ;double it
CEAC   11 A8 08               LD   de,MENU_CFG_D   ;get config depth table
CEAF   83                     ADD   a,e   ;index table
CEB0   5F                     LD   e,a   ;to index postion
CEB1   7D                     LD   a,l   ;(DE) = HL
CEB2   12                     LD   (de),a   
CEB3   13                     INC   de   
CEB4   7C                     LD   a,h   
CEB5   12                     LD   (de),a   
CEB6   D1                     POP   de   ;restore DE
CEB7   C9                     RET      
CEB8                             ; 
CEB8                             ; Reset the menu variables for setting up a new menu
CEB8                             ; Input: HL = Pointer to Menu configuration.
CEB8                             ; Destroys: A
CEB8                MENURESET:      
CEB8   AF                     XOR   a   ;clear A
CEB9   32 96 08               LD   (MENU_POS),a   ;set menu position to first
CEBC   32 97 08               LD   (MENU_SEL),a   ;set first item to be selected
CEBF   7E                     LD   a,(hl)   ;get menu count
CEC0   32 98 08               LD   (MENU_CNT),a   ;save menu count
CEC3   22 99 08               LD   (MENU_CFG),hl   ;store new menu configuration
CEC6   C9                     RET      
CEC7                             ; 
CEC7                             ; Revert the menu to the previous one if any.
CEC7                             ; Input: none
CEC7                             ; Destroy: A
CEC7                MENUPOP:      
CEC7   3A 9B 08               LD   a,(MENU_IDX)   ;get current menu index
CECA   3D                     DEC   a   ;reduce by one
CECB   32 9B 08               LD   (MENU_IDX),a   ;save it back
CECE   FA 44 C6               JP   m,switchMode   ;if a < 0, switch to Data mode and return
CED1   87                     ADD   a,a   ;double it
CED2   E5                     PUSH   hl   ;save HL
CED3   21 A8 08               LD   hl,MENU_CFG_D   ;get config depth table
CED6   85                     ADD   a,l   ;index table
CED7   6F                     LD   l,a   ;to index postion
CED8   7E                     LD   a,(hl)   ;get low byte
CED9   23                     INC   hl   
CEDA   66                     LD   h,(hl)   ;get high byte
CEDB   6F                     LD   l,a   ;make HL = (HL)
CEDC   CD B8 CE               CALL   menuReset   ;reset menu to new menu
CEDF   E1                     POP   hl   ;restore HL
CEE0   C9                     RET      
CEE1                             ; 
CEE1                             ; Menu Draw routine.  Title, then menu items from MENU_POS
CEE1                MENUDRAW:      
CEE1   06 01                  LD   b,01H   ;clear LCD instruction
CEE3   CD 7B C5               CALL   commandToLCD   ;update LCD
CEE6   2A 99 08               LD   hl,(MENU_CFG)   ;load menu config
CEE9   23                     INC   hl   ;move to seven segment text
CEEA                             ;set segment text
CEEA   11 80 08               LD   de,DISP_BUFF   ;store in Monitor 7seg Buffer
CEED   06 06                  LD   b,6   
CEEF                LCDSEGLOOP:      
CEEF   7E                     LD   a,(hl)   
CEF0   CD 58 C6               CALL   ASCIItoSegment   ;convert A to segment code
CEF3   12                     LD   (de),a   
CEF4   23                     INC   hl   
CEF5   13                     INC   de   
CEF6   10 F7                  DJNZ   LCDSegLoop   
CEF8                             ;HL is now at menu title
CEF8   CD 62 C5               CALL   stringToLCD   ;send Title to LCD
CEFB   3A 96 08               LD   a,(MENU_POS)   ;get current menu selection
CEFE   CD 5B CF               CALL   menuIndex   ;set HL to menu config at index A
CF01   0E 03                  LD   c,3   ;three rows
CF03   3A 98 08               LD   a,(MENU_CNT)   ;get menu count
CF06   B9                     CP   c   ;is it 3 or less?
CF07   30 01                  JR   nc,$+3   ;yes, skip setting b=count
CF09   4F                     LD   c,a   ;set rows to max count
CF0A   11 1C D2               LD   de,LCDBaseRows+1   ;LCD rows 2,3,4
CF0D                DRAWLOOP:      
CF0D   1A                     LD   a,(de)   ;get row value
CF0E   47                     LD   b,a   ;set B as LCD row
CF0F   04                     INC   b   ;move one to the right
CF10   CD 7B C5               CALL   commandToLCD   ;update LCD
CF13   CD 62 C5               CALL   stringToLCD   ;write menu item
CF16   3A 88 08               LD   a,(MCB)   ;get MCB
CF19   E6 20                  AND   MCB_MEN_PAR   ;check to see if menu or parameter structure
CF1B   28 21                  JR   z,drawHLSkip   ;menu so skip HL draw
CF1D   1A                     LD   a,(de)   ;get row value
CF1E   C6 10                  ADD   a,16   ;right justify
CF20   47                     LD   b,a   ;set B as LCD row/column
CF21   CD 7B C5               CALL   commandToLCD   ;update LCD                
CF24   E5                     PUSH   hl   ;save HL
CF25   7E                     LD   a,(hl)   ;store ram
CF26   23                     INC   hl   ;address
CF27   66                     LD   h,(hl)   ;back into
CF28   6F                     LD   l,a   ;HL
CF29   23                     INC   hl   ;move to high byte
CF2A   06 02                  LD   b,2   ;type bytes
CF2C                DRAWHL:      
CF2C   7E                     LD   a,(hl)   ;get byte
CF2D   E5                     PUSH   hl   ;save HL
CF2E   CD C1 C8               CALL   regAToASCII   
CF31   7C                     LD   a,h   
CF32   CD 77 C5               CALL   charToLCD   ;send character to LCD
CF35   7D                     LD   a,l   
CF36   CD 77 C5               CALL   charToLCD   ;send character to LCD
CF39   E1                     POP   hl   ;restore HL
CF3A   2B                     DEC   hl   ;move to low byte
CF3B   10 EF                  DJNZ   drawHL   ;do next byte
CF3D   E1                     POP   hl   ;restore HL
CF3E                DRAWHLSKIP:      
CF3E   23                     INC   hl   ;skip jump
CF3F   23                     INC   hl   
CF40   13                     INC   de   ;move to next row
CF41   0D                     DEC   c   ;get next row
CF42   20 C9                  JR   nz,drawLoop   ;if any
CF44                             ;draw pointer
CF44   3A 96 08               LD   a,(MENU_POS)   ;get menu text pos
CF47   47                     LD   b,a   
CF48   3A 97 08               LD   a,(MENU_SEL)   ;get selection
CF4B   90                     SUB   b   ;A = 0,1 or 2
CF4C   11 1C D2               LD   de,LCDBaseRows+1   ;LCD rows 2,3,4
CF4F   83                     ADD   a,e   ;index DE (same page!)
CF50   5F                     LD   e,a   
CF51   1A                     LD   a,(de)   ;get row index
CF52   47                     LD   b,a   
CF53   CD 7B C5               CALL   commandToLCD   ;update LCD
CF56   3E 7E                  LD   a,MENU_PTR   ;display ->
CF58   C3 77 C5               JP   charToLCD   ;display it and exit
CF5B                             ; 
CF5B                             ; Index menu configuration with A
CF5B                             ; Input: A = index
CF5B                             ; Output: HL = position of menu entry text.
CF5B                MENUINDEX:      
CF5B   47                     LD   b,a   ;save index
CF5C   2A 99 08               LD   hl,(MENU_CFG)   ;get configuration
CF5F   7E                     LD   a,(hl)   ;skip menu title and 7seg/count data (can't be zero)
CF60   23                     INC   hl   
CF61   B7                     OR   a   ;is it zero
CF62   20 FB                  JR   nz,$-3   ;repeat until zero found
CF64   78                     LD   a,b   ;is index zero?
CF65   B7                     OR   a   ;yes
CF66   C8                     RET   z   ;HL in correct spot
CF67                INDEXLOOP:      
CF67   7E                     LD   a,(hl)   ;skip menu entry
CF68   23                     INC   hl   
CF69   B7                     OR   a   ;is it zero
CF6A   20 FB                  JR   nz,$-3   ;repeat until zero found
CF6C   23                     INC   hl   ;move to next menu entry
CF6D   23                     INC   hl   
CF6E   10 F7                  DJNZ   indexLoop   ;keep going until done
CF70   C9                     RET      
CF71                             ; 
CF71                             ; Menu driver for external applications.  Creates a selectable custom menu
CF71                             ; Keys: Go = Select menu item, AD = Exit Menu, +/- = Navigate menu
CF71                             ; Input: HL = Pointer to Menu configuration. (See Note)
CF71                             ; Destroys: A, HL
CF71                             ; Note: Menu configuration is as follows.  All strings are ZERO terminated!
CF71                             ; <Menu Entries>, <7Seg Text>, <Menu Text Title>,
CF71                             ;        [<Menu Text Label>, <Menu Routine Address>]+
CF71                             ; EG: .db 2             ;Two menu items
CF71                             ;     .db "Games "      ;7Seg Text
CF71                             ;     .db "Games",0     ;Menu title
CF71                             ;     .db "TEC Invaders",0  ;Text and Routine
CF71                             ;     .dw invaders
CF71                             ;     .db "TEC Maze",0  ;Text and routine
CF71                             ;     .dw maze
CF71                MENUDRIVER:      
CF71   CD 9E CE               CALL   menuInit   ;Initialise the internal memory with menu config
CF74   21 88 08               LD   hl,MCB   ;set MCB
CF77   CB DE                  SET   3,(hl)   ;into LCD mode
CF79   E1                     POP   hl   ;pop return address of rst 10
CF7A   E1                     POP   hl   ;pop return address of GO call
CF7B   C3 05 C2               JP   setLCD   ;hook into monitor menu controller
CF7E                             ; 
CF7E                             ; Parameter data entry driver.  Creates a list of editable two byte parameters
CF7E                             ; utilising the menu handler.
CF7E                             ; Keys: Go = Continue, AD = Exit, +/- = Navigate, 0-F = enter values
CF7E                             ; Input: HL = Pointer to Parameter configuration. (See Note)
CF7E                             ; Note: Parameter configuration is as follows.  All strings are ZERO terminated!
CF7E                             ; Parameter text can be no longer than 14 characters
CF7E                             ; <No. of Entries>, <7Seg Text>, <Parameter Title Text>,
CF7E                             ;      [<Param Text Label>, <Param RAM Address>]+
CF7E                             ; EG: .db 3             ;Three parameters
CF7E                             ;     .db "Params"      ;7seg text
CF7E                             ;     .db "= Enter Parameters =",0     ;Parameter title
CF7E                             ;     .db "Start Address:",0  ;Text and Address
CF7E                             ;     .dw COPY_START
CF7E                             ;     .db "End Address:",0  ;Text and Address
CF7E                             ;     .dw COPY_END
CF7E                             ;     .db "Dest. Address:",0  ;Text and Address
CF7E                             ;     .dw COPY_DEST
CF7E                PARAMDRIVER:      
CF7E   CD 9E CE               CALL   menuInit   ;Initialise the internal memory with param config
CF81   21 88 08               LD   hl,MCB   ;set MCB
CF84   CB DE                  SET   3,(hl)   ;into LCD mode
CF86   CB EE                  SET   5,(hl)   ;and Parameter Entry mode
CF88   C3 05 C2               JP   setLCD   ;hook into monitor menu controller    
CF8B                             ; 
CF8B                             ; Get Caps lock state
CF8B                             ; Input: none
CF8B                             ; Output: A = caps lock state; 0 = off, CAPSLOCK = on
CF8B                GETCAPS:      
CF8B   3A 9C 08               LD   a,(CAPS_LOCK)   ; fetch current value
CF8E   C9                     RET      
CF8F                             ; 
CF8F                             ; Get GLCD Terminal state
CF8F                             ; Input: none
CF8F                             ; Output: A = GLCD Terminal state; 0 = off, FF = on
CF8F                GETGLCDTERM:      
CF8F   3A 8F 08               LD   a,(GLCD_TERM)   ; fetch current value
CF92   C9                     RET      
CF93                             ; 
CF93                             ; Get SHADOW state
CF93                             ; Input: none
CF93                             ; Output: A = shadow state; 0 = off, SHADOW = on
CF93                GETSHADOW:      
CF93   3A 9D 08               LD   a,(SYS_MODE)   ; fetch current value
CF96   E6 01                  AND   SHADOW   ; return SHADOW bit only
CF98   EE 01                  XOR   SHADOW   ; flip bit becuase active low
CF9A   C9                     RET      
CF9B                             ; 
CF9B                             ; Get PROTECT state
CF9B                             ; Input: none
CF9B                             ; Output: A = protect state; 0 = off
CF9B                GETPROTECT:      
CF9B   3A 9E 08               LD   a,(PROT_MODE)   ; fetch current value
CF9E   C9                     RET      
CF9F                             ; 
CF9F                             ; Get EXPAND state
CF9F                             ; Input: none
CF9F                             ; Output: A = expand state; 0 = off
CF9F                GETEXPAND:      
CF9F   3A 9D 08               LD   a,(SYS_MODE)   ; fetch current value
CFA2   E6 04                  AND   EXPAND   ; return EXPAND bit only
CFA4   C9                     RET      
CFA5                             ; 
CFA5                             ; Set Caps lock state
CFA5                             ; Input: A = Desired caps lock state; 0 = off, CAPSLOCK = on
CFA5                             ; Destroy: A
CFA5                SETCAPS:      
CFA5   C5                     PUSH   bc   
CFA6   E6 80                  AND   CAPSLOCK   ; ensure only correct bit is accepted
CFA8   32 9C 08               LD   (CAPS_LOCK),a   ; save caps lock
CFAB   47                     LD   b,a   ; save A in B
CFAC   3A 9D 08               LD   a,(SYS_MODE)   ; get current state
CFAF   E6 7F                  AND   CAPSLOCK-1   ; clear bit
CFB1                UPDATEMODE:      
CFB1   B0                     OR   b   ; set new bit state from B
CFB2   D3 FF                  OUT   (SYS_CTRL),a   
CFB4   32 9D 08               LD   (SYS_MODE),a   
CFB7   C1                     POP   bc   
CFB8   C9                     RET      
CFB9                             ; 
CFB9                             ; Set GLCD Terminal state
CFB9                             ; Input: A = Desired GLCD Terminal state; 0 = off, FF = on
CFB9                             ; Destroy: A
CFB9                SETGLCDTERM:      
CFB9   B7                     OR   a   ; check for zero
CFBA   28 02                  JR   z,$+4   ; yes, skip force FF
CFBC   3E FF                  LD   a,0FFH   ; set to FF
CFBE   32 8F 08               LD   (GLCD_TERM),a   ; save glcd termnial flag
CFC1   C3 15 D0               JP   initGLCDTerminal   ; set GLCD based on flag
CFC4                             ; 
CFC4                             ; Set SHADOW state
CFC4                             ; Input: A = Desired SHADOW state; 0 = off, SHADOW = on
CFC4                             ; Destroy: A
CFC4                SETSHADOW:      
CFC4   C5                     PUSH   bc   
CFC5   E6 01                  AND   SHADOW   ; ensure only correct is accepted
CFC7   AF                     XOR   a   ; flip bit because active low
CFC8   47                     LD   b,a   ; save A in B
CFC9   3A 9D 08               LD   a,(SYS_MODE)   ; get current state
CFCC   E6 FE                  AND   -SHADOW-1   ; clear bit
CFCE   18 E1                  JR   updateMode   ; set mode and exit
CFD0                             ; 
CFD0                             ; Set PROTECT state
CFD0                             ; Input: A = Desired Protect state; 0 = off, PROTECT = on
CFD0                             ; Destroy: A
CFD0                SETPROTECT:      
CFD0   C5                     PUSH   bc   
CFD1   E6 02                  AND   PROTECT   ; ensure only correct bit is accepted
CFD3   32 9E 08               LD   (PROT_MODE),a   ; save prot mode
CFD6   47                     LD   b,a   ; save A in B
CFD7   3A 9D 08               LD   a,(SYS_MODE)   ; get current state
CFDA   E6 FD                  AND   -PROTECT-1   ; clear bit
CFDC   18 D3                  JR   updateMode   ; set mode and exit
CFDE                             ; 
CFDE                             ; Set EXPAND state
CFDE                             ; Input: A = Desired Expand state; 0 = off, EXPAND = on
CFDE                             ; Destroy: A
CFDE                SETEXPAND:      
CFDE   C5                     PUSH   bc   
CFDF   E6 04                  AND   EXPAND   ; ensure only correct bit is accepted
CFE1   32 9F 08               LD   (XPND_MODE),a   ; Save expand
CFE4   47                     LD   b,a   ; save A in B
CFE5   3A 9D 08               LD   a,(SYS_MODE)   ; get current state
CFE8   E6 FB                  AND   -EXPAND-1   ; clear bit
CFEA   18 C5                  JR   updateMode   ; set mode and exit
CFEC                             ; 
CFEC                             ; Toggle Caps Lock
CFEC                             ; Input: none
CFEC                             ; Destroy: A
CFEC                TOGGLECAPS:      
CFEC   3A 9C 08               LD   a,(CAPS_LOCK)   ; get caps lock mode status
CFEF   EE 80                  XOR   CAPSLOCK   ; toggle bit
CFF1   32 9C 08               LD   (CAPS_LOCK),a   ; return it back
CFF4   3A 9D 08               LD   a,(SYS_MODE)   ; get current state
CFF7   EE 80                  XOR   CAPSLOCK   ; toggle bit
CFF9                UPDATECTL:      
CFF9   D3 FF                  OUT   (SYS_CTRL),a   ; update latch
CFFB   32 9D 08               LD   (SYS_MODE),a   ; save state
CFFE   C9                     RET      
CFFF                             ; 
CFFF                             ; Toggle EXPAND
CFFF                             ; Input: none
CFFF                             ; Destroy: A
CFFF                TOGGLEEXPAND:      
CFFF   3A 9F 08               LD   a,(XPND_MODE)   ; get expand mode status
D002   EE 04                  XOR   EXPAND   ; toggle bit
D004   32 9F 08               LD   (XPND_MODE),a   ; return it back
D007   3A 9D 08               LD   a,(SYS_MODE)   ; get current state
D00A   EE 04                  XOR   EXPAND   ; toggle bit
D00C   18 EB                  JR   updateCTL   
D00E                             ; 
D00E                             ; Toggle GLCD Terminal Flag
D00E                             ; Input: none
D00E                             ; Destroy: A
D00E                TOGGLEGLCDTERMINAL:      
D00E   3A 8F 08               LD   a,(GLCD_TERM)   ; get glcd terminal status
D011   2F                     CPL      ; twos complement
D012   32 8F 08               LD   (GLCD_TERM),a   ; save it back
D015                INITGLCDTERMINAL:      
D015   C5                     PUSH   bc   
D016   D5                     PUSH   de   
D017   E5                     PUSH   hl   
D018   F5                     PUSH   af   
D019   B7                     OR   a   
D01A   28 05                  JR   z,$+7   
D01C   CD 18 DB               CALL   initTerminal   ; set GLCD as terminal
D01F   18 03                  JR   $+5   
D021   CD 00 D8               CALL   initLCD   ; set GLCD as normal
D024   F1                     POP   af   
D025   E1                     POP   hl   
D026   D1                     POP   de   
D027   C1                     POP   bc   
D028   C9                     RET      
D029                             ; 
D029                             ; Toggle Key Press Beep
D029                             ; Input: none
D029                             ; Destroy: A
D029                TOGGLEBEEP:      
D029   3A 8D 08               LD   a,(KEY_BEEP)   ; get current state
D02C   2F                     CPL      ; twos complement
D02D   32 8D 08               LD   (KEY_BEEP),a   ; save it back
D030   C9                     RET      
D031                             ; 
D031                             ; Toggle Auto increment address after second nibble keyed
D031                             ; Input: none
D031                             ; Destroy: A
D031                TOGGLEAUTOADDRESS:      
D031   3A 8B 08               LD   a,(KEY_AUTO)   ; get current state
D034   2F                     CPL      ; twos complement
D035   32 8B 08               LD   (KEY_AUTO),a   ; save it back
D038   C9                     RET      
D039                             ; 
D039                             ; Display credits via menu
D039                DISPLAYCREDITS:      
D039   21 1F D5               LD   hl,creditsCFG   
D03C   CD 71 CF               CALL   menuDriver   
D03F                             ; 
D03F                             ; Display setting menu
D03F                DISPLAYSETTINGS:      
D03F   21 96 D4               LD   hl,settingsCFG   
D042   CD 71 CF               CALL   menuDriver   
D045                             ; 
D045                             ; Random Number generator.
D045                             ; Input: note
D045                             ; Output: A = pseudo random number
D045                             ; Destroy: B
D045                RANDOM:      
D045   3A B0 08               LD   a,(RNG_SEED)   ;Random RAM seed
D048   47                     LD   b,a   
D049   CB 20                  SLA   b   
D04B   9F                     SBC   a,a   
D04C   E6 5F                  AND   5FH   
D04E   A8                     XOR   b   
D04F   32 B0 08               LD   (RNG_SEED),a   
D052   47                     LD   b,a   
D053   ED 5F                  LD   a,r   
D055   80                     ADD   a,b   
D056   C9                     RET      
D057                             ; 
D057                             ; Set Disassembly Start Address.  Set the first address for disassembler output
D057                             ; Input: HL = start address
D057                             ; Output: none
D057                             ; Destroy: none
D057                SETDISSTART:      
D057   22 29 09               LD   (DISFROM),hl   ;save start in DIS_FROM
D05A   C9                     RET      
D05B                             ; 
D05B                             ; Get Disassembly Next Address.  Get the next disassembly address
D05B                             ; Input: none
D05B                             ; Output: HL = next disassembly address
D05B                             ; Destroy: none
D05B                GETDISNEXT:      
D05B   2A 29 09               LD   hl,(DISFROM)   ;get next address from DIS_FROM
D05E   C9                     RET      
D05F                             ; 
D05F                             ; Generate Disassembly line
D05F                             ; Input: None (but must call setDisStart first)
D05F                             ; Output: HL = pointer to disassembly ASCII output, zero terminated
D05F                             ; Destroy: All
D05F                GETDISASSEMBLY:      
D05F   CD 1D E7               CALL   disStart   ;generate Disassembly
D062   21 26 09               LD   hl,DISPTR   ;get end of output string
D065   36 00                  LD   (hl),0   ;place zero at end of string
D067   21 00 09               LD   hl,DISLINE1   ;reset HL to point to start of string
D06A   C9                     RET      
D06B                             ; 
D06B                             ; Convert the output of the matrixScan routine to ASCII.  matrixScan returns values between 0 and 64
D06B                             ; these represent key presses on the keyboard.  This routine will convert the output of matrixScan, DE
D06B                             ; to the actual key pressed in ASCII.  If key doesn't map to an ASCII character then the
D06B                             ; matrix key value is returned.
D06B                             ; Input: DE = value return from matrixScan. E = key, D = secondary key
D06B                             ; Output: A = key pressed in ASCII
D06B                             ; Destroy: BC, HL
D06B                MATRIXSCANASCII:      
D06B   7B                     LD   a,e   ;get key pressed
D06C                             ;handle ESC, CR, Space, Single Quote and Backslash
D06C   21 8F D0               LD   hl,KMOD_TABLE   ;point to mod table
D06F   01 05 00               LD   bc,0005H   ;five keys to check
D072   ED A1        KCPI:     CPI      ;compare A to value in Table
D074   28 06                  JR   z,kModA   ;yes, mod it
D076   23                     INC   hl   ;skip the next table entry
D077   EA 72 D0               JP   pe,kCPI   ;does BC=0, no check again
D07A   18 1D                  JR   kNumChar   ;key doesn't need modding, move to next check
D07C                KMODA:       
D07C   7E                     LD   a,(hl)   ;save A with new modded value
D07D   FE 26                  CP   26H   ;is it either a quote or back slash?
D07F   D8                     RET   c   ;no, then just cleanly exit as shift doesn't apply
D080   47                     LD   b,a   ;save A in B
D081   7A                     LD   a,d   ;check second key
D082   B7                     OR   a   ;is A a SHIFT? Shift = 0
D083   20 5B                  JR   nz,kAlpEnd   ;No, exit cleanly with modded value
D085   21 B0 D0               LD   hl,KSHIFT_TABLE   ;point to shift table
D088   3E 12                  LD   a,12H   ;set base index
D08A   81                     ADD   a,c   ;add key index
D08B                KSHIFTINDEX:      
D08B   85                     ADD   a,l   ;index table
D08C   6F                     LD   l,a   ;set L
D08D   7E                     LD   a,(hl)   ;get shifted value for quote or backslash
D08E   C9                     RET      ;cleanly exit
D08F                KMOD_TABLE:      
D08F                             ;First value is key, second value is modded ASCII, 5 keys in total
D08F   0A 0D 0C 1B 0D 20 0E 27 3F 5C DB   0AH,0DH,0CH,1BH,0DH,20H,0EH,27H,3FH,5CH   
D099                KNUMCHAR:      
D099                             ;Handle number and Characters
D099   FE 21                  CP   21H   ;check key range below A-Z
D09B   30 27                  JR   nc,kAlpha   ;its higher, check for Chracter
D09D   FE 0F                  CP   0FH   ;is it greater than Comma?
D09F   38 23                  JR   c,kAlpha   ;yes, check for Character
D0A1   C6 1D                  ADD   a,1DH   ;index to get correct ASCII
D0A3   47                     LD   b,a   ;save key
D0A4   7A                     LD   a,d   ;check second key
D0A5   B7                     OR   a   ;is it a SHIFT? Shift = 0
D0A6   20 38                  JR   nz,kAlpEnd   ;No, exit cleanly with new value
D0A8   21 B0 D0               LD   hl,KSHIFT_TABLE   ;point to shift table
D0AB   78                     LD   a,b   ;get key value
D0AC   D6 2C                  SUB   2CH   ;set base index
D0AE   18 DB                  JR   kShiftIndex   ;do index and cleanly exit
D0B0                KSHIFT_TABLE:      
D0B0                             ;Characters when shift is pressed.  22H is double quote
D0B0   3C 5F 3E 3F 29 21 40 23 24 25 5E 26 2A 28 20 3A 20 2B 7C 22 DB   "<_>?)!@#$%^&*( : +|",22H   
D0C4                KALPHA:      
D0C4                             ;Handle Alphabet characters A-Z
D0C4   FE 24                  CP   24H   ;is key is A or over
D0C6   D8                     RET   c   ;no, no mod just exit cleanly
D0C7   C6 3D                  ADD   a,3DH   ;index key to get correct ASCII
D0C9   47                     LD   b,a   ;save key
D0CA   7A                     LD   a,d   ;check second key
D0CB   3D                     DEC   a   ;is it CTRL?
D0CC   20 04                  JR   nz,kCaps   ;no, check for caps lock
D0CE   78                     LD   a,b   ;get correct key
D0CF   D6 60                  SUB   60H   ;adjust for CTRL-? keys
D0D1   C9                     RET      ;exit
D0D2                KCAPS:       
D0D2   CD 8B CF               CALL   getCaps   ;get CAPS lock state
D0D5   B7                     OR   a   ;is it set or not?
D0D6   20 04                  JR   nz,kUpper   ;yes, make upper case
D0D8   7A                     LD   a,d   ;check second key
D0D9   B7                     OR   a   ;is it SHIFT?
D0DA   20 04                  JR   nz,kAlpEnd   ;no, cleanly exit
D0DC                KUPPER:      
D0DC   78                     LD   a,b   ;get key
D0DD   D6 20                  SUB   "a"-"A"   ;subtract 20H to adjust for upper case
D0DF   C9                     RET      ;exit cleanly
D0E0                KALPEND:      
D0E0   78                     LD   a,b   ;save correct key
D0E1   C9                     RET      ;exit
D0E2                             ; 
D0E2                             ; Parse matrix keyboard input.  This routine checks the key(s) pressed on
D0E2                             ; the Matrix Keyboard and either returns the key pressed in ASCII or handle
D0E2                             ; special cases.  The special cases are Key Bounce/Repeat and Caps lock.  This routine
D0E2                             ; is designed to come directly after matrixScan and included in the Scan loop.
D0E2                             ; Input: DE = value return from matrixScan. E = key, D = secondary key
D0E2                             ;        Zero Flag = Set if key pressed. (From matrixScan output)
D0E2                             ; Output: A = key pressed in ASCII
D0E2                             ;         Carry Flag = Set if ASCII returned.
D0E2                             ;         Carry Flag = Not Set if special case and no ASCII returned
D0E2                             ; Destroy: BC, HL
D0E2                PARSEMATRIXSCAN:      
D0E2   21 8C 08               LD   hl,KEY_REPEAT   ;get the key repeat timer
D0E5   28 0E                  JR   z,parseKey   ;Key has been pressed, check it
D0E7   36 00                  LD   (hl),00H   ;reset delay counter
D0E9   AF                     XOR   a   ;no key pressed, clear the key buffer
D0EA   32 89 08               LD   (KEY_BUFF),a   
D0ED                PARSESPECIAL:      
D0ED   06 00                  LD   b,00H   ;delay to slow this
D0EF   10 FE                  DJNZ   $   ;shit down.
D0F1   10 FE                  DJNZ   $   ;shit down.
D0F3   B7                     OR   a   ;Clear carry flag
D0F4   C9                     RET      
D0F5                PARSEKEY:      
D0F5                             ;check for previous key
D0F5   3A 89 08               LD   a,(KEY_BUFF)   ;Check previous key
D0F8   BB                     CP   e   ;is the key pressed
D0F9   20 05                  JR   nz,parseNewKey   ;New key, parse it
D0FB   35                     DEC   (hl)   ;key held, decrease timer
D0FC   20 EF                  JR   nz,parseSpecial   ;loop back to exit as if no key pressed
D0FE   36 20                  LD   (hl),KEY_SPEED   ;short timer set for subsequent presses
D100                PARSENEWKEY:      
D100                             ;different key, save it
D100   7B                     LD   a,e   
D101   32 89 08               LD   (KEY_BUFF),a   ;save key to key buffer
D104   FE 03                  CP   03H   ;ignore Shift/Ctrl/Fn if first key pressed
D106   38 E5                  JR   c,parseSpecial   ;exit cleanly
D108   35                     DEC   (hl)   ;set timer off
D109                             ;check for Caps lock pressed (need to fix auto repeat issue)
D109   3E 07                  LD   a,07H   ;caps lock key value
D10B   BB                     CP   e   
D10C   20 05                  JR   nz,parseMatrix   ;no, then convert key pressed
D10E   CD EC CF               CALL   toggleCaps   
D111   18 DA                  JR   parseSpecial   ;exit cleanly
D113                PARSEMATRIX:      
D113   CD 6B D0               CALL   matrixScanASCII   
D116                             ;All good, A=ASCII key pressed,
D116   37                     SCF      ;set carry for good exit
D117   C9                     RET      
