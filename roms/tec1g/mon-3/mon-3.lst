D800                             ; This is a native Z80 Graphics library to be used with 128x64 Graphical LCD Screens
D800                             ; 
D800                             ; There are a few variants of these LCD screens, but they must all must use the ST7920
D800                             ; LCD Controller.  The LCD Screen that I used is the QC12864B.  This screen has two
D800                             ; ST7921 Panels (128 x 32) stacked one above the other.
D800                             ; 
D800                             ; These screens have DDRAM (Graphics) and CGRAM (Text) areas.  Both RAM areas can
D800                             ; be displayed at the same time.
D800                             ; 
D800                             ; The Pinout for the QC12864B board is as follows:
D800                             ; 
D800                             ; Pin	Name	Desc                    Serial  Parallel
D800                             ; ---   ----    -------------           ------  -------------
D800                             ; 1     VSS     Ground                  GND     GND
D800                             ; 2     VDD     Power                   5v      5v
D800                             ; 3     V0      Contrast                N/A     N/A
D800                             ; 4     D/I     IR/DR (CS)              5v      A7
D800                             ; 5     R/W     R/W (SID)               D0      RD (inverted)
D800                             ; 6     E       Enable (SCLK)           D1      Port 7 (inverted)
D800                             ; 7     DB0     Data                    N/A     D0
D800                             ; 8     DB1     Data                    N/A     D1
D800                             ; 9     DB2     Data                    N/A     D2
D800                             ; 10    DB3     Data                    N/A     D3
D800                             ; 11    DB4     Data                    N/A     D4
D800                             ; 12    DB5     Data                    N/A     D5
D800                             ; 13    DB6     Data                    N/A     D6
D800                             ; 14    DB7     Data                    N/A     D7
D800                             ; 15    PSB     Serial/Para             GND     5v
D800                             ; 16    NC
D800                             ; 17    RST     Reset                   RST     RST
D800                             ; 18    VEE     LCD Drive               N/A     N/A
D800                             ; 19    A       Backlight               5v/NC   5v/NC
D800                             ; 20    K       Backlight               GND/NC  GND/NC
D800                             ; 
D800                             ; 
D800                             ; Modifiable values.  Thse three values can be modified to suit your own set up
D800                             ; GLCD_INST and GLCD_DATA are the output ports to send an Instruction or Data value.
D800                             ; V_DELAY_US is the minimum delay needed for a command to be processed by the
D800                             ; LCD board.  If only some of the data is being sent, make this value larger
D800                             ;Port 7 on TEC is connected to LCD Enable (Pin 6)
D800                             ;A7 is connected to Register select (Pin 4).  (A7=0 for Instruction, A7=1 for Data)
D800                V_DELAY_US:   EQU   000AH   ;Delay for 76us on your system
D800                             ; Dont need to modify anything else below.
D800                UP:       EQU   05H   ; Up Arrow
D800                DN:       EQU   06H   ; Down Arrow
D800                FF:       EQU   0CH   ; Form Feed
D800                CURSOR:   EQU   8FH   ; Cursor
D800                             ; Initialise LCD
D800                INITLCD:      
D800   21 19 DD               LD   HL,INIT_BASIC   ;POINT HL TO LCD INITIALIZE TABLE
D803   06 04                  LD   B,04H   ;B=4 BYTES
D805                NEXT_CMD:      
D805   7E                     LD   A,(HL)   
D806   D3 07                  OUT   (GLCD_INST),A   
D808   CD 02 DB               CALL   delayUS   
D80B   23                     INC   HL   
D80C   10 F7                  DJNZ   NEXT_CMD   
D80E   11 40 01               LD   DE,0140H   ;1.6 ms
D811   CD 05 DB               CALL   delayMS   
D814   21 00 0A               LD   HL,GBUF   ;Set viewport
D817   22 13 0E               LD   (VPORT),HL   ;to GBUF
D81A   CD 2D D8               CALL   clearGrLCD   
D81D                             ; Clears the Graphics Memory Buffer
D81D                CLEARGBUF:      
D81D   2A 13 0E               LD   HL,(VPORT)   
D820   ED 5B 13 0E            LD   DE,(VPORT)   
D824   13                     INC   DE   
D825   AF                     XOR   A   
D826   77                     LD   (HL),A   
D827   01 FF 03               LD   BC,03FFH   
D82A   ED B0                  LDIR      
D82C   C9                     RET      
D82D                             ; Clears the Graphics LCD Buffer
D82D                CLEARGRLCD:      
D82D   CD 6D D8               CALL   setGrMode   
D830   0E 00                  LD   C,00H   
D832                CLR_X:       
D832   3E 80                  LD   A,80H   
D834   B1                     OR   C   
D835   D3 07                  OUT   (GLCD_INST),A   
D837   CD 02 DB               CALL   delayUS   
D83A   3E 80                  LD   A,80H   
D83C   D3 07                  OUT   (GLCD_INST),A   
D83E   CD 02 DB               CALL   delayUS   
D841   AF                     XOR   A   ;Clear Byte
D842   06 10                  LD   B,10H   
D844                CLR_Y:       
D844   D3 87                  OUT   (GLCD_DATA),A   
D846   CD 02 DB               CALL   delayUS   
D849   D3 87                  OUT   (GLCD_DATA),A   
D84B   CD 02 DB               CALL   delayUS   
D84E   10 F4                  DJNZ   CLR_Y   
D850   0C                     INC   C   
D851   79                     LD   A,C   
D852   FE 20                  CP   20H   
D854   20 DC                  JR   NZ,CLR_X   
D856   C9                     RET      
D857                             ; Clears the ASCII Text LCD
D857                CLEARTXTLCD:      
D857   CD 7B D8               CALL   setTxtMode   
D85A   3E 80                  LD   A,80H   
D85C   D3 07                  OUT   (GLCD_INST),A   
D85E   CD 02 DB               CALL   delayUS   
D861   06 40                  LD   B,40H   
D863                CLR_ROWS:      
D863   3E 20                  LD   A," "   
D865   D3 87                  OUT   (GLCD_DATA),A   
D867   CD 02 DB               CALL   delayUS   
D86A   10 F7                  DJNZ   CLR_ROWS   
D86C   C9                     RET      
D86D                             ; Set Graphics Mode
D86D                SETGRMODE:      
D86D   3E 34                  LD   A,34H   
D86F   D3 07                  OUT   (GLCD_INST),A   
D871   CD 02 DB               CALL   delayUS   
D874   3E 36                  LD   A,36H   
D876   D3 07                  OUT   (GLCD_INST),A   
D878   C3 02 DB               JP   delayUS   
D87B                             ; Set Text Mode
D87B                SETTXTMODE:      
D87B   3E 30                  LD   A,30H   
D87D   D3 07                  OUT   (GLCD_INST),A   
D87F   C3 02 DB               JP   delayUS   
D882                             ;Draw Box
D882                             ;Inputs: BC = X0,Y0
D882                             ;        DE = X1,Y1
D882                             ;Destroys: HL
D882                DRAWBOX:      
D882   C5                     PUSH   BC   
D883                TOP:         
D883   CD 3D DA               CALL   drawPixel   
D886   7A                     LD   A,D   
D887   04                     INC   B   
D888   B8                     CP   B   
D889   30 F8                  JR   NC,TOP   
D88B   C1                     POP   BC   
D88C   C5                     PUSH   BC   
D88D   4B                     LD   C,E   
D88E                BOTTOM:      
D88E   CD 3D DA               CALL   drawPixel   
D891   7A                     LD   A,D   
D892   04                     INC   B   
D893   B8                     CP   B   
D894   30 F8                  JR   NC,BOTTOM   
D896   C1                     POP   BC   
D897   C5                     PUSH   BC   
D898                LEFT:        
D898   CD 3D DA               CALL   drawPixel   
D89B   7B                     LD   A,E   
D89C   0C                     INC   C   
D89D   B9                     CP   C   
D89E   30 F8                  JR   NC,LEFT   
D8A0   C1                     POP   BC   
D8A1   C5                     PUSH   BC   
D8A2   42                     LD   B,D   
D8A3                RIGHT:       
D8A3   CD 3D DA               CALL   drawPixel   
D8A6   7B                     LD   A,E   
D8A7   0C                     INC   C   
D8A8   B9                     CP   C   
D8A9   30 F8                  JR   NC,RIGHT   
D8AB   C1                     POP   BC   
D8AC   C9                     RET      
D8AD                             ;Fill Box
D8AD                             ;Draws vertical lines from X0,Y0 to X0,Y1 and increase X0 to X1 until X0=X1
D8AD                             ;Inputs: BC = X0,Y0
D8AD                             ;        DE = X1,Y1
D8AD                             ;Destroys: HL
D8AD                FILLBOX:      
D8AD   C5                     PUSH   BC   
D8AE                NEXT_PIXEL:      
D8AE   CD 3D DA               CALL   drawPixel   
D8B1   7B                     LD   A,E   
D8B2   0C                     INC   C   
D8B3   B9                     CP   C   
D8B4   30 F8                  JR   NC,NEXT_PIXEL   
D8B6   C1                     POP   BC   
D8B7   7A                     LD   A,D   
D8B8   04                     INC   B   
D8B9   B8                     CP   B   
D8BA   30 F1                  JR   NC,fillBox   
D8BC   C9                     RET      
D8BD                             ;Draw a line between two points using Bresenham Line Algorithm
D8BD                             ; void plotLine(int x0, int y0, int x1, int y1)
D8BD                             ; {
D8BD                             ;    int dx =  abs(x1-x0), sx = x0<x1 ? 1 : -1;
D8BD                             ;    int dy = -abs(y1-y0), sy = y0<y1 ? 1 : -1;
D8BD                             ;    int err = dx+dy, e2; /* error value e_xy */
D8BD                             ;    for(;;){  /* loop */
D8BD                             ;       setPixel(x0,y0);
D8BD                             ;       if (x0==x1 && y0==y1) break;
D8BD                             ;       e2 = 2*err;
D8BD                             ;       if (e2 >= dy) 00bbIGVyciArPSBkeTsgeDAgKz0gc3g7IA== /* e_xy+e_x > 0 */
D8BD                             ;       if (e2 <= dx) 00bbIGVyciArPSBkeDsgeTAgKz0gc3k7IA== /* e_xy+e_y < 0 */
D8BD                             ;    }
D8BD                             ; }
D8BD                             ;Inputs: BC = X0,Y0
D8BD                             ;        DE = X1,Y1
D8BD                DRAWLINE:      
D8BD                             ;check that points are in range
D8BD   79                     LD   A,C   
D8BE   FE 40                  CP   40H   
D8C0   D0                     RET   NC   
D8C1   78                     LD   A,B   
D8C2   FE 80                  CP   80H   
D8C4   D0                     RET   NC   
D8C5   7B                     LD   A,E   
D8C6   FE 40                  CP   40H   
D8C8   D0                     RET   NC   
D8C9   7A                     LD   A,D   
D8CA   FE 80                  CP   80H   
D8CC   D0                     RET   NC   
D8CD                             ;sx = x0<x1 ? 1 : -1
D8CD   26 01                  LD   H,01H   
D8CF   78                     LD   A,B   
D8D0   BA                     CP   D   
D8D1   38 02                  JR   C,$ + 4   
D8D3   26 FF                  LD   H,0FFH   
D8D5   7C                     LD   A,H   
D8D6   32 02 0E               LD   (SX),A   
D8D9                             ;sy = y0<y1 ? 1 : -1
D8D9   26 01                  LD   H,01H   
D8DB   79                     LD   A,C   
D8DC   BB                     CP   E   
D8DD   38 02                  JR   C,$ + 4   
D8DF   26 FF                  LD   H,0FFH   
D8E1   7C                     LD   A,H   
D8E2   32 03 0E               LD   (SY),A   
D8E5   ED 53 00 0E            LD   (ENDPT),DE   
D8E9                             ;dx =  abs(x1-x0)
D8E9   C5                     PUSH   BC   
D8EA   6A                     LD   L,D   
D8EB   26 00                  LD   H,0   
D8ED   48                     LD   C,B   
D8EE   06 00                  LD   B,0   
D8F0   B7                     OR   A   
D8F1   ED 42                  SBC   HL,BC   
D8F3   CD 5E D9               CALL   ABSHL   
D8F6   22 04 0E               LD   (DX),HL   
D8F9   C1                     POP   BC   
D8FA                             ;dy = -abs(y1-y0)
D8FA   C5                     PUSH   BC   
D8FB   6B                     LD   L,E   
D8FC   26 00                  LD   H,0   
D8FE   06 00                  LD   B,0   
D900   B7                     OR   A   
D901   ED 42                  SBC   HL,BC   
D903   CD 5E D9               CALL   ABSHL   
D906   AF                     XOR   A   
D907   95                     SUB   L   
D908   6F                     LD   L,A   
D909   9F                     SBC   A,A   
D90A   94                     SUB   H   
D90B   67                     LD   H,A   
D90C   22 06 0E               LD   (DY),HL   
D90F   C1                     POP   BC   
D910                             ;err = dx+dy,
D910   ED 5B 04 0E            LD   DE,(DX)   
D914   19                     ADD   HL,DE   
D915   22 08 0E               LD   (ERR),HL   
D918                LINE_LOOP:      
D918                             ;setPixel(x0,y0)
D918   CD 3D DA               CALL   drawPixel   
D91B                             ;if (x0==x1 && y0==y1) break;
D91B   3A 01 0E               LD   A,(ENDPT + 1)   
D91E   B8                     CP   B   
D91F   20 05                  JR   NZ,$ + 7   
D921   3A 00 0E               LD   A,(ENDPT)   
D924   B9                     CP   C   
D925   C8                     RET   Z   
D926                             ;e2 = 2*err;
D926   2A 08 0E               LD   HL,(ERR)   
D929   29                     ADD   HL,HL   ;E2
D92A                             ;if (e2 >= dy)  err += dy; x0 += sx;
D92A   ED 5B 06 0E            LD   DE,(DY)   
D92E   B7                     OR   A   
D92F   ED 52                  SBC   HL,DE   
D931   19                     ADD   HL,DE   
D932   FA 43 D9               JP   M,LL2   
D935   E5                     PUSH   HL   
D936   2A 08 0E               LD   HL,(ERR)   
D939   19                     ADD   HL,DE   
D93A   22 08 0E               LD   (ERR),HL   
D93D   3A 02 0E               LD   A,(SX)   
D940   80                     ADD   A,B   
D941   47                     LD   B,A   
D942   E1                     POP   HL   
D943                LL2:         
D943                             ;if (e2 <= dx)  err += dx; y0 += sy;
D943   ED 5B 04 0E            LD   DE,(DX)   
D947   B7                     OR   A   
D948   ED 52                  SBC   HL,DE   
D94A   19                     ADD   HL,DE   
D94B   28 03                  JR   Z,LL3   
D94D   F2 18 D9               JP   P,LINE_LOOP   
D950                LL3:         
D950   2A 08 0E               LD   HL,(ERR)   
D953   19                     ADD   HL,DE   
D954   22 08 0E               LD   (ERR),HL   
D957   3A 03 0E               LD   A,(SY)   
D95A   81                     ADD   A,C   
D95B   4F                     LD   C,A   
D95C   18 BA                  JR   LINE_LOOP   
D95E                ABSHL:       
D95E   CB 7C                  BIT   7,H   
D960   C8                     RET   Z   
D961   AF                     XOR   A   
D962   95                     SUB   L   
D963   6F                     LD   L,A   
D964   9F                     SBC   A,A   
D965   94                     SUB   H   
D966   67                     LD   H,A   
D967   C9                     RET      
D968                             ;Draw a circle from a midpoint to a radius using Bresenham Line Algorithm
D968                             ; void plotCircle(int xm, int ym, int r)
D968                             ; {
D968                             ;    int x = -r, y = 0, err = 2-2*r, i = 0; /* II. Quadrant */
D968                             ;    printf("Midpoint = (%X,%X), Radius = %X\n", xm, ym, r);
D968                             ;    do {
D968                             ;       printf("(%X,%X) ", xm-x, ym+y); /*   I. Quadrant */
D968                             ;       printf("(%X,%X) ", xm-y, ym-x); /*  II. Quadrant */
D968                             ;       printf("(%X,%X) ", xm+x, ym-y); /* III. Quadrant */
D968                             ;       printf("(%X,%X) ", xm+y, ym+x); /*  IV. Quadrant */
D968                             ;       r = err;
D968                             ;       if (r <= y) err += ++y*2+1;           /* e_xy+e_y < 0 */
D968                             ;       if (r > x || err > y) err += ++x*2+1; /* e_xy+e_x > 0 or no 2nd y-step */
D968                             ;       printf("x = %d, r = %d, y = %d, err =%d\n", x, r, y, err);
D968                             ;    } while (x < 0);
D968                             ; }
D968                             ;Inputs BC = xm,ym (Midpoint)
D968                             ;       E = radius
D968                DRAWCIRCLE:      
D968                             ;   int x = -r, err = 2-2*r; /* II. Quadrant */
D968   AF                     XOR   A   
D969   93                     SUB   E   
D96A   32 02 0E               LD   (SX),A   ;x
D96D                             ;   y = 0
D96D   AF                     XOR   A   
D96E   32 03 0E               LD   (SY),A   ;y
D971                             ;   RAD = r
D971   16 00                  LD   D,00H   
D973   7B                     LD   A,E   
D974   ED 53 0A 0E            LD   (RAD),DE   ;r
D978                             ;   err = 2-2*r
D978   EB                     EX   DE,HL   
D979   29                     ADD   HL,HL   
D97A   EB                     EX   DE,HL   
D97B   21 02 00               LD   HL,0002H   
D97E   B7                     OR   A   
D97F   ED 52                  SBC   HL,DE   ;err
D981   22 08 0E               LD   (ERR),HL   
D984                CIRCLE_LOOP:      
D984                             ;       setPixel(xm-x, ym+y); /*   I. Quadrant */
D984   C5                     PUSH   BC   
D985   3A 02 0E               LD   A,(SX)   
D988   ED 44                  NEG      
D98A   80                     ADD   A,B   
D98B   47                     LD   B,A   
D98C   3A 03 0E               LD   A,(SY)   
D98F   81                     ADD   A,C   
D990   4F                     LD   C,A   
D991   CD 3D DA               CALL   drawPixel   
D994   C1                     POP   BC   
D995                             ;       setPixel(xm+x, ym-y); /* III. Quadrant */
D995   C5                     PUSH   BC   
D996   3A 02 0E               LD   A,(SX)   
D999   80                     ADD   A,B   
D99A   47                     LD   B,A   
D99B   3A 03 0E               LD   A,(SY)   
D99E   ED 44                  NEG      
D9A0   81                     ADD   A,C   
D9A1   4F                     LD   C,A   
D9A2   CD 3D DA               CALL   drawPixel   
D9A5   C1                     POP   BC   
D9A6                             ;       setPixel(xm-y, ym-x); /*  II. Quadrant */
D9A6   C5                     PUSH   BC   
D9A7   3A 03 0E               LD   A,(SY)   
D9AA   ED 44                  NEG      
D9AC   80                     ADD   A,B   
D9AD   47                     LD   B,A   
D9AE   3A 02 0E               LD   A,(SX)   
D9B1   ED 44                  NEG      
D9B3   81                     ADD   A,C   
D9B4   4F                     LD   C,A   
D9B5   CD 3D DA               CALL   drawPixel   
D9B8   C1                     POP   BC   
D9B9                             ;       setPixel(xm+y, ym+x); /*  IV. Quadrant */
D9B9   C5                     PUSH   BC   
D9BA   3A 03 0E               LD   A,(SY)   
D9BD   80                     ADD   A,B   
D9BE   47                     LD   B,A   
D9BF   3A 02 0E               LD   A,(SX)   
D9C2   81                     ADD   A,C   
D9C3   4F                     LD   C,A   
D9C4   CD 3D DA               CALL   drawPixel   
D9C7   C1                     POP   BC   
D9C8                             ;       r = err;
D9C8   2A 08 0E               LD   HL,(ERR)   
D9CB   22 0A 0E               LD   (RAD),HL   
D9CE                             ;       if (r <= y) err += ++y*2+1;           /* e_xy+e_y < 0 */
D9CE   3A 03 0E               LD   A,(SY)   
D9D1   5F                     LD   E,A   
D9D2   16 00                  LD   D,0   
D9D4   B7                     OR   A   
D9D5   ED 52                  SBC   HL,DE   
D9D7   19                     ADD   HL,DE   
D9D8   28 03                  JR   Z,$ + 5   
D9DA   F2 F0 D9               JP   P,DS1   
D9DD   3A 03 0E               LD   A,(SY)   
D9E0   3C                     INC   A   
D9E1   32 03 0E               LD   (SY),A   
D9E4   87                     ADD   A,A   
D9E5   3C                     INC   A   
D9E6   5F                     LD   E,A   
D9E7   16 00                  LD   D,0   
D9E9   2A 08 0E               LD   HL,(ERR)   
D9EC   19                     ADD   HL,DE   
D9ED   22 08 0E               LD   (ERR),HL   
D9F0                             ;       if (r > x || err > y) err += ++x*2+1; /* e_xy+e_x > 0 or no 2nd y-step */
D9F0                DS1:         
D9F0   2A 0A 0E               LD   HL,(RAD)   
D9F3   3A 02 0E               LD   A,(SX)   
D9F6   16 FF                  LD   D,0FFH   
D9F8   5F                     LD   E,A   
D9F9   B7                     OR   A   
D9FA   ED 52                  SBC   HL,DE   
D9FC   19                     ADD   HL,DE   
D9FD   28 03                  JR   Z,$ + 5   
D9FF   F2 14 DA               JP   P,DS2   
DA02   2A 08 0E               LD   HL,(ERR)   
DA05   3A 03 0E               LD   A,(SY)   
DA08   16 00                  LD   D,0   
DA0A   5F                     LD   E,A   
DA0B   B7                     OR   A   
DA0C   ED 52                  SBC   HL,DE   
DA0E   19                     ADD   HL,DE   
DA0F   28 16                  JR   Z,DS3   
DA11   FA 27 DA               JP   M,DS3   
DA14                DS2:         
DA14   3A 02 0E               LD   A,(SX)   
DA17   3C                     INC   A   
DA18   32 02 0E               LD   (SX),A   
DA1B   87                     ADD   A,A   
DA1C   3C                     INC   A   
DA1D   5F                     LD   E,A   
DA1E   16 FF                  LD   D,0FFH   
DA20   2A 08 0E               LD   HL,(ERR)   
DA23   19                     ADD   HL,DE   
DA24   22 08 0E               LD   (ERR),HL   
DA27                             ;   } while (x < 0);
DA27                DS3:         
DA27   3A 02 0E               LD   A,(SX)   
DA2A   B7                     OR   A   
DA2B   C2 84 D9               JP   NZ,CIRCLE_LOOP   
DA2E   C9                     RET      
DA2F                             ;Fill Circle
DA2F                             ;Fills a circle by increasing radius until Radius = Original Radius E
DA2F                             ;Inputs BC = xm,ym (Midpoint)
DA2F                             ;       E = radius
DA2F                FILLCIRCLE:      
DA2F   16 01                  LD   D,01H   ;Start radius
DA31                NEXT_CIRCLE:      
DA31   D5                     PUSH   DE   ;Save end Radius
DA32   5A                     LD   E,D   
DA33   CD 68 D9               CALL   drawCircle   
DA36   D1                     POP   DE   ;Restore Radius
DA37   7B                     LD   A,E   
DA38   14                     INC   D   
DA39   BA                     CP   D   
DA3A   30 F5                  JR   NC,NEXT_CIRCLE   
DA3C   C9                     RET      
DA3D                             ;Draw Pixel in position X Y
DA3D                             ;Input B = column/X (0-127), C = row/Y (0-63)
DA3D                             ;destroys HL
DA3D                DRAWPIXEL:      
DA3D   79                     LD   A,C   
DA3E   FE 40                  CP   40H   
DA40   D0                     RET   NC   
DA41   78                     LD   A,B   
DA42   FE 80                  CP   80H   
DA44   D0                     RET   NC   
DA45   D5                     PUSH   DE   
DA46   CD 71 DA               CALL   SET_GBUF   
DA49   7A                     LD   A,D   
DA4A   B6                     OR   (HL)   
DA4B   77                     LD   (HL),A   
DA4C   D1                     POP   DE   
DA4D   C9                     RET      
DA4E                             ;Clear Pixel in position X Y
DA4E                             ;Input B = column/X (0-127), C = row/Y (0-63)
DA4E                             ;destroys HL
DA4E                CLEARPIXEL:      
DA4E   79                     LD   A,C   
DA4F   FE 40                  CP   40H   
DA51   D0                     RET   NC   
DA52   78                     LD   A,B   
DA53   FE 80                  CP   80H   
DA55   D0                     RET   NC   
DA56   D5                     PUSH   DE   
DA57   CD 71 DA               CALL   SET_GBUF   
DA5A   7A                     LD   A,D   
DA5B   2F                     CPL      
DA5C   A6                     AND   (HL)   
DA5D   77                     LD   (HL),A   
DA5E   D1                     POP   DE   
DA5F   C9                     RET      
DA60                             ;Flip Pixel in position X Y
DA60                             ;Input B = column/X (0-127), C = row/Y (0-63)
DA60                             ;destroys HL
DA60                FLIPPIXEL:      
DA60   79                     LD   A,C   
DA61   FE 40                  CP   40H   
DA63   D0                     RET   NC   
DA64   78                     LD   A,B   
DA65   FE 80                  CP   80H   
DA67   D0                     RET   NC   
DA68   D5                     PUSH   DE   
DA69   CD 71 DA               CALL   SET_GBUF   
DA6C   7A                     LD   A,D   
DA6D   AE                     XOR   (HL)   
DA6E   77                     LD   (HL),A   
DA6F   D1                     POP   DE   
DA70   C9                     RET      
DA71                             ;Helper routine to set HL to the correct GBUF address given X and Y
DA71                             ;Input B = column/X (0-127), C = row/Y (0-63)
DA71                             ;Output HL = address of GBUF X,Y byte, D = Byte with Pixel Bit Set
DA71                             ;Destroys E
DA71                SET_GBUF:      
DA71   69                     LD   L,C   
DA72   26 00                  LD   H,00H   
DA74   29                     ADD   HL,HL   
DA75   29                     ADD   HL,HL   
DA76   29                     ADD   HL,HL   
DA77   29                     ADD   HL,HL   
DA78   ED 5B 13 0E            LD   DE,(VPORT)   
DA7C   1B                     DEC   DE   
DA7D   19                     ADD   HL,DE   
DA7E   78                     LD   A,B   
DA7F   16 08                  LD   D,08H   
DA81                BASE_COL:      
DA81   23                     INC   HL   
DA82   92                     SUB   D   
DA83   30 FC                  JR   NC,BASE_COL   
DA85   2F                     CPL      
DA86   16 01                  LD   D,01H   
DA88   B7                     OR   A   
DA89   C8                     RET   Z   
DA8A                SHIFT_BIT:      
DA8A   CB 22                  SLA   D   
DA8C   3D                     DEC   A   
DA8D   20 FB                  JR   NZ,SHIFT_BIT   
DA8F   C9                     RET      
DA90                             ;Main draw routine.  Moves GBUF to LCD and clears buffer
DA90                             ;Destroys all
DA90                PLOTTOLCD:      
DA90   2A 13 0E               LD   HL,(VPORT)   
DA93   0E 80                  LD   C,80H   
DA95                PLOT_ROW:      
DA95   79                     LD   A,C   
DA96   E6 9F                  AND   9FH   
DA98   D3 07                  OUT   (GLCD_INST),A   ;Vertical
DA9A   CD 02 DB               CALL   delayUS   
DA9D   3E 80                  LD   A,80H   
DA9F   CB 69                  BIT   5,C   
DAA1   28 02                  JR   Z,$ + 4   
DAA3   F6 08                  OR   08H   
DAA5   D3 07                  OUT   (GLCD_INST),A   ;Horizontal
DAA7   CD 02 DB               CALL   delayUS   
DAAA   06 10                  LD   B,10H   ;send eight double bytes (16 bytes)
DAAC                PLOT_COLUMN:      
DAAC   7E                     LD   A,(HL)   
DAAD   D3 87                  OUT   (GLCD_DATA),A   
DAAF   CD 02 DB               CALL   delayUS   
DAB2   3A 0C 0E               LD   A,(CLRBUF)   
DAB5   B7                     OR   A   
DAB6   28 02                  JR   Z,$ + 4   
DAB8   36 00                  LD   (HL),00H   ;Clear Buffer if CLRBUF is non zero
DABA   23                     INC   HL   
DABB   10 EF                  DJNZ   PLOT_COLUMN   
DABD   0C                     INC   C   
DABE   CB 71                  BIT   6,C   ;Is Row = 64?
DAC0   28 D3                  JR   Z,PLOT_ROW   
DAC2   C9                     RET      
DAC3                             ; Print ASCII text on a given row
DAC3                             ; Inputs: C = 0 to 3 Row Number
DAC3                             ;         .db "String" on next line, terminate with 0
DAC3                             ; EG:
DAC3                             ;   LD C,2
DAC3                             ;   CALL printString
DAC3                             ;   .db "This Text",0
DAC3                             ; 
DAC3                PRINTSTRING:      
DAC3   41                     LD   B,C   
DAC4   CD 7B D8               CALL   setTxtMode   
DAC7   21 15 DD               LD   HL,ROWS   
DACA   78                     LD   A,B   
DACB   85                     ADD   A,L   
DACC   30 01                  JR   NC,$ + 3   
DACE   24                     INC   H   
DACF   6F                     LD   L,A   
DAD0   7E                     LD   A,(HL)   
DAD1   D3 07                  OUT   (GLCD_INST),A   
DAD3   CD 02 DB               CALL   delayUS   
DAD6   E1                     POP   HL   
DAD7                DS_LOOP:      
DAD7   7E                     LD   A,(HL)   
DAD8   23                     INC   HL   
DAD9   B7                     OR   A   
DADA   28 07                  JR   Z,DS_EXIT   
DADC   D3 87                  OUT   (GLCD_DATA),A   
DADE   CD 02 DB               CALL   delayUS   
DAE1   18 F4                  JR   DS_LOOP   
DAE3                DS_EXIT:      
DAE3   E9                     JP   (HL)   
DAE4                             ;Print Characters at a position X,Y
DAE4                             ;Eventhough there are 16 columns, only every second column can be written
DAE4                             ;to and two characters are to be printed.  IE: if you want to print one
DAE4                             ;character in column 2, then you must set B=0 and print " x", putting
DAE4                             ;a space before the chracter.
DAE4                             ;Input B = column/X (0-7), C = row/Y (0-3)
DAE4                             ;      HL = Start address of text to display, terminate with 0
DAE4                PRINTCHARS:      
DAE4   CD 7B D8               CALL   setTxtMode   
DAE7   11 15 DD               LD   DE,ROWS   
DAEA   79                     LD   A,C   
DAEB   83                     ADD   A,E   
DAEC   30 01                  JR   NC,$ + 3   
DAEE   14                     INC   D   
DAEF   5F                     LD   E,A   
DAF0   1A                     LD   A,(DE)   
DAF1   80                     ADD   A,B   
DAF2   D3 07                  OUT   (GLCD_INST),A   
DAF4   CD 02 DB               CALL   delayUS   
DAF7                PC_LOOP:      
DAF7   7E                     LD   A,(HL)   
DAF8   23                     INC   HL   
DAF9   B7                     OR   A   
DAFA   C8                     RET   Z   
DAFB   D3 87                  OUT   (GLCD_DATA),A   
DAFD   CD 02 DB               CALL   delayUS   
DB00   18 F5                  JR   PC_LOOP   
DB02                             ; Delay for LCD write
DB02                DELAYUS:      
DB02   11 0A 00               LD   DE,V_DELAY_US   ;DELAY BETWEEN, was 0010H
DB05                DELAYMS:      
DB05   1B                     DEC   DE   ;EACH BYTE
DB06   7A                     LD   A,D   ;AS PER
DB07   B3                     OR   E   ;LCD MANUFACTER'S
DB08   20 FB                  JR   NZ,delayMS   ;INSTRUCTIONS
DB0A   C9                     RET      
DB0B                             ; Set Buffer Clearing after outputting to LCD
DB0B                             ; Input: A = 0 Buffer to be cleared, A <> 0 Buffer kept
DB0B                SETBUFCLEAR:      
DB0B   3E FF                  LD   A,0FFH   
DB0D   32 0C 0E               LD   (CLRBUF),A   
DB10   C3 1D D8               JP   clearGBUF   
DB13                SETBUFNOCLEAR:      
DB13   AF                     XOR   A   
DB14   32 0C 0E               LD   (CLRBUF),A   
DB17   C9                     RET      
DB18                             ;Initialise the GLCD Terminal
DB18                             ;Clears the GBUF, sets cursor to top left and displays cursor.
DB18                             ;This must be called prior to any Terminal routine.  This routine
DB18                             ;will as call INIT_LCD.
DB18                INITTERMINAL:      
DB18   CD 00 D8               CALL   initLCD   ;Clear LCD GBUF
DB1B   CD 6D D8               CALL   setGrMode   ;Graphics mode
DB1E   CD 13 DB               CALL   setBufNoClear   ;Retain screen
DB21   21 C0 13               LD   HL,TGBUF   ;Reset VPORT and BUFF_TOP to TGBUF
DB24   22 13 0E               LD   (VPORT),HL   ;to GBUF
DB27   22 15 0E               LD   (TBUF),HL   
DB2A   CD 1D D8               CALL   clearGBUF   
DB2D   AF                     XOR   A   ;Clear A
DB2E   32 10 0E               LD   (CURSOR_ON),A   ;Cursor ON
DB31   32 11 0E               LD   (INVERSE),A   ;Inverse OFF
DB34   01 00 00               LD   BC,0000H   
DB37   CD F2 DB               CALL   setCursor   ;Move cursor to top left
DB3A   18 61                  JR   DRAW_CURSOR   ;Draw Cursor and exit
DB3C                             ;Send or handle ASCII characters to the GLCD screen.  This routines displays
DB3C                             ;ASCII charcters to the GLCD screen and handles some special control characters
DB3C                             ;It also handles srolling history of 10 lines.  Characters are drawn at the
DB3C                             ;current cursor position.  Cursor increments if characger is drawn.
DB3C                             ;       CR / 0DH = will move the cursor down and reset it column
DB3C                             ;       LF / 0AH = is ignored
DB3C                             ;       FF / 0CH = clears the terminal (restarts)
DB3C                             ;       BS / 08H = will delete the character at the cursor and move cursor back one
DB3C                             ;       HT / 09H = will TAB 4 spaces
DB3C                             ;       UP / 05H = will scroll up one line if any
DB3C                             ;       DN / 06H = will scroll down one line if any
DB3C                             ;Input: C = ASCII charcter to send to the GLCD screen.
DB3C                             ;       C = 0  cursor drawn only
DB3C                SENDCHARTOLCD:      
DB3C                             ;Check for special characters
DB3C   79                     LD   A,C   
DB3D   B7                     OR   A   ;Zero?
DB3E   28 5D                  JR   Z,DRAW_CURSOR   
DB40                DO_SCRL_UP:      
DB40   FE 05                  CP   UP   ;Up Arrow
DB42   20 07                  JR   NZ,DO_SCRL_DN   
DB44   AF                     XOR   A   
DB45   CD 5E DC               CALL   MOVE_VPORT   
DB48   C3 90 DA               JP   plotToLCD   
DB4B                DO_SCRL_DN:      
DB4B   FE 06                  CP   DN   ;Down Arrow
DB4D   20 04                  JR   NZ,DO_CR   
DB4F   3E 01                  LD   A,1   
DB51   18 F2                  JR   $-12   ;Move VPORT above
DB53                DO_CR:       
DB53                             ;Key is now a drawing character, reset VPORT first
DB53   21 C0 13               LD   HL,TGBUF   
DB56   22 13 0E               LD   (VPORT),HL   
DB59   FE 0A                  CP   LF   ;LF
DB5B   C8                     RET   Z   
DB5C   FE 0D                  CP   CR   ;CR
DB5E   20 0D                  JR   NZ,DO_FF   
DB60   16 20                  LD   D,SPACE   ;Clear Cursor
DB62   CD B7 DC               CALL   drawGraphic   
DB65   CD 10 DC               CALL   INC_ROW   
DB68   32 0F 0E               LD   (CURSOR_YS),A   ;Save start row
DB6B   18 30                  JR   DRAW_CURSOR   
DB6D                DO_FF:       
DB6D   FE 0C                  CP   FF   ;Form Feed / Clear Screen
DB6F   28 A7                  JR   Z,initTerminal   ;Reset All.
DB71                DO_BS:       
DB71   FE 08                  CP   BKSP   ;Backspace
DB73   20 0A                  JR   NZ,DO_TAB   
DB75   16 20                  LD   D,SPACE   ;Space
DB77   CD B7 DC               CALL   drawGraphic   
DB7A   CD 7E DC               CALL   DEC_CURSOR   
DB7D   18 1E                  JR   DRAW_CURSOR   
DB7F                DO_TAB:      
DB7F   FE 09                  CP   TAB   ;Horizontal Tab
DB81   20 13                  JR   NZ,DO_CHAR   
DB83   16 20                  LD   D,SPACE   ;Space
DB85   CD B7 DC               CALL   drawGraphic   
DB88   CD 03 DC               CALL   INC_CURSOR   
DB8B   CD 03 DC               CALL   INC_CURSOR   
DB8E   CD 03 DC               CALL   INC_CURSOR   
DB91   CD 03 DC               CALL   INC_CURSOR   
DB94   18 07                  JR   DRAW_CURSOR   
DB96                DO_CHAR:      
DB96   57                     LD   D,A   ;get character
DB97   CD B7 DC               CALL   drawGraphic   
DB9A   CD 03 DC               CALL   INC_CURSOR   
DB9D                DRAW_CURSOR:      
DB9D   3A 10 0E               LD   A,(CURSOR_ON)   
DBA0   B7                     OR   A   
DBA1   16 20                  LD   D,SPACE   ;Space
DBA3   20 02                  JR   NZ,$+4   ;Skip cursor draw
DBA5   16 8F                  LD   D,CURSOR   ;Cursor
DBA7   CD B7 DC               CALL   drawGraphic   
DBAA   C3 90 DA               JP   plotToLCD   ;Plot screen and exit
DBAD                             ;Send a string of characters to the GLCD.  Prints a string pointed
DBAD                             ;by DE.  It stops printing and returns when either a CR is printed or
DBAD                             ;when the next byte is the same as what is in register C
DBAD                             ;Inputs: DE = address of string to print
DBAD                             ;        C = character to stop printing.
DBAD                             ;Destroy: All
DBAD                SENDSTRINGTOLCD:      
DBAD   41                     LD   B,C   ;Save cp in B
DBAE                NEXT_CHAR:      
DBAE   1A                     LD   A,(DE)   ;Get character
DBAF   13                     INC   DE   ;Move pointer
DBB0   B8                     CP   B   ;Same as B?
DBB1   28 EA                  JR   Z,DRAW_CURSOR   ;Yes exit and plot LCD screen
DBB3   FE 0D                  CP   CR   ;Is it a CR?
DBB5   28 9C                  JR   Z,DO_CR   ;Yes do a CR and plot LCD screen and exit
DBB7   FE 0C                  CP   FF   ;Is it a FF?
DBB9   28 B2                  JR   Z,DO_FF   ;Yes do a Form Feed and plot LCD screen and exit
DBBB   D9                     EXX      ;Save bulk registers
DBBC   57                     LD   D,A   ;Get Character
DBBD   CD B7 DC               CALL   drawGraphic   ;Draw the character
DBC0   CD 03 DC               CALL   INC_CURSOR   ;Move cursor by one
DBC3   D9                     EXX      ;Restore bulk registers
DBC4   18 E8                  JR   NEXT_CHAR   ;Repeat for next character
DBC6   C9                     RET      
DBC7                             ;Display a register in ASCII on the GLCD
DBC7                             ;Input: C = value to convert and display
DBC7                SENDREGTOLCD:      
DBC7   79                     LD   A,C   
DBC8   CD CD DB               CALL   DRAW_A   ;Do the conversion
DBCB   18 D0                  JR   DRAW_CURSOR   ;exit and plot LCD screen
DBCD                DRAW_A:      
DBCD   F5                     PUSH   AF   ;Save AF
DBCE   0F                     RRCA      ;move high
DBCF   0F                     RRCA      ;nibble to low nibble
DBD0   0F                     RRCA      
DBD1   0F                     RRCA      
DBD2   CD D6 DB               CALL   NIBBLE_TO_LCD   ;Convert and display
DBD5   F1                     POP   AF   ;Restore AF
DBD6                NIBBLE_TO_LCD:      
DBD6   E6 0F                  AND   0FH   ;mask out high nibble
DBD8   C6 90                  ADD   A,90H   ;convert to
DBDA   27                     DAA      ;ASCII
DBDB   CE 40                  ADC   A,40H   ;using this
DBDD   27                     DAA      ;amazing routine
DBDE   57                     LD   D,A   ;get character
DBDF   CD B7 DC               CALL   drawGraphic   ;Draw the character
DBE2   CD 03 DC               CALL   INC_CURSOR   ;Move cursor by one
DBE5   C9                     RET      
DBE6                             ;Display the register HL in ASCII on the GLCD
DBE6                             ;Input: HL = value to convert and display
DBE6                SENDHLTOLCD:      
DBE6   E5                     PUSH   HL   ;Save HL
DBE7   7C                     LD   A,H   ;get H
DBE8   CD CD DB               CALL   DRAW_A   ;Do the conversion
DBEB   E1                     POP   HL   
DBEC   7D                     LD   A,L   ;get L
DBED   CD CD DB               CALL   DRAW_A   ;Do the conversion
DBF0   18 AB                  JR   DRAW_CURSOR   ;exit and plot LCD screen
DBF2                             ;Set the Graphic cursor position
DBF2                             ;Inputs: BC = X,Y where X = 0..127, Y = 0..63
DBF2                             ;Ignores update if one of the X,Y values are out of range
DBF2                             ;Destroys: A
DBF2                SETCURSOR:      
DBF2                             ;Check range. Exit if X,Y out of range
DBF2   79                     LD   A,C   
DBF3   FE 40                  CP   40H   
DBF5   D0                     RET   NC   
DBF6   78                     LD   A,B   
DBF7   FE 80                  CP   80H   
DBF9   D0                     RET   NC   
DBFA                             ;Set Cursor and initial start row
DBFA   ED 43 0D 0E            LD   (CURSOR_XY),BC   ;Save cursor
DBFE   79                     LD   A,C   
DBFF   32 0F 0E               LD   (CURSOR_YS),A   ;And initial Y Start
DC02   C9                     RET      
DC03                             ;Increment the cursor by one font character
DC03                             ;A Font Character is 6x6 Pixels.  Move column 6 across until it can't then reset
DC03                             ;column back to 0 and move 6 down.
DC03                             ;If can't go down any further then keep on last row but move column back to 0
DC03                             ;Font Characters maximum 20 across and 10 down
DC03                             ;Output: Carry Set = No screen overflow
DC03                             ;Destroys: A
DC03                INC_CURSOR:      
DC03   3A 0E 0E               LD   A,(CURSOR_X)   ;Get X
DC06   C6 06                  ADD   A,6   ;Add 6
DC08   FE 7E                  CP   126   ;Is it >= 126?
DC0A   30 04                  JR   NC,INC_ROW   ;Yes, reset column and increment row
DC0C   32 0E 0E               LD   (CURSOR_X),A   ;Save new column
DC0F   C9                     RET      
DC10                INC_ROW:      
DC10   AF                     XOR   A   
DC11   32 0E 0E               LD   (CURSOR_X),A   ;reset column to 0
DC14   3A 0D 0E               LD   A,(CURSOR_Y)   ;get row
DC17   C6 06                  ADD   A,6   ;Add 6
DC19   FE 3C                  CP   60   ;Is it >= 60
DC1B   38 07                  JR   C,SAVE_ROW   ;No, save new row
DC1D   F5                     PUSH   AF   
DC1E   CD 28 DC               CALL   SHIFT_BUFFER   ;Shift buffer up one row
DC21   F1                     POP   AF   
DC22   D6 06                  SUB   6   ;overflow, just leave the same
DC24                SAVE_ROW:      
DC24   32 0D 0E               LD   (CURSOR_Y),A   ;Save new row
DC27   C9                     RET      
DC28                             ;Shift the graphics buffer (GBUF) into the scroll buffer (SBUF) by
DC28                             ;one row (6 lines).  Move the top buffer address to the new top of
DC28                             ;the scroll buffer
DC28                SHIFT_BUFFER:      
DC28                             ;Check if anymore buffer left
DC28   2A 15 0E               LD   HL,(TBUF)   ;Get top buffer address
DC2B   11 00 10               LD   DE,TGBUF-SBUF   ;Get scroll buffer address
DC2E   B7                     OR   A   ;Clear carry
DC2F   ED 52                  SBC   HL,DE   ;TBUF-SBUF
DC31   28 09                  JR   Z,SKIP_TBUF   
DC33   19                     ADD   HL,DE   ;restore HL
DC34   11 60 00               LD   DE,16*6   ;Six pixel rows
DC37   ED 52                  SBC   HL,DE   ;Move TBUF down by 6 rows
DC39   22 15 0E               LD   (TBUF),HL   ;Save new TBUF
DC3C                SKIP_TBUF:      
DC3C   21 60 10               LD   HL,TGBUF-SBUF+(16*6)   ;Top of scroll buffer less one row
DC3F   11 00 10               LD   DE,TGBUF-SBUF   ;Top of scroll buffer
DC42   01 20 07               LD   BC,16*6*19   ;19 rows
DC45   ED B0                  LDIR      
DC47   21 20 17               LD   HL,TGBUF+0360H   ;clear last row (9*16)
DC4A   11 21 17               LD   DE,TGBUF+0361H   
DC4D   01 5F 00               LD   BC,5FH   
DC50   AF                     XOR   A   
DC51   77                     LD   (HL),A   
DC52   ED B0                  LDIR      
DC54                             ;Move Y Start up one row
DC54   3A 0F 0E               LD   A,(CURSOR_YS)   ;Get Y Start row
DC57   D6 06                  SUB   6   
DC59   D8                     RET   C   ;Ignore if less than zero
DC5A   32 0F 0E               LD   (CURSOR_YS),A   
DC5D   C9                     RET      
DC5E                             ;Move the VPORT vertically between TBUF and end of GBUB.  VPORT will be
DC5E                             ;shifted by a standard termial row of 6 lines.
DC5E                             ;input: A = 0 shift up else shift down
DC5E                MOVE_VPORT:      
DC5E   2A 13 0E               LD   HL,(VPORT)   ;get viewport
DC61   EB                     EX   DE,HL   
DC62   B7                     OR   A   ;check move
DC63   20 0E                  JR   NZ,MOVE_DOWN   ;shift down
DC65                MOVE_UP:      
DC65   2A 15 0E               LD   HL,(TBUF)   ;get top of buffer
DC68   ED 52                  SBC   HL,DE   ; 
DC6A   C8                     RET   Z   ;if the same, then at top already
DC6B   21 A0 FF               LD   HL,0-60H   ;one row up
DC6E                SAVE_VPORT:      
DC6E   19                     ADD   HL,DE   ;get new VPORT value
DC6F   22 13 0E               LD   (VPORT),HL   
DC72   C9                     RET      
DC73                MOVE_DOWN:      
DC73   21 C0 13               LD   HL,TGBUF   ;get top of graphics buffer
DC76   ED 52                  SBC   HL,DE   ; 
DC78   C8                     RET   Z   ;if the same, then at top already
DC79   21 60 00               LD   HL,60H   ;one row down
DC7C   18 F0                  JR   SAVE_VPORT   
DC7E                             ;Decrement the cursor by one font character up to the current row start
DC7E                             ;Used to help with Backspace character or left arrow?
DC7E                             ;Destroys: A
DC7E                DEC_CURSOR:      
DC7E   3A 0E 0E               LD   A,(CURSOR_X)   ;Get X
DC81   D6 06                  SUB   6   ;subract 6
DC83                SAVE_COL:      
DC83   32 0E 0E               LD   (CURSOR_X),A   ;Save new column
DC86                             ;if < 0 then just make 0 or 20 depending on Y Start
DC86   D0                     RET   NC   
DC87   C5                     PUSH   BC   
DC88   3A 0F 0E               LD   A,(CURSOR_YS)   ;Get Y Start
DC8B   47                     LD   B,A   
DC8C   3A 0D 0E               LD   A,(CURSOR_Y)   ;Get Y
DC8F   90                     SUB   B   
DC90   C1                     POP   BC   
DC91   3E 00                  LD   A,0   ;reset to 0
DC93   28 EE                  JR   Z,SAVE_COL   
DC95   3E 78                  LD   A,6*20   ;last column
DC97   32 0E 0E               LD   (CURSOR_X),A   ;Save new column
DC9A   3A 0D 0E               LD   A,(CURSOR_Y)   
DC9D   D6 06                  SUB   6   ;move row one line up
DC9F   32 0D 0E               LD   (CURSOR_Y),A   ;Save new row
DCA2   C9                     RET      
DCA3                             ;Get cursor position
DCA3                             ;Outputs: BC = X,Y where X = 0..127, Y = 0..63
DCA3                GETCURSOR:      
DCA3   ED 4B 0D 0E            LD   BC,(CURSOR_XY)   
DCA7   C9                     RET      
DCA8                             ;Display Cursor
DCA8                             ;Input: C = 0, Turn cursor on, C = non zero, Turn cursor off
DCA8                             ;Default is Cursor ON
DCA8                DISPLAYCURSOR:      
DCA8   79                     LD   A,C   
DCA9   32 10 0E               LD   (CURSOR_ON),A   
DCAC   C3 9D DB               JP   DRAW_CURSOR   
DCAF                             ;Inverse Graphic Drawing
DCAF                             ;Initial state is normal.  Calling this routine will TOGGLE the inverse drawing flag
DCAF                             ;Destroys: A
DCAF                INVGRAPHIC:      
DCAF   3A 11 0E               LD   A,(INVERSE)   
DCB2   2F                     CPL      ;flip bits
DCB3   32 11 0E               LD   (INVERSE),A   
DCB6   C9                     RET      
DCB7                             ;Draw Graphic at the current cursor.  Draw either an ASCII character or
DCB7                             ;a custom sprite/picture
DCB7                             ;Input: D = ASCII number or
DCB7                             ;    if D=0 Then
DCB7                             ;       HL = Address of graphic data
DCB7                             ;       B = width of graphic in pixels (1-128)
DCB7                             ;       C = height of graphic in pixels (1-64)
DCB7                             ;Destroys: All
DCB7                DRAWGRAPHIC:      
DCB7   7A                     LD   A,D   
DCB8   B7                     OR   A   ;is A=0
DCB9   28 10                  JR   Z,PLOT_GRAPHIC   ;yes, use data pointing to HL
DCBB                             ;Use internal font table and index it to value in A
DCBB   3D                     DEC   A   ;fix for A = 0..255
DCBC   26 00                  LD   H,0   
DCBE   6F                     LD   L,A   
DCBF   29                     ADD   HL,HL   ;Multipy A by 2
DCC0   54                     LD   D,H   
DCC1   5D                     LD   E,L   ;Save in DE
DCC2   29                     ADD   HL,HL   ;Multipy A by 4
DCC3   19                     ADD   HL,DE   ;Multiply by 6
DCC4   11 1D DD               LD   DE,FONT_DATA   ;Font Table
DCC7   19                     ADD   HL,DE   ;Add index (A*8) to HL
DCC8   01 06 06               LD   BC,0606H   ;Six pixels across, Six pixels down
DCCB                PLOT_GRAPHIC:      
DCCB   50                     LD   D,B   ;D=Column pixel count
DCCC   7A                     LD   A,D   
DCCD   32 12 0E               LD   (PIXEL_X),A   ;Save original pixel length
DCD0   59                     LD   E,C   ;E=Row pixel count
DCD1   ED 4B 0D 0E            LD   BC,(CURSOR_XY)   ;Get graphics cursor position
DCD5                PLOT_BYTE:      
DCD5   7A                     LD   A,D   ;Get column bit count
DCD6   D6 08                  SUB   8   
DCD8   57                     LD   D,A   
DCD9   D5                     PUSH   DE   
DCDA   16 08                  LD   D,8   
DCDC   5E                     LD   E,(HL)   ;get pixel data
DCDD   30 09                  JR   NC,INV_BIT   
DCDF   82                     ADD   A,D   ;Restore column bit count
DCE0   57                     LD   D,A   
DCE1   7A                     LD   A,D   
DCE2                             ;D = Rotate adjust count
DCE2   CB 0B                  RRC   E   ;rotate it to get first bit in bit 7
DCE4   15                     DEC   D   
DCE5   20 FB                  JR   NZ,$-3   
DCE7   57                     LD   D,A   ;reset D to actual bit count
DCE8                INV_BIT:      
DCE8   3A 11 0E               LD   A,(INVERSE)   ;check inverse flag
DCEB   AB                     XOR   E   ;flip bits
DCEC   5F                     LD   E,A   ;save new data
DCED                PLOT_BIT:      
DCED   CB 03                  RLC   E   
DCEF   E5                     PUSH   HL   
DCF0   30 05                  JR   NC,REMOVE_PIXEL   
DCF2   CD 3D DA               CALL   drawPixel   
DCF5   18 03                  JR   $+5   
DCF7                REMOVE_PIXEL:      
DCF7   CD 4E DA               CALL   clearPixel   
DCFA   E1                     POP   HL   
DCFB   04                     INC   B   ;move X to the right by one
DCFC   15                     DEC   D   
DCFD   20 EE                  JR   NZ,PLOT_BIT   
DCFF                             ;All bits are plotted check if D <= 0
DCFF   23                     INC   HL   ;move to next pixel byte
DD00   D1                     POP   DE   ;restore Column/Row bit count
DD01   7A                     LD   A,D   
DD02   B7                     OR   A   ;check for zero or lessor
DD03   28 03                  JR   Z,$+5   
DD05   F2 D5 DC               JP   P,PLOT_BYTE   ;its greater or zero, do next byte
DD08                             ;Move down a row and set column to the start
DD08   1D                     DEC   E   ;move column pixel count down by one
DD09   C8                     RET   Z   ;if its zero no more to do, just exit
DD0A   0C                     INC   C   ;move down a row
DD0B   3A 0E 0E               LD   A,(CURSOR_X)   
DD0E   47                     LD   B,A   ;reset column
DD0F   3A 12 0E               LD   A,(PIXEL_X)   
DD12   57                     LD   D,A   ;reset pixel length per row
DD13   18 C0                  JR   PLOT_BYTE   
DD15                             ; Contstants
DD15   80 90 88 98  ROWS:     DB   80H,90H,88H,98H   ;Text Row start position
