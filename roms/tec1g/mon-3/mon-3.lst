EEED                             ;Sound and Music Routine.
EEED                             ;------------------------
EEED                             ; Based on Mon1 routine by J. Hardy and modified to work at 4Mhz
EEED                             ; By B. Chiha
EEED                             ; This routine will play a series of notes based on data in memory
EEED                             ; To play a note use a reference between 01H and 18H.  Where
EEED                             ; 01H is the lowest and 18h is the highest.  Use 00H to make a pause
EEED                             ; and any value greater then 18H to exit.
EEED                             ; 
EEED                             ; Note reference table is as follows:
EEED                             ; +-----------+
EEED                             ; |  G  | 01H |
EEED                             ; |  G# | 02H |     Exit = 1FH
EEED                             ; |  A  | 03H |
EEED                             ; |  A# | 04H |
EEED                             ; |  B  | 05H |
EEED                             ; |  C  | 06H |
EEED                             ; |  C# | 07H |
EEED                             ; |  D  | 08H |
EEED                             ; |  D# | 09H |
EEED                             ; |  E  | 0AH |
EEED                             ; |  F  | 0BH |
EEED                             ; |  F# | 0CH |
EEED                             ; |  G  | 0DH |
EEED                             ; |  G# | 0EH |
EEED                             ; |  A  | 0FH |
EEED                             ; |  A# | 10H |
EEED                             ; |  B  | 11H |
EEED                             ; |  C  | 12H |
EEED                             ; |  C# | 13H |
EEED                             ; |  D  | 14H |
EEED                             ; |  D# | 15H |
EEED                             ; |  E  | 16H |
EEED                             ; |  F  | 17H |
EEED                             ; |  F# | 18H |
EEED                             ; +-----------+
EEED                PLAYTUNEMENU:      
EEED   21 74 EF               LD   hl,tuneParams   ;get tune parameters
EEF0   CD 7E CF               CALL   paramDriver   ;collect parameters
EEF3   ED 5B C0 08            LD   de,(DATA_FROM)   ;get start address
EEF7                PLAYTUNE:      
EEF7   1A                     LD   a,(de)   ;put note index in A
EEF8   13                     INC   de   ;move to next note
EEF9   FE 19                  CP   19H   ;is it of of range?
EEFB   D0                     RET   nc   ;exit if it is
EEFC   B7                     OR   a   ;is it a pause?
EEFD   28 19                  JR   z,tunePause   ;yes, do a pause
EEFF   21 44 EF               LD   hl,FREQ_TABLE   ;load HL with frequency table
EF02   3D                     DEC   a   ;fix indexing
EF03   87                     ADD   a,a   ;double A
EF04   85                     ADD   a,l   ;index HL
EF05   6F                     LD   l,a   ;and
EF06   3E 00                  LD   a,0   ;ensure
EF08   8C                     ADC   a,h   ;H is set
EF09   67                     LD   h,a   ;correctly
EF0A   7E                     LD   a,(hl)   ;get wavelength
EF0B   C5                     PUSH   bc   ;save BC
EF0C   47                     LD   b,a   
EF0D   23                     INC   hl   
EF0E   7E                     LD   a,(hl)   ;get frequency
EF0F   6F                     LD   l,a   ;set HL = A
EF10   26 00                  LD   h,0   
EF12   CD 29 EF               CALL   playNote   ;play the tone
EF15   C1                     POP   bc   ;restore BC
EF16   18 DF                  JR   playTune   ;play next note
EF18                TUNEPAUSE:      
EF18   E5                     PUSH   hl   ;save HL
EF19   21 00 20               LD   hl,2000h   ;some time delay
EF1C   D5                     PUSH   de   ;save DE
EF1D   11 01 00               LD   de,1   ;load DE with 1
EF20   ED 52                  SBC   hl,de   ;subtract 1 from HL
EF22   D2 20 EF               JP   nc,$-2   ;repeat subtraction until HL=0
EF25   D1                     POP   de   ;restore DE
EF26   E1                     POP   hl   ;restore HL
EF27   18 CE                  JR   playTune   ;play next note
EF29                             ; Play a note.  Play a note with a given frequency and wavelength
EF29                             ; Input: HL = frequency (01-7F)
EF29                             ;        B = wavelength (00-FF)
EF29                             ; Destroys: HL, BC, A
EF29                PLAYNOTE:      
EF29   29                     ADD   hl,hl   ;double HL
EF2A   29                     ADD   hl,hl   ;double again for 4Mhz
EF2B   AF                     XOR   a   ;clear A
EF2C   D5                     PUSH   de   ;save DE
EF2D   11 01 00               LD   de,1   ;set DE=1
EF30   48                     LD   c,b   ;save wavelength
EF31                NOTELOOP:      
EF31   D3 01                  OUT   (DIGITS),a   ;toggle speaker bit
EF33   06 03                  LD   b,3   ;elongate wavelength
EF35   C5                     PUSH   bc   ;save BC
EF36   41                     LD   b,c   ;get wavelength
EF37   10 FE                  DJNZ   $   ;loop for wavelength
EF39   C1                     POP   bc   ;restore BC
EF3A   10 F9                  DJNZ   $-5   ;loop 3 times
EF3C   EE 80                  XOR   80H   ;invert bit 7 of A (speaker bit)
EF3E   ED 52                  SBC   hl,de   ;HL = HL - 1
EF40   20 EF                  JR   nz,noteLoop   ;repeat for frequency
EF42   D1                     POP   de   ;restore DE
EF43   C9                     RET      
EF44                             ; frequency table, contains wavelength and frequency combined sequentially
EF44                FREQ_TABLE:      
EF44   8C 19 83 1A 7C 1C 75 1D DB   8CH,19H,83H,1AH,7CH,1CH,75H,1DH   
EF4C   70 1E 67 20 62 23 5C 25 DB   70H,1EH,67H,20H,62H,23H,5CH,25H   
EF54   57 27 52 29 4E 2C 48 2E DB   57H,27H,52H,29H,4EH,2CH,48H,2EH   
EF5C   45 31 41 33 3C 37 39 3A DB   45H,31H,41H,33H,3CH,37H,39H,3AH   
EF64   36 3D 32 41 2F 45 2C 49 DB   36H,3DH,32H,41H,2FH,45H,2CH,49H   
EF6C   2A 4D 27 52 25 57 23 5C DB   2AH,4DH,27H,52H,25H,57H,23H,5CH   
EF74                TUNEPARAMS:      
EF74   01                     DB   1   ;Three parameters
EF75   54 55 4E 45 20 20      DB   "TUNE  "   ;7seg text
EF7B   3D 20 45 6E 74 65 72 20 50 61 72 61 6D 65 74 65 72 73 20 3D 00 DB   "= Enter Parameters =",0   ;Parameter title
EF90   53 74 61 72 74 20 41 64 64 72 65 73 73 3A 00 DB   "Start Address:",0   ;Text and Address
EF9F   C0 08                  DW   DATA_FROM   
